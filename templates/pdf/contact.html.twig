{# Bilingual PDF for a contact submission, safe to forward to partners.
   Rendered through DocRaptor (Chrome headless). Same visual language as
   pdf/document_request.html.twig: nested gray→white cards, muted #525252
   labels, centered brand chrome, colored status pill.

   Deliberately excluded (internal only): follow-up notes thread, lead
   rating/qualification note, IP address. #}
{% set fr = locale == 'fr' %}
{% set t = {
    title: fr ? 'Demande de contact' : 'Contact request',
    receivedOn: fr ? 'Reçue le' : 'Received on',
    summary: fr ? 'Coordonnées' : 'Contact details',
    nameLabel: fr ? 'Nom' : 'Name',
    emailLabel: 'Email',
    phoneLabel: fr ? 'Téléphone' : 'Phone',
    langLabel: fr ? 'Langue' : 'Language',
    langValue: contact.lang == 'fr' ? (fr ? 'Français' : 'French') : (fr ? 'Anglais' : 'English'),
    companyLabel: fr ? 'Société' : 'Company',
    offerLabel: fr ? 'Formule souhaitée' : 'Desired package',
    requestLabel: fr ? 'Demande' : 'Request',
    projectLabel: fr ? 'Projet logement' : 'Housing project',
    projectBudget: fr ? 'Budget mensuel' : 'Monthly budget',
    projectAreas: fr ? 'Quartiers visés' : 'Target areas',
    projectMoveIn: fr ? 'Emménagement souhaité' : 'Desired move-in',
    projectType: fr ? 'Type de bien' : 'Property type',
    projectStay: fr ? "Durée d'installation" : 'Length of stay',
    projectFurnishing: fr ? 'Meublé / non meublé' : 'Furnishing',
    projectGuarantor: fr ? 'Type de garant' : 'Guarantor type',
    messageLabel: fr ? 'Message' : 'Message',
    referenceLabel: fr ? 'Référence' : 'Reference',
    followUp: fr ? 'Suivi' : 'Follow-up',
    assignee: fr ? 'Suivi par' : 'Followed by',
    projectAreasMap: fr ? 'Quartiers souhaités (en couleur)' : 'Requested districts (highlighted)',
    handledBy: fr ? 'Prise en charge par' : 'Handled by',
    firstTreatedAt: fr ? 'Première prise en charge' : 'First handled on',
    statusChangedAt: fr ? 'Dernier changement de statut' : 'Last status change',
    footerTag: fr ? 'Agence de Relocation pour Particuliers et Professionnels' : 'Relocation Agency for Individuals and Businesses',
    footerAddress: '155 Rue du Faubourg Saint-Denis, 75010 Paris, France',
} %}
<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <title>{{ t.title }} - {{ contact.reference }}</title>
    <style>
        @page { margin: 18mm 16mm 22mm 16mm; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', 'Roboto', sans-serif;
            color: #1f2937;
            font-size: 10.5pt;
            line-height: 1.55;
            margin: 0;
            padding: 0;
        }
        a { color: #71172e; }
        h1, h2, h3 { font-weight: 600; color: #111827; }
        .muted { color: #525252; }
        .narrow { max-width: 480pt; margin: 0 auto; }

        .gray-card {
            background-color: #F7F7F7;
            border: 1px solid #E5E5E5;
            border-radius: 12pt;
            padding: 10pt;
            margin-bottom: 14pt;
            page-break-inside: avoid;
        }
        .white-inner {
            background-color: #ffffff;
            border-radius: 8pt;
            padding: 14pt 18pt;
        }
        .section-label {
            margin: 2pt 0 8pt 4pt;
            font-size: 8.5pt;
            font-weight: 600;
            color: #71172e;
            text-transform: uppercase;
            letter-spacing: 0.8pt;
        }

        .field-table { display: table; width: 100%; border-collapse: collapse; }
        .field-tr { display: table-row; }
        .field-th {
            display: table-cell;
            width: 36%;
            padding: 5pt 12pt 5pt 0;
            font-size: 9pt;
            color: #525252;
            vertical-align: top;
            border-bottom: 1px solid #F5F5F4;
        }
        .field-td {
            display: table-cell;
            padding: 5pt 0;
            font-size: 10pt;
            font-weight: 600;
            color: #111827;
            vertical-align: top;
            border-bottom: 1px solid #F5F5F4;
        }
        .field-tr:last-child .field-th,
        .field-tr:last-child .field-td { border-bottom: none; }

        .highlights { display: table; width: 100%; border-collapse: separate; border-spacing: 6pt 0; margin: 0 -6pt 10pt; }
        .highlight {
            display: table-cell;
            width: 33%;
            background-color: #F7F7F7;
            border-radius: 8pt;
            padding: 8pt 10pt;
            vertical-align: top;
        }
        .highlight .hl-label { margin: 0; font-size: 7.5pt; color: #525252; text-transform: uppercase; letter-spacing: 0.5pt; }
        .highlight .hl-value { margin: 2pt 0 0; font-size: 11pt; font-weight: 700; color: #111827; }
        hr.sep { width: 100%; border: none; border-top: 2px solid #eaeaea; margin: 10pt 0; }
        .footer-brand { margin: 14pt 0 0; font-size: 9pt; text-align: center; color: #525252; }
        .footer-address { margin: 4pt 0 0; font-size: 9pt; text-align: center; color: #9ca3af; }
        .page-footer {
            position: fixed;
            bottom: -14mm;
            left: 0; right: 0;
            text-align: center;
            color: #9ca3af;
            font-size: 7.5pt;
            line-height: 1.5;
        }
        .page-footer .brand { color: #71172e; font-weight: 600; }
    </style>
</head>
<body>
    <div class="narrow">
        {# ---- Centered logo (mirrors email header) ---- #}
        <div style="text-align:center">
            {% if logoDataUri %}
                <img src="{{ logoDataUri }}" alt="Relocation in Paris" width="166" height="38" style="display:block;border:none;outline:none;text-decoration:none;height:38px;width:166px;margin:0 auto">
            {% else %}
                <span style="font-size:15pt;font-weight:700;color:#71172e;letter-spacing:0.6pt">Relocation in Paris</span>
            {% endif %}
        </div>

        <div style="width:26pt;height:2pt;background-color:#71172e;border-radius:2pt;margin:14pt auto 0"></div>
        <h1 style="font-size:22pt;line-height:1.3;text-align:center;margin:8pt 0 0">{{ t.title }}</h1>
        <p style="margin:6pt 0 0;font-size:13pt;font-weight:600;text-align:center;color:#374151">{{ contact.fullName ? contact.fullName|title : contact.email }}</p>
        <p style="margin:8pt 0 0;font-size:9pt;text-align:center;color:#9ca3af">
            {{ t.referenceLabel }} {{ contact.reference }} &middot;
            {{ t.receivedOn }} {{ contact.createdAt|format_datetime(pattern='dd MMMM yyyy, HH:mm', locale=locale) }}
        </p>
        <div style="margin:0 0 18pt"></div>

        {# ---- Contact details (gray outer → white inner) ---- #}
        <div class="gray-card">
            <p class="section-label">{{ t.summary }}</p>
            <div class="white-inner">
                <div class="field-table">
                    <div class="field-tr">
                        <span class="field-th">{{ t.nameLabel }}</span>
                        <span class="field-td">{{ contact.fullName ? contact.fullName|title : '-' }}</span>
                    </div>
                    <div class="field-tr">
                        <span class="field-th">{{ t.emailLabel }}</span>
                        <span class="field-td">{{ contact.email }}</span>
                    </div>
                    <div class="field-tr">
                        <span class="field-th">{{ t.phoneLabel }}</span>
                        <span class="field-td">{{ contact.phoneNumber ? contact.phoneNumber|phone_format : '-' }}</span>
                    </div>
                    <div class="field-tr">
                        <span class="field-th">{{ t.langLabel }}</span>
                        <span class="field-td">{{ t.langValue }}</span>
                    </div>
                    <div class="field-tr">
                        <span class="field-th">{{ t.companyLabel }}</span>
                        <span class="field-td">{{ contact.company ?: '-' }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# ---- Request + message ---- #}
        <div class="gray-card">
            <p class="section-label">{{ t.requestLabel }}</p>
            <div class="white-inner">
                <p style="margin:0;padding:0;font-size:10.5pt"><strong>{{ helpTypeLabel }}</strong></p>
                {% if contact.message %}
                    <hr class="sep">
                    <p class="muted" style="margin:0;padding:0 0 6pt;font-size:9pt">{{ t.messageLabel }} :</p>
                    <p style="margin:0;padding:2pt 0;font-size:10pt;line-height:1.65;color:#374151;white-space:pre-line">{{ contact.message }}</p>
                {% endif %}
            </div>
        </div>

        {# ---- Housing project (only when the admin filled something) ---- #}
        {% if offerLabel or contact.projectBudget or contact.projectAreas or contact.projectMoveInAt or contact.projectPropertyType or contact.projectStayDuration or contact.projectFurnishing or contact.projectGuarantorType %}
            <div class="gray-card">
                <p class="section-label">{{ t.projectLabel }}</p>
                <div class="white-inner">
                    {% if contact.projectBudget or contact.projectMoveInAt or contact.projectStayDuration %}
                        <div class="highlights">
                            {% if contact.projectBudget %}
                                <div class="highlight">
                                    <p class="hl-label">{{ t.projectBudget }}</p>
                                    <p class="hl-value">{{ contact.projectBudget|format_number(locale=locale) }} €<span style="font-size:8pt;font-weight:400;color:#525252"> /{{ fr ? 'mois' : 'mo' }}</span></p>
                                </div>
                            {% endif %}
                            {% if contact.projectMoveInAt %}
                                <div class="highlight">
                                    <p class="hl-label">{{ t.projectMoveIn }}</p>
                                    <p class="hl-value">{{ contact.projectMoveInAt|format_date(pattern='dd MMM yyyy', locale=locale) }}</p>
                                </div>
                            {% endif %}
                            {% if contact.projectStayDuration %}
                                <div class="highlight">
                                    <p class="hl-label">{{ t.projectStay }}</p>
                                    <p class="hl-value">{{ contact.projectStayDuration.labelKey|trans([], 'messages', locale) }}</p>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                    <div class="field-table">
                        {% if offerLabel %}
                            <div class="field-tr">
                                <span class="field-th">{{ ux_icon('lucide:briefcase', {style: 'width:9pt;height:9pt;vertical-align:-1.5pt;margin-right:4pt;color:#525252', 'aria-hidden': 'true'}) }}{{ t.offerLabel }}</span>
                                <span class="field-td">{{ offerLabel }}</span>
                            </div>
                        {% endif %}
                        {% if areaLabels is not empty %}
                            <div class="field-tr">
                                <span class="field-th">{{ ux_icon('lucide:map-pin', {style: 'width:9pt;height:9pt;vertical-align:-1.5pt;margin-right:4pt;color:#525252', 'aria-hidden': 'true'}) }}{{ t.projectAreas }}</span>
                                <span class="field-td">{{ areaLabels|join(', ') }}</span>
                            </div>
                        {% endif %}
                        {% if contact.projectPropertyType %}
                            {# CSV of enum values translates; legacy free text prints as-is. #}
                            {% set typeLabels = [] %}
                            {% for value in contact.projectPropertyType|split(',')|filter(v => v != '') %}
                                {% set typeKey = 'listProperty.form.propertyType.choice.' ~ value %}
                                {% set typeLabel = typeKey|trans([], 'messages', locale) %}
                                {% set typeLabels = typeLabels|merge([typeLabel != typeKey ? typeLabel : value]) %}
                            {% endfor %}
                            <div class="field-tr">
                                <span class="field-th">{{ ux_icon('lucide:building-2', {style: 'width:9pt;height:9pt;vertical-align:-1.5pt;margin-right:4pt;color:#525252', 'aria-hidden': 'true'}) }}{{ t.projectType }}</span>
                                <span class="field-td">{{ typeLabels|join(', ') }}</span>
                            </div>
                        {% endif %}
                        {% if contact.projectFurnishing %}
                            {% set furnishingLabels = contact.projectFurnishing|split(',')|filter(v => v != '')|map(v => ('admin.contacts.project.furnishing.choice.' ~ v)|trans([], 'messages', locale)) %}
                            <div class="field-tr">
                                <span class="field-th">{{ ux_icon('lucide:sofa', {style: 'width:9pt;height:9pt;vertical-align:-1.5pt;margin-right:4pt;color:#525252', 'aria-hidden': 'true'}) }}{{ t.projectFurnishing }}</span>
                                <span class="field-td">{{ furnishingLabels|join(', ') }}</span>
                            </div>
                        {% endif %}
                        {% if contact.projectGuarantorType %}
                            <div class="field-tr">
                                <span class="field-th">{{ ux_icon('lucide:shield-check', {style: 'width:9pt;height:9pt;vertical-align:-1.5pt;margin-right:4pt;color:#525252', 'aria-hidden': 'true'}) }}{{ t.projectGuarantor }}</span>
                                <span class="field-td">{{ contact.projectGuarantorType.labelKey|trans([], 'messages', locale) }}</span>
                            </div>
                        {% endif %}
                    </div>
                    {% if areasMapSvg %}
                        <div style="margin-top:10pt;border-top:1px solid #eaeaea;padding-top:10pt;page-break-inside:avoid">
                            <p style="margin:0 0 6pt;font-size:9pt;color:#525252">{{ t.projectAreasMap }}</p>
                            <div style="width:100%;border:1px solid #E5E5E5;border-radius:8pt;overflow:hidden;line-height:0">{{ areasMapSvg|raw }}</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {# ---- Follow-up (only once the request was handled) ---- #}
        {% if contact.assigneeName or contact.statusChangedBy or contact.firstTreatedAt %}
            <div class="gray-card">
                <p class="section-label">{{ t.followUp }}</p>
                <div class="white-inner">
                    <div class="field-table">
                        {% if contact.assigneeName %}
                            <div class="field-tr">
                                <span class="field-th">{{ t.assignee }}</span>
                                <span class="field-td">{{ contact.assigneeName|title }}</span>
                            </div>
                        {% endif %}
                        {% if contact.statusChangedBy %}
                            <div class="field-tr">
                                <span class="field-th">{{ t.handledBy }}</span>
                                <span class="field-td">{{ contact.statusChangedBy|title }}</span>
                            </div>
                        {% endif %}
                        {% if contact.firstTreatedAt %}
                            <div class="field-tr">
                                <span class="field-th">{{ t.firstTreatedAt }}</span>
                                <span class="field-td">{{ contact.firstTreatedAt|format_datetime(pattern='dd MMMM yyyy, HH:mm', locale=locale) }}</span>
                            </div>
                        {% endif %}
                        {% if contact.statusChangedAt %}
                            <div class="field-tr">
                                <span class="field-th">{{ t.statusChangedAt }}</span>
                                <span class="field-td">{{ contact.statusChangedAt|format_datetime(pattern='dd MMMM yyyy, HH:mm', locale=locale) }}</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}

        {# ---- Bottom signature, centered like email footer ---- #}
        <hr class="sep" style="margin-top:20pt">
        <p class="footer-brand">
            <strong style="color:#71172e">Relocation in Paris</strong> &middot; {{ t.footerTag }}
        </p>
        <p class="footer-address">{{ t.footerAddress }}</p>
    </div>

    <div class="page-footer">
        <span class="brand">Relocation in Paris</span> &middot; {{ t.title }} {{ contact.reference }}
    </div>
</body>
</html>
