{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.tools.title'|trans }}{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ 'admin.tools.title'|trans }}"
    />
{% endblock %}

{% block body %}
    <div class="space-y-8" data-testid="tools-page">
        <section class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="tools-grid">
            {# Accès directs aux sous-pages (demande, catalogue) dans la card. #}
            <article class="rounded-2xl border border-neutral-200 bg-white p-2" data-testid="tool-documents-card">
                <div class="flex h-full flex-col gap-1 rounded-xl bg-neutral-50 p-2">
                    <div class="flex items-start gap-3 p-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                            {{ ux_icon('lucide:file-text', {class: 'size-5', 'aria-hidden': 'true'}) }}
                        </div>
                        <div class="min-w-0 space-y-1">
                            <h2 class="text-sm font-semibold tracking-tight text-gray-900">
                                {{ 'admin.tools.documents.title'|trans }}
                            </h2>
                            <p class="text-sm leading-relaxed text-pretty text-gray-500">
                                {{ 'admin.tools.documents.description'|trans }}
                            </p>
                        </div>
                    </div>
                    <div class="mt-auto flex flex-col overflow-hidden rounded-lg bg-white">
                        <a
                            href="{{ path('admin_tools_documents_request', {adminPrefix: adminPrefix}) }}"
                            class="flex items-center gap-2 border-b border-gray-950/5 px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-primary"
                        >
                            {{ ux_icon('lucide:send', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                            {{ 'admin.tools.documents.request.title'|trans }}
                            {{ ux_icon('lucide:chevron-right', {class: 'ml-auto size-4 shrink-0 text-gray-300', 'aria-hidden': 'true'}) }}
                        </a>
                        <a
                            href="{{ path('admin_tools_documents', {adminPrefix: adminPrefix}) }}"
                            class="flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-primary"
                        >
                            {{ ux_icon('lucide:layout-grid', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                            {{ 'admin.tools.documents.cta'|trans }}
                            {{ ux_icon('lucide:chevron-right', {class: 'ml-auto size-4 shrink-0 text-gray-300', 'aria-hidden': 'true'}) }}
                        </a>
                    </div>
                </div>
            </article>
        </section>
    </div>
{% endblock %}
