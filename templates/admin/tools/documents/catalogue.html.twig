{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.tools.documents.catalogue.title'|trans }}{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ 'admin.tools.documents.catalogue.title'|trans }}"
        :crumbs="[
            {label: 'admin.tools.title'|trans, url: path('admin_tools', {adminPrefix: adminPrefix})},
            {label: 'admin.tools.documents.title'|trans, url: path('admin_tools_documents', {adminPrefix: adminPrefix})},
        ]"
    />
{% endblock %}

{% block body %}
    <div class="space-y-8" data-testid="tools-documents-catalogue-page">
        <twig:Admin:DocumentList :adminPrefix="adminPrefix" />
    </div>
{% endblock %}
