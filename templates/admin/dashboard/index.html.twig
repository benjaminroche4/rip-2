{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.dashboard.title'|trans }}{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader title="{{ 'admin.dashboard.title'|trans }}" />
{% endblock %}

{% block body %}
    <div class="flex min-h-[50vh] items-center justify-center" data-testid="dashboard-page">
        <div class="flex flex-col items-center gap-3 text-center">
            {{ ux_icon('lucide:construction', {class: 'size-14 text-gray-300', 'aria-hidden': 'true'}) }}
            <p class="text-base font-medium text-gray-500">{{ 'admin.dashboard.underConstruction'|trans }}</p>
        </div>
    </div>
{% endblock %}
