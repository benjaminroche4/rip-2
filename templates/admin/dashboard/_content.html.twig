{# Contenu lourd du dashboard (dépend de l'API Allo), chargé en différé
   dans la Turbo Frame du shell (index.html.twig). #}
<turbo-frame id="dashboard-content">
    <div class="space-y-8">
        <section class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-testid="kpi-grid">
            {% for kpi in kpis %}
                {% if kpi.previous is not null %}
                    <twig:Admin:KpiComparisonCard :kpi="kpi" />
                {% else %}
                    {# leadsLast12Months card — two stats with divider (12 months total + year-to-date) #}
                    <twig:Admin:KpiAllTimeCard
                        :kpi="kpi"
                        firstLabel="{{ 'admin.dashboard.kpi.period.last12m'|trans }}"
                        :firstValue="kpi.value"
                        secondLabel="{{ 'admin.dashboard.kpi.thisYear'|trans({'%year%': thisYearLabel}) }}"
                        :secondValue="thisYearLeads"
                    />
                {% endif %}
            {% endfor %}
        </section>

        <section class="rounded-2xl border border-neutral-200 bg-white p-2" data-testid="response-time-card">
            <div class="rounded-xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0 p-4">
                <div>
                    <h2 class="text-xl font-semibold tracking-tight text-gray-900">
                        {{ 'admin.dashboard.responseTime.title'|trans }}
                    </h2>
                    <p class="mt-0.5 text-sm text-pretty text-gray-500">
                        {{ 'admin.dashboard.responseTime.subtitle'|trans }}
                    </p>
                </div>
                <div class="mt-6 flex flex-col gap-y-4 sm:flex-row sm:items-stretch sm:gap-x-6">
                    <div class="min-w-0 sm:flex-1">
                        <p class="text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.dashboard.responseTime.avg'|trans }}</p>
                        <p class="mt-1 text-2xl font-medium text-gray-900 tabular-nums">{{ responseTimeAvgLabel ?? '-' }}</p>
                    </div>
                    <div class="hidden w-px self-stretch bg-linear-to-b from-transparent via-gray-950/10 to-transparent sm:block" aria-hidden="true"></div>
                    <div class="min-w-0 sm:flex-1">
                        <p class="text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.dashboard.responseTime.withinSla'|trans }}</p>
                        <p class="mt-1 text-2xl font-medium text-gray-900 tabular-nums">{{ responseTimeSlaRate is not null ? responseTimeSlaRate ~ ' %' : '-' }}</p>
                    </div>
                    <div class="hidden w-px self-stretch bg-linear-to-b from-transparent via-gray-950/10 to-transparent sm:block" aria-hidden="true"></div>
                    <div class="min-w-0 sm:flex-1">
                        <p class="text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.dashboard.responseTime.treated'|trans }}</p>
                        <p class="mt-1 text-2xl font-medium text-gray-900 tabular-nums">{{ responseTimeTreatedCount }}</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="rounded-2xl border border-neutral-200 bg-white p-2">
            <div class="rounded-xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                <div class="px-3 pt-3 pb-5">
                    <h2 class="text-xl font-semibold tracking-tight text-gray-900">
                        {{ 'admin.dashboard.activity.title'|trans }}
                    </h2>
                    <p class="mt-0.5 text-sm text-pretty text-gray-500">
                        {{ 'admin.dashboard.activity.subtitle'|trans }}
                    </p>
                </div>
                <div class="h-80 px-3 pt-5 pb-3">
                    <canvas
                        data-controller="chart"
                        data-chart-labels-value="{{ chartLabels|json_encode }}"
                        data-chart-series-value="{{ chartSeries|json_encode }}"
                        data-testid="activity-chart"
                    ></canvas>
                </div>
            </div>
        </section>

        <section class="rounded-2xl border border-neutral-200 bg-white p-2">
            <div class="rounded-xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                <div class="px-3 pt-3 pb-5">
                    <h2 class="text-xl font-semibold tracking-tight text-gray-900">
                        {{ 'admin.dashboard.weekVsWeek.title'|trans }}
                    </h2>
                    <p class="mt-0.5 text-sm text-pretty text-gray-500">
                        {{ 'admin.dashboard.weekVsWeek.subtitle'|trans }}
                    </p>
                </div>
                <div class="h-80 px-3 pt-5 pb-3">
                    <canvas
                        data-controller="chart-bars"
                        data-chart-bars-labels-value="{{ weekChartLabels|json_encode }}"
                        data-chart-bars-series-value="{{ weekChartSeries|json_encode }}"
                        data-testid="week-vs-week-chart"
                    ></canvas>
                </div>
            </div>
        </section>

        {% if allTimeChartSeries|length > 0 %}
            <section class="rounded-2xl border border-neutral-200 bg-white p-2">
                <div class="rounded-xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                    <div class="px-3 pt-3 pb-5">
                        <h2 class="text-xl font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dashboard.contactsAllTime.title'|trans }}
                        </h2>
                        <p class="mt-0.5 text-sm text-pretty text-gray-500">
                            {{ 'admin.dashboard.contactsAllTime.subtitle'|trans }}
                        </p>
                    </div>
                    <div class="h-80 px-3 pt-5 pb-3">
                        <canvas
                            data-controller="chart"
                            data-chart-labels-value="{{ allTimeChartLabels|json_encode }}"
                            data-chart-series-value="{{ allTimeChartSeries|json_encode }}"
                            data-testid="contacts-all-time-chart"
                        ></canvas>
                    </div>
                </div>
            </section>
        {% endif %}

        {% if weekdayChartSeries|length > 0 %}
            <section class="rounded-2xl border border-neutral-200 bg-white p-2">
                <div class="rounded-xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                    <div class="px-3 pt-3 pb-5">
                        <h2 class="text-xl font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dashboard.contactsWeekdays.title'|trans }}
                        </h2>
                        <p class="mt-0.5 text-sm text-pretty text-gray-500">
                            {{ 'admin.dashboard.contactsWeekdays.subtitle'|trans }}
                        </p>
                    </div>
                    <div class="h-80 px-3 pt-5 pb-3">
                        <canvas
                            data-controller="chart-bars"
                            data-chart-bars-labels-value="{{ weekdayChartLabels|json_encode }}"
                            data-chart-bars-series-value="{{ weekdayChartSeries|json_encode }}"
                            data-testid="contacts-weekday-chart"
                        ></canvas>
                    </div>
                </div>
            </section>
        {% endif %}

    </div>
</turbo-frame>
