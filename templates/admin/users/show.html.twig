{% extends 'admin/base.html.twig' %}

{% set displayName = profile.fullName ? profile.fullName|title : profile.email %}
{% set isAdmin = profile.primaryRole == 'admin' %}
{% set authMethodKey = profile.hasGoogleAuth ? 'google' : 'password' %}
{% set lastLoginValue = profile.lastLoginAt
    ? profile.lastLoginAt|format_datetime('medium', 'short', locale=app.request.locale)
    : 'admin.users.lastLoginNever'|trans %}
{% set createdAtValue = profile.createdAt|format_date('long', locale=app.request.locale) %}
{% set authMethodValue = ('admin.users.profile.authMethod.' ~ authMethodKey)|trans %}
{% set ageValue = 'admin.users.profile.stat.daysOld'|trans({'%count%': date('now').diff(profile.createdAt).days}) %}
{% set idleValue = profile.lastLoginAt ? 'admin.users.profile.stat.daysIdle'|trans({'%count%': date('now').diff(profile.lastLoginAt).days}) : null %}

{% block title %}{{ displayName }}{% endblock %}

{% block head %}
    {# Accès, fonctions et suspension vivent dans des LiveComponents : un
       snapshot Turbo restauré montrerait des toggles périmés au retour. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ displayName }}"
        :crumbs="[{label: 'admin.users.title'|trans, url: path('admin_users', {adminPrefix: adminPrefix})}]"
    />
{% endblock %}

{% block body %}
    {# Bannière live : visible tant que le compte est suspendu. #}
    <twig:Admin:UserSuspendedBanner :userId="profile.id" />

    {# Deux colonnes : la fiche à droite reste visible (sticky sur toute la
       hauteur de page), tout le reste défile dans la colonne de gauche. #}
    {# Octroi/retrait de l'accès BO : la fiche se re-visite en Turbo (morph)
       pour révéler ou masquer les cards staff sans rechargement manuel. #}
    <div
        class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[3fr_2fr]"
        data-controller="page-refresh"
        data-action="user-access:changed@window->page-refresh#refresh"
        data-testid="user-profile"
    >
        <section class="rounded-3xl border border-neutral-200 bg-white p-2 lg:sticky lg:top-6 lg:order-2">
            <div class="rounded-2xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                {# Identité éditable : crayon → mode édition (pattern ContactDetails). #}
                <twig:Admin:UserIdentity :userId="profile.id" adminPrefix="{{ adminPrefix }}" uniqueId="{{ profile.uniqueId }}" />
                {% set roleChip %}
                    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium {{ isAdmin ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-neutral-50 text-gray-700' }}">
                        {{ ('admin.users.role.' ~ profile.primaryRole)|trans }}
                    </span>
                {% endset %}
                {% set twoFactorValue %}
                    {% if profile.hasTwoFactor %}
                        <span class="inline-flex items-center gap-1.5 font-medium text-emerald-600">
                            {{ ux_icon('lucide:shield-check', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                            {{ 'admin.users.profile.twoFactor.enabled'|trans }}
                        </span>
                    {% else %}
                        <span class="text-gray-500">{{ 'admin.users.profile.twoFactor.disabled'|trans }}</span>
                    {% endif %}
                {% endset %}
                {% set copyButton %}
                    <button
                        type="button"
                        data-action="copy-link#copy"
                        class="flex shrink-0 cursor-pointer items-center gap-1 text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                        data-testid="user-unique-id-copy"
                    >
                        {{ ux_icon('lucide:copy', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                        <span data-copy-link-target="label">{{ 'admin.users.profile.copy'|trans }}</span>
                    </button>
                {% endset %}
                <div class="grid grid-cols-2 gap-2 px-6 pb-5">
                    <div class="rounded-xl border border-neutral-200/70 bg-white p-3">
                        <div class="text-xs font-medium tracking-wide text-gray-400 uppercase">{{ 'admin.users.profile.field.role'|trans }}</div>
                        <div class="mt-1.5 text-sm">{{ roleChip }}</div>
                    </div>
                    {# Langue éditable : chips autosave (choix de la locale des emails). #}
                    <twig:Admin:UserLanguage :userId="profile.id" />
                </div>
                <dl class="divide-y divide-gray-950/5 border-t border-gray-950/5">
                    <div class="grid grid-cols-3 gap-4 px-6 py-3.5">
                        <dt class="text-sm text-gray-600">{{ 'admin.users.profile.field.createdAt'|trans }}</dt>
                        <dd class="col-span-2 text-sm font-medium tabular-nums text-gray-900">
                            {{ createdAtValue }}
                            <span class="font-normal text-gray-400">&middot; {{ ageValue }}</span>
                        </dd>
                    </div>
                    <div class="grid grid-cols-3 gap-4 px-6 py-3.5">
                        <dt class="text-sm text-gray-600">{{ 'admin.users.profile.field.lastLogin'|trans }}</dt>
                        <dd class="col-span-2 text-sm font-medium tabular-nums text-gray-900">
                            {{ lastLoginValue }}
                            {% if idleValue %}
                                <span class="font-normal text-gray-400">&middot; {{ idleValue }}</span>
                            {% endif %}
                        </dd>
                    </div>
                    <div class="grid grid-cols-3 gap-4 px-6 py-3.5">
                        <dt class="text-sm text-gray-600">{{ 'admin.users.profile.field.authMethod'|trans }}</dt>
                        <dd class="col-span-2 flex items-center gap-1.5 text-sm font-medium text-gray-900">
                            {% if profile.hasGoogleAuth %}
                                {{ ux_icon('material-icon-theme:google', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                            {% endif %}
                            {{ authMethodValue }}
                        </dd>
                    </div>
                    <div class="grid grid-cols-3 gap-4 px-6 py-3.5">
                        <dt class="text-sm text-gray-600">{{ 'admin.users.profile.field.twoFactor'|trans }}</dt>
                        <dd class="col-span-2 text-sm" data-testid="user-two-factor-status">{{ twoFactorValue }}</dd>
                    </div>
                    <div
                        class="grid grid-cols-3 gap-4 px-6 py-3.5"
                        data-controller="copy-link"
                        data-copy-link-text-value="{{ profile.uniqueId }}"
                        data-copy-link-copied-label-value="{{ 'admin.users.profile.copied'|trans }}"
                    >
                        <dt class="text-sm text-gray-600">{{ 'admin.users.profile.field.uniqueId'|trans }}</dt>
                        <dd class="col-span-2 flex min-w-0 items-center gap-2.5">
                            <span class="truncate font-mono text-xs leading-5 text-gray-600">{{ profile.uniqueId }}</span>
                            {{ copyButton }}
                        </dd>
                    </div>
                </dl>
            </div>
        </section>

        <div class="space-y-6 lg:order-1">
            {# Droits d'accès au BO : gérés ici, plus dans la liste. #}
            <twig:Admin:UserAccess :userId="profile.id" />

            {# Fonctions et activité métier : réservées aux membres du staff.
               Sans accès BO, ces cards n'ont pas de sens et restent cachées
               (elles apparaissent au rechargement après l'octroi de l'accès). #}
            {% if profile.primaryRole != 'user' %}
            {# Fonctions métier : filtrent les listes d'assignation. #}
            <twig:Admin:UserFunctions :userId="profile.id" />

        {# Activité métier : leads assignés et dossiers gérés par ce membre.
           Chaque bloc suit l'accès du lecteur à SA section (aujourd'hui la
           page est admin-only, donc sans effet visible ; la garde tient si
           la fiche s'ouvre un jour à d'autres profils). #}
        {% set canSeeLeads = is_granted('ROLE_SECTION_CONTACTS') %}
        {% set canSeeDossiers = is_granted('ROLE_SECTION_DOSSIERS') %}
        {% if canSeeLeads or canSeeDossiers %}
        <div class="space-y-6" data-testid="user-activity">
            {% if canSeeLeads %}
            <section class="rounded-3xl border border-neutral-200 bg-white p-2">
                <div class="rounded-2xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                    <p class="px-6 pt-5 pb-3 text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.users.activity.leads.title'|trans }}</p>
                    {% if assignedLeads is empty %}
                        <p class="px-6 pb-5 text-sm text-gray-500">{{ 'admin.users.activity.leads.empty'|trans }}</p>
                    {% else %}
                        <ul class="divide-y divide-gray-950/5 border-t border-gray-950/5" role="list">
                            {% for lead in assignedLeads %}
                                <li>
                                    <a
                                        href="{{ path('admin_contact_show', {adminPrefix: adminPrefix, reference: lead.reference}) }}"
                                        class="group/row flex items-center gap-3 px-6 py-3 transition-colors duration-100 ease-out hover:bg-gray-50"
                                        data-testid="user-activity-lead"
                                    >
                                        <span class="shrink-0 font-mono text-xs text-gray-500">{{ lead.reference }}</span>
                                        <span class="min-w-0 flex-1 truncate text-sm font-medium text-gray-900">{{ lead.label|title }}</span>
                                        <span class="shrink-0 text-xs text-gray-500">{{ lead.createdAt|format_date('medium', locale=app.request.locale) }}</span>
                                        {{ ux_icon('lucide:chevron-right', {class: 'size-4 shrink-0 text-gray-300 transition-colors duration-100 ease-out group-hover/row:text-gray-500', 'aria-hidden': 'true'}) }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </section>
            {% endif %}
            {% if canSeeDossiers %}
            <section class="rounded-3xl border border-neutral-200 bg-white p-2">
                <div class="rounded-2xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                    <p class="px-6 pt-5 pb-3 text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.users.activity.dossiers.title'|trans }}</p>
                    {% if managedDossiers is empty %}
                        <p class="px-6 pb-5 text-sm text-gray-500">{{ 'admin.users.activity.dossiers.empty'|trans }}</p>
                    {% else %}
                        <ul class="divide-y divide-gray-950/5 border-t border-gray-950/5" role="list">
                            {% for dossier in managedDossiers %}
                                <li>
                                    <a
                                        href="{{ path('admin_dossier_show', {adminPrefix: adminPrefix, reference: dossier.reference}) }}"
                                        class="group/row flex items-center gap-3 px-6 py-3 transition-colors duration-100 ease-out hover:bg-gray-50"
                                        data-testid="user-activity-dossier"
                                    >
                                        <span class="shrink-0 font-mono text-xs text-gray-500">{{ dossier.reference }}</span>
                                        <span class="min-w-0 flex-1 truncate text-sm font-medium text-gray-900">{{ dossier.label }}</span>
                                        <span class="shrink-0 text-xs text-gray-500">{{ dossier.createdAt|format_date('medium', locale=app.request.locale) }}</span>
                                        {{ ux_icon('lucide:chevron-right', {class: 'size-4 shrink-0 text-gray-300 transition-colors duration-100 ease-out group-hover/row:text-gray-500', 'aria-hidden': 'true'}) }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </section>
            {% endif %}
            </div>
            {% endif %}
            {% endif %}

            {# Zone sensible : accès admin et suppression définitive du compte. #}
            <twig:Admin:UserDanger :userId="profile.id" adminPrefix="{{ adminPrefix }}" />
        </div>
    </div>
{% endblock %}
