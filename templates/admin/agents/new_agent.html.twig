{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.agents.create.title'|trans }}{% endblock %}

{% block head %}
    {# Le formulaire vit dans un LiveComponent : un snapshot Turbo restauré
       montrerait un état périmé au retour. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ 'admin.agents.create.title'|trans }}"
        :crumbs="[{label: 'admin.agents.title'|trans, url: path('admin_agents', {adminPrefix: adminPrefix})}]"
    />
{% endblock %}

{% block body %}
    <div data-testid="agent-new-page">
        <twig:RealEstateAgent:AgentCreate :adminPrefix="adminPrefix" />
    </div>
{% endblock %}
