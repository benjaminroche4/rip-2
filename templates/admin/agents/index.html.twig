{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.agents.title'|trans }}{% endblock %}

{% block head %}
    {# La recherche vit dans un LiveComponent : un snapshot Turbo restauré
       montrerait un état périmé de la liste au retour. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader title="{{ 'admin.agents.title'|trans }}">
        <twig:RealEstateAgent:CreateMenu adminPrefix="{{ adminPrefix }}" />
    </twig:Admin:PageHeader>
{% endblock %}

{% block body %}
    <div data-testid="agents-page">
        <twig:RealEstateAgent:AgentList :adminPrefix="adminPrefix" />
    </div>
{% endblock %}
