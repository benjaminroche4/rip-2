{% extends 'admin/base.html.twig' %}

{% block title %}{{ agency.name }}{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ agency.name }}"
        :crumbs="[{label: 'admin.agents.title'|trans, url: path('admin_agents', {adminPrefix: adminPrefix})}]"
    />
{% endblock %}

{% block body %}
    {# Le chrome de page (titre, fil d'ariane) vit hors du composant live :
       un morph Turbo le rafraîchit quand l'identité change. #}
    <div
        class="contents"
        data-controller="page-refresh"
        data-action="agency-identity:changed@window->page-refresh#refresh"
    ></div>
    <div class="mx-auto flex max-w-4xl flex-col gap-6" data-testid="agency-show-page">
        <twig:RealEstateAgent:AgencyDetails :agencyId="agency.id" adminPrefix="{{ adminPrefix }}" />

        <section class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="agency-agents">
            <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
                <h3 class="px-3 pt-3 pb-1 text-xs font-semibold tracking-wide text-gray-400 uppercase">
                    {{ 'admin.agencies.show.agentsTitle'|trans }}
                </h3>
                {% if agents is empty %}
                    <p class="rounded-xl px-3 pt-1 pb-4 text-sm text-gray-500" data-testid="agency-agents-empty">
                        {{ 'admin.agencies.show.empty'|trans }}
                    </p>
                {% else %}
                    <ul class="flex flex-col gap-1" role="list">
                        {% for agent in agents %}
                            <li class="rounded-xl bg-white {{ agent.active ? '' : 'opacity-60' }}" data-testid="agency-agent-row">
                                <a
                                    href="{{ path('admin_agent_show', {adminPrefix: adminPrefix, id: agent.id}) }}"
                                    class="flex items-center gap-3 rounded-xl px-5 py-4 transition-colors duration-100 ease-out hover:bg-gray-50"
                                >
                                    <twig:Avatar filename="{{ agent.avatarFilename }}" name="{{ agent.fullName }}" size="8" />
                                    <span class="min-w-0 flex-1">
                                        <span class="flex min-w-0 items-center gap-2">
                                            <span class="truncate text-sm font-medium text-gray-900">{{ agent.fullName|title }}</span>
                                            {% if not agent.active %}
                                                <span class="shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-500" data-testid="agency-agent-inactive">{{ 'admin.agents.status.inactive'|trans }}</span>
                                            {% endif %}
                                            {% for specialty in agent.specialties %}
                                                <span class="shrink-0 rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-medium text-gray-600">{{ specialty.labelKey|trans }}</span>
                                            {% endfor %}
                                        </span>
                                        {% if agent.position %}
                                            <span class="block truncate text-xs text-gray-500">{{ agent.position.labelKey|trans }}</span>
                                        {% endif %}
                                    </span>
                                    {{ ux_icon('lucide:chevron-right', {class: 'size-4 shrink-0 text-gray-300', 'aria-hidden': 'true'}) }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}
