{% extends 'admin/base.html.twig' %}

{% block title %}{{ agency.name }}{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ agency.name }}"
        :crumbs="[{label: 'admin.agents.title'|trans, url: path('admin_agents', {adminPrefix: adminPrefix})}]"
    />
{% endblock %}

{% block body %}
    {# Le chrome de page (titre, fil d'ariane) vit hors du composant live :
       un morph Turbo le rafraîchit quand l'identité change. #}
    <div
        class="contents"
        data-controller="page-refresh"
        data-action="agency-identity:changed@window->page-refresh#refresh"
    ></div>
    <div class="mx-auto flex max-w-4xl flex-col gap-6" data-testid="agency-show-page">
        <twig:RealEstateAgent:AgencyDetails :agencyId="agency.id" adminPrefix="{{ adminPrefix }}" />

        <section class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="agency-agents">
            <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
                <h3 class="px-3 pt-3 pb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                    {{ 'admin.agencies.show.agentsTitle'|trans }}
                </h3>
                {% if agents is empty %}
                    {# État vide au langage commun (liste dossiers, visites
                       agent) : zone pointillée, pastille, titre + sous-texte. #}
                    <div class="rounded-xl border border-dashed border-gray-950/10 bg-white/60" data-testid="agency-agents-empty">
                        <div class="flex flex-col items-center justify-center gap-2.5 px-4 py-10 text-center">
                            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-400">
                                {{ ux_icon('lucide:briefcase', {class: 'size-5', 'aria-hidden': 'true'}) }}
                            </div>
                            <div class="space-y-0.5">
                                <p class="text-sm font-medium text-gray-700">{{ 'admin.agencies.show.empty.title'|trans }}</p>
                                <p class="max-w-[38ch] text-xs text-pretty text-gray-400">{{ 'admin.agencies.show.empty.text'|trans }}</p>
                            </div>
                        </div>
                    </div>
                {% else %}
                    {# Ligne fiche condensée : identité à gauche, paires
                       label/valeur (poste, téléphone, email) au langage des
                       cards de fiche. #}
                    <ul class="flex flex-col gap-1" role="list">
                        {% for agent in agents %}
                            <li class="rounded-xl bg-white {{ agent.active ? '' : 'opacity-60' }}" data-testid="agency-agent-row">
                                <a
                                    href="{{ path('admin_agent_show', {adminPrefix: adminPrefix, reference: agent.reference}) }}"
                                    class="flex flex-col gap-4 rounded-xl p-5 transition-colors duration-100 ease-out hover:bg-gray-50 sm:flex-row sm:items-center"
                                >
                                    <span class="flex min-w-0 items-center gap-3 sm:w-56 sm:shrink-0">
                                        <twig:Avatar filename="{{ agent.avatarFilename }}" name="{{ agent.fullName }}" size="8" />
                                        <span class="min-w-0">
                                            <span class="block truncate text-sm font-medium text-gray-900">{{ agent.fullName|title }}</span>
                                            {% if not agent.active %}
                                                <span class="text-xs text-gray-400" data-testid="agency-agent-inactive">{{ 'admin.agents.status.inactive'|trans }}</span>
                                            {% endif %}
                                        </span>
                                    </span>
                                    <span class="grid min-w-0 flex-1 gap-3 text-sm sm:grid-cols-3">
                                        <span class="min-w-0">
                                            <span class="block text-xs text-gray-600">{{ 'admin.agents.create.position.label'|trans }}</span>
                                            <span class="block truncate font-medium {{ agent.position ? 'text-gray-900' : 'text-gray-400' }}">{{ agent.position ? agent.position.labelKey|trans : '-' }}</span>
                                        </span>
                                        <span class="min-w-0">
                                            <span class="block text-xs text-gray-600">{{ 'admin.agents.create.phone.label'|trans }}</span>
                                            {% if agent.phone %}
                                                {% set phoneCountry = agent.phone|phone_country %}
                                                <span class="flex items-center gap-1.5 font-medium text-gray-900">
                                                    {% if phoneCountry %}{{ ux_icon('circle-flags:' ~ phoneCountry, {class: 'size-3.5 shrink-0 rounded-full', 'aria-hidden': 'true'}) }}{% endif %}
                                                    <span class="truncate">{{ agent.phone|phone_format }}</span>
                                                </span>
                                            {% else %}
                                                <span class="block font-medium text-gray-400">-</span>
                                            {% endif %}
                                        </span>
                                        <span class="min-w-0">
                                            <span class="block text-xs text-gray-600">{{ 'admin.agents.create.email.label'|trans }}</span>
                                            <span class="block truncate font-medium {{ agent.email ? 'text-gray-900' : 'text-gray-400' }}">{{ agent.email ?? '-' }}</span>
                                        </span>
                                    </span>
                                    {{ ux_icon('lucide:chevron-right', {class: 'hidden size-4 shrink-0 text-gray-300 sm:block', 'aria-hidden': 'true'}) }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}
