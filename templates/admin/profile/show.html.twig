{% extends 'admin/base.html.twig' %}

{% set displayName = profile.fullName ? profile.fullName|title : profile.email %}
{% set isAdmin = profile.primaryRole == 'admin' %}
{% set authMethodKey = profile.hasGoogleAuth ? 'google' : 'password' %}
{% set lastLoginValue = profile.lastLoginAt
    ? profile.lastLoginAt|format_datetime('medium', 'short', locale=app.request.locale)
    : 'admin.users.lastLoginNever'|trans %}
{% set createdAtValue = profile.createdAt|format_date('long', locale=app.request.locale) %}
{% set authMethodValue = ('admin.users.profile.authMethod.' ~ authMethodKey)|trans %}

{% block title %}{{ 'admin.profile.title'|trans }}{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader title="{{ 'admin.profile.title'|trans }}" />
{% endblock %}

{% block body %}
    {# Même gabarit que la fiche utilisateur admin : fiche sticky à droite,
       le reste défile à gauche. Tout est en lecture seule sauf le mot de
       passe : la gestion des droits reste réservée aux admins. #}
    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[3fr_2fr]" data-testid="profile-page">
        <section class="rounded-2xl border border-neutral-200 bg-white p-2 lg:sticky lg:top-6 lg:order-2">
            <div class="rounded-xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                <div class="p-6">
                    <div class="flex flex-wrap items-center gap-4">
                        <twig:Avatar filename="{{ profile.avatarFilename }}" name="{{ displayName }}" email="{{ profile.email }}" size="12" />
                        <div class="min-w-0 flex-1">
                            <h2 class="text-base font-semibold tracking-tight text-gray-900">{{ displayName }}</h2>
                            <p class="truncate text-sm text-gray-500">{{ profile.email }}</p>
                        </div>
                    </div>
                </div>
                <dl class="divide-y divide-gray-950/5 border-t border-gray-950/5">
                    <div class="grid grid-cols-3 gap-4 px-6 py-3.5">
                        <dt class="text-sm font-medium text-gray-900">{{ 'admin.users.profile.field.role'|trans }}</dt>
                        <dd class="col-span-2 text-sm text-gray-600">{{ ('admin.users.role.' ~ profile.primaryRole)|trans }}</dd>
                    </div>
                    <div class="grid grid-cols-3 gap-4 px-6 py-3.5">
                        <dt class="text-sm font-medium text-gray-900">{{ 'admin.users.profile.field.createdAt'|trans }}</dt>
                        <dd class="col-span-2 text-sm text-gray-600">{{ createdAtValue }}</dd>
                    </div>
                    <div class="grid grid-cols-3 gap-4 px-6 py-3.5">
                        <dt class="text-sm font-medium text-gray-900">{{ 'admin.users.profile.field.lastLogin'|trans }}</dt>
                        <dd class="col-span-2 text-sm text-gray-600">{{ lastLoginValue }}</dd>
                    </div>
                    <div class="grid grid-cols-3 gap-4 px-6 py-3.5">
                        <dt class="text-sm font-medium text-gray-900">{{ 'admin.users.profile.field.authMethod'|trans }}</dt>
                        <dd class="col-span-2 flex items-center gap-1.5 text-sm text-gray-600">
                            {% if profile.hasGoogleAuth %}
                                {{ ux_icon('material-icon-theme:google', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                            {% endif %}
                            {{ authMethodValue }}
                        </dd>
                    </div>
                    {# Seul champ modifiable de la fiche : la langue pilote le
                       back-office et les emails. Même tuile que la fiche
                       utilisateur (crayon puis chips), sans son libellé
                       puisque le <dt> le porte déjà. #}
                    <div class="grid grid-cols-3 items-center gap-4 px-6 py-3.5">
                        <dt class="text-sm font-medium text-gray-900">{{ 'admin.users.profile.field.language'|trans }}</dt>
                        <dd class="col-span-2">
                            <twig:Admin:UserLanguage :userId="profile.id" :showLabel="false" class="relative pr-8" />
                        </dd>
                    </div>
                </dl>
            </div>
        </section>

        <div class="space-y-6 lg:order-1">
            {# Droits : lecture seule (même vocabulaire que la card d'accès
               de la fiche utilisateur, sans les interrupteurs). #}
            <section class="rounded-2xl border border-neutral-200 bg-white p-2" data-testid="profile-access">
                <div class="rounded-xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 class="font-medium text-gray-900">{{ 'admin.profile.access.title'|trans }}</h2>
                        <p class="mt-0.5 text-xs text-gray-500">{{ 'admin.profile.access.subtitle'|trans }}</p>
                    </div>
                    <div class="flex flex-col overflow-hidden rounded-xl bg-white">
                        {% for key, role in constant('App\\Admin\\Twig\\Components\\UserAccess::SECTIONS') %}
                            {% set granted = isAdmin or role in profile.roles %}
                            <div class="flex items-center justify-between gap-3 border-b border-gray-950/5 px-4 py-3 text-sm last:border-b-0" data-testid="profile-access-{{ key }}">
                                <span class="font-medium text-gray-900">{{ ('admin.users.access.' ~ key)|trans }}</span>
                                {% if granted %}
                                    <span class="flex items-center gap-1.5 text-xs font-medium text-emerald-600">
                                        {{ ux_icon('lucide:check', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.profile.access.granted'|trans }}
                                    </span>
                                {% else %}
                                    <span class="flex items-center gap-1.5 text-xs font-medium text-gray-400">
                                        {{ ux_icon('lucide:x', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.profile.access.denied'|trans }}
                                    </span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                    {% if isAdmin %}
                        <p class="flex items-center gap-1.5 px-3 pt-2 pb-1 text-xs text-gray-500">
                            {{ ux_icon('lucide:shield-check', {class: 'size-3.5 shrink-0 text-primary', 'aria-hidden': 'true'}) }}
                            {{ 'admin.profile.access.adminHint'|trans }}
                        </p>
                    {% endif %}
                </div>
            </section>

            {# Fonctions métier attribuées (lecture seule). #}
            {% if staffFunctions is not empty %}
                <section class="rounded-2xl border border-neutral-200 bg-white p-2" data-testid="profile-functions">
                    <div class="rounded-xl bg-neutral-50 p-2">
                        <div class="p-3">
                            <h2 class="font-medium text-gray-900">{{ 'admin.profile.functions.title'|trans }}</h2>
                            <p class="mt-0.5 text-xs text-gray-500">{{ 'admin.profile.functions.subtitle'|trans }}</p>
                        </div>
                        <div class="flex flex-wrap gap-2 rounded-xl bg-white px-4 py-3">
                            {% for function in staffFunctions %}
                                <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/40 bg-primary/5 px-3 py-1.5 text-sm font-medium text-primary">
                                    {{ function.labelKey|trans }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                </section>
            {% endif %}

            {# Activité : leads assignés et dossiers gérés, comme sur la
               fiche utilisateur. Chaque bloc suit l'accès à SA section : un
               agent de visite ne voit pas le nom des prospects qu'on lui a
               assignés s'il n'a plus la section Leads. #}
            {% set canSeeLeads = is_granted('ROLE_SECTION_CONTACTS') %}
            {% set canSeeDossiers = is_granted('ROLE_SECTION_DOSSIERS') %}
            {% if canSeeLeads or canSeeDossiers %}
            <div class="space-y-6" data-testid="profile-activity">
                {% if canSeeLeads %}
                <section class="rounded-2xl border border-neutral-200 bg-white p-2">
                    <div class="rounded-xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                        <p class="px-6 pt-5 pb-3 text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.users.activity.leads.title'|trans }}</p>
                        {% if assignedLeads is empty %}
                            <p class="px-6 pb-5 text-sm text-gray-500">{{ 'admin.users.activity.leads.empty'|trans }}</p>
                        {% else %}
                            <ul class="divide-y divide-gray-950/5 border-t border-gray-950/5" role="list">
                                {% for lead in assignedLeads %}
                                    <li>
                                        <a
                                            href="{{ path('admin_contact_show', {adminPrefix: adminPrefix, reference: lead.reference}) }}"
                                            class="group/row flex items-center gap-3 px-6 py-3 transition-colors duration-100 ease-out hover:bg-gray-50"
                                            data-testid="profile-activity-lead"
                                        >
                                            <span class="shrink-0 font-mono text-xs text-gray-500">{{ lead.reference }}</span>
                                            <span class="min-w-0 flex-1 truncate text-sm font-medium text-gray-900">{{ lead.label|title }}</span>
                                            <span class="shrink-0 text-xs text-gray-500">{{ lead.createdAt|format_date('medium', locale=app.request.locale) }}</span>
                                            {{ ux_icon('lucide:chevron-right', {class: 'size-4 shrink-0 text-gray-300 transition-colors duration-100 ease-out group-hover/row:text-gray-500', 'aria-hidden': 'true'}) }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </section>
                {% endif %}
                {% if canSeeDossiers %}
                <section class="rounded-2xl border border-neutral-200 bg-white p-2">
                    <div class="rounded-xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0">
                        <p class="px-6 pt-5 pb-3 text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.users.activity.dossiers.title'|trans }}</p>
                        {% if managedDossiers is empty %}
                            <p class="px-6 pb-5 text-sm text-gray-500">{{ 'admin.users.activity.dossiers.empty'|trans }}</p>
                        {% else %}
                            <ul class="divide-y divide-gray-950/5 border-t border-gray-950/5" role="list">
                                {% for dossier in managedDossiers %}
                                    <li>
                                        <a
                                            href="{{ path('admin_dossier_show', {adminPrefix: adminPrefix, reference: dossier.reference}) }}"
                                            class="group/row flex items-center gap-3 px-6 py-3 transition-colors duration-100 ease-out hover:bg-gray-50"
                                            data-testid="profile-activity-dossier"
                                        >
                                            <span class="shrink-0 font-mono text-xs text-gray-500">{{ dossier.reference }}</span>
                                            <span class="min-w-0 flex-1 truncate text-sm font-medium text-gray-900">{{ dossier.label }}</span>
                                            <span class="shrink-0 text-xs text-gray-500">{{ dossier.createdAt|format_date('medium', locale=app.request.locale) }}</span>
                                            {{ ux_icon('lucide:chevron-right', {class: 'size-4 shrink-0 text-gray-300 transition-colors duration-100 ease-out group-hover/row:text-gray-500', 'aria-hidden': 'true'}) }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </section>
                {% endif %}
            </div>
            {% endif %}

            {# Double authentification : activation par QR + code, codes de
               récupération, désactivation protégée. #}
            {# Ancre de l'incitation posée dans la sidebar. #}
            <div id="two-factor" class="scroll-mt-6">
                <twig:Admin:TwoFactorSettings :adminPrefix="adminPrefix" />
            </div>

            {# Changement de mot de passe, avec jauge de solidité en direct
               (même composant que l'inscription publique). #}
            <section class="rounded-2xl border border-neutral-200 bg-white p-2" data-testid="profile-password">
                <div class="rounded-xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 class="font-medium text-gray-900">{{ 'admin.profile.password.title'|trans }}</h2>
                        <p class="mt-0.5 text-xs text-gray-500">{{ 'admin.profile.password.subtitle'|trans }}</p>
                    </div>

                    {% if profile.hasPasswordAuth %}
                        {% for message in app.flashes('profile_password_success') %}
                            <p class="mx-3 mb-2 flex items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700" role="status" data-testid="profile-password-success">
                                {{ ux_icon('lucide:check', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ message|trans }}
                            </p>
                        {% endfor %}

                        {% set inputClass = 'w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none' %}
                        {{ form_start(passwordForm, {action: path('admin_profile_password', {adminPrefix: adminPrefix}), attr: {class: 'flex flex-col gap-4 rounded-xl bg-white px-4 py-4', novalidate: 'novalidate', 'data-testid': 'profile-password-form'}}) }}
                            <div class="min-w-0">
                                <twig:Label for="{{ passwordForm.currentPassword.vars.id }}" class="text-gray-600">
                                    {{ 'admin.profile.password.current.label'|trans }}
                                    <span class="text-red-600" aria-hidden="true">*</span>
                                </twig:Label>
                                <div class="mt-1.5">
                                    {{ form_widget(passwordForm.currentPassword, {attr: {class: inputClass, 'data-testid': 'profile-password-current'}}) }}
                                    {% for error in passwordForm.currentPassword.vars.errors %}
                                        <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                <div class="min-w-0">
                                    <twig:Label for="{{ passwordForm.plainPassword.first.vars.id }}" class="text-gray-600">
                                        {{ 'admin.profile.password.new.label'|trans }}
                                        <span class="text-red-600" aria-hidden="true">*</span>
                                    </twig:Label>
                                    <div class="mt-1.5">
                                        {{ form_widget(passwordForm.plainPassword.first, {attr: {class: inputClass, 'data-testid': 'profile-password-new'}}) }}
                                        {# Jauge de solidité en direct sous le champ. #}
                                        <twig:PasswordStrength inputId="{{ passwordForm.plainPassword.first.vars.id }}" />
                                        {% for error in passwordForm.plainPassword.first.vars.errors %}
                                            <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="min-w-0">
                                    <twig:Label for="{{ passwordForm.plainPassword.second.vars.id }}" class="text-gray-600">
                                        {{ 'admin.profile.password.repeat.label'|trans }}
                                        <span class="text-red-600" aria-hidden="true">*</span>
                                    </twig:Label>
                                    <div class="mt-1.5">
                                        {{ form_widget(passwordForm.plainPassword.second, {attr: {class: inputClass, 'data-testid': 'profile-password-repeat'}}) }}
                                        {% for error in passwordForm.plainPassword.second.vars.errors %}
                                            <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center justify-end">
                                <twig:Button size="sm" type="submit" data-testid="profile-password-submit">
                                    {{ 'admin.profile.password.submit'|trans }}
                                </twig:Button>
                            </div>
                        {{ form_end(passwordForm) }}
                    {% else %}
                        <p class="flex items-center gap-2 rounded-xl bg-white px-4 py-4 text-sm text-gray-500" data-testid="profile-password-google">
                            {{ ux_icon('material-icon-theme:google', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                            {{ 'admin.profile.password.googleOnly'|trans }}
                        </p>
                    {% endif %}
                </div>
            </section>
        </div>
    </div>
{% endblock %}
