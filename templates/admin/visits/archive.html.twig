{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.visits.archive.title'|trans }}{% endblock %}

{% block head %}
    {# La pagination vit dans un LiveComponent : un snapshot Turbo restauré
       montrerait un état périmé au retour. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ 'admin.visits.archive.title'|trans }}"
        :crumbs="[{label: 'admin.visits.title'|trans, url: path('admin_visits', {adminPrefix: adminPrefix})}]"
    />
{% endblock %}

{% block body %}
    <div data-testid="visits-archive-page">
        <twig:Visit:Tabs :adminPrefix="adminPrefix" active="archive" :upcomingCount="upcomingCount" :archivedCount="archivedCount" />
        <twig:Visit:VisitArchive :adminPrefix="adminPrefix" />
    </div>
{% endblock %}
