{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.visits.show.title'|trans({'%date%': visit.scheduledAt|format_datetime(pattern='d MMMM'), '%time%': visit.scheduledAt|format_datetime(pattern="HH'h'mm")}) }}{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ 'admin.visits.show.title'|trans({'%date%': visit.scheduledAt|format_datetime(pattern='d MMMM'), '%time%': visit.scheduledAt|format_datetime(pattern="HH'h'mm")}) }}"
        :crumbs="[{label: 'admin.visits.title'|trans, url: path('admin_visits', {adminPrefix: adminPrefix})}]"
    />
{% endblock %}

{% block body %}
    <div class="space-y-6" data-controller="confirm-dialog" data-testid="visit-show-page">
        {# ── Visite planifiée dont le créneau est passé : bandeau ambre
              pleine largeur, l'utilisateur clôt d'un clic (Effectuée mène
              droit au compte-rendu via l'ancre de la redirection). ── #}
        {% if overdue %}
            {# Même langage que les bandeaux d'état lead/dossier (pastille
               blanche ronde, dégradé horizontal, titre semibold). #}
            <section
                class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-amber-200 bg-linear-to-r from-amber-100/80 to-amber-50/40 px-5 py-4 shadow-sm"
                role="status"
                data-testid="visit-overdue-banner"
            >
                <div class="flex min-w-0 items-center gap-4">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-white text-amber-600 shadow-sm">
                        {{ ux_icon('lucide:clipboard-pen', {class: 'size-5', 'aria-hidden': 'true'}) }}
                    </span>
                    <p class="min-w-0 font-semibold text-gray-900">{{ 'admin.visits.show.overdue.title'|trans }}</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <form method="post" action="{{ path('admin_visit_status', {adminPrefix: adminPrefix, reference: visit.reference}) }}" class="contents">
                        <input type="hidden" name="_token" value="{{ csrf_token('visit_status') }}">
                        <input type="hidden" name="status" value="done">
                        <twig:Button size="sm" type="submit" data-testid="visit-overdue-done">
                            {{ ux_icon('lucide:check', {'aria-hidden': 'true'}) }}
                            {{ 'admin.visits.status.done'|trans }}
                        </twig:Button>
                    </form>
                    <form method="post" action="{{ path('admin_visit_status', {adminPrefix: adminPrefix, reference: visit.reference}) }}" class="contents">
                        <input type="hidden" name="_token" value="{{ csrf_token('visit_status') }}">
                        <input type="hidden" name="status" value="cancelled">
                        <button
                            type="submit"
                            class="flex cursor-pointer items-center gap-1.5 rounded-full border border-amber-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-gray-900"
                            data-testid="visit-overdue-cancelled"
                        >
                            {{ 'admin.visits.status.cancelled'|trans }}
                        </button>
                    </form>
                </div>
            </section>
        {% endif %}

        {# ── Suivi du retour client : bandeaux d'état, même famille visuelle
              que le bandeau ci-dessus (pastille blanche ronde, dégradé
              horizontal). Empilés sous overdue s'il est là, mais en pratique
              exclusifs (overdue ne concerne que les visites planifiées). ── #}
        {% if visit.clientDecision and visit.clientDecision.value == 'thinking' %}
            <section
                class="flex flex-wrap items-center gap-4 rounded-2xl border border-sky-200 bg-linear-to-r from-sky-100/80 to-sky-50/40 px-5 py-4 shadow-sm"
                role="status"
                data-testid="visit-thinking-banner"
            >
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-white text-sky-600 shadow-sm">
                    {{ ux_icon('lucide:hourglass', {class: 'size-5', 'aria-hidden': 'true'}) }}
                </span>
                <div class="min-w-0">
                    <p class="font-semibold text-gray-900">{{ 'admin.visits.banner.thinking.title'|trans }}</p>
                    {% if visit.decisionDeadline %}
                        <p class="mt-0.5 text-sm text-gray-600" data-testid="visit-thinking-banner-deadline">{{ 'admin.visits.banner.thinking.deadline'|trans({'%date%': visit.decisionDeadline|format_datetime(pattern='d MMMM yyyy')}) }}</p>
                    {% endif %}
                </div>
            </section>
        {% elseif visit.clientDecision and visit.clientDecision.value == 'positioning' and visit.applicationOutcome is null %}
            <section
                class="flex flex-wrap items-center gap-4 rounded-2xl border border-primary/20 bg-linear-to-r from-primary/10 to-primary/5 px-5 py-4 shadow-sm"
                role="status"
                data-testid="visit-positioning-banner"
            >
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-white text-primary shadow-sm">
                    {{ ux_icon('lucide:send', {class: 'size-5', 'aria-hidden': 'true'}) }}
                </span>
                <p class="min-w-0 font-semibold text-gray-900">{{ 'admin.visits.banner.positioning.title'|trans }}</p>
            </section>
        {% endif %}

        {# ── Bandeau héro pleine largeur : badges type + statut (+ compte à
              rebours), la ligne clé date + heure + durée en grand, puis
              adresse, dossier et référence sur une rangée de méta. ── #}
        {% set heroBadges %}
            <span class="flex items-center gap-1.5 rounded-full bg-neutral-200/60 px-2.5 py-1 text-xs font-medium text-gray-600" data-testid="visit-type-badge">
                {{ ux_icon(visit.type.icon, {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                {{ visit.type.labelKey|trans }}
            </span>
            <span class="flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium {{ visit.status.badgeClasses }}" data-testid="visit-status-badge">
                {{ ux_icon(visit.status.icon, {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                {{ visit.status.labelKey|trans }}
            </span>
            {% if minutesUntil and visit.status.value == 'planned' %}
                <span class="rounded-full bg-primary/5 px-2.5 py-1 text-xs font-semibold text-primary tabular-nums" data-testid="visit-countdown">
                    {% if minutesUntil >= 60 %}
                        {{ 'admin.visits.row.startsInHours'|trans({'%count%': (minutesUntil / 60)|round(0, 'floor')}) }}
                    {% else %}
                        {{ 'admin.visits.row.startsInMinutes'|trans({'%count%': minutesUntil}) }}
                    {% endif %}
                </span>
            {% endif %}
        {% endset %}
        {% set heroHeadingText %}{{ visit.scheduledAt|format_datetime(pattern='EEEE d MMMM yyyy')|capitalize }}, {{ visit.scheduledAt|format_datetime(pattern="HH'h'mm") }} <span class="font-normal text-gray-400">· {{ 'admin.visits.show.durationMinutes'|trans({'%count%': visit.durationMinutes}) }}</span>{% endset %}
        {% set heroMeta %}
            <a
                href="https://www.google.com/maps/search/?api=1&query={{ visit.address|url_encode }}"
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-w-0 items-center gap-1.5 text-sm text-gray-600 transition-colors duration-100 ease-out hover:text-primary"
                title="{{ 'admin.visits.row.openInMaps'|trans }}"
                data-testid="visit-hero-address"
            >
                {{ ux_icon('lucide:map-pin', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                <span class="truncate">{{ visit.address }}</span>
            </a>
            {% set canOpenDossier = is_granted('ROLE_SECTION_DOSSIERS') %}
            <{{ canOpenDossier ? 'a' : 'span' }}
                {% if canOpenDossier %}href="{{ path('admin_dossier_show', {adminPrefix: adminPrefix, reference: visit.dossierReference}) }}"{% endif %}
                class="flex min-w-0 items-center gap-1.5 text-sm font-medium text-gray-900 {{ canOpenDossier ? 'transition-colors duration-100 ease-out hover:text-primary' }}"
                data-testid="visit-hero-dossier"
            >
                {{ ux_icon('lucide:folder-open', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                <span class="truncate">{{ visit.dossierName }} <span class="font-normal text-gray-400">({{ visit.dossierReference }})</span></span>
            </{{ canOpenDossier ? 'a' : 'span' }}>
            <span class="flex items-center gap-1.5 text-sm text-gray-500 tabular-nums" data-testid="visit-hero-reference">
                {{ ux_icon('lucide:hash', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                {{ visit.reference }}
            </span>
        {% endset %}
        <section class="rounded-3xl border border-neutral-200 bg-white p-2">
            <div class="rounded-2xl bg-neutral-50 p-2">
                <div class="flex items-center gap-5 rounded-xl bg-white px-6 py-5">
                    {# Photo principale du bien (la première), quand il y en a une. #}
                    {% set heroPhoto = photosBefore is not empty ? photosBefore|first : (photosAfter is not empty ? photosAfter|first : null) %}
                    {% if heroPhoto %}
                        <div class="relative hidden shrink-0 sm:block">
                            <img
                                src="{{ path('admin_visit_photo_file', {adminPrefix: adminPrefix, reference: visit.reference, photoId: heroPhoto.id}) }}"
                                alt=""
                                width="112"
                                height="112"
                                loading="eager"
                                class="size-28 rounded-xl object-cover ring-1 ring-gray-950/10"
                                data-testid="visit-hero-photo"
                            >
                            {# Nombre de photos de l'annonce, comme le badge
                               du récap de création. #}
                            {% if photosBefore|length > 0 %}
                                <span class="absolute right-1.5 bottom-1.5 flex items-center gap-1 rounded-full bg-gray-950/70 px-1.5 py-0.5 text-[10px] font-semibold text-white tabular-nums" data-testid="visit-hero-photo-count">
                                    {{ ux_icon('lucide:image', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ photosBefore|length }}
                                </span>
                            {% endif %}
                        </div>
                    {% endif %}
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-1.5">{{ heroBadges }}</div>
                        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-pretty text-gray-900" data-testid="visit-heading">{{ heroHeadingText }}</h2>
                        <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-gray-950/5 pt-3">{{ heroMeta }}</div>
                    </div>
                </div>
            </div>
        </section>

        {# ── Deux colonnes : compte-rendu (si effectuée) en tête de colonne
              principale, puis le composant "Le bien" + latérale sticky
              (root en display:contents), et la bibliothèque de photos de
              l'annonce. En mobile tout s'empile, la latérale en dernier. ── #}
        {% set reportShown = visit.status.value == 'done' %}
        <div class="flex flex-col gap-6 lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
            {# ── Compte-rendu : au-dessus de la card "Le bien", affiché
                  seulement une fois la visite effectuée. Trois blocs :
                  ressenti et retour de l'agent (avec les photos prises
                  pendant ou après la visite), retour client, et l'issue de
                  la candidature quand le client se positionne. Accent ambre
                  tant que le retour de l'agent est vide, badge vert rempli. ── #}
            {% if reportShown %}
            {% set reportFilled = (visit.report ?? '')|trim != '' %}
            {% set reportBadge %}
                        {% if reportFilled %}
                            <span class="flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-[11px] font-medium text-green-700" data-testid="visit-report-done">
                                {{ ux_icon('lucide:check', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.visits.show.reportDone'|trans }}
                            </span>
                        {% else %}
                            <span class="flex items-center gap-1 rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700" data-testid="visit-report-todo">
                                {{ ux_icon('lucide:circle-alert', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.visits.show.reportTodo'|trans }}
                            </span>
                        {% endif %}
            {% endset %}
            {% set agentForm %}
                        {# Autosave : les chips ressenti postent au clic, le
                           texte au change (blur avec valeur modifiée). Champ
                           rempli = lecture verrouillée + stylo (field-lock),
                           le rechargement post-POST reverrouille tout seul. #}
                        <form method="post" action="{{ path('admin_visit_report', {adminPrefix: adminPrefix, reference: visit.reference}) }}" class="mt-3" data-controller="auto-submit" data-testid="visit-report-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('visit_report') }}">
                            <p class="text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.visits.show.feelingLabel'|trans }}</p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for feeling in enum('App\\Visit\\Domain\\ClientFeeling').cases() %}
                                    <label class="cursor-pointer">
                                        <input
                                            type="radio"
                                            name="feeling"
                                            value="{{ feeling.value }}"
                                            {{ visit.clientFeeling and visit.clientFeeling.value == feeling.value ? 'checked' }}
                                            data-action="change->auto-submit#submit"
                                            class="peer sr-only"
                                        >
                                        <span class="flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out peer-checked:border-primary/40 peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-gray-50 hover:text-gray-900">
                                            {{ ux_icon(feeling.icon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                            {{ feeling.labelKey|trans }}
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                            {# "Les plus du logement" : chips multi toggle-off
                               (checkboxes), autosave au clic via le même POST
                               que le reste du compte-rendu. #}
                            <p class="mt-4 text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.visits.show.highlightsLabel'|trans }}</p>
                            <div class="mt-2 flex flex-wrap gap-1.5" data-testid="visit-highlights">
                                {% for highlight in enum('App\\Visit\\Domain\\PropertyHighlight').cases() %}
                                    <label class="cursor-pointer">
                                        <input
                                            type="checkbox"
                                            name="highlights[]"
                                            value="{{ highlight.value }}"
                                            {{ highlight.value in visit.reportHighlights|map(h => h.value) ? 'checked' }}
                                            data-action="change->auto-submit#submit"
                                            class="peer sr-only"
                                            data-testid="visit-highlight-{{ highlight.value }}"
                                        >
                                        <span class="flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out peer-checked:border-primary/40 peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-gray-50 hover:text-gray-900">
                                            {{ ux_icon(highlight.icon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                            {{ highlight.labelKey|trans }}
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                            <div class="mt-3" data-controller="field-lock" data-testid="visit-report-field">
                                {% if reportFilled %}
                                    <div class="flex items-start justify-between gap-2" data-field-lock-target="display" data-testid="visit-report-display">
                                        <p class="text-sm whitespace-pre-line text-gray-900">{{ visit.report }}</p>
                                        <button
                                            type="button"
                                            data-action="field-lock#unlock"
                                            class="flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-lg text-gray-400 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900"
                                            aria-label="{{ 'admin.contacts.notes.edit'|trans }}"
                                            title="{{ 'admin.contacts.notes.edit'|trans }}"
                                            data-testid="visit-report-edit"
                                        >
                                            {{ ux_icon('lucide:pencil', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        </button>
                                    </div>
                                {% endif %}
                                <textarea
                                    name="report"
                                    rows="3"
                                    maxlength="5000"
                                    placeholder="{{ 'admin.visits.show.reportPlaceholder'|trans }}"
                                    data-field-lock-target="editor"
                                    data-action="change->auto-submit#submit blur->field-lock#relock"
                                    class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none {{ reportFilled ? 'hidden' }}"
                                    data-testid="visit-report-text"
                                >{{ visit.report }}</textarea>
                            </div>
                        </form>
            {% endset %}
            {% set photosAfterBlock %}
                        {% set afterGalleryPhotos = photosAfter|map(p => {
                            url: path('admin_visit_photo_file', {adminPrefix: adminPrefix, reference: visit.reference, photoId: p.id}),
                            alt: p.originalName,
                        }) %}
                        <div
                            class="mt-4 border-t border-gray-950/5 pt-3"
                            data-controller="gallery photo-upload"
                            data-gallery-photos-value="{{ afterGalleryPhotos|json_encode|e('html_attr') }}"
                            data-action="dragover->photo-upload#over dragleave->photo-upload#leave drop->photo-upload#drop change->photo-upload#changed photo-delete:removed->gallery#removePhoto"
                            data-testid="visit-report-photos"
                        >
                            <div class="flex flex-wrap items-center justify-between gap-3">
                                <p class="flex items-baseline gap-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                                    {{ 'admin.visits.photos.after'|trans }}
                                    {% if photosAfter is not empty %}
                                        <span class="text-xs font-medium text-gray-400 normal-case tabular-nums" data-gallery-target="photoCount" data-testid="visit-report-photos-count">{{ photosAfter|length }}</span>
                                    {% endif %}
                                </p>
                                <form
                                    action="{{ path('admin_visit_photos_upload', {adminPrefix: adminPrefix, reference: visit.reference}) }}"
                                    method="post"
                                    enctype="multipart/form-data"
                                    class="contents"
                                >
                                    <input type="hidden" name="_token" value="{{ csrf_token('visit_photos') }}">
                                    <input type="hidden" name="phase" value="after">
                                    {# Vrai bouton d'ajout (pattern « Choisir une
                                       photo » du formulaire agent) : label stylé,
                                       input file en sr-only à l'intérieur. #}
                                    <label class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary">
                                        {{ ux_icon('lucide:image-plus', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.visits.photos.add'|trans }}
                                        <input
                                            type="file"
                                            name="photos[]"
                                            multiple
                                            accept="image/jpeg,image/png,image/webp"
                                            class="sr-only"
                                            data-photo-upload-target="input"
                                            data-testid="visit-report-photos-input"
                                        >
                                    </label>
                                </form>
                            </div>
                            <p class="mt-1.5 flex items-center gap-1.5 text-[11px] text-gray-400" data-testid="visit-report-photos-hint">
                                {{ ux_icon('lucide:info', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }} {{ 'admin.visits.create.photos.hint'|trans }}
                            </p>
                            {% if photosAfter is not empty %}
                                <ul class="mt-2 grid grid-cols-3 gap-2 sm:grid-cols-4" role="list" data-photo-upload-target="grid" data-testid="visit-report-photos-grid">
                                    {% for photo in photosAfter %}
                                        <li class="group/photo relative overflow-hidden rounded-xl border border-gray-950/5">
                                            <button
                                                type="button"
                                                data-action="gallery#open"
                                                data-gallery-index-param="{{ loop.index0 }}"
                                                aria-label="{{ 'gallery.open'|trans }}"
                                                class="block h-full w-full cursor-zoom-in focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
                                            >
                                                <img
                                                    src="{{ path('admin_visit_photo_file', {adminPrefix: adminPrefix, reference: visit.reference, photoId: photo.id}) }}"
                                                    alt="{{ photo.originalName }}"
                                                    loading="lazy"
                                                    width="400"
                                                    height="300"
                                                    class="aspect-[4/3] w-full object-cover transition-transform duration-100 ease-out group-hover/photo:scale-[1.02]"
                                                    data-testid="visit-report-photo"
                                                >
                                            </button>
                                            {# Téléchargement : navigation native, attachement. #}
                                            <a
                                                href="{{ path('admin_visit_photo_file', {adminPrefix: adminPrefix, reference: visit.reference, photoId: photo.id, download: 1}) }}"
                                                class="absolute top-1.5 right-1.5 hidden items-center justify-center rounded-lg bg-white/90 p-1.5 text-gray-600 opacity-0 transition-opacity duration-100 ease-out group-hover/photo:flex group-hover/photo:opacity-100 hover:bg-white hover:text-gray-900 focus-visible:flex focus-visible:opacity-100"
                                                title="{{ 'admin.visits.photos.download'|trans }}"
                                                aria-label="{{ 'admin.visits.photos.download'|trans }}"
                                                data-testid="visit-report-photo-download"
                                            >
                                                {{ ux_icon('lucide:download', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                            </a>
                                            <form
                                                action="{{ path('admin_visit_photo_delete', {adminPrefix: adminPrefix, reference: visit.reference, photoId: photo.id}) }}"
                                                method="post"
                                                data-controller="photo-delete"
                                                data-action="submit->confirm-dialog#intercept submit->photo-delete#submit"
                                                data-confirm-message="{{ 'admin.visits.photos.deleteConfirm'|trans({'%name%': photo.originalName}) }}"
                                                class="absolute inset-x-0 bottom-0 flex justify-end bg-gradient-to-t from-gray-950/60 to-transparent p-1.5 opacity-0 transition-opacity duration-100 ease-out group-hover/photo:opacity-100 focus-within:opacity-100"
                                            >
                                                <input type="hidden" name="_token" value="{{ csrf_token('visit_photo_delete') }}">
                                                <button
                                                    type="submit"
                                                    class="flex cursor-pointer items-center gap-1.5 rounded-lg bg-white/90 px-2 py-1 text-xs font-medium text-red-600 transition-colors duration-100 ease-out hover:bg-white"
                                                    title="{{ 'admin.visits.photos.delete'|trans }}"
                                                    aria-label="{{ 'admin.visits.photos.delete'|trans }}"
                                                    data-testid="visit-report-photo-delete"
                                                >
                                                    {{ ux_icon('lucide:trash-2', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                </button>
                                            </form>
                                        </li>
                                    {% endfor %}
                                </ul>
                                <twig:Gallery:Lightbox :photos="afterGalleryPhotos" />
                            {% else %}
                                {# État vide : bande pointillée discrète, même
                                   langage que les états vides du BO. #}
                                <p class="mt-2 flex items-center justify-center gap-2 rounded-xl border border-dashed border-neutral-200 bg-white/60 px-4 py-6 text-xs text-gray-400" data-testid="visit-report-photos-empty">
                                    {{ ux_icon('lucide:image', {class: 'size-4 shrink-0 text-gray-300', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.visits.photos.afterEmpty'|trans }}
                                </p>
                            {% endif %}
                        </div>
            {% endset %}
            {% set decisionChips %}
                            {% for case in enum('App\\Visit\\Domain\\ClientDecision').cases() %}
                                {% set active = visit.clientDecision and visit.clientDecision.value == case.value %}
                                <form method="post" action="{{ path('admin_visit_client_decision', {adminPrefix: adminPrefix, reference: visit.reference}) }}" class="contents">
                                    <input type="hidden" name="_token" value="{{ csrf_token('visit_client_decision') }}">
                                    <input type="hidden" name="decision" value="{{ active ? '' : case.value }}">
                                    <button
                                        type="submit"
                                        aria-pressed="{{ active ? 'true' : 'false' }}"
                                        class="flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition-colors duration-100 ease-out {{ active ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                                        data-testid="visit-decision-{{ case.value }}"
                                    >
                                        {{ ux_icon(case.icon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ case.labelKey|trans }}
                                    </button>
                                </form>
                            {% endfor %}
            {% endset %}
            {% set outcomeBlock %}
                    {% if visit.clientDecision and visit.clientDecision.value == 'positioning' %}
                        <div class="mt-1 rounded-xl bg-white px-4 py-3 text-sm" data-testid="visit-application-outcome">
                            <p class="flex flex-wrap items-center gap-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                                {{ 'admin.visits.applicationOutcome.title'|trans }}
                                {% if not visit.applicationOutcome %}
                                    {# Toujours sans réponse du bailleur : l'attente s'affiche. #}
                                    {% set waitingDays = (('now'|date('U') - (visit.clientDecisionAt ?? visit.scheduledAt)|date('U')) / 86400)|round(0, 'floor') %}
                                    <span class="flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700 normal-case" data-testid="visit-waiting-chip">
                                        {{ ux_icon('lucide:timer', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.visits.row.waitingSince'|trans({'%count%': waitingDays}) }}
                                    </span>
                                {% endif %}
                            </p>
                            <p class="mt-0.5 text-xs text-gray-500">{{ 'admin.visits.applicationOutcome.help'|trans }}</p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for case in enum('App\\Visit\\Domain\\ApplicationOutcome').cases() %}
                                    {% set active = visit.applicationOutcome and visit.applicationOutcome.value == case.value %}
                                    {% set activeClasses = case.value == 'accepted'
                                        ? 'border-green-200 bg-green-50 text-green-700'
                                        : 'border-amber-300 bg-amber-50 text-amber-700' %}
                                    <form method="post" action="{{ path('admin_visit_application_outcome', {adminPrefix: adminPrefix, reference: visit.reference}) }}" class="contents">
                                        <input type="hidden" name="_token" value="{{ csrf_token('visit_application_outcome') }}">
                                        <input type="hidden" name="outcome" value="{{ active ? '' : case.value }}">
                                        <button
                                            type="submit"
                                            aria-pressed="{{ active ? 'true' : 'false' }}"
                                            class="flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition-colors duration-100 ease-out {{ active ? activeClasses : 'border-neutral-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                                            data-testid="visit-application-{{ case.value }}"
                                        >
                                            {{ ux_icon(case.icon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                            {{ case.labelKey|trans }}
                                        </button>
                                    </form>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
            {% endset %}
            {# Coque ambre en permanence : le compte-rendu est LA zone
               post-visite, distincte des cards d'infos (seul le badge
               bascule Obligatoire / Complété). #}
            <div id="visit-report" class="scroll-mt-6 rounded-3xl border border-amber-200 bg-amber-50/40 p-2 lg:col-start-1 lg:row-start-1" data-testid="visit-report-card">
                <div class="rounded-2xl bg-amber-50/60 p-2">
                    {# En-tête : tuile icône primary + titre, badge d'état à droite. #}
                    <div class="flex flex-wrap items-center gap-2.5 px-4 pt-3 pb-2">
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary/10">
                            {{ ux_icon('lucide:clipboard-pen', {class: 'size-4 shrink-0 text-primary', 'aria-hidden': 'true'}) }}
                        </span>
                        <h2 class="text-sm font-semibold text-gray-900">{{ 'admin.visits.show.modules.report'|trans }}</h2>
                        <span class="ml-auto">{{ reportBadge }}</span>
                    </div>
                    <div class="mt-1 flex flex-col gap-1">
                    <div class="rounded-xl bg-white px-4 py-3 text-sm" data-testid="visit-report-agent-block">
                        <p class="flex items-center gap-1.5 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                            {{ 'admin.visits.show.reportBlocks.agent'|trans }}
                            {# L'info : ce retour interne nourrit la génération IA
                               de la note client et le reporting. #}
                            <span class="normal-case" title="{{ 'admin.visits.show.reportBlocks.agentInfo'|trans }}" data-testid="visit-report-internal-info">
                                {{ ux_icon('lucide:info', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                <span class="sr-only">{{ 'admin.visits.show.reportBlocks.agentInfo'|trans }}</span>
                            </span>
                        </p>
                        {{ agentForm }}
                        {{ photosAfterBlock }}
                    </div>
                    {# ── Note envoyée au client : rédigée à la main ou générée
                          par IA à partir des infos du logement et du retour
                          interne de l'agent. ── #}
                    <div class="rounded-xl bg-white px-4 py-3 text-sm" data-testid="visit-client-note">
                        {% set clientNoteFilled = (visit.clientNote ?? '')|trim != '' %}
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <p class="flex items-center gap-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                                <span class="ai-orb" aria-hidden="true"></span>
                                {{ 'admin.visits.show.clientNote.title'|trans }}
                            </p>
                            <div class="flex flex-wrap items-center gap-1.5">
                                {# Note déjà remplie : la génération écraserait le
                                   texte, la modale de confirmation partagée
                                   s'interpose. Note vide : génération directe. #}
                                <form
                                    method="post"
                                    action="{{ path('admin_visit_client_note_generate', {adminPrefix: adminPrefix, reference: visit.reference}) }}"
                                    class="contents"
                                    {% if clientNoteFilled %}
                                        data-action="submit->confirm-dialog#intercept"
                                        data-confirm-message="{{ 'admin.visits.show.clientNote.generateConfirm'|trans }}"
                                    {% endif %}
                                >
                                    <input type="hidden" name="_token" value="{{ csrf_token('visit_client_note') }}">
                                    <button
                                        type="submit"
                                        class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary disabled:cursor-wait disabled:opacity-60"
                                        title="{{ 'admin.visits.show.clientNote.generateInfo'|trans }}"
                                        data-testid="visit-client-note-generate"
                                    >
                                        {{ ux_icon('lucide:refresh-cw', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.visits.show.clientNote.generate'|trans }}
                                    </button>
                                </form>
                                {% if clientNoteFilled %}
                                    {# Envoi de la note aux contacts du dossier :
                                       toujours confirmé en modale (un seul chemin
                                       de sortie), qui prévient aussi du renvoi. #}
                                    <twig:AlertDialog id="send-client-note-{{ visit.id }}">
                                        <button
                                            type="button"
                                            class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                                            data-action="click->alert-dialog#open"
                                            data-alert-dialog-target="trigger"
                                            aria-haspopup="dialog"
                                            aria-expanded="false"
                                            data-testid="visit-client-note-send"
                                        >
                                            {{ ux_icon('lucide:send', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                            {{ 'admin.visits.show.clientNote.send'|trans }}
                                        </button>
                                        <twig:AlertDialog:Content class="sm:max-w-md">
                                            <twig:AlertDialog:Header>
                                                <twig:AlertDialog:Title>
                                                    {{ 'admin.visits.show.clientNote.sendModal.title'|trans }}
                                                </twig:AlertDialog:Title>
                                                <twig:AlertDialog:Description>
                                                    {{ 'admin.visits.show.clientNote.sendModal.text'|trans }}
                                                    {% if visit.clientNoteSentAt %}
                                                        {{ 'admin.visits.show.clientNote.sendModal.resend'|trans({'%date%': visit.clientNoteSentAt|format_datetime(pattern='d MMMM yyyy')}) }}
                                                    {% endif %}
                                                </twig:AlertDialog:Description>
                                            </twig:AlertDialog:Header>
                                            {# Joindre les photos de l'annonce (phase
                                               before, jamais celles prises en visite) :
                                               proposé seulement quand il y en a, coché
                                               par défaut. Rattachée au formulaire du
                                               footer par l'attribut form. #}
                                            {% set visitPhotoCount = photosBefore|length %}
                                            {% if visitPhotoCount > 0 %}
                                                <label class="mt-3 flex cursor-pointer items-center gap-2 text-sm text-gray-600" data-testid="visit-client-note-attach-photos">
                                                    <input
                                                        type="checkbox"
                                                        name="attachPhotos"
                                                        value="1"
                                                        form="send-client-note-form-{{ visit.id }}"
                                                        checked
                                                        class="size-4 rounded border-neutral-300 text-primary focus:ring-primary"
                                                    >
                                                    {{ 'admin.visits.show.clientNote.sendModal.attachPhotos'|trans({'%count%': visitPhotoCount}) }}
                                                </label>
                                            {% endif %}
                                            <twig:AlertDialog:Footer class="mt-4">
                                                <twig:AlertDialog:Cancel>
                                                    {{ 'admin.visits.show.clientNote.sendModal.cancel'|trans }}
                                                </twig:AlertDialog:Cancel>
                                                <form
                                                    method="post"
                                                    id="send-client-note-form-{{ visit.id }}"
                                                    action="{{ path('admin_visit_client_note_send', {adminPrefix: adminPrefix, reference: visit.reference}) }}"
                                                    class="contents"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('visit_client_note') }}">
                                                    <twig:AlertDialog:Action type="submit" data-testid="visit-client-note-send-submit">
                                                        <span class="flex items-center gap-2">
                                                            {{ ux_icon('lucide:send', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                                            {{ 'admin.visits.show.clientNote.sendModal.confirm'|trans }}
                                                        </span>
                                                    </twig:AlertDialog:Action>
                                                </form>
                                            </twig:AlertDialog:Footer>
                                        </twig:AlertDialog:Content>
                                    </twig:AlertDialog>
                                {% endif %}
                            </div>
                        </div>
                        {% if visit.clientNoteSentAt %}
                            {# État d'envoi discret : survit aux éditions de la
                               note (jamais réinitialisé), le renvoi reste possible. #}
                            <p class="mt-1.5 flex items-center gap-1.5 text-[11px] text-gray-400" data-testid="visit-client-note-sent-at">
                                {{ ux_icon('lucide:check', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.visits.show.clientNote.sentAt'|trans({'%date%': visit.clientNoteSentAt|format_datetime(pattern='d MMMM yyyy, HH:mm')}) }}
                            </p>
                        {% endif %}
                        {% for _ in app.flashes('visit_client_note_error') %}
                            <p class="mt-2 rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2.5 text-xs text-amber-800" role="alert" data-testid="visit-client-note-error">
                                {{ 'admin.visits.show.clientNote.generateFailed'|trans }}
                            </p>
                        {% endfor %}
                        {# Autosave au change (blur avec valeur modifiée) :
                           note remplie = lecture verrouillée + stylo, le
                           rechargement post-POST reverrouille tout seul. #}
                        {% set clientNoteFilled = (visit.clientNote ?? '')|trim != '' %}
                        <form method="post" action="{{ path('admin_visit_client_note', {adminPrefix: adminPrefix, reference: visit.reference}) }}" data-controller="auto-submit" data-testid="visit-client-note-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('visit_client_note') }}">
                            <div class="mt-2" data-controller="field-lock" data-testid="visit-client-note-field">
                                {% if clientNoteFilled %}
                                    <div class="flex items-start justify-between gap-2" data-field-lock-target="display" data-testid="visit-client-note-display">
                                        <p class="text-sm whitespace-pre-line text-gray-900">{{ visit.clientNote }}</p>
                                        <button
                                            type="button"
                                            data-action="field-lock#unlock"
                                            class="flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-lg text-gray-400 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900"
                                            aria-label="{{ 'admin.contacts.notes.edit'|trans }}"
                                            title="{{ 'admin.contacts.notes.edit'|trans }}"
                                            data-testid="visit-client-note-edit"
                                        >
                                            {{ ux_icon('lucide:pencil', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        </button>
                                    </div>
                                {% endif %}
                                <textarea
                                    name="clientNote"
                                    rows="4"
                                    maxlength="5000"
                                    placeholder="{{ 'admin.visits.show.clientNote.placeholder'|trans }}"
                                    data-field-lock-target="editor"
                                    data-action="change->auto-submit#submit blur->field-lock#relock"
                                    class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none {{ clientNoteFilled ? 'hidden' }}"
                                    data-testid="visit-client-note-text"
                                >{{ visit.clientNote }}</textarea>
                            </div>
                        </form>
                    </div>
                    <div class="rounded-xl bg-white px-4 py-3 text-sm" data-testid="visit-client-decision">
                        <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">{{ 'admin.visits.show.reportBlocks.client'|trans }}</p>
                        <div class="mt-2 flex flex-wrap gap-1.5">{{ decisionChips }}</div>
                        {% if visit.clientDecision and visit.clientDecisionAt %}
                            {# Horodatage discret de la décision active. #}
                            <p class="mt-1.5 text-[11px] text-gray-400" data-testid="visit-decision-since">
                                {{ 'admin.visits.decision.since'|trans({'%date%': visit.clientDecisionAt|format_datetime(pattern='d MMMM yyyy')}) }}
                            </p>
                        {% endif %}
                        {# ── Réfléchit : échéance de réflexion, autosave au
                              change (même flux POST que la décision). ── #}
                        {% if visit.clientDecision and visit.clientDecision.value == 'thinking' %}
                            <div class="mt-3 flex flex-wrap items-center gap-3 border-t border-gray-950/5 pt-3" data-testid="visit-decision-deadline">
                                <label for="visit-decision-deadline-input" class="text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.visits.decisionDeadline.label'|trans }}</label>
                                <form
                                    method="post"
                                    action="{{ path('admin_visit_client_decision', {adminPrefix: adminPrefix, reference: visit.reference}) }}"
                                    data-controller="auto-submit"
                                    class="contents"
                                >
                                    <input type="hidden" name="_token" value="{{ csrf_token('visit_client_decision') }}">
                                    <input
                                        type="date"
                                        id="visit-decision-deadline-input"
                                        name="deadline"
                                        value="{{ visit.decisionDeadline ? visit.decisionDeadline|date('Y-m-d') : '' }}"
                                        data-action="change->auto-submit#submit"
                                        class="rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-gray-900 tabular-nums transition-colors duration-100 focus:border-gray-400 focus:outline-none"
                                        data-testid="visit-decision-deadline-input"
                                    >
                                </form>
                                {# Échéance passée (date seule, heure de Paris)
                                   alors que le client réfléchit toujours :
                                   rappel ambre discret. #}
                                {% if visit.decisionDeadline and visit.decisionDeadline|date('Y-m-d', false) < 'now'|date('Y-m-d', 'Europe/Paris') %}
                                    <span class="flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700" data-testid="visit-deadline-overdue">
                                        {{ ux_icon('lucide:clock-alert', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.visits.decisionDeadline.overdue'|trans }}
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}
                        {# ── Refuse : qui a refusé, chips single toggle-off
                              (même flux POST que la décision). ── #}
                        {% if visit.clientDecision and visit.clientDecision.value == 'refused' %}
                            <div class="mt-3 border-t border-gray-950/5 pt-3" data-testid="visit-refusal-origin">
                                <p class="text-xs font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.visits.refusalOrigin.title'|trans }}</p>
                                <div class="mt-2 flex flex-wrap gap-1.5">
                                    {% for case in enum('App\\Visit\\Domain\\RefusalOrigin').cases() %}
                                        {% set active = visit.refusalOrigin and visit.refusalOrigin.value == case.value %}
                                        <form method="post" action="{{ path('admin_visit_client_decision', {adminPrefix: adminPrefix, reference: visit.reference}) }}" class="contents">
                                            <input type="hidden" name="_token" value="{{ csrf_token('visit_client_decision') }}">
                                            <input type="hidden" name="origin" value="{{ active ? '' : case.value }}">
                                            <button
                                                type="submit"
                                                aria-pressed="{{ active ? 'true' : 'false' }}"
                                                class="flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition-colors duration-100 ease-out {{ active ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                                                data-testid="visit-refusal-{{ case.value }}"
                                            >
                                                {{ ux_icon(case.icon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                                {{ case.labelKey|trans }}
                                            </button>
                                        </form>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                    {{ outcomeBlock }}
                    </div>
                </div>
            </div>
            {% endif %}

            <twig:Visit:VisitDetails :visitId="visit.id" :adminPrefix="adminPrefix" />

            {# ── Photos de l'annonce (phase 'before') : stockées dans le
                  bucket, streamées via le controller (jamais d'URL d'objet
                  publique). Les photos prises pendant ou après la visite
                  vivent dans le bloc compte-rendu. ── #}
            {% if photosBefore is empty %}
                {# Zéro photo d'annonce : une simple mention, avec l'ajout
                   discret à droite (la grande card bibliothèque n'apparaît
                   qu'avec des photos). #}
                <div class="rounded-3xl border border-neutral-200 bg-white p-2 lg:col-start-1 {{ reportShown ? 'lg:row-start-3' : 'lg:row-start-2' }}" data-testid="visit-photos-none">
                    <div class="rounded-2xl bg-neutral-50 p-2">
                        <div
                            class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-white px-5 py-3.5 text-sm"
                            data-controller="photo-upload"
                            data-action="dragover->photo-upload#over dragleave->photo-upload#leave drop->photo-upload#drop change->photo-upload#changed"
                        >
                            <p class="flex items-center gap-2 text-gray-400">
                                {{ ux_icon('lucide:image', {class: 'size-4 shrink-0 text-gray-300', 'aria-hidden': 'true'}) }}
                                {{ 'admin.visits.photos.none'|trans }}
                            </p>
                            <p class="flex w-full items-center gap-1.5 text-[11px] text-gray-400 sm:order-last sm:w-auto">
                                {{ ux_icon('lucide:info', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }} {{ 'admin.visits.create.photos.hint'|trans }}
                            </p>
                            <form
                                action="{{ path('admin_visit_photos_upload', {adminPrefix: adminPrefix, reference: visit.reference}) }}"
                                method="post"
                                enctype="multipart/form-data"
                                class="contents"
                            >
                                <input type="hidden" name="_token" value="{{ csrf_token('visit_photos') }}">
                                <input type="hidden" name="phase" value="before">
                                <label class="flex cursor-pointer items-center gap-1.5 text-xs font-medium text-primary transition-colors duration-100 ease-out hover:text-primary/80">
                                    {{ ux_icon('lucide:image-plus', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.visits.photos.add'|trans }}
                                    <input
                                        type="file"
                                        name="photos[]"
                                        multiple
                                        accept="image/jpeg,image/png,image/webp"
                                        class="sr-only"
                                        data-photo-upload-target="input"
                                        data-testid="visit-photos-input"
                                    >
                                </label>
                            </form>
                        </div>
                        {% for count in app.flashes('visit_photos_rejected') %}
                            <p class="mt-1 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800" role="alert" data-testid="visit-photos-rejected">
                                {{ 'admin.visits.photos.rejected'|trans({'%count%': count}) }}
                            </p>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
            {% set galleryPhotos = photosBefore|map(p => {
                url: path('admin_visit_photo_file', {adminPrefix: adminPrefix, reference: visit.reference, photoId: p.id}),
                alt: p.originalName,
            }) %}
            {# Bibliothèque par défaut : galerie pure, le stylo « Gérer »
               bascule en mode gestion (classe posée par le controller) qui
               révèle l'upload et les voiles de suppression, tous deux
               toujours présents dans le DOM. #}
            <div
                class="rounded-3xl border border-neutral-200 bg-white p-2 lg:col-start-1 {{ reportShown ? 'lg:row-start-3' : 'lg:row-start-2' }}"
                data-controller="photo-manage"
                data-photo-manage-managing-class="photo-managing"
                data-testid="visit-photos"
            >
                <div
                    class="rounded-2xl bg-neutral-50 p-2"
                    data-controller="gallery photo-upload"
                    data-gallery-photos-value="{{ galleryPhotos|json_encode|e('html_attr') }}"
                    data-action="dragover->photo-upload#over dragleave->photo-upload#leave drop->photo-upload#drop change->photo-upload#changed photo-delete:removed->gallery#removePhoto"
                >
                    <div class="flex flex-wrap items-center justify-between gap-3 px-4 pt-3 pb-1">
                        <h2 class="flex items-baseline gap-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                            {{ 'admin.visits.photos.title'|trans }}
                            <span class="text-xs font-medium text-gray-400 normal-case tabular-nums" data-gallery-target="photoCount">{{ photosBefore|length }}</span>
                        </h2>
                        <div class="flex items-center gap-2">
                            {# Upload multipart classique, plusieurs fichiers,
                               envoi automatique à la sélection. Masqué hors
                               mode gestion, jamais retiré du DOM. #}
                            <form
                                action="{{ path('admin_visit_photos_upload', {adminPrefix: adminPrefix, reference: visit.reference}) }}"
                                method="post"
                                enctype="multipart/form-data"
                                class="contents"
                            >
                                <input type="hidden" name="_token" value="{{ csrf_token('visit_photos') }}">
                                <input type="hidden" name="phase" value="before">
                                <label class="hidden cursor-pointer items-center gap-2 rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm font-medium text-gray-900 transition-colors duration-100 ease-out hover:bg-gray-50 focus-within:outline-2 focus-within:outline-primary [.photo-managing_&]:flex">
                                    {{ ux_icon('lucide:image-plus', {class: 'size-4 shrink-0 text-gray-500', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.visits.photos.add'|trans }}
                                    <input
                                        type="file"
                                        name="photos[]"
                                        multiple
                                        accept="image/jpeg,image/png,image/webp"
                                        class="sr-only"
                                        data-photo-upload-target="input"
                                        data-testid="visit-photos-input"
                                    >
                                </label>
                            </form>
                            {# Stylo « Gérer » discret, même geste que les
                               stylos d'édition du BO. #}
                            <button
                                type="button"
                                data-action="photo-manage#toggle"
                                data-photo-manage-target="toggle"
                                aria-pressed="false"
                                class="flex size-7 cursor-pointer items-center justify-center rounded-lg text-gray-400 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900 aria-pressed:bg-primary/5 aria-pressed:text-primary"
                                aria-label="{{ 'admin.visits.photos.manage'|trans }}"
                                title="{{ 'admin.visits.photos.manage'|trans }}"
                                data-testid="visit-photos-manage"
                            >
                                {{ ux_icon('lucide:pencil', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                            </button>
                        </div>
                    </div>

                    <p class="hidden items-center gap-1.5 px-4 pb-1 text-[11px] text-gray-400 [.photo-managing_&]:flex" data-testid="visit-photos-hint">
                        {{ ux_icon('lucide:info', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }} {{ 'admin.visits.create.photos.hint'|trans }}
                    </p>
                    {% for count in app.flashes('visit_photos_rejected') %}
                        <p class="mx-2 mb-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800" role="alert" data-testid="visit-photos-rejected">
                            {{ 'admin.visits.photos.rejected'|trans({'%count%': count}) }}
                        </p>
                    {% endfor %}

                    <ul class="mt-1 grid grid-cols-2 gap-2 rounded-xl bg-white p-2 sm:grid-cols-3 lg:grid-cols-4" role="list" data-photo-upload-target="grid" data-testid="visit-photos-grid">
                        {% for photo in photosBefore %}
                            {# La première photo sert de couverture (2x2)
                               sur desktop, les autres de vignettes. #}
                            <li class="group/photo relative overflow-hidden rounded-xl border border-gray-950/5 {{ loop.first ? 'sm:col-span-2 sm:row-span-2' }}">
                                {# Clic : ouvre le lightbox plein écran (même viewer que la marketplace). #}
                                <button
                                    type="button"
                                    data-action="gallery#open"
                                    data-gallery-index-param="{{ loop.index0 }}"
                                    aria-label="{{ 'gallery.open'|trans }}"
                                    class="block h-full w-full cursor-zoom-in focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
                                >
                                    <img
                                        src="{{ path('admin_visit_photo_file', {adminPrefix: adminPrefix, reference: visit.reference, photoId: photo.id}) }}"
                                        alt="{{ photo.originalName }}"
                                        loading="lazy"
                                        width="400"
                                        height="300"
                                        class="aspect-[4/3] w-full object-cover transition-transform duration-100 ease-out group-hover/photo:scale-[1.02] {{ loop.first ? 'sm:aspect-auto sm:h-full' }}"
                                        data-testid="visit-photo"
                                    >
                                </button>
                                {# Téléchargement : navigation native vers le
                                   flux en attachement, visible au survol. #}
                                <a
                                    href="{{ path('admin_visit_photo_file', {adminPrefix: adminPrefix, reference: visit.reference, photoId: photo.id, download: 1}) }}"
                                    class="absolute top-2 right-2 hidden items-center justify-center rounded-lg bg-white/90 p-1.5 text-gray-600 opacity-0 transition-opacity duration-100 ease-out group-hover/photo:flex group-hover/photo:opacity-100 hover:bg-white hover:text-gray-900 focus-visible:flex focus-visible:opacity-100"
                                    title="{{ 'admin.visits.photos.download'|trans }}"
                                    aria-label="{{ 'admin.visits.photos.download'|trans }}"
                                    data-testid="visit-photo-download"
                                >
                                    {{ ux_icon('lucide:download', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                </a>
                                {# Suppression : voile au survol, POST + CSRF,
                                   visible seulement en mode gestion (le
                                   formulaire reste dans le DOM). #}
                                <form
                                    action="{{ path('admin_visit_photo_delete', {adminPrefix: adminPrefix, reference: visit.reference, photoId: photo.id}) }}"
                                    method="post"
                                    data-controller="photo-delete"
                                    data-action="submit->confirm-dialog#intercept submit->photo-delete#submit"
                                    data-confirm-message="{{ 'admin.visits.photos.deleteConfirm'|trans({'%name%': photo.originalName}) }}"
                                    class="absolute inset-x-0 bottom-0 hidden justify-end bg-gradient-to-t from-gray-950/60 to-transparent p-2 opacity-0 transition-opacity duration-100 ease-out group-hover/photo:opacity-100 focus-within:opacity-100 [.photo-managing_&]:flex"
                                >
                                    <input type="hidden" name="_token" value="{{ csrf_token('visit_photo_delete') }}">
                                    <button
                                        type="submit"
                                        class="flex cursor-pointer items-center gap-1.5 rounded-lg bg-white/90 px-2.5 py-1.5 text-xs font-medium text-red-600 transition-colors duration-100 ease-out hover:bg-white"
                                        title="{{ 'admin.visits.photos.delete'|trans }}"
                                        aria-label="{{ 'admin.visits.photos.delete'|trans }}"
                                        data-testid="visit-photo-delete"
                                    >
                                        {{ ux_icon('lucide:trash-2', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.visits.photos.delete'|trans }}
                                    </button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>

                    <twig:Gallery:Lightbox :photos="galleryPhotos" />
                </div>
            </div>
            {% endif %}
        </div>
        <twig:ConfirmDialog />
    </div>
{% endblock %}
