{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.visits.edit.title'|trans }}{% endblock %}

{% block head %}
    {# Le formulaire vit dans un LiveComponent : un snapshot Turbo restauré
       montrerait un état périmé au retour. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ 'admin.visits.edit.title'|trans }}"
        :crumbs="[
            {label: 'admin.visits.title'|trans, url: path('admin_visits', {adminPrefix: adminPrefix})},
            {label: visit.reference, url: path('admin_visit_show', {adminPrefix: adminPrefix, reference: visit.reference})},
        ]"
    />
{% endblock %}

{% block body %}
    <div data-testid="visit-edit-page">
        {# Même composant que la création, monté sur la visite existante. Les
           coordonnées déjà géocodées sont injectées en preview : enregistrer
           sans toucher l'adresse ne regéocode pas. #}
        <twig:Visit:VisitForm
            :adminPrefix="adminPrefix"
            :visit="visit"
            :previewLat="visit.latitude"
            :previewLng="visit.longitude"
            locatedAddress="{{ visit.latitude is not null ? visit.address : '' }}"
        />
    </div>
{% endblock %}
