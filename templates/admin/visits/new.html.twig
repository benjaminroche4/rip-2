{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.visits.new.title'|trans }}{% endblock %}

{% block head %}
    {# Le formulaire vit dans un LiveComponent : un snapshot Turbo restauré
       montrerait un état périmé au retour. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ 'admin.visits.new.title'|trans }}"
        :crumbs="[{label: 'admin.visits.title'|trans, url: path('admin_visits', {adminPrefix: adminPrefix})}]"
    />
{% endblock %}

{% block body %}
    <div data-testid="visit-new-page">
        <twig:Visit:VisitForm :adminPrefix="adminPrefix" :dossierId="preselectedDossierId ?? null" />
    </div>
{% endblock %}
