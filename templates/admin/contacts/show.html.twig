{% extends 'admin/base.html.twig' %}

{% set displayName = contact.fullName ? contact.fullName|title : contact.email %}

{% block title %}{{ displayName }} ({{ contact.reference }}){% endblock %}

{% block head %}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ displayName }}"
        :crumbs="[{label: 'admin.contacts.title'|trans, url: path('admin_contacts', {adminPrefix: adminPrefix})}]"
    >
        <nav class="flex shrink-0 items-center gap-2" aria-label="{{ 'admin.contacts.title'|trans }}">
            {% if adjacent.newer %}
                <a
                    href="{{ path('admin_contact_show', {adminPrefix: adminPrefix, reference: adjacent.newer} + (from ? {from: from} : {})) }}"
                    class="flex size-9 items-center justify-center rounded-xl border border-neutral-200 bg-white text-gray-600 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-gray-900"
                    aria-label="{{ 'admin.contacts.show.prev'|trans }}"
                    title="{{ 'admin.contacts.show.prev'|trans }}"
                    data-testid="contact-prev"
                >
                    {{ ux_icon('lucide:chevron-left', {class: 'size-4', 'aria-hidden': 'true'}) }}
                </a>
            {% else %}
                <span class="flex size-9 items-center justify-center rounded-xl border border-neutral-200 bg-white text-gray-300" aria-hidden="true">
                    {{ ux_icon('lucide:chevron-left', {class: 'size-4'}) }}
                </span>
            {% endif %}
            {% if adjacent.older %}
                <a
                    href="{{ path('admin_contact_show', {adminPrefix: adminPrefix, reference: adjacent.older} + (from ? {from: from} : {})) }}"
                    class="flex size-9 items-center justify-center rounded-xl border border-neutral-200 bg-white text-gray-600 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-gray-900"
                    aria-label="{{ 'admin.contacts.show.next'|trans }}"
                    title="{{ 'admin.contacts.show.next'|trans }}"
                    data-testid="contact-next"
                >
                    {{ ux_icon('lucide:chevron-right', {class: 'size-4', 'aria-hidden': 'true'}) }}
                </a>
            {% else %}
                <span class="flex size-9 items-center justify-center rounded-xl border border-neutral-200 bg-white text-gray-300" aria-hidden="true">
                    {{ ux_icon('lucide:chevron-right', {class: 'size-4'}) }}
                </span>
            {% endif %}
        </nav>
    </twig:Admin:PageHeader>
{% endblock %}

{% block body %}
    {# Le chrome de page (titre, header, badge de note) vit hors des
       composants live : un morph Turbo le rafraîchit quand l'identité
       ou la note changent. #}
    <div
        class="contents"
        data-controller="page-refresh"
        data-action="contact-identity:changed@window->page-refresh#refresh contact-status:changed@window->page-refresh#refresh"
    ></div>
    {% set pdfUrl = path('admin_contact_pdf', {adminPrefix: adminPrefix, reference: contact.reference}) %}
    {% set menuRowClass = 'flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-gray-900' %}
    {% set exportRow %}
        {# Nom du lead en tête de page (live : suit l'édition de la fiche
           sans rechargement), menu Actions en vis-à-vis. #}
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex min-w-0 items-center gap-2.5">
                <twig:Admin:ContactHeading :contactId="contact.id" />
                {% if contact.leadRating %}
                    <twig:Admin:LeadRatingBadge :rating="contact.leadRating" data-testid="lead-rating-title-badge" />
                {% endif %}
            </div>
            <details
                class="relative"
                data-controller="details-dropdown"
                data-action="click@window->details-dropdown#closeOnOutside keydown.esc@window->details-dropdown#close"
                data-testid="contact-actions-menu"
            >
                <summary class="flex cursor-pointer list-none items-center gap-2 rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm font-medium text-gray-900 transition-colors duration-100 ease-out hover:bg-gray-50 [&::-webkit-details-marker]:hidden">
                    {{ ux_icon('lucide:ellipsis', {class: 'size-4 shrink-0 text-gray-500', 'aria-hidden': 'true'}) }}
                    {{ 'admin.contacts.show.actions'|trans }}
                    {{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                </summary>
                <div class="absolute right-0 z-10 mt-2 w-60 rounded-xl border border-neutral-200 bg-white p-1 shadow-lg">
                    {# Voir le dossier et convertir mènent tous deux dans la
                       section Dossiers (la conversion exige les deux sections
                       côté serveur) : sans elle, ces entrées sont masquées
                       plutôt que d'aboutir à un 403. #}
                    {% if is_granted('ROLE_SECTION_DOSSIERS') %}
                    {% if convertedDossierRef %}
                        {# Déjà converti : lien direct vers le dossier. #}
                        <a
                            href="{{ path('admin_dossier_show', {adminPrefix: adminPrefix, reference: convertedDossierRef}) }}"
                            class="{{ menuRowClass }}"
                            data-testid="contact-view-dossier"
                        >
                            {{ ux_icon('lucide:folder-open', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                            {{ 'admin.contacts.show.viewDossier'|trans({'%reference%': convertedDossierRef}) }}
                        </a>
                    {% else %}
                    <twig:AlertDialog id="to-dossier-{{ contact.id }}">
                        <button
                            type="button"
                            class="{{ menuRowClass }}"
                            data-action="click->alert-dialog#open"
                            data-alert-dialog-target="trigger"
                            aria-haspopup="dialog"
                            aria-expanded="false"
                            data-testid="contact-to-dossier-trigger"
                        >
                            {{ ux_icon('lucide:folder-plus', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                            {{ 'admin.contacts.show.toDossier'|trans }}
                        </button>
                        <twig:AlertDialog:Content class="sm:max-w-lg">
                            <twig:AlertDialog:Header>
                                <twig:AlertDialog:Title>
                                    {{ 'admin.contacts.show.toDossierModal.title'|trans }}
                                </twig:AlertDialog:Title>
                                <twig:AlertDialog:Description>
                                    {{ 'admin.contacts.show.toDossierModal.description'|trans({'%name%': displayName}) }}
                                </twig:AlertDialog:Description>
                            </twig:AlertDialog:Header>
                            <form
                                method="post"
                                action="{{ path('admin_dossier_from_contact', {adminPrefix: adminPrefix, reference: contact.reference}) }}"
                                class="contents"
                                data-creating-overlay-trigger
                            >
                                <input type="hidden" name="_token" value="{{ csrf_token('dossier_from_contact') }}">

                                {# ── Récap de ce qui va constituer le dossier :
                                      l'identité du futur locataire principal. ── #}
                                <div class="mt-4 rounded-xl border border-neutral-200 bg-neutral-50 px-3.5 py-3">
                                    <div class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                                        <div class="min-w-0">
                                            <p class="text-xs text-gray-400">{{ 'admin.dossiers.create.person.firstName.label'|trans }}</p>
                                            <p class="mt-0.5 truncate font-medium text-gray-900">{{ contact.firstName|title ?: '-' }}</p>
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-xs text-gray-400">{{ 'admin.dossiers.create.person.lastName.label'|trans }}</p>
                                            <p class="mt-0.5 truncate font-medium text-gray-900">{{ contact.lastName|title ?: '-' }}</p>
                                        </div>
                                    </div>
                                </div>

                                {# ── Formule : reprise du lead quand elle existe,
                                      sinon choix (optionnel) au moment de la
                                      conversion, en radios natives dans le POST. ── #}
                                <div class="mt-3">
                                    <p class="text-xs font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.dossiers.card.package.label'|trans }} <span class="text-red-600" aria-hidden="true">*</span></p>
                                    {% if contact.offer %}
                                        <div class="mt-2 flex items-center justify-between gap-2 rounded-xl border border-primary/40 bg-primary/5 px-3.5 py-3" data-testid="contact-to-dossier-offer">
                                            <span class="flex items-center gap-1.5 text-sm font-medium text-primary">
                                                {{ ux_icon('lucide:badge-check', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                                {{ ('contact.contactForm.offer.' ~ contact.offer ~ '.title')|trans }}
                                            </span>
                                            <span class="shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary tabular-nums">
                                                {{ ('contact.contactForm.offer.' ~ contact.offer ~ '.price')|trans }}
                                            </span>
                                        </div>
                                    {% else %}
                                        <p class="mt-1 text-xs text-gray-500">{{ 'admin.contacts.show.toDossierModal.chooseOffer'|trans }}</p>
                                        <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
                                            {% for offerValue in ['accompagne', 'confie'] %}
                                                <label class="cursor-pointer rounded-xl border border-neutral-200 bg-white p-3 transition-colors duration-100 ease-out hover:border-gray-400 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5">
                                                    <input type="radio" name="offer" value="{{ offerValue }}" required class="peer sr-only" data-testid="contact-to-dossier-offer-{{ offerValue }}">
                                                    <span class="flex items-center justify-between gap-2">
                                                        <span class="flex items-center gap-1.5 text-sm font-medium text-gray-900 peer-checked:text-primary">
                                                            {{ ux_icon('lucide:badge-check', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                                            {{ ('contact.contactForm.offer.' ~ offerValue ~ '.title')|trans }}
                                                        </span>
                                                        <span class="shrink-0 rounded-full bg-neutral-100 px-2 py-0.5 text-xs font-semibold text-gray-600 tabular-nums">
                                                            {{ ('contact.contactForm.offer.' ~ offerValue ~ '.price')|trans }}
                                                        </span>
                                                    </span>
                                                </label>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>

                            <twig:AlertDialog:Footer class="mt-4">
                                <twig:AlertDialog:Cancel type="button">
                                    {{ 'admin.contacts.show.toDossierModal.cancel'|trans }}
                                </twig:AlertDialog:Cancel>
                                <twig:AlertDialog:Action type="submit" data-testid="contact-to-dossier">
                                    <span class="flex items-center gap-2">
                                        {{ ux_icon('lucide:folder-plus', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.contacts.show.toDossierModal.confirm'|trans }}
                                    </span>
                                </twig:AlertDialog:Action>
                            </twig:AlertDialog:Footer>
                            </form>
                        </twig:AlertDialog:Content>
                    </twig:AlertDialog>
                    {% endif %}
                    {% endif %}

                    {# The component renders a matching menu row; its confirmation
                       modal is fixed-positioned so it overlays fine from here. #}
                    <twig:Admin:ContactRecapEmail :contactId="contact.id" />

                    <a
                        href="{{ pdfUrl }}"
                        class="{{ menuRowClass }} relative"
                        data-controller="pdf-download"
                        data-pdf-download-url-value="{{ pdfUrl }}"
                        data-action="click->pdf-download#download"
                        data-testid="contact-pdf-export"
                    >
                        <span data-pdf-download-target="label" class="flex items-center gap-2.5">
                            {{ ux_icon('lucide:download', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                            {{ 'admin.contacts.show.exportPdf'|trans }}
                        </span>
                        <span data-pdf-download-target="spinner" class="absolute inset-0 hidden flex items-center justify-center gap-2 bg-white/80">
                            <twig:Spinner />
                            <span data-pdf-download-target="percent" class="text-xs font-medium tabular-nums">0%</span>
                        </span>
                    </a>

                    {# Suppression définitive : admins uniquement, isolée
                       derrière un séparateur, toujours confirmée. #}
                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="-mx-1 my-1 h-px bg-neutral-200/70" aria-hidden="true"></div>
                        <twig:AlertDialog id="delete-contact-{{ contact.id }}">
                            <button
                                type="button"
                                class="flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm font-medium text-red-600 transition-colors duration-100 ease-out hover:bg-red-50"
                                data-action="click->alert-dialog#open"
                                data-alert-dialog-target="trigger"
                                aria-haspopup="dialog"
                                data-testid="contact-delete-trigger"
                            >
                                {{ ux_icon('lucide:trash-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.contacts.show.delete.action'|trans }}
                            </button>
                            <twig:AlertDialog:Content class="sm:max-w-md">
                                <twig:AlertDialog:Header>
                                    <twig:AlertDialog:Title>
                                        {{ 'admin.contacts.show.delete.title'|trans }}
                                    </twig:AlertDialog:Title>
                                    <twig:AlertDialog:Description>
                                        {{ 'admin.contacts.show.delete.description'|trans({'%name%': displayName, '%reference%': contact.reference}) }}
                                    </twig:AlertDialog:Description>
                                </twig:AlertDialog:Header>
                                <twig:AlertDialog:Footer class="mt-4">
                                    <twig:AlertDialog:Cancel>
                                        {{ 'admin.contacts.show.delete.cancel'|trans }}
                                    </twig:AlertDialog:Cancel>
                                    <form
                                        method="post"
                                        action="{{ path('admin_contact_delete', {adminPrefix: adminPrefix, reference: contact.reference}) }}"
                                        class="contents"
                                    >
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_contact') }}">
                                        <twig:AlertDialog:Action type="submit" class="bg-red-600 hover:bg-red-700" data-testid="contact-delete-confirm">
                                            <span class="flex items-center gap-2">
                                                {{ ux_icon('lucide:trash-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                                {{ 'admin.contacts.show.delete.confirm'|trans }}
                                            </span>
                                        </twig:AlertDialog:Action>
                                    </form>
                                </twig:AlertDialog:Footer>
                            </twig:AlertDialog:Content>
                        </twig:AlertDialog>
                    {% endif %}
                </div>
            </details>
        </div>
    {% endset %}
    {% set detailCard %}
        <div class="rounded-3xl border border-neutral-200 bg-white p-2">
            {# Repliable, comme les cards de la fiche dossier. #}
            <details open class="group details-animated rounded-2xl bg-neutral-50 p-2">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-3 [&::-webkit-details-marker]:hidden">
                    <h2 class="font-medium text-gray-900">{{ 'admin.contacts.show.identityTitle'|trans }}</h2>
                    {{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-gray-400 transition-transform duration-200 group-open:rotate-180', 'aria-hidden': 'true'}) }}
                </summary>
                <twig:Admin:ContactDetails :contactId="contact.id" />
            </details>
        </div>
    {% endset %}

    <div class="space-y-6" data-testid="contact-detail">
        {{ exportRow }}

        {# Un seul bandeau à la fois, par priorité : lead clôturé (l'état
           prime sur tout) > dossier créé depuis ce lead (il implique la
           conversion, plus riche que le bandeau "Converti") > état terminal
           > simple partage d'adresse email. La zone se recalcule en morph à
           chaque changement de statut (contact-status:changed). #}
        {% set fromThisLead = linkedDossiers|filter(d => d.fromThisContact) %}
        {% set contactIsTerminal = contact.status.value in ['closed', 'converted'] %}
        {% set showCreatedBanner = fromThisLead is not empty and contact.status.value != 'closed' %}
        {% if not showCreatedBanner %}
            <twig:Admin:ContactTerminalBanner :contactId="contact.id" id="contact-terminal-banner" />
        {% endif %}

        {# Bandeau dossiers liés : le dossier issu de ce lead et tout autre
           dossier qui porte la même adresse email (ex : demande de suivi
           d'entreprise présente sur plusieurs relocations). Teinte émeraude
           informative, même famille visuelle que les bandeaux terminaux. #}
        {% if linkedDossiers is not empty and (showCreatedBanner or not contactIsTerminal) %}
            {% set canSeeDossiers = is_granted('ROLE_SECTION_DOSSIERS') %}
            <div
                id="contact-linked-dossiers-banner"
                class="flex items-start gap-4 rounded-2xl border border-emerald-200 bg-linear-to-r from-emerald-100/80 to-emerald-50/30 px-5 py-4 shadow-sm"
                role="status"
                data-testid="contact-linked-dossiers-banner"
            >
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-white text-emerald-600 shadow-sm">
                    {{ ux_icon('lucide:folder-check', {class: 'size-5', 'aria-hidden': 'true'}) }}
                </span>
                <div class="min-w-0 flex-1">
                    <p class="font-semibold text-emerald-950">
                        {% if fromThisLead is not empty %}
                            {{ 'admin.contacts.show.linkedDossiers.createdTitle'|trans }}
                        {% else %}
                            {{ 'admin.contacts.show.linkedDossiers.othersTitle'|trans({'%count%': linkedDossiers|length}) }}
                        {% endif %}
                    </p>
                    {% set otherDossiers = linkedDossiers|filter(d => not d.fromThisContact) %}
                    {% if linkedDossiers|length == 1 and fromThisLead is not empty %}
                        {# Cas simple : uniquement le dossier converti, une
                           phrase avec sa référence et son nom. #}
                        {% set dossier = linkedDossiers|first %}
                        <p class="mt-0.5 text-sm leading-5 text-emerald-800/80" data-testid="contact-linked-dossier">
                            {% if canSeeDossiers %}
                                <a
                                    href="{{ path('admin_dossier_show', {adminPrefix: adminPrefix, reference: dossier.reference}) }}"
                                    class="font-medium text-emerald-900 underline underline-offset-4 transition-colors duration-100 ease-out hover:text-emerald-950"
                                >{{ dossier.reference }} &middot; {{ dossier.name }}</a>
                            {% else %}
                                <span class="font-medium text-emerald-900">{{ dossier.reference }} &middot; {{ dossier.name }}</span>
                            {% endif %}
                            {% if dossier.closed %}
                                <span class="ml-1 inline-flex items-center rounded-full bg-neutral-200 px-2 py-0.5 text-[11px] font-medium text-neutral-700">{{ 'admin.contacts.show.linkedDossiers.closedBadge'|trans }}</span>
                            {% endif %}
                        </p>
                    {% else %}
                        {# Plusieurs dossiers : sous "créé depuis ce lead" ne
                           listent que les dossiers issus du lead; les autres
                           dossiers de la même adresse suivent sous leur
                           propre libellé, pour ne pas les confondre. #}
                        {% set primaryList = fromThisLead is not empty ? fromThisLead : linkedDossiers %}
                        <div class="mt-2 flex flex-wrap gap-2">
                            {% for dossier in primaryList %}
                                {% set chipInner %}
                                    <span class="font-medium text-emerald-900">{{ dossier.reference }}</span>
                                    <span class="text-emerald-800/80">{{ dossier.name }}</span>
                                    <span class="text-xs text-emerald-800/60">{{ dossier.personRole.labelKey|trans }}</span>
                                    {% if dossier.closed %}
                                        <span class="inline-flex items-center rounded-full bg-neutral-200 px-2 py-0.5 text-[11px] font-medium text-neutral-700">{{ 'admin.contacts.show.linkedDossiers.closedBadge'|trans }}</span>
                                    {% endif %}
                                {% endset %}
                                {% if canSeeDossiers %}
                                    <a
                                        href="{{ path('admin_dossier_show', {adminPrefix: adminPrefix, reference: dossier.reference}) }}"
                                        class="flex items-center gap-2 rounded-full border border-emerald-200 bg-white/70 px-3 py-1 text-sm transition-colors duration-100 ease-out hover:border-emerald-300 hover:bg-white"
                                        data-testid="contact-linked-dossier"
                                    >{{ chipInner }}</a>
                                {% else %}
                                    <span
                                        class="flex items-center gap-2 rounded-full border border-emerald-200 bg-white/70 px-3 py-1 text-sm"
                                        data-testid="contact-linked-dossier"
                                    >{{ chipInner }}</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                        {% if fromThisLead is not empty and otherDossiers is not empty %}
                            <p class="mt-3 text-xs font-medium text-emerald-800/70">{{ 'admin.contacts.show.linkedDossiers.othersAlso'|trans({'%count%': otherDossiers|length}) }}</p>
                            <div class="mt-1.5 flex flex-wrap gap-2">
                                {% for dossier in otherDossiers %}
                                    {% set chipInner %}
                                        <span class="font-medium text-emerald-900">{{ dossier.reference }}</span>
                                        <span class="text-emerald-800/80">{{ dossier.name }}</span>
                                        <span class="text-xs text-emerald-800/60">{{ dossier.personRole.labelKey|trans }}</span>
                                        {% if dossier.closed %}
                                            <span class="inline-flex items-center rounded-full bg-neutral-200 px-2 py-0.5 text-[11px] font-medium text-neutral-700">{{ 'admin.contacts.show.linkedDossiers.closedBadge'|trans }}</span>
                                        {% endif %}
                                    {% endset %}
                                    {% if canSeeDossiers %}
                                        <a
                                            href="{{ path('admin_dossier_show', {adminPrefix: adminPrefix, reference: dossier.reference}) }}"
                                            class="flex items-center gap-2 rounded-full border border-emerald-200 bg-white/70 px-3 py-1 text-sm transition-colors duration-100 ease-out hover:border-emerald-300 hover:bg-white"
                                            data-testid="contact-linked-dossier"
                                        >{{ chipInner }}</a>
                                    {% else %}
                                        <span
                                            class="flex items-center gap-2 rounded-full border border-emerald-200 bg-white/70 px-3 py-1 text-sm"
                                            data-testid="contact-linked-dossier"
                                        >{{ chipInner }}</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <div class="lg:grid lg:grid-cols-[1fr_26rem] lg:items-start lg:gap-6">
            <div class="space-y-6">
                {{ detailCard }}

                <twig:Admin:ContactProject :contactId="contact.id" />
                <twig:Admin:LeadQuality :contactId="contact.id" />
            </div>
            <div class="space-y-4 max-lg:mt-6 lg:sticky lg:top-6">
                {# Card statut : état, suivi par, sélecteur, puis les accès
                   au drawer Suivi et notes et à l'historique des demandes,
                   la référence en pied de card. #}
                <div class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="status-card">
                    <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
                        <twig:Admin:ContactStatusControl :contactId="contact.id" />

                        <div class="flex flex-col overflow-hidden rounded-xl bg-white">
                            {# ── Drawer : fil de suivi. ─────────────────── #}
                            <div
                                class="contents"
                                data-controller="drawer"
                                data-action="keydown.esc@window->drawer#close"
                                data-testid="notes-drawer"
                            >
                                <button
                                    type="button"
                                    data-controller="notes-count"
                                    data-action="drawer#open contact-notes:count@window->notes-count#update"
                                    class="flex w-full cursor-pointer items-center gap-2 border-b border-gray-950/5 px-4 py-3 text-left text-sm font-medium text-gray-700 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-primary"
                                    data-testid="notes-drawer-open"
                                >
                                    {{ ux_icon('lucide:message-square-text', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.contacts.drawer.notes'|trans }}
                                    <span
                                        class="inline-flex min-w-5 items-center justify-center rounded-full bg-neutral-100 px-1.5 py-0.5 text-[11px] leading-none font-semibold text-gray-600 tabular-nums {{ notesCount == 0 ? 'hidden' }}"
                                        data-notes-count-target="badge"
                                        data-testid="notes-count-badge"
                                    >{{ notesCount }}</span>
                                    {{ ux_icon('lucide:chevron-right', {class: 'ml-auto size-4 shrink-0 text-gray-300', 'aria-hidden': 'true'}) }}
                                </button>
                                <div data-drawer-target="root" hidden class="fixed inset-0 z-50">
                                    <button
                                        type="button"
                                        data-drawer-target="backdrop"
                                        data-action="drawer#close"
                                        class="absolute inset-0 cursor-default bg-gray-950/40 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 ease-out motion-reduce:transition-none"
                                        aria-label="{{ 'admin.contacts.drawer.close'|trans }}"
                                        tabindex="-1"
                                    ></button>
                                    <aside
                                        data-drawer-target="panel"
                                        class="absolute inset-y-0 right-0 flex w-full max-w-md translate-x-full flex-col bg-white shadow-2xl transition-transform duration-200 ease-out motion-reduce:transition-none"
                                        role="dialog"
                                        aria-modal="true"
                                        aria-label="{{ 'admin.contacts.drawer.notes'|trans }}"
                                    >
                                        <div class="flex items-center justify-between gap-4 border-b border-gray-950/5 px-5 py-4">
                                            <h2 class="font-medium text-gray-900">{{ 'admin.contacts.drawer.notes'|trans }}</h2>
                                            <button
                                                type="button"
                                                data-action="drawer#close"
                                                class="flex size-8 cursor-pointer items-center justify-center rounded-lg text-gray-400 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900"
                                                aria-label="{{ 'admin.contacts.drawer.close'|trans }}"
                                                data-testid="notes-drawer-close"
                                            >
                                                {{ ux_icon('lucide:x', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                            </button>
                                        </div>
                                        {# min-h-0 : le composant (display:contents) fournit la zone
                                           scrollable et le composer épinglé en pied de panel. #}
                                        <div class="flex min-h-0 flex-1 flex-col bg-neutral-50">
                                            <twig:Admin:ContactNotes :contactId="contact.id" />
                                        </div>
                                    </aside>
                                </div>
                            </div>

                            {# ── Drawer : demandes précédentes. ─────────── #}
                            {% if previousRequests is not empty %}
                                <div
                                    class="contents"
                                    data-controller="drawer"
                                    data-action="keydown.esc@window->drawer#close"
                                    data-testid="previous-requests"
                                >
                                    <button
                                        type="button"
                                        data-action="drawer#open"
                                        class="flex w-full cursor-pointer items-center gap-2 px-4 py-3 text-left text-sm font-medium text-gray-700 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-primary"
                                        data-testid="previous-drawer-open"
                                    >
                                        {{ ux_icon('lucide:history', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.contacts.previous.title'|trans({'%count%': previousRequests|length}) }}
                                        {{ ux_icon('lucide:chevron-right', {class: 'ml-auto size-4 shrink-0 text-gray-300', 'aria-hidden': 'true'}) }}
                                    </button>
                                    <div data-drawer-target="root" hidden class="fixed inset-0 z-50">
                                        <button
                                            type="button"
                                            data-drawer-target="backdrop"
                                            data-action="drawer#close"
                                            class="absolute inset-0 cursor-default bg-gray-950/40 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 ease-out motion-reduce:transition-none"
                                            aria-label="{{ 'admin.contacts.drawer.close'|trans }}"
                                            tabindex="-1"
                                        ></button>
                                        <aside
                                            data-drawer-target="panel"
                                            class="absolute inset-y-0 right-0 flex w-full max-w-md translate-x-full flex-col bg-white shadow-2xl transition-transform duration-200 ease-out motion-reduce:transition-none"
                                            role="dialog"
                                            aria-modal="true"
                                            aria-label="{{ 'admin.contacts.previous.title'|trans({'%count%': previousRequests|length}) }}"
                                        >
                                            <div class="flex items-center justify-between gap-4 border-b border-gray-950/5 px-5 py-4">
                                                <h2 class="font-medium text-gray-900">
                                                    {{ 'admin.contacts.previous.title'|trans({'%count%': previousRequests|length}) }}
                                                </h2>
                                                <button
                                                    type="button"
                                                    data-action="drawer#close"
                                                    class="flex size-8 cursor-pointer items-center justify-center rounded-lg text-gray-400 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900"
                                                    aria-label="{{ 'admin.contacts.drawer.close'|trans }}"
                                                    data-testid="previous-drawer-close"
                                                >
                                                    {{ ux_icon('lucide:x', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                                </button>
                                            </div>
                                            <div class="flex-1 overflow-y-auto px-5 py-2">
                                                <ul class="divide-y divide-gray-950/5" role="list">
                                                    {% for previous in previousRequests %}
                                                        <li>
                                                            <a
                                                                href="{{ path('admin_contact_show', {adminPrefix: adminPrefix, reference: previous.reference}) }}"
                                                                class="flex items-center justify-between gap-3 py-3 text-sm transition-colors duration-100 hover:text-primary"
                                                            >
                                                                <span class="flex min-w-0 items-center gap-2">
                                                                    <span class="size-1.5 shrink-0 rounded-full {{ previous.status.dotClass }}" aria-hidden="true"></span>
                                                                    <span class="truncate font-medium text-gray-900">{{ previous.reference }}</span>
                                                                    <span class="truncate text-gray-500">{{ previous.helpType|trans }}</span>
                                                                </span>
                                                                <span class="shrink-0 text-xs text-gray-500 tabular-nums">{{ previous.createdAt|format_date('short') }}</span>
                                                            </a>
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </aside>
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        <div class="flex justify-end px-3 pt-1 pb-1">
                            <p class="text-xs font-medium text-gray-400 tabular-nums" data-testid="status-card-reference">{{ contact.reference }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Revealed while the lead -> dossier conversion POST is in flight. #}
    <twig:Admin:CreatingOverlay
        title="admin.dossiers.creating.title"
        subtitle="admin.dossiers.creating.subtitle"
    />
{% endblock %}
