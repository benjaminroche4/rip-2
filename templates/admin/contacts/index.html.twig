{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.contacts.title'|trans }}{% endblock %}

{% block head %}
    {# Les filtres/tri vivent dans un LiveComponent : un snapshot Turbo
       restauré montrerait un état périmé de la liste au retour. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader title="{{ 'admin.contacts.title'|trans }}">
        <twig:Admin:ContactCreate :adminPrefix="adminPrefix" />
    </twig:Admin:PageHeader>
{% endblock %}

{% block body %}
    <div class="space-y-8" data-testid="contacts-page">
        <twig:Admin:ContactList :adminPrefix="adminPrefix" />
    </div>
{% endblock %}
