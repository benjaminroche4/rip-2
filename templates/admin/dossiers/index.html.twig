{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.dossiers.title'|trans }}{% endblock %}

{% block head %}
    {# Les filtres vivent dans un LiveComponent : un snapshot Turbo restauré
       montrerait un état périmé de la liste au retour. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader title="{{ 'admin.dossiers.title'|trans }}">
        <twig:Dossier:DossierCreate adminPrefix="{{ adminPrefix }}" />
    </twig:Admin:PageHeader>
{% endblock %}

{% block body %}
    <div data-testid="dossiers-page">
        <twig:Dossier:DossierList :adminPrefix="adminPrefix" />
    </div>
{% endblock %}
