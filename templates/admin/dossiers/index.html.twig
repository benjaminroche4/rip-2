{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.dossiers.title'|trans }}{% endblock %}

{% block page_header %}
    <twig:Admin:PageHeader
        title="{{ 'admin.dossiers.title'|trans }}"
        subtitle="{{ 'admin.dossiers.subtitle'|trans }}"
    >
        <twig:Dossier:DossierCreate adminPrefix="{{ adminPrefix }}" />
    </twig:Admin:PageHeader>
{% endblock %}

{% block body %}
    <div class="space-y-8" data-testid="dossiers-page">
        {% if dossiers is empty %}
            <section class="rounded-2xl border border-dashed border-gray-950/10 bg-white/50 p-2" data-testid="dossiers-empty">
                <div class="flex flex-col items-center justify-center gap-3 rounded-xl px-4 py-16 text-center">
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-400">
                        {{ ux_icon('lucide:folder-open', {class: 'size-6', 'aria-hidden': 'true'}) }}
                    </div>
                    <div class="space-y-1">
                        <h2 class="text-sm font-medium text-gray-700">
                            {{ 'admin.dossiers.empty.title'|trans }}
                        </h2>
                        <p class="max-w-[40ch] text-xs text-pretty text-gray-400">
                            {{ 'admin.dossiers.empty.description'|trans }}
                        </p>
                    </div>
                </div>
            </section>
        {% else %}
            {# Même vocabulaire de carte que les leads (ContactList) : coque
               blanche arrondie, intérieur gris, zones blanches séparées par
               des dégradés verticaux, pied avec date + CTA. #}
            <div class="space-y-4" data-testid="dossiers-list">
                {% for dossier in dossiers %}
                    <article class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="dossier-row">
                        <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
                            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 p-3">
                                <div class="min-w-0">
                                    <p class="truncate font-medium text-gray-900">{{ dossier.name }}</p>
                                    <p class="mt-1 flex items-center gap-1.5 font-mono text-xs text-gray-500">
                                        {{ ux_icon('lucide:hash', {class: 'size-3 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                        {{ dossier.reference }}
                                    </p>
                                </div>
                            </div>

                            <div class="flex flex-col gap-y-4 rounded-xl bg-white px-5 py-4 sm:flex-row sm:items-stretch sm:gap-x-6">
                                <div class="min-w-0 space-y-2 text-sm sm:flex-1">
                                    <p class="text-gray-600">{{ 'admin.dossiers.create.person.primaryTag'|trans }}</p>
                                    <p class="truncate font-medium text-gray-900">{{ dossier.primaryTenantName ?: '-' }}</p>
                                </div>
                                <div class="hidden w-px self-stretch bg-linear-to-b from-transparent via-gray-950/10 to-transparent sm:block" aria-hidden="true"></div>
                                <div class="min-w-0 space-y-2 text-sm sm:flex-1">
                                    <p class="text-gray-600">{{ 'admin.dossiers.create.persons.title'|trans }}</p>
                                    <p class="flex items-center gap-2 font-medium text-gray-900">
                                        {{ ux_icon('lucide:users', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.dossiers.list.personCount'|trans({'%count%': dossier.personCount}) }}
                                    </p>
                                </div>
                            </div>

                            <div class="mt-2 mb-1 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-1">
                                <p class="flex items-center gap-1 pl-1 text-xs text-gray-900" title="{{ dossier.createdAt|format_datetime('medium', 'short') }}">
                                    <span class="opacity-50">{{ 'admin.contacts.card.created'|trans }}</span>
                                    <span class="tabular-nums">{{ dossier.createdAt|format_datetime(pattern='dd.MM.yyyy') }}</span>
                                </p>
                                <twig:Button
                                    as="a"
                                    size="sm"
                                    href="{{ path('admin_dossier_show', {adminPrefix: adminPrefix, reference: dossier.reference}) }}"
                                    class="px-10"
                                    data-testid="dossier-card-details"
                                >
                                    {{ 'admin.dossiers.list.viewMore'|trans }}
                                </twig:Button>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
