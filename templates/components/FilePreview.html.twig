{# Visionneuse de fichier façon lightbox marketplace : plein écran sur fond
   sombre, nom du fichier en haut à gauche, actions en haut à droite,
   document centré (img native pour les images, iframe pour les PDF).
   Pilotée par le controller file-preview; les liens déclencheurs utilisent
   data-action="click->file-preview#open" + data-file-preview-name/type. #}
<div
    data-file-preview-target="overlay"
    hidden
    class="fixed inset-0 z-50 bg-black/80"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'filePreview.title'|trans }}"
    data-testid="file-preview-modal"
>
    <div class="fixed inset-x-0 top-0 z-20 flex items-center justify-between gap-3 p-4">
        {# Badge = type de la pièce (Pièce d'identité...), pas le nom du
           fichier déposé. #}
        <p class="inline-flex min-w-0 items-center rounded-full bg-white px-3 py-1.5 shadow-sm">
            <span class="truncate text-xs font-medium text-gray-900" data-file-preview-target="title"></span>
        </p>
        <div class="flex shrink-0 items-center gap-2">
            <a
                data-file-preview-target="newTab"
                href="#"
                target="_blank" rel="noopener noreferrer"
                class="flex size-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition duration-100 hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none"
                aria-label="{{ 'filePreview.openNewTab'|trans }}"
                title="{{ 'filePreview.openNewTab'|trans }}"
            >
                {{ ux_icon('lucide:external-link', {'class': 'size-4.5 shrink-0', 'aria-hidden': 'true'}) }}
            </a>
            <button
                type="button"
                data-action="file-preview#close"
                class="flex size-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition duration-100 hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none"
                aria-label="{{ 'filePreview.close'|trans }}"
                title="{{ 'filePreview.close'|trans }}"
                data-testid="file-preview-close"
            >
                {{ ux_icon('lucide:x', {'class': 'size-5 shrink-0', 'aria-hidden': 'true'}) }}
            </button>
        </div>
    </div>

    {# Clic sur le fond = fermeture (le contenu stoppe la propagation). #}
    <div class="relative flex h-full w-full items-center justify-center px-4 pt-16 pb-8" data-action="click->file-preview#closeOnBackdrop">
        {# Loader affiché à l'ouverture, masqué au `load` du document. #}
        <div data-file-preview-target="loader" hidden class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center">
            <twig:Spinner class="size-8 text-white/80" />
        </div>
        <img
            data-file-preview-target="image"
            src=""
            alt=""
            hidden
            draggable="false"
            data-action="load->file-preview#loaded error->file-preview#loaded"
            class="max-h-full max-w-full rounded-xl object-contain select-none"
        />
        <iframe
            data-file-preview-target="frame"
            src="about:blank"
            title="{{ 'filePreview.title'|trans }}"
            hidden
            data-action="load->file-preview#loaded"
            class="h-full w-full max-w-3xl rounded-xl bg-white"
        ></iframe>
    </div>
</div>
