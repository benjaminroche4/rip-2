<div {{ attributes }} data-testid="dossiers-list-component">
    {% set dossiers = this.dossiers %}
    {% set counts = this.statusCounts %}
    {% set visitCountsByDossier = this.visitCounts %}

    <div class="lg:grid lg:grid-cols-[15rem_1fr] lg:items-start lg:gap-6">
        <aside class="lg:sticky lg:top-6">
            <div class="relative">
                {{ ux_icon('lucide:search', {class: 'pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-gray-400', 'aria-hidden': 'true'}) }}
                <input
                    type="search"
                    data-model="debounce(300)|search"
                    value="{{ this.search }}"
                    placeholder="{{ 'admin.dossiers.searchPlaceholder'|trans }}"
                    aria-label="{{ 'admin.dossiers.searchPlaceholder'|trans }}"
                    class="w-full rounded-xl border border-neutral-200 bg-white py-2 pr-3.5 pl-9 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                    data-testid="dossiers-search"
                >
            </div>

            <div class="mt-4 flex flex-col gap-1.5" data-testid="dossiers-filters">
                {% for status in this.statuses %}
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="filter"
                        data-live-status-param="{{ status.value }}"
                        class="flex cursor-pointer items-center gap-2 rounded-xl border px-3.5 py-2 text-left text-sm font-medium transition-colors duration-100 ease-out {{ this.statusFilter == status.value ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                        data-testid="dossiers-filter-{{ status.value }}"
                    >
                        <span class="size-1.5 shrink-0 rounded-full {{ status.dotClass }}" aria-hidden="true"></span>
                        {{ status.labelKey|trans }}
                        <span class="ml-auto text-xs {{ this.statusFilter == status.value ? 'text-primary/60' : 'text-gray-400' }} tabular-nums">{{ counts[status.value] }}</span>
                    </button>
                {% endfor %}
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="filter"
                    data-live-status-param="all"
                    class="flex cursor-pointer items-center rounded-xl border px-3.5 py-2 text-left text-sm font-medium transition-colors duration-100 ease-out {{ this.statusFilter == 'all' ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                    data-testid="dossiers-filter-all"
                >
                    {{ 'admin.dossiers.filter.all'|trans }}
                    <span class="ml-auto text-xs {{ this.statusFilter == 'all' ? 'text-primary/60' : 'text-gray-400' }} tabular-nums">{{ this.totalCount }}</span>
                </button>
            </div>
        </aside>

        <div class="max-lg:mt-6">
            {# Portée : tous les dossiers ou seulement les miens, comme sur
               Leads. Même pastille glissante que les onglets de la fiche
               dossier (suit le survol, revient sur l'actif). #}
            <div class="mb-4 flex items-center justify-end">
                <div
                    class="inline-flex rounded-2xl border border-neutral-200 bg-white p-1.5"
                    data-controller="tabs"
                    data-tabs
                    data-active-tab="{{ this.scope }}"
                    data-tabs-active-class="text-primary"
                    data-tabs-inactive-class="text-gray-600 hover:text-gray-900"
                    data-testid="dossiers-scope"
                >
                    <div class="relative flex items-stretch" role="tablist" aria-label="{{ 'admin.dossiers.scope.label'|trans }}" data-action="mouseleave->tabs#resetIndicator">
                        <span
                            data-tabs-target="indicator"
                            class="absolute top-0 left-0 z-0 rounded-lg bg-neutral-100 transition-[transform,width,height] duration-200 ease-out will-change-transform motion-reduce:transition-none"
                            aria-hidden="true"
                            hidden
                        ></span>
                        {% for scope in ['all', 'mine', 'archived'] %}
                            {% if not loop.first %}
                                <span class="z-0 my-2 w-px shrink-0 bg-gray-950/10" aria-hidden="true"></span>
                            {% endif %}
                            <button
                                type="button"
                                role="tab"
                                aria-selected="{{ this.scope == scope ? 'true' : 'false' }}"
                                data-tabs-target="tab"
                                data-tabs-key="{{ scope }}"
                                data-action="live#action mouseenter->tabs#hoverIndicator"
                                data-live-action-param="changeScope"
                                data-live-scope-param="{{ scope }}"
                                class="relative z-10 flex cursor-pointer items-center gap-1.5 rounded-xl px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors duration-100 ease-out {{ this.scope == scope ? 'text-primary' : 'text-gray-600 hover:text-gray-900' }}"
                                data-testid="dossiers-scope-{{ scope }}"
                            >
                                {{ ('admin.dossiers.scope.' ~ scope)|trans }}
                                {% if scope in ['mine', 'archived'] %}
                                    <span class="inline-flex min-w-5 items-center justify-center rounded-full border border-neutral-200 bg-white px-1.5 py-0.5 text-[11px] leading-none font-semibold text-gray-600 tabular-nums">{{ scope == 'mine' ? this.mineCount : this.archivedCount }}</span>
                                {% endif %}
                            </button>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div data-loading="delay(150)|action(filter)|action(changeScope)|addClass(hidden)">
                {% if dossiers is empty %}
                    <section class="rounded-2xl border border-dashed border-gray-950/10 bg-white/50 p-2" data-testid="dossiers-empty">
                        <div class="flex flex-col items-center justify-center gap-3 rounded-xl px-4 py-16 text-center">
                            <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-400">
                                {{ ux_icon(this.search|trim != '' or this.statusFilter != 'all' ? 'lucide:search-x' : 'lucide:folder-open', {class: 'size-6', 'aria-hidden': 'true'}) }}
                            </div>
                            <div class="space-y-1">
                                <h2 class="text-sm font-medium text-gray-700">
                                    {{ (this.search|trim != '' or this.statusFilter != 'all' ? 'admin.dossiers.emptyFiltered.title' : 'admin.dossiers.empty.title')|trans }}
                                </h2>
                                <p class="max-w-[40ch] text-xs text-pretty text-gray-400">
                                    {{ (this.search|trim != '' or this.statusFilter != 'all' ? 'admin.dossiers.emptyFiltered.description' : 'admin.dossiers.empty.description')|trans }}
                                </p>
                            </div>
                        </div>
                    </section>
                {% else %}
                    <div class="space-y-4" data-testid="dossiers-list">
                        {% for dossier in dossiers %}
                            {% if dossier.closedAt %}
                                {# Dossier archivé : même coque et mêmes bandes
                                   que la card courante, seul le contenu change
                                   (la recherche est finie : plus de statut ni
                                   de barre d'avancement, mais l'état, les dates
                                   de début et de clôture, et le bilan chiffré). #}
                                {% set visitCounts = visitCountsByDossier[dossier.id]|default({upcoming: 0, total: 0}) %}
                                <article class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="dossier-row">
                                    <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
                                        <a
                                            href="{{ path('admin_dossier_show', {adminPrefix: this.adminPrefix, reference: dossier.reference}) }}"
                                            class="space-y-3 rounded-t-xl bg-white px-5 py-6 text-center"
                                            data-testid="dossier-card-details"
                                        >
                                            <p class="truncate text-lg font-medium text-gray-900">{{ dossier.name|title }}</p>
                                            <span class="flex flex-wrap items-center justify-center gap-1.5">
                                                <span class="flex items-center gap-1.5 rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700" data-testid="dossier-archived-badge">
                                                    {{ ux_icon('lucide:check', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                    {{ 'admin.dossiers.card.archived'|trans }}
                                                </span>
                                                {# Formule : c'est elle qui permet de comparer
                                                   deux dossiers clos entre eux. #}
                                                {% if dossier.offer %}
                                                    <span class="rounded-full border border-neutral-200 px-2.5 py-0.5 text-xs font-medium text-gray-600" data-testid="dossier-archived-offer">
                                                        {{ ('contact.contactForm.offer.' ~ dossier.offer ~ '.title')|trans }}
                                                    </span>
                                                {% endif %}
                                            </span>
                                            <span class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-gray-600">
                                                <span>
                                                    {{ 'admin.dossiers.card.progress.started'|trans }}
                                                    <span class="font-medium text-gray-900 tabular-nums">{{ dossier.createdAt|format_datetime(pattern='dd MMM yyyy') }}</span>
                                                </span>
                                                <span class="h-3 w-px bg-gray-950/10" aria-hidden="true"></span>
                                                <span>
                                                    {{ 'admin.dossiers.card.progress.closed'|trans }}
                                                    <span class="font-medium text-gray-900 tabular-nums">{{ dossier.closedAt|format_datetime(pattern='dd MMM yyyy') }}</span>
                                                </span>
                                                {# Durée totale : l'indicateur d'efficacité du
                                                   dossier, sans soustraction mentale. #}
                                                <span class="h-3 w-px bg-gray-950/10" aria-hidden="true"></span>
                                                <span class="font-medium text-gray-900" data-testid="dossier-archived-duration">
                                                    {{ 'admin.dossiers.card.closedIn'|trans({'%count%': dossier.createdAt.diff(dossier.closedAt).days}) }}
                                                </span>
                                            </span>
                                        </a>
                                        {# Visites à venir n'a plus de sens sur un dossier clos :
                                           la tuile passe au responsable. #}
                                        <twig:Dossier:VisitStats
                                            :total="visitCounts.total"
                                            :manager="{name: dossier.managerName, avatar: dossier.managerAvatarFilename}"
                                            :alerts="false"
                                        />
                                    </div>
                                </article>
                            {% else %}
                            <article class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="dossier-row">
                                <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
                                    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 p-3">
                                        <div class="flex min-w-0 items-center gap-3">
                                            <p class="truncate font-medium text-gray-900">{{ dossier.name }}</p>
                                        </div>
                                        <div class="flex shrink-0 items-center gap-3">
                                            {# Responsable : même emplacement que la personne de suivi
                                               sur la card contact (header, avant le statut). #}
                                            {% if dossier.managerName %}
                                                <div class="flex items-center gap-2">
                                                    <div class="min-w-0 text-right">
                                                        <p class="text-xs text-gray-500">{{ 'admin.dossiers.card.managedBy'|trans }}</p>
                                                        <p class="truncate text-xs font-medium text-gray-900">{{ dossier.managerName|title }}</p>
                                                    </div>
                                                    <twig:Avatar filename="{{ dossier.managerAvatarFilename }}" name="{{ dossier.managerName }}" size="7" />
                                                </div>
                                            {% endif %}
                                            {# Statut effectif (clôture et pièces en attente déjà déduits). #}
                                            <span class="flex shrink-0 items-center gap-2 rounded-xl border border-neutral-200 bg-white px-3.5 py-1.5" data-testid="dossier-status-badge">
                                                <span class="size-1.5 shrink-0 rounded-full {{ dossier.status.dotClass }}" aria-hidden="true"></span>
                                                <span class="truncate text-sm font-medium text-gray-900">{{ dossier.status.labelKey|trans }}</span>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="flex flex-col gap-y-4 rounded-t-xl bg-white px-5 py-4 sm:flex-row sm:items-stretch sm:gap-x-6">
                                        <div class="min-w-0 space-y-2 text-sm sm:flex-1">
                                            <p class="text-gray-600">{{ 'admin.dossiers.create.person.primaryTag'|trans }}</p>
                                            <p class="truncate font-medium text-gray-900">{{ dossier.primaryTenantName ? dossier.primaryTenantName|title : '-' }}</p>
                                        </div>
                                        <div class="hidden w-px self-stretch bg-linear-to-b from-transparent via-gray-950/10 to-transparent sm:block" aria-hidden="true"></div>
                                        <div class="min-w-0 space-y-2 text-sm sm:flex-1">
                                            <p class="text-gray-600">{{ 'admin.dossiers.card.filesStatus.label'|trans }}</p>
                                            {% if dossier.status.value == 'awaiting_documents' %}
                                                <p class="flex items-center gap-1.5 font-medium text-amber-600">
                                                    {{ ux_icon('lucide:clock', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                                    {{ 'admin.dossiers.card.filesStatus.pending'|trans }}
                                                </p>
                                            {% else %}
                                                <p class="flex items-center gap-1.5 font-medium text-emerald-600">
                                                    {{ ux_icon('lucide:check', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                                    {{ 'admin.dossiers.card.filesStatus.completed'|trans }}
                                                </p>
                                            {% endif %}
                                        </div>
                                        <div class="hidden w-px self-stretch bg-linear-to-b from-transparent via-gray-950/10 to-transparent sm:block" aria-hidden="true"></div>
                                        <div class="min-w-0 space-y-2 text-sm sm:flex-1">
                                            <p class="text-gray-600">{{ 'admin.dossiers.card.package.label'|trans }}</p>
                                            {% if dossier.offer %}
                                                <p class="truncate font-medium text-gray-900">
                                                    {{ ('contact.contactForm.offer.' ~ dossier.offer ~ '.title')|trans }}
                                                    <span class="font-normal text-gray-500">({{ ('contact.contactForm.offer.' ~ dossier.offer ~ '.price')|trans }})</span>
                                                </p>
                                            {% else %}
                                                <p class="font-medium text-gray-400">-</p>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <div class="bg-white px-5 py-4">
                                        <div class="space-y-2">
                                            <div class="h-2 w-full overflow-hidden rounded-full bg-neutral-100">
                                                {% if dossier.timeline %}
                                                    <div
                                                        class="progress-bar-fill h-full rounded-full bg-linear-to-r {{ {
                                                            'green': 'from-[#8ebf7d] to-[#279d2f]',
                                                            'amber': 'from-amber-300 to-amber-500',
                                                            'red': 'from-red-400 to-red-600',
                                                        }[dossier.timeline.tone.value] }}"
                                                        style="width: {{ max(2, dossier.timeline.percent) }}%"
                                                        data-testid="dossier-card-bar-{{ dossier.timeline.tone.value }}"
                                                    ></div>
                                                {% endif %}
                                            </div>
                                            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-xs">
                                                <p class="text-gray-600">
                                                    {{ 'admin.dossiers.card.progress.started'|trans }}
                                                    <span class="font-medium text-gray-900 tabular-nums">{{ dossier.createdAt|format_datetime(pattern='dd MMM yyyy') }}</span>
                                                </p>
                                                <p class="text-gray-600">
                                                    {{ 'admin.dossiers.card.progress.estimatedFinish'|trans }}
                                                    {% if dossier.moveInAt %}
                                                        <span class="font-medium text-gray-900 tabular-nums">{{ dossier.moveInAt|format_datetime(pattern='dd MMM yyyy') }}</span>
                                                    {% else %}
                                                        <span class="font-medium text-gray-400">-</span>
                                                    {% endif %}
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    {# Compteurs de visites du dossier (annulées exclues),
                                       mêmes tuiles que sur le Récapitulatif de la fiche. #}
                                    {% set visitCounts = visitCountsByDossier[dossier.id]|default({upcoming: 0, total: 0}) %}
                                    <twig:Dossier:VisitStats
                                        :upcoming="visitCounts.upcoming"
                                        :total="visitCounts.total"
                                    />

                                    <div class="mt-1 flex flex-wrap items-center justify-end gap-x-6 gap-y-2 px-1 pb-1">
                                        <twig:Button
                                            as="a"
                                            size="sm"
                                            href="{{ path('admin_dossier_show', {adminPrefix: this.adminPrefix, reference: dossier.reference}) }}"
                                            class="px-10"
                                            data-testid="dossier-card-details"
                                        >
                                            {{ 'admin.dossiers.list.viewMore'|trans }}
                                        </twig:Button>
                                    </div>
                                </div>
                            </article>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            {# Pendant un changement de filtre, squelettes qui pulsent. #}
            <div data-loading="delay(150)|action(filter)|action(changeScope)|removeClass(hidden)" class="hidden" data-testid="dossiers-skeleton">
                <div class="space-y-4">
                    {% for i in 1..3 %}
                        <div class="animate-pulse rounded-3xl border border-neutral-200 bg-white p-2">
                            <div class="space-y-2 rounded-2xl bg-neutral-50 p-5">
                                <div class="h-4 w-1/3 rounded bg-neutral-200"></div>
                                <div class="h-3 w-2/3 rounded bg-neutral-200"></div>
                                <div class="h-3 w-1/2 rounded bg-neutral-100"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
