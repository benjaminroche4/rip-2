{# Card "Récap express" : résumé IA persisté du dossier, généré à la
   demande (jamais au chargement). Le bouton passe par une LiveAction
   synchrone; data-loading couvre les quelques secondes d'appel modèle. #}
{% set recap = this.recap %}
<div {{ attributes.defaults({class: 'contents'}) }}>
    {# Le récap n'est disponible qu'une fois les étapes Personnes et
       Recherche validées : avant, le modèle n'aurait pas de matière fiable
       à résumer. En attendant, la card reste visible avec l'incitation à
       compléter les étapes (même vocabulaire que StepLocked). #}
    {% if not this.unlocked %}
    <section class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="dossier-recap-locked">
        <div class="rounded-2xl bg-neutral-50 p-2">
            <div class="flex items-center justify-between gap-4 p-3">
                <div class="min-w-0">
                    <h2 class="flex items-center gap-2 font-medium text-gray-900">
                        <span class="ai-orb" aria-hidden="true"></span>
                        {{ 'admin.dossiers.show.recap.title'|trans }}
                    </h2>
                    <p class="mt-0.5 text-xs text-gray-500">{{ 'admin.dossiers.show.recap.locked'|trans }}</p>
                </div>
                <span class="flex shrink-0 items-center gap-1.5 rounded-full bg-gray-100 py-1 pr-2.5 pl-1.5 text-xs font-medium text-gray-500">
                    {{ ux_icon('lucide:lock', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                    {{ 'admin.dossiers.show.modules.lockedShort'|trans }}
                </span>
            </div>
        </div>
    </section>
    {% else %}
    <section class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="dossier-show-recap">
        <div class="rounded-2xl bg-neutral-50 p-2">
            <div class="rounded-xl bg-white px-5 pt-4 pb-5">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                    {# Orbe animé à la Siri : signale que le contenu est écrit
                       par le modèle, sans le dire une fois de plus. #}
                    <h2 class="flex items-center gap-2 font-medium text-gray-900">
                        <span class="ai-orb" aria-hidden="true"></span>
                        {{ 'admin.dossiers.show.recap.title'|trans }}
                    </h2>
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="generate"
                        data-loading="action(generate)|addAttribute(disabled)"
                        class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary disabled:cursor-wait disabled:opacity-60"
                        data-testid="dossier-recap-generate"
                    >
                        {# Bascule par classe (jamais |show/|hide) : ces directives
                           posent un `display` inline qui écraserait le `flex` et
                           renverrait l'icône à la ligne. #}
                        <span data-loading="action(generate)|addClass(hidden)" class="flex items-center gap-1.5">
                            {{ ux_icon('lucide:refresh-cw', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                            {{ (recap ? 'admin.dossiers.show.recap.refresh' : 'admin.dossiers.show.recap.generate')|trans }}
                        </span>
                        <span data-loading="action(generate)|removeClass(hidden)" class="hidden flex items-center gap-1.5">
                            {{ ux_icon('lucide:loader-circle', {class: 'size-3.5 shrink-0 animate-spin', 'aria-hidden': 'true'}) }}
                            {{ 'admin.dossiers.show.recap.generating'|trans }}
                        </span>
                    </button>
                </div>

                {% if this.failed %}
                    <p class="mb-3 flex items-center gap-2 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-700" data-testid="dossier-recap-error">
                        {{ ux_icon('lucide:triangle-alert', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                        {{ 'admin.dossiers.show.recap.error'|trans }}
                    </p>
                {% endif %}

                {# Pendant la génération, le contenu (ou l'état vide) cède la
                   place à un squelette de la même forme : pas de saut de
                   layout et l'utilisateur voit ce qui arrive. Bascule par
                   classe uniquement (cf. le bouton ci-dessus). #}
                <div data-loading="action(generate)|addClass(hidden)">
                {% if recap %}
                    {% set points = recap.attentionPoints %}
                    <div class="space-y-4" data-testid="dossier-recap-content">
                        <div class="space-y-1.5">
                            <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">{{ 'admin.dossiers.show.recap.sections.summary'|trans }}</p>
                            <p class="text-sm leading-relaxed text-pretty text-gray-700">{{ recap.summary }}</p>
                        </div>

                        {% if points is not empty %}
                            <div class="space-y-1.5 border-t border-neutral-100 pt-4">
                                <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">{{ 'admin.dossiers.show.recap.sections.attention'|trans }}</p>
                                <ul class="space-y-1.5">
                                    {% for point in points %}
                                        <li class="flex items-start gap-2 text-sm text-gray-700">
                                            {{ ux_icon('lucide:circle-alert', {class: 'mt-0.5 size-3.5 shrink-0 text-amber-500', 'aria-hidden': 'true'}) }}
                                            {{ point }}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {% if recap.nextAction %}
                            <div class="space-y-1.5 border-t border-neutral-100 pt-4">
                                <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">{{ 'admin.dossiers.show.recap.sections.nextAction'|trans }}</p>
                                <p class="text-sm font-medium text-gray-900">{{ recap.nextAction }}</p>
                            </div>
                        {% endif %}

                        {# flex : sans lui, le preflight met le SVG en display:block
                           et l'icône partirait seule sur sa ligne. #}
                        <p class="flex items-center gap-1.5 text-xs text-gray-400">
                            {{ ux_icon('lucide:clock', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                            <span>
                                {{ 'admin.dossiers.show.recap.generatedAt'|trans }}
                                {% if recap.generatedAt %}
                                    <span class="tabular-nums">{{ recap.generatedAt|format_datetime(pattern='dd.MM.yyyy HH:mm') }}</span>
                                {% endif %}
                                &middot; {{ 'admin.dossiers.show.recap.disclaimerShort'|trans }}
                            </span>
                        </p>
                    </div>
                {% else %}
                    {# Une seule bande, l'action est déjà dans le bouton du
                       titre : l'état vide se contente de la demander. #}
                    <p class="flex items-center gap-2 rounded-lg bg-neutral-50 px-3 py-2 text-xs text-gray-500" data-testid="dossier-recap-empty">
                        {{ ux_icon('lucide:sparkles', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                        <span>
                            {{ 'admin.dossiers.show.recap.emptyCta'|trans }}
                            <span class="text-gray-400">{{ 'admin.dossiers.show.recap.emptyHintCompact'|trans }}</span>
                        </span>
                    </p>
                {% endif %}
                </div>

                <div
                    data-loading="action(generate)|removeClass(hidden)"
                    class="hidden animate-pulse space-y-3"
                    aria-hidden="true"
                    data-testid="dossier-recap-skeleton"
                >
                    <div class="space-y-2">
                        <div class="h-2.5 w-full rounded-full bg-neutral-100"></div>
                        <div class="h-2.5 w-11/12 rounded-full bg-neutral-100"></div>
                        <div class="h-2.5 w-8/12 rounded-full bg-neutral-100"></div>
                    </div>
                    <div class="space-y-1.5">
                        <div class="flex items-center gap-2">
                            <span class="size-3.5 shrink-0 rounded-full bg-neutral-100"></span>
                            <span class="h-2.5 w-7/12 rounded-full bg-neutral-100"></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="size-3.5 shrink-0 rounded-full bg-neutral-100"></span>
                            <span class="h-2.5 w-5/12 rounded-full bg-neutral-100"></span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 rounded-lg bg-neutral-50 px-3 py-2.5">
                        <span class="size-3.5 shrink-0 rounded-full bg-neutral-200/70"></span>
                        <span class="h-2.5 w-6/12 rounded-full bg-neutral-200/70"></span>
                    </div>
                </div>
            </div>
        </div>
    </section>
    {% endif %}
</div>
