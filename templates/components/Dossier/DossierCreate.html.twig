{#
    Dossier:DossierCreate — "new dossier" modal on the admin dossiers list.
    A name + 1..4 person panels (max 2 tenants, 2 follow-up requests): white
    cards with a gray header band carrying the title, the primary-tenant tag
    (movable between tenants) and the remove action. Surface and spacing
    conventions mirror Admin:ContactCreate.
#}

{% macro chips(field, icons = {}) %}
    {# icons: optional map of choice value → ux_icon name (e.g. circle flags).
       Same chip vocabulary as the ContactProject qualification pills. #}
    <div role="radiogroup" aria-labelledby="{{ field.vars.id }}-label" class="mt-2 flex flex-wrap gap-2">
        {% for choice in field.children %}
            <label for="{{ choice.vars.id }}" class="flex cursor-pointer items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-gray-400 hover:text-gray-900 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5 has-[input:checked]:text-primary">
                <input
                    type="radio"
                    id="{{ choice.vars.id }}"
                    name="{{ choice.vars.full_name }}"
                    value="{{ choice.vars.value }}"
                    {% if choice.vars.checked %}checked{% endif %}
                    class="sr-only"
                />
                {% if icons[choice.vars.value] is defined %}
                    {# Les drapeaux sont ronds partout dans le BO. #}
                    {{ ux_icon(icons[choice.vars.value], {class: 'size-4 shrink-0' ~ (icons[choice.vars.value] starts with 'circle-flags:' ? ' rounded-full' : ''), 'aria-hidden': 'true'}) }}
                {% endif %}
                {{ choice.vars.label|trans }}
            </label>
        {% endfor %}
    </div>
    {% for error in field.vars.errors %}
        <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
    {% endfor %}
{% endmacro %}

{% macro input(field, label, type, required = true) %}
    {# Mêmes champs que la card personnes de la page détail (PersonsManager). #}
    {% set hasErrors = field.vars.errors|length > 0 %}
    <div class="min-w-0">
        <twig:Label for="{{ field.vars.id }}" class="text-gray-600">
            {{ label|trans }}
            {% if required %}<span class="text-red-600" aria-hidden="true">*</span>{% endif %}
        </twig:Label>
        <div class="mt-1.5">
            <input
                type="{{ type }}"
                id="{{ field.vars.id }}"
                name="{{ field.vars.full_name }}"
                value="{{ field.vars.value }}"
                {% if field.vars.attr.maxlength is defined %}maxlength="{{ field.vars.attr.maxlength }}"{% endif %}
                {% if field.vars.attr.placeholder is defined %}placeholder="{{ field.vars.attr.placeholder }}"{% endif %}
                {% if required %}required{% endif %}
                aria-invalid="{{ hasErrors ? 'true' : 'false' }}"
                class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
            >
            {% for error in field.vars.errors %}
                <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{# Même geste étoile que la card Personnes du détail : le principal porte
   l'étoile pleine dans le rond primaire, chaque autre locataire une étoile
   grise cliquable qui transfère le tag en un clic. #}
{% macro primaryControls(key, isTenant, isPrimary) %}
    {% if isPrimary %}
        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary" title="{{ 'admin.dossiers.create.person.primaryTag'|trans }}" role="img" aria-label="{{ 'admin.dossiers.create.person.primaryTag'|trans }}" data-testid="dossier-primary-tag">
            {{ ux_icon('lucide:star', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
        </span>
    {% elseif isTenant %}
        <button
            type="button"
            class="flex size-6 shrink-0 cursor-pointer items-center justify-center rounded-full text-gray-300 transition-colors duration-100 ease-out hover:bg-primary/5 hover:text-primary"
            data-action="live#action"
            data-live-action-param="choosePrimary"
            data-live-key-param="{{ key }}"
            title="{{ 'admin.dossiers.create.person.makePrimary'|trans }}"
            aria-label="{{ 'admin.dossiers.create.person.makePrimary'|trans }}"
            data-testid="dossier-primary-choose"
        >
            {{ ux_icon('lucide:star', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
        </button>
    {% endif %}
{% endmacro %}

{% import _self as ui %}

<div {{ attributes.defaults({class: 'shrink-0'}) }} data-testid="dossier-create">
    <twig:Button
        size="sm"
        data-action="live#action"
        data-live-action-param="openModal"
        data-testid="dossier-create-open"
    >
        <span class="flex items-center gap-2">
            {{ ux_icon('lucide:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'admin.dossiers.create.button'|trans }}
        </span>
    </twig:Button>

    {% if this.open %}
        {% set persons = form.persons %}
        {% set personCount = persons.children|length %}
        {% set maxPersons = constant('App\\Dossier\\Entity\\Dossier::MAX_PERSONS') %}
        {% set primaryKey = this.effectivePrimaryKey %}
        {% set tenantValue = constant('App\\Dossier\\Domain\\DossierPersonRole::TENANT').value %}
        {# Modale STATIQUE, sans animation d'entrée : le formulaire porte un
           data-model on(change) qui re-rend le composant modale ouverte — un
           modal-anim (attribut data-entered posé au runtime) serait effacé
           par le morph et la modale deviendrait invisible. Fermeture sans
           effet non plus, symétrique de l'ouverture (décision utilisateur) :
           instant-exit masque la modale au clic même, le retrait réel
           n'arrivant qu'au re-rendu live ~200 ms plus tard. #}
        <div
            class="fixed inset-0 z-50 flex items-center justify-center p-4"
            role="dialog"
            aria-modal="true"
            aria-labelledby="dossier-create-title"
            data-controller="modal-focus instant-exit"
            data-action="keydown.esc@window->instant-exit#run keydown.esc@window->live#action"
            data-live-action-param="closeModal"
            data-testid="dossier-create-modal"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="instant-exit#run live#action"
                data-live-action-param="closeModal"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <form
                class="relative max-h-[92vh] w-full max-w-3xl overflow-y-auto rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl"
                data-action="live#action:prevent"
                data-live-action-param="create"
                data-model="on(change)|*"
                novalidate
                autocomplete="off"
                data-testid="dossier-create-form"
            >
                <div class="space-y-3 rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3 pb-0">
                        <h2 id="dossier-create-title" class="text-lg font-semibold tracking-tight text-gray-900">{{ 'admin.dossiers.create.title'|trans }}</h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">{{ 'admin.dossiers.create.subtitle'|trans }}</p>
                    </div>

                    {# ── Formule visée : obligatoire, un dossier porte
                          toujours sa formule. ── #}
                    <section class="px-3" data-testid="dossier-create-offer">
                        <h3 class="mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                            {{ 'admin.dossiers.card.package.label'|trans }} <span class="text-red-600" aria-hidden="true">*</span>
                        </h3>
                        {# Deux cards sélectionnables (titre, prix, résumé) :
                           résumé orienté staff (qui fait les visites), pas le
                           texte marketing public; toggle-off en recliquant. #}
                        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                            {% for offerValue in ['accompagne', 'confie'] %}
                                {% set picked = this.offer == offerValue %}
                                <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-action-param="chooseOffer"
                                    data-live-offer-param="{{ offerValue }}"
                                    aria-pressed="{{ picked ? 'true' : 'false' }}"
                                    class="cursor-pointer rounded-xl border p-3.5 text-left transition-colors duration-100 ease-out {{ picked ? 'border-primary/40 bg-primary/5' : 'border-neutral-200 bg-white hover:border-gray-400' }}"
                                    data-testid="dossier-create-offer-{{ offerValue }}"
                                >
                                    <span class="flex items-center justify-between gap-2">
                                        <span class="flex items-center gap-1.5 text-sm font-medium {{ picked ? 'text-primary' : 'text-gray-900' }}">
                                            {{ ux_icon('lucide:badge-check', {class: 'size-4 shrink-0 transition-colors duration-100 ease-out ' ~ (picked ? 'text-primary' : 'text-gray-400'), 'aria-hidden': 'true'}) }}
                                            {{ ('contact.contactForm.offer.' ~ offerValue ~ '.title')|trans }}
                                        </span>
                                        <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold tabular-nums transition-colors duration-100 ease-out {{ picked ? 'bg-primary/10 text-primary' : 'bg-neutral-100 text-gray-600' }}">
                                            {{ ('contact.contactForm.offer.' ~ offerValue ~ '.price')|trans }}
                                        </span>
                                    </span>
                                    <span class="mt-1.5 block text-xs text-balance text-gray-500">
                                        {{ ('admin.dossiers.create.offer.' ~ offerValue ~ '.hint')|trans }}
                                    </span>
                                </button>
                            {% endfor %}
                        </div>
                        {% if this.offerMissing %}
                            <p class="mt-2 text-sm text-red-600" role="alert" data-testid="dossier-create-offer-error">{{ 'admin.dossiers.create.offer.required'|trans }}</p>
                        {% endif %}
                    </section>

                    <section data-testid="dossier-create-persons">
                        <div class="mb-3 flex items-baseline justify-between gap-4 px-3">
                            <h3 class="text-xs font-semibold tracking-wide text-gray-500 uppercase">
                                {{ 'admin.dossiers.create.persons.title'|trans }}
                            </h3>
                            <p class="text-xs text-gray-400 tabular-nums">
                                {{ 'admin.dossiers.create.persons.count'|trans({'%count%': personCount, '%max%': maxPersons}) }}
                            </p>
                        </div>

                        <div class="flex flex-col gap-1">
                            {% for personForm in persons %}
                                {% set key = personForm.vars.name %}
                                {% set isTenant = personForm.role.vars.value == tenantValue %}
                                {# The id keys the card for morphing (ignored phone widget and
                                   exit animations stay attached to the right person). #}
                                <article
                                    id="dossier-person-{{ key }}"
                                    class="animate-card-in overflow-hidden rounded-xl bg-white"
                                    data-controller="card-remove"
                                    data-card-remove-key-value="{{ key }}"
                                    data-testid="dossier-create-person"
                                >
                                    {# Même bandeau gris encastré que les cards
                                       personnes de la fiche dossier. #}
                                    <header class="m-2 mb-0 flex flex-wrap items-center justify-between gap-3 rounded-lg bg-neutral-50 px-3 py-2.5">
                                        {# Live heading: shows the person's name as soon as it is
                                           typed (the component re-renders on change), falls back
                                           to "Personne N" while empty. #}
                                        {% set fullName = ((personForm.firstName.vars.value ?: '') ~ ' ' ~ (personForm.lastName.vars.value ?: ''))|trim %}
                                        <div class="flex min-w-0 items-center gap-2">
                                            <p class="truncate text-sm font-semibold text-gray-900" data-testid="dossier-person-heading">
                                                {{ fullName ? fullName|title : 'admin.dossiers.create.person.heading'|trans({'%number%': loop.index}) }}
                                            </p>
                                            {{ ui.primaryControls(key, isTenant, isTenant and key == primaryKey) }}
                                        </div>
                                        {% if personCount > 1 %}
                                            <button
                                                type="button"
                                                class="inline-flex cursor-pointer items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-gray-400 transition-colors duration-100 ease-out hover:bg-red-50 hover:text-red-600"
                                                data-action="card-remove#remove"
                                                data-testid="dossier-create-remove-person"
                                            >
                                                {{ ux_icon('lucide:x', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                {{ 'admin.dossiers.create.person.remove'|trans }}
                                            </button>
                                        {% endif %}
                                    </header>

                                    <div class="flex flex-col gap-4 border-t border-gray-950/5 px-4 py-4">
                                        <div>
                                            <p id="{{ personForm.role.vars.id }}-label" class="text-sm text-gray-600">
                                                {{ 'admin.dossiers.create.person.role.label'|trans }}
                                                <span class="text-red-600" aria-hidden="true">*</span>
                                            </p>
                                            {{ ui.chips(personForm.role, {tenant: 'lucide:key-round', follow_up: 'lucide:bell'}) }}
                                        </div>

                                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                            {{ ui.input(personForm.firstName, 'admin.dossiers.create.person.firstName.label', 'text') }}
                                            {{ ui.input(personForm.lastName, 'admin.dossiers.create.person.lastName.label', 'text') }}
                                            {{ ui.input(personForm.email, 'admin.dossiers.create.person.email.label', 'email') }}
                                            <div class="min-w-0">
                                                <twig:Label for="{{ personForm.phone.vars.id }}" class="text-gray-600">
                                                    {{ 'admin.dossiers.create.person.phone.label'|trans }}
                                                </twig:Label>
                                                {# Same intl-tel-input widget as the public contact form.
                                                   data-live-ignore: the widget builds its own DOM around
                                                   the input — morphing must leave the zone alone (the
                                                   value still syncs to the model via the change event). #}
                                                <div
                                                    class="mt-1.5"
                                                    data-live-ignore
                                                    data-controller="phone-input"
                                                    data-phone-input-initial-country-value="fr"
                                                    data-phone-input-search-placeholder-value="{{ 'phoneInput.searchPlaceholder'|trans }}"
                                                >
                                                    <input
                                                        type="tel"
                                                        id="{{ personForm.phone.vars.id }}"
                                                        name="{{ personForm.phone.vars.full_name }}"
                                                        value="{{ personForm.phone.vars.value }}"
                                                        maxlength="30"
                                                        placeholder="6 12 34 56 78"
                                                        data-phone-input-target="input"
                                                        class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                                                    >
                                                </div>
                                                {% for error in personForm.phone.vars.errors %}
                                                    <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                                                {% endfor %}
                                            </div>
                                        </div>

                                        <div>
                                            <p id="{{ personForm.language.vars.id }}-label" class="text-sm text-gray-600">
                                                {{ 'admin.dossiers.create.person.language.label'|trans }}
                                                <span class="text-red-600" aria-hidden="true">*</span>
                                            </p>
                                            {{ ui.chips(personForm.language, {fr: 'circle-flags:fr', en: 'circle-flags:en'}) }}
                                        </div>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>

                        {% if personCount < maxPersons %}
                            <button
                                type="button"
                                class="mt-1 flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-xl border border-dashed border-gray-950/10 px-2 py-2.5 text-xs font-medium whitespace-nowrap text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                                data-action="live#action"
                                data-live-action-param="addPerson"
                                data-testid="dossier-create-add-person"
                            >
                                {{ ux_icon('lucide:user-plus', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.dossiers.create.persons.add'|trans }}
                            </button>
                        {% endif %}

                        {% for error in persons.vars.errors %}
                            <p class="mt-3 text-sm text-red-600" role="alert" data-testid="dossier-create-persons-error">{{ error.message }}</p>
                        {% endfor %}
                    </section>

                    <div class="flex items-center justify-end gap-4 p-3 pt-0">
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="closeModal"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="dossier-create-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        {# data-loading disables the button while `create` runs — a
                           double-click would otherwise insert two dossiers. #}
                        <button
                            type="submit"
                            data-loading="action(create)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60"
                            data-testid="dossier-create-submit"
                        >
                            <span data-loading="action(create)|addClass(hidden)" class="flex items-center gap-2">
                                {{ ux_icon('lucide:plus', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.dossiers.create.submit'|trans }}
                            </span>
                            <span data-loading="action(create)|removeClass(hidden)" class="hidden flex items-center gap-2">
                                {{ ux_icon('lucide:loader-circle', {class: 'size-4 shrink-0 animate-spin', 'aria-hidden': 'true'}) }}
                                {{ 'admin.dossiers.create.submitting'|trans }}
                            </span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    {% endif %}
</div>
