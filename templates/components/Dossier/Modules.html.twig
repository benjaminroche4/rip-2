{# Cards modules du détail dossier : même coque repliable que la
   Recherche. Chaque module correspond à une étape du parcours et reste
   verrouillé tant que l'étape précédente n'est pas validée (même calcul que
   la barre d'onglets). Composant live : se déverrouille dès les événements
   "dossier-search:changed" / "dossier-documents:changed". #}
        <div {{ attributes.defaults({class: 'space-y-6'}) }} data-testid="dossier-show-modules">
    {% for module in [{key: 'file'}, {key: 'visit'}, {key: 'payment'}] %}
        {# data-tab-panel : visibilité pilotée par les onglets de la page
           (attribut rendu côté serveur, donc morph-proof). #}
        <section class="rounded-3xl border border-neutral-200 bg-white p-2" data-tab-panel="{{ module.key }}" data-testid="dossier-module-card">
            {% set unlocked = this.isModuleUnlocked(module.key) %}
            {% if unlocked %}
                {% set dossierVisits = module.key == 'visit' ? this.dossierVisits : null %}
                {# Repli piloté par la prop live : sans ça, le morph refermerait
                   la card ouverte au premier changement de statut. #}
                <details {{ module.key in this.openModules ? 'open' }} class="group details-animated rounded-2xl bg-neutral-50 p-2"
                    {% if module.key == 'file' %}data-controller="file-preview" data-action="keydown.esc@window->file-preview#close"{% endif %}>
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between gap-4 p-3 [&::-webkit-details-marker]:hidden"
                        data-action="live#action"
                        data-live-action-param="toggleModule"
                        data-live-module-param="{{ module.key }}"
                    >
                        <div class="min-w-0">
                            <h2 class="font-medium text-gray-900">{{ ('admin.dossiers.show.modules.' ~ module.key ~ '.title')|trans }}</h2>
                            <p class="mt-0.5 text-xs text-gray-500">{{ ('admin.dossiers.show.modules.' ~ module.key ~ '.description')|trans }}</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            {% if module.key == 'file' %}
                                {% set pieceCounts = this.pieceCounts %}
                                {% if pieceCounts.total > 0 %}
                                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium tabular-nums {{ pieceCounts.deposited == pieceCounts.total ? 'bg-green-50 text-green-700' : 'bg-neutral-100 text-gray-600' }}" data-testid="module-file-counter">
                                        {{ 'admin.dossiers.show.modules.file.counter'|trans({'%deposited%': pieceCounts.deposited, '%total%': pieceCounts.total}) }}
                                    </span>
                                {% endif %}
                            {% elseif module.key == 'visit' and dossierVisits.upcoming|length > 0 %}
                                <span class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 tabular-nums" data-testid="module-visit-counter">
                                    {{ 'admin.dossiers.show.modules.visit.counter'|trans({'%count%': dossierVisits.upcoming|length}) }}
                                </span>
                            {% endif %}
                            {{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-gray-400 transition-transform duration-200 group-open:rotate-180', 'aria-hidden': 'true'}) }}
                        </div>
                    </summary>
                    {% if module.key == 'file' %}
                        {# Un bloc par locataire : bouton de demande de pièces
                           + tableau des pièces demandées et leur statut. #}
                        {% if this.lastSentTo %}
                            <p class="mt-1 flex items-center gap-1.5 px-3 py-2 text-xs font-medium text-green-700" data-testid="module-file-sent">
                                {{ ux_icon('lucide:mail-check', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.dossiers.show.modules.file.sent'|trans({'%email%': this.lastSentTo}) }}
                            </p>
                        {% endif %}
                        <ul class="mt-1 flex flex-col gap-1" role="list">
                            {% for tenant in this.tenants %}
                                <li class="bg-white px-5 py-4 first:rounded-t-xl last:rounded-b-xl" data-testid="module-file-tenant">
                                    <div class="flex items-center justify-between gap-3">
                                        <p class="text-sm font-medium text-gray-900">{{ tenant.name }}</p>
                                        <div class="flex shrink-0 items-center gap-2">
                                            {# Relance : renvoie l'email pour les pièces encore
                                               attendues (demandées ou refusées), sans repasser
                                               par la modal de sélection. #}
                                            {% set pendingPieces = tenant.documents|filter(d => d.status in ['requested', 'refused']) %}
                                            {% if pendingPieces|length > 0 %}
                                                <button
                                                    type="button"
                                                    data-action="live#action"
                                                    data-live-action-param="askResend"
                                                    data-live-key-param="{{ tenant.id }}"
                                                    class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary disabled:cursor-default disabled:opacity-60"
                                                    title="{{ 'admin.dossiers.show.modules.file.resendTitle'|trans }}"
                                                    data-testid="module-file-resend"
                                                >
                                                    {{ ux_icon('lucide:bell-ring', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                    {{ 'admin.dossiers.show.modules.file.resend'|trans }}
                                                </button>
                                            {% endif %}
                                            <button
                                                type="button"
                                                data-action="live#action"
                                                data-live-action-param="openPicker"
                                                data-live-key-param="{{ tenant.id }}"
                                                class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                                                data-testid="module-file-request"
                                            >
                                                {{ ux_icon('lucide:list-checks', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                {{ 'admin.dossiers.show.modules.file.select'|trans }}
                                            </button>
                                        </div>
                                    </div>
                                    {% if tenant.documents is not empty %}
                                        <table class="mt-3 w-full text-sm">
                                            <thead>
                                                <tr class="text-left text-xs text-gray-400">
                                                    <th scope="col" class="pb-2 font-medium">{{ 'admin.dossiers.show.modules.file.table.piece'|trans }}</th>
                                                    <th scope="col" class="pb-2 font-medium">{{ 'admin.dossiers.show.modules.file.table.requestedAt'|trans }}</th>
                                                    <th scope="col" class="pb-2 text-right font-medium">{{ 'admin.dossiers.show.modules.file.table.status'|trans }}</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-950/5">
                                                {% for document in tenant.documents %}
                                                    <tr data-testid="module-file-document">
                                                        <td class="py-2 pr-4">
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="font-medium text-gray-900">{{ document.typeLabelKey|trans }}</span>
                                                                <button
                                                                    type="button"
                                                                    data-action="live#action"
                                                                    data-live-action-param="editDescription"
                                                                    data-live-key-param="{{ document.id }}"
                                                                    title="{{ 'admin.dossiers.show.modules.file.pieceDescription.edit'|trans }}"
                                                                    class="cursor-pointer rounded p-0.5 text-gray-300 transition-colors duration-100 ease-out hover:text-gray-600"
                                                                    data-testid="module-file-description-edit"
                                                                >
                                                                    {{ ux_icon('lucide:pencil', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                                                </button>
                                                                {# Retirer la demande : la pièce disparaît aussi du dépôt client. #}
                                                                <button
                                                                    type="button"
                                                                    data-action="live#action"
                                                                    data-live-action-param="askDeletePiece"
                                                                    data-live-key-param="{{ document.id }}"
                                                                    title="{{ 'admin.dossiers.show.modules.file.deletePiece'|trans }}"
                                                                    class="cursor-pointer rounded p-0.5 text-gray-300 transition-colors duration-100 ease-out hover:text-red-600"
                                                                    data-testid="module-piece-delete"
                                                                >
                                                                    {{ ux_icon('lucide:trash-2', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                                                </button>
                                                            </div>
                                                            {% if this.editingDescriptionId == document.id %}
                                                                <div class="mt-1.5 flex items-center gap-1.5">
                                                                    <input
                                                                        type="text"
                                                                        maxlength="500"
                                                                        data-model="norender|descriptionDraft"
                                                                        data-action="keydown.enter->live#action:prevent"
                                                                        data-live-action-param="saveDescription"
                                                                        value="{{ this.descriptionDraft }}"
                                                                        placeholder="{{ 'admin.dossiers.show.modules.file.pieceDescription.placeholder'|trans }}"
                                                                        class="w-full rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                                                                        data-testid="module-file-description-input"
                                                                    >
                                                                    <button type="button" data-action="live#action" data-live-action-param="saveDescription" data-loading="action(saveDescription)|addAttribute(disabled)" class="shrink-0 cursor-pointer rounded-lg bg-primary p-1.5 text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60" title="{{ 'admin.dossiers.show.persons.save'|trans }}" data-testid="module-file-description-save">
                                                                        {{ ux_icon('lucide:check', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(saveDescription)|addClass(hidden)'}) }}
                                                                        <twig:Spinner class="hidden size-3.5 shrink-0" data-loading="action(saveDescription)|removeClass(hidden)" />
                                                                    </button>
                                                                    <button type="button" data-action="live#action" data-live-action-param="cancelDescription" class="shrink-0 cursor-pointer rounded-lg p-1.5 text-gray-400 transition-colors duration-100 ease-out hover:text-gray-700" title="{{ 'admin.dossiers.create.cancel'|trans }}">
                                                                        {{ ux_icon('lucide:x', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                                    </button>
                                                                </div>
                                                            {% elseif document.description %}
                                                                <p class="mt-0.5 text-xs text-gray-500" data-testid="module-file-description">{{ document.description }}</p>
                                                            {% endif %}
                                                        </td>
                                                        <td class="py-2 pr-4 text-gray-600 tabular-nums">{{ document.requestedAt ? document.requestedAt|format_datetime(pattern='dd.MM.yyyy') : '-' }}</td>
                                                        <td class="py-2 text-right">
                                                            {# Statut de vérification : badge dropdown (demandée,
                                                               déposée, validée, refusée). #}
                                                            {% set statusStyles = {
                                                                requested: {badge: 'bg-gray-100 text-gray-500 hover:bg-gray-200', icon: 'lucide:clock'},
                                                                received: {badge: 'bg-blue-50 text-blue-700 hover:bg-blue-100', icon: 'lucide:inbox'},
                                                                validated: {badge: 'bg-green-50 text-green-700 hover:bg-green-100', icon: 'lucide:check'},
                                                                refused: {badge: 'bg-red-50 text-red-700 hover:bg-red-100', icon: 'lucide:x'},
                                                            } %}
                                                            <details
                                                                class="relative inline-block text-left"
                                                                data-controller="details-dropdown"
                                                                data-action="click@window->details-dropdown#closeOnOutside keydown.esc@window->details-dropdown#close"
                                                            >
                                                                <summary
                                                                    class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium transition-colors duration-100 ease-out [&::-webkit-details-marker]:hidden {{ statusStyles[document.status].badge }}"
                                                                    data-testid="module-file-status"
                                                                >
                                                                    {{ ux_icon(statusStyles[document.status].icon, {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                                                    {{ document.statusLabelKey|trans }}
                                                                    {{ ux_icon('lucide:chevron-down', {class: 'size-3 shrink-0 opacity-60', 'aria-hidden': 'true'}) }}
                                                                </summary>
                                                                <div class="absolute right-0 z-10 mt-2 w-48 rounded-xl border border-neutral-200 bg-white p-1 text-left shadow-lg">
                                                                    {% for statusValue, style in statusStyles %}
                                                                        <button
                                                                            type="button"
                                                                            data-action="live#action details-dropdown#close"
                                                                            data-live-action-param="setStatus"
                                                                            data-live-key-param="{{ document.id }}"
                                                                            data-live-status-param="{{ statusValue }}"
                                                                            class="flex w-full cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-left text-xs transition-colors duration-100 ease-out {{ statusValue == document.status ? 'bg-neutral-100 font-medium text-gray-900' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                                                                            data-testid="module-file-status-choice"
                                                                        >
                                                                            {{ ux_icon(style.icon, {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                                                            <span class="min-w-0 flex-1 truncate">{{ ('admin.dossiers.show.modules.file.status.' ~ statusValue)|trans }}</span>
                                                                            {% if statusValue == document.status %}
                                                                                {{ ux_icon('lucide:check', {class: 'size-3.5 shrink-0 text-primary', 'aria-hidden': 'true'}) }}
                                                                            {% endif %}
                                                                        </button>
                                                                    {% endfor %}
                                                                </div>
                                                            </details>
                                                        </td>
                                                    </tr>
                                                    {% if document.status == 'refused' and document.refusalReason %}
                                                        <tr class="border-t-0!">
                                                            <td colspan="3" class="pb-2">
                                                                <p class="text-xs text-red-600" data-testid="module-file-refusal-reason">{{ document.refusalReason }}</p>
                                                            </td>
                                                        </tr>
                                                    {% endif %}
                                                    {% if document.files is not empty %}
                                                        <tr class="border-t-0!">
                                                            <td colspan="3" class="pb-2">
                                                                <ul class="space-y-1">
                                                                    {% for file in document.files %}
                                                                        <li class="flex items-center gap-2 text-xs text-gray-600" data-testid="module-file-uploaded">
                                                                            {{ ux_icon('lucide:paperclip', {class: 'size-3 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                                                            <a href="{{ path('admin_dossier_document_file', {adminPrefix: this.adminPrefix, reference: this.reference, id: file.id}) }}"
                                                                               target="_blank" rel="noopener noreferrer"
                                                                               class="truncate underline decoration-gray-300 underline-offset-2 transition-colors duration-100 ease-out hover:text-gray-900"
                                                                               data-action="file-preview#open"
                                                                               data-file-preview-name="{{ document.typeLabelKey|trans }}"
                                                                               data-file-preview-type="{{ file.mimeType }}"
                                                                               data-testid="module-file-download">
                                                                                {{ file.name }}
                                                                            </a>
                                                                            <span class="shrink-0 text-gray-400 tabular-nums">{{ file.uploadedAt ? file.uploadedAt|format_datetime(pattern='dd.MM.yyyy HH:mm') : '' }}</span>
                                                                            <button
                                                                                type="button"
                                                                                data-action="live#action"
                                                                                data-live-action-param="askDeleteFile"
                                                                                data-live-key-param="{{ file.id }}"
                                                                                title="{{ 'admin.dossiers.show.modules.file.deleteFile'|trans }}"
                                                                                class="ml-auto shrink-0 cursor-pointer rounded p-0.5 text-gray-400 transition-colors duration-100 ease-out hover:text-red-600"
                                                                                data-testid="module-file-delete"
                                                                            >
                                                                                {{ ux_icon('lucide:trash-2', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                                            </button>
                                                                        </li>
                                                                    {% endfor %}
                                                                </ul>
                                                            </td>
                                                        </tr>
                                                    {% endif %}
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                        {# Lien public de dépôt, en bas de card : existe dès
                           qu'une demande de pièces a été envoyée. #}
                        {% set depositUrl = this.depositUrl %}
                        {% if depositUrl %}
                            <div
                                class="mt-1 flex items-center justify-between gap-3 rounded-xl bg-white px-5 py-3"
                                data-controller="copy-link"
                                data-copy-link-text-value="{{ depositUrl }}"
                                data-copy-link-copied-label-value="{{ 'admin.dossiers.show.modules.file.depositLink.copied'|trans }}"
                                data-testid="module-file-deposit-link"
                            >
                                <div class="min-w-0">
                                    <p class="text-xs font-medium text-gray-900">{{ 'admin.dossiers.show.modules.file.depositLink.label'|trans }}</p>
                                    <a href="{{ depositUrl }}" target="_blank" rel="noopener noreferrer" class="block truncate text-xs text-gray-500 underline decoration-gray-300 underline-offset-2 transition-colors duration-100 ease-out hover:text-gray-900">{{ depositUrl }}</a>
                                </div>
                                <div class="flex shrink-0 items-center gap-2">
                                    <button
                                        type="button"
                                        data-action="copy-link#copy"
                                        class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                                        data-testid="module-file-deposit-copy"
                                    >
                                        {{ ux_icon('lucide:copy', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        <span data-copy-link-target="label">{{ 'admin.dossiers.show.modules.file.depositLink.copy'|trans }}</span>
                                    </button>
                                    {% if this.hasDepositedFiles %}
                                        <a href="{{ path('admin_dossier_documents_zip', {adminPrefix: this.adminPrefix, reference: this.reference}) }}"
                                           class="flex items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                                           data-testid="module-file-zip"
                                        >
                                            {{ ux_icon('lucide:folder-archive', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                            {{ 'admin.dossiers.show.modules.file.downloadZip'|trans }}
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                        <twig:FilePreview />
                    {% elseif module.key == 'visit' %}
                        {# Visites du dossier : à venir puis passées; chaque
                           ligne ouvre la fiche visite si l'utilisateur a
                           accès à la section Visites. #}
                        {% set canOpenVisit = this.adminPrefix != '' and is_granted('ROLE_SECTION_VISITS') %}
                        {% set moduleVisits = dossierVisits.upcoming|merge(dossierVisits.past) %}
                        {% if moduleVisits is empty %}
                            <p class="mt-1 rounded-xl bg-white px-5 py-6 text-sm text-gray-400" data-testid="module-visit-empty">
                                {{ 'admin.dossiers.show.modules.visit.empty'|trans }}
                            </p>
                        {% else %}
                            <ul class="mt-1 flex flex-col gap-1" role="list">
                                {% for visit in moduleVisits %}
                                    {% set rowTag = canOpenVisit ? 'a' : 'div' %}
                                    <li class="bg-white first:rounded-t-xl last:rounded-b-xl" data-testid="module-visit-row">
                                        <{{ rowTag }}
                                            {% if canOpenVisit %}href="{{ path('admin_visit_show', {adminPrefix: this.adminPrefix, id: visit.id}) }}"{% endif %}
                                            class="group/visit flex items-center gap-4 px-5 py-3.5 {{ canOpenVisit ? 'transition-colors duration-100 ease-out hover:bg-neutral-50' }}"
                                        >
                                            <div class="min-w-0 flex-1">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <p class="text-sm font-medium text-gray-900 tabular-nums">{{ visit.scheduledAt|format_datetime(pattern='EEE d MMM, HH:mm')|capitalize }}</p>
                                                    <span class="text-xs text-gray-400">{{ visit.type.labelKey|trans }}</span>
                                                    <span class="flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium {{ visit.status.badgeClasses }}" data-testid="module-visit-status">
                                                        {{ ux_icon(visit.status.icon, {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                                        {{ visit.status.labelKey|trans }}
                                                    </span>
                                                </div>
                                                <p class="mt-0.5 truncate text-xs text-gray-500">{{ visit.address }}</p>
                                            </div>
                                            {% if canOpenVisit %}
                                                {{ ux_icon('lucide:chevron-right', {class: 'size-4 shrink-0 text-gray-300 transition-colors duration-100 ease-out group-hover/visit:text-gray-500', 'aria-hidden': 'true'}) }}
                                            {% endif %}
                                        </{{ rowTag }}>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if canOpenVisit %}
                            <div class="mt-1 flex justify-end rounded-xl bg-white px-5 py-3">
                                <a
                                    href="{{ path('admin_visit_new', {adminPrefix: this.adminPrefix}) }}"
                                    class="flex items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                                    data-testid="module-visit-plan"
                                >
                                    {{ ux_icon('lucide:calendar-plus', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.dossiers.show.modules.visit.plan'|trans }}
                                </a>
                            </div>
                        {% endif %}
                    {% else %}
                        <p class="mt-1 rounded-xl bg-white px-5 py-6 text-sm text-gray-400">
                            {{ 'admin.dossiers.show.modules.comingSoon'|trans }}
                        </p>
                    {% endif %}
                </details>
            {% else %}
                {% set moduleTitle = ('admin.dossiers.show.modules.' ~ module.key ~ '.title')|trans %}
                {% set moduleDescription = ('admin.dossiers.show.modules.' ~ module.key ~ '.description')|trans %}
                <div class="rounded-2xl bg-neutral-50 p-2" data-testid="dossier-module-locked">
                    <div class="flex items-center justify-between gap-4 p-3">
                        <div class="min-w-0">
                            <h2 class="font-medium text-gray-900">{{ moduleTitle }}</h2>
                            <p class="mt-0.5 text-xs text-gray-500">{{ moduleDescription }}</p>
                        </div>
                        {# Texte complet du verrou en tooltip. #}
                        {% set blockingStep = this.blockingStepLabel(module.key) %}
                        <span
                            class="flex shrink-0 items-center gap-1.5 rounded-full bg-gray-100 py-1 pr-2.5 pl-1.5 text-xs font-medium text-gray-500"
                            title="{{ blockingStep ? 'admin.dossiers.show.steps.lockedHint'|trans({'%step%': blockingStep|trans}) : 'admin.dossiers.show.modules.locked'|trans }}"
                        >
                            {{ ux_icon('lucide:lock', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                            {{ 'admin.dossiers.show.modules.lockedShort'|trans }}
                        </span>
                    </div>
                </div>
            {% endif %}
        </section>
    {% endfor %}

    {# Modale de demande de pièces : étape 1 checkboxes des pièces, étape 2
       choix du destinataire de l'email + confirmation d'envoi. #}
    {% if this.pickerId is not null %}
        {% set pickerTenant = null %}
        {% for tenant in this.tenants %}
            {% if tenant.id == this.pickerId %}{% set pickerTenant = tenant %}{% endif %}
        {% endfor %}
        {% set checkboxClass = 'peer size-4 inline-block align-middle accent-primary rounded-sm border border-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:ring-primary/60 focus:outline-primary/80 checked:bg-primary checked:border-primary' %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-file-picker-title"
            data-controller="modal-focus modal-anim"
            data-action="keydown.esc@window->modal-anim#out keydown.esc@window->live#action"
            data-live-action-param="closePicker"
            data-testid="module-file-picker"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="modal-anim#out live#action"
                data-live-action-param="closePicker"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative max-h-[92vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-file-picker-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.requestTitle'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ (this.pickerStep == 'select'
                                ? 'admin.dossiers.show.modules.file.requestSubtitle'
                                : 'admin.dossiers.show.modules.file.recipientSubtitle')|trans({'%name%': pickerTenant ? pickerTenant.name : ''}) }}
                        </p>
                    </div>
                    <div class="space-y-5 rounded-xl bg-white px-5 py-4">

                        {% if this.pickerStep == 'select' %}
                            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2" data-testid="module-file-types">
                                {% for type in this.documentTypes %}
                                    <label class="flex cursor-pointer items-center gap-2.5 rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-gray-400 hover:text-gray-900 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5 has-[input:checked]:text-primary">
                                        <input
                                            type="checkbox"
                                            value="{{ type.value }}"
                                            data-model="norender|selectedTypes[]"
                                            {% if type.value in this.selectedTypes %}checked{% endif %}
                                            class="{{ checkboxClass }}"
                                            data-testid="module-file-type-checkbox"
                                        >
                                        {{ type.labelKey|trans }}
                                    </label>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="flex flex-col gap-2" role="radiogroup" data-testid="module-file-recipients">
                                <p class="text-sm text-gray-600">{{ 'admin.dossiers.show.modules.file.sendTo'|trans }}</p>
                                {% for recipient in this.recipients %}
                                    <label class="flex cursor-pointer items-center gap-2.5 rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 transition-colors duration-100 ease-out hover:border-gray-400 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5">
                                        <input
                                            type="radio"
                                            name="module-file-recipient"
                                            value="{{ recipient.id }}"
                                            data-model="norender|recipientId"
                                            {% if this.recipientId == recipient.id %}checked{% endif %}
                                            class="peer sr-only"
                                        >
                                        <span class="min-w-0 flex-1">
                                            <span class="block truncate text-sm font-medium text-gray-900">
                                                {{ recipient.name|title }}
                                                {% if recipient.primary %}
                                                    <span class="ml-1 rounded-full bg-primary/5 px-2 py-0.5 text-[11px] font-medium text-primary">{{ 'admin.dossiers.create.person.primaryTag'|trans }}</span>
                                                {% endif %}
                                            </span>
                                            <span class="block truncate text-xs text-gray-500">{{ recipient.email }}</span>
                                        </span>
                                        {{ ux_icon('lucide:check', {class: 'size-4 shrink-0 text-primary opacity-0 transition-opacity duration-100 peer-checked:opacity-100', 'aria-hidden': 'true'}) }}
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {% if this.pickerError %}
                            <p class="text-sm text-red-600" role="alert" data-testid="module-file-picker-error">{{ this.pickerError|trans }}</p>
                        {% endif %}

                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        {% if this.pickerStep == 'select' %}
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="closePicker"
                                class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            >
                                {{ 'admin.dossiers.create.cancel'|trans }}
                            </button>
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="pickerNext"
                                class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90"
                                data-testid="module-file-next"
                            >
                                {{ 'admin.dossiers.show.modules.file.next'|trans }}
                                {{ ux_icon('lucide:arrow-right', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                            </button>
                        {% else %}
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="pickerBack"
                                class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                                data-testid="module-file-back"
                            >
                                {{ 'admin.dossiers.show.modules.file.back'|trans }}
                            </button>
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="sendRequest"
                                data-loading="action(sendRequest)|addAttribute(disabled)"
                                class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60"
                                data-testid="module-file-send"
                            >
                                <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(sendRequest)|removeClass(hidden)" />
                                {{ ux_icon('lucide:send', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(sendRequest)|addClass(hidden)'}) }}
                                {{ 'admin.dossiers.show.modules.file.send'|trans }}
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Modal de relance : choix de l'email qui reçoit le rappel. ─────── #}
    {% if this.resendingId is not null %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-file-resend-title"
            data-controller="modal-focus modal-anim"
            data-action="keydown.esc@window->modal-anim#out keydown.esc@window->live#action"
            data-live-action-param="cancelResend"
            data-testid="module-file-resend-modal"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="modal-anim#out live#action"
                data-live-action-param="cancelResend"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-file-resend-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.resendModal.title'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ 'admin.dossiers.show.modules.file.resendModal.text'|trans }}
                        </p>
                    </div>
                    <div class="space-y-5 rounded-xl bg-white px-5 py-4">
                        {# Plusieurs personnes peuvent être relancées d'un coup. #}
                        <div class="flex flex-col gap-2" role="group" data-testid="module-file-resend-recipients">
                            {% for recipient in this.recipients %}
                                <label class="flex cursor-pointer items-center gap-2.5 rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 transition-colors duration-100 ease-out hover:border-gray-400 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5">
                                    <input
                                        type="checkbox"
                                        value="{{ recipient.id }}"
                                        data-model="norender|resendRecipientIds[]"
                                        {% if recipient.id in this.resendRecipientIds %}checked{% endif %}
                                        class="accent-primary"
                                        data-testid="module-file-resend-recipient"
                                    >
                                    <span class="min-w-0">
                                        <span class="block truncate text-sm font-medium text-gray-900">{{ recipient.name|title }}</span>
                                        <span class="block truncate text-xs text-gray-500">{{ recipient.email }}</span>
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                        {% if this.resendError %}
                            <p class="text-sm text-red-600" role="alert" data-testid="module-file-resend-error">{{ this.resendError|trans }}</p>
                        {% endif %}
                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        <button
                            type="button"
                            data-action="modal-anim#out live#action"
                            data-live-action-param="cancelResend"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="module-file-resend-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="modal-anim#out live#action"
                            data-live-action-param="confirmResend"
                            data-loading="action(confirmResend)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60"
                            data-testid="module-file-resend-confirm"
                        >
                            <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(confirmResend)|removeClass(hidden)" />
                            {{ ux_icon('lucide:send', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(confirmResend)|addClass(hidden)'}) }}
                            {{ 'admin.dossiers.show.modules.file.resendModal.confirm'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Modal de confirmation de retrait d'une pièce demandée. ────────── #}
    {% if this.confirmDeletePieceId is not null %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-piece-delete-title"
            data-controller="modal-focus modal-anim"
            data-action="keydown.esc@window->modal-anim#out keydown.esc@window->live#action"
            data-live-action-param="cancelDeletePiece"
            data-testid="module-piece-delete-modal"
        >
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="modal-anim#out live#action"
                data-live-action-param="cancelDeletePiece"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-piece-delete-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.deletePieceConfirm.title'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ 'admin.dossiers.show.modules.file.deletePieceConfirm.text'|trans }}
                        </p>
                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        <button
                            type="button"
                            data-action="modal-anim#out live#action"
                            data-live-action-param="cancelDeletePiece"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="module-piece-delete-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="modal-anim#out live#action"
                            data-live-action-param="deletePiece"
                            data-live-key-param="{{ this.confirmDeletePieceId }}"
                            data-loading="action(deletePiece)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-red-700 disabled:cursor-default disabled:opacity-60"
                            data-testid="module-piece-delete-confirm"
                        >
                            <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(deletePiece)|removeClass(hidden)" />
                            {{ ux_icon('lucide:trash-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(deletePiece)|addClass(hidden)'}) }}
                            {{ 'admin.dossiers.show.modules.file.deletePieceConfirm.confirm'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Modal de confirmation de suppression d'un fichier déposé. ─────── #}
    {% if this.confirmDeleteFileId is not null %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-file-delete-title"
            data-controller="modal-focus modal-anim"
            data-action="keydown.esc@window->modal-anim#out keydown.esc@window->live#action"
            data-live-action-param="cancelDeleteFile"
            data-testid="module-file-delete-modal"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="modal-anim#out live#action"
                data-live-action-param="cancelDeleteFile"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-file-delete-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.deleteFileConfirm.title'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ 'admin.dossiers.show.modules.file.deleteFileConfirm.text'|trans }}
                        </p>
                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        <button
                            type="button"
                            data-action="modal-anim#out live#action"
                            data-live-action-param="cancelDeleteFile"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="module-file-delete-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="modal-anim#out live#action"
                            data-live-action-param="deleteFile"
                            data-live-key-param="{{ this.confirmDeleteFileId }}"
                            data-loading="action(deleteFile)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-red-700 disabled:cursor-default disabled:opacity-60"
                            data-testid="module-file-delete-confirm"
                        >
                            <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(deleteFile)|removeClass(hidden)" />
                            {{ ux_icon('lucide:trash-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(deleteFile)|addClass(hidden)'}) }}
                            {{ 'admin.dossiers.show.modules.file.deleteFileConfirm.confirm'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Modal de refus : motif optionnel + email au locataire. ────────── #}
    {% if this.refusingId is not null %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-file-refusal-title"
            data-controller="modal-focus modal-anim"
            data-action="keydown.esc@window->modal-anim#out keydown.esc@window->live#action"
            data-live-action-param="cancelRefusal"
            data-testid="module-file-refusal"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="modal-anim#out live#action"
                data-live-action-param="cancelRefusal"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-file-refusal-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.refuse.title'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ 'admin.dossiers.show.modules.file.refuse.text'|trans }}
                        </p>
                    </div>
                    <div class="space-y-5 rounded-xl bg-white px-5 py-4">
                        <div>
                            <label for="module-file-refusal-reason" class="text-sm text-gray-600">{{ 'admin.dossiers.show.modules.file.refuse.reasonLabel'|trans }}</label>
                            <textarea
                                id="module-file-refusal-reason"
                                rows="3"
                                maxlength="500"
                                data-model="norender|refusalReason"
                                placeholder="{{ 'admin.dossiers.show.modules.file.refuse.reasonPlaceholder'|trans }}"
                                class="mt-1.5 w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                                data-testid="module-file-refusal-input"
                            >{{ this.refusalReason }}</textarea>
                        </div>
                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        <button
                            type="button"
                            data-action="modal-anim#out live#action"
                            data-live-action-param="cancelRefusal"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="module-file-refusal-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="modal-anim#out live#action"
                            data-live-action-param="confirmRefusal"
                            data-loading="action(confirmRefusal)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-red-700 disabled:cursor-default disabled:opacity-60"
                            data-testid="module-file-refusal-confirm"
                        >
                            <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(confirmRefusal)|removeClass(hidden)" />
                            {{ ux_icon('lucide:x', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(confirmRefusal)|addClass(hidden)'}) }}
                            {{ 'admin.dossiers.show.modules.file.refuse.confirm'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
