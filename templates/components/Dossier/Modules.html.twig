{# Cards modules du détail dossier : même coque repliable que la
   Recherche. Chaque module correspond à une étape du parcours et reste
   verrouillé tant que l'étape précédente n'est pas validée (même calcul que
   la barre d'onglets). Composant live : se déverrouille dès les événements
   "dossier-search:changed" / "dossier-documents:changed". #}
{# ── Briques de la liste des pièces (titre + gestes, date, refus, chips
      de fichiers, pastille et badge de statut). #}
{% macro pieceTitle(document, editingDescriptionId, descriptionDraft) %}
    <div class="flex items-center gap-1.5">
        <span class="text-sm font-medium text-gray-900">{{ document.typeLabelKey|trans }}</span>
        {# Retirer la demande : la pièce disparaît aussi du dépôt client. #}
        <button
            type="button"
            data-action="live#action"
            data-live-action-param="askDeletePiece"
            data-live-key-param="{{ document.id }}"
            title="{{ 'admin.dossiers.show.modules.file.deletePiece'|trans }}"
            class="cursor-pointer rounded p-0.5 text-gray-300 transition duration-100 ease-out hover:text-red-600 sm:opacity-0 sm:group-hover/piece:opacity-100 sm:focus-visible:opacity-100"
            data-testid="module-piece-delete"
        >
            {{ ux_icon('lucide:trash-2', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
        </button>
    </div>
    {% if editingDescriptionId == document.id %}
        <div class="mt-1.5 flex items-center gap-1.5">
            <input
                type="text"
                maxlength="500"
                data-model="norender|descriptionDraft"
                data-action="keydown.enter->live#action:prevent"
                data-live-action-param="saveDescription"
                value="{{ descriptionDraft }}"
                placeholder="{{ 'admin.dossiers.show.modules.file.pieceDescription.placeholder'|trans }}"
                class="w-full rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                data-testid="module-file-description-input"
            >
            <button type="button" data-action="live#action" data-live-action-param="saveDescription" data-loading="action(saveDescription)|addAttribute(disabled)" class="shrink-0 cursor-pointer rounded-lg bg-primary p-1.5 text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60" title="{{ 'admin.dossiers.show.persons.save'|trans }}" data-testid="module-file-description-save">
                {{ ux_icon('lucide:check', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(saveDescription)|addClass(hidden)'}) }}
                <twig:Spinner class="hidden size-3.5 shrink-0" data-loading="action(saveDescription)|removeClass(hidden)" />
            </button>
            <button type="button" data-action="live#action" data-live-action-param="cancelDescription" class="shrink-0 cursor-pointer rounded-lg p-1.5 text-gray-400 transition-colors duration-100 ease-out hover:text-gray-700" title="{{ 'admin.dossiers.create.cancel'|trans }}">
                {{ ux_icon('lucide:x', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
            </button>
        </div>
    {% elseif document.description %}
        {# Note existante : le stylo d'édition vit sur la note elle-même. #}
        <p class="group/note mt-0.5 flex items-center gap-1 text-xs text-gray-500" data-testid="module-file-description">
            {{ ux_icon('lucide:sticky-note', {class: 'size-3 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
            {{ document.description }}
            <button
                type="button"
                data-action="live#action"
                data-live-action-param="editDescription"
                data-live-key-param="{{ document.id }}"
                title="{{ 'admin.dossiers.show.modules.file.pieceDescription.editNote'|trans }}"
                class="shrink-0 cursor-pointer rounded p-0.5 text-gray-300 transition duration-100 ease-out hover:text-gray-600 sm:opacity-0 sm:group-hover/note:opacity-100 sm:focus-visible:opacity-100"
                data-testid="module-file-description-edit"
            >
                {{ ux_icon('lucide:pencil', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
            </button>
        </p>
    {% else %}
        {# Pas encore de note : affordance explicite, toujours visible. #}
        <button
            type="button"
            data-action="live#action"
            data-live-action-param="editDescription"
            data-live-key-param="{{ document.id }}"
            title="{{ 'admin.dossiers.show.modules.file.pieceDescription.edit'|trans }}"
            class="mt-0.5 flex cursor-pointer items-center gap-1 text-[0.6875rem] text-gray-400 transition-colors duration-100 ease-out hover:text-gray-600"
            data-testid="module-file-description-edit"
        >
            {{ ux_icon('lucide:sticky-note', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
            {{ 'admin.dossiers.show.modules.file.pieceDescription.add'|trans }}
        </button>
    {% endif %}
{% endmacro %}

{% macro pieceDate(document) %}
    {% if document.requestedAt %}
        <p class="mt-0.5 flex flex-wrap items-center gap-1.5 text-xs text-gray-400 tabular-nums">
            {{ 'admin.dossiers.show.modules.file.table.requestedAt'|trans }} {{ document.requestedAt|format_datetime(pattern='dd.MM.yyyy') }}
            {# Ancienneté d'une demande toujours en attente : neutre, puis
               ambre dès 5 jours, rouge dès 10 : une relance s'impose. #}
            {% if document.status in ['requested', 'refused'] %}
                {% set daysAgo = date(document.requestedAt).diff(date()).days %}
                {% if daysAgo >= 1 %}
                    {% set ageClass = daysAgo >= 10 ? 'bg-red-50 text-red-600' : (daysAgo >= 5 ? 'bg-amber-50 text-amber-700' : 'bg-neutral-100 text-gray-500') %}
                    <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{ ageClass }}" data-testid="module-file-age">
                        {{ 'admin.dossiers.show.modules.file.requestedAgo'|trans({'%count%': daysAgo}) }}
                    </span>
                {% endif %}
            {% endif %}
        </p>
    {% endif %}
{% endmacro %}

{% macro pieceRefusal(document) %}
    {% if document.status == 'refused' and document.refusalReason %}
        <p class="mt-1 flex items-start gap-1.5 text-xs text-red-600" data-testid="module-file-refusal-reason">
            {{ ux_icon('lucide:message-circle-x', {class: 'mt-px size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
            {{ document.refusalReason }}
        </p>
    {% endif %}
{% endmacro %}

{% macro pieceFileChips(document, adminPrefix, reference, renamingFileId = null, renameDraft = '') %}
    {% if document.files is not empty %}
        {# Une ligne par fichier : nom entier lisible (jamais tronqué),
           taille et date en dessous, renommage au stylo, suppression à
           droite. #}
        <ul role="list" class="mt-2 flex flex-col gap-1">
            {% for file in document.files %}
                <li class="group/file flex items-center gap-2 rounded-lg bg-neutral-50 py-1.5 pr-1.5 pl-2.5" data-testid="module-file-uploaded">
                    {{ ux_icon('lucide:paperclip', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                    <div class="min-w-0 flex-1">
                        {% if renamingFileId == file.id %}
                            <div class="flex items-center gap-1.5">
                                <input
                                    type="text"
                                    maxlength="200"
                                    data-model="norender|renameDraft"
                                    data-action="keydown.enter->live#action:prevent"
                                    data-live-action-param="saveFileName"
                                    value="{{ renameDraft }}"
                                    aria-label="{{ 'admin.dossiers.show.modules.file.renameFile'|trans }}"
                                    class="w-full rounded-lg border border-neutral-200 bg-white px-2.5 py-1 text-xs text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                                    data-testid="module-file-rename-input"
                                >
                                <button type="button" data-action="live#action" data-live-action-param="saveFileName" data-loading="action(saveFileName)|addAttribute(disabled)" class="shrink-0 cursor-pointer rounded-lg bg-primary p-1.5 text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60" title="{{ 'admin.dossiers.show.persons.save'|trans }}" data-testid="module-file-rename-save">
                                    {{ ux_icon('lucide:check', {class: 'size-3 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(saveFileName)|addClass(hidden)'}) }}
                                    <twig:Spinner class="hidden size-3 shrink-0" data-loading="action(saveFileName)|removeClass(hidden)" />
                                </button>
                                <button type="button" data-action="live#action" data-live-action-param="cancelFileName" class="shrink-0 cursor-pointer rounded-lg p-1.5 text-gray-400 transition-colors duration-100 ease-out hover:text-gray-700" title="{{ 'admin.dossiers.create.cancel'|trans }}">
                                    {{ ux_icon('lucide:x', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                </button>
                            </div>
                        {% else %}
                            <div class="flex items-center gap-1.5">
                                <a href="{{ path('admin_dossier_document_file', {adminPrefix: adminPrefix, reference: reference, id: file.id}) }}"
                                   target="_blank" rel="noopener noreferrer"
                                   class="min-w-0 text-xs font-medium break-words text-gray-700 transition-colors duration-100 ease-out hover:text-gray-900"
                                   data-action="file-preview#open"
                                   data-file-preview-name="{{ document.typeLabelKey|trans }}"
                                   data-file-preview-type="{{ file.mimeType }}"
                                   data-testid="module-file-download">
                                    {{ file.name }}
                                </a>
                                <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-action-param="editFileName"
                                    data-live-key-param="{{ file.id }}"
                                    title="{{ 'admin.dossiers.show.modules.file.renameFile'|trans }}"
                                    class="shrink-0 cursor-pointer rounded p-0.5 text-gray-300 transition duration-100 ease-out hover:text-gray-600 sm:opacity-0 sm:group-hover/file:opacity-100 sm:focus-visible:opacity-100"
                                    data-testid="module-file-rename"
                                >
                                    {{ ux_icon('lucide:pencil', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                </button>
                            </div>
                            <p class="text-[0.6875rem] text-gray-400 tabular-nums">
                                {{ 'admin.dossiers.show.modules.file.sizeMb'|trans({'%size%': (file.size / 1000000)|number_format(1, ',', ' ')}) }}{% if file.uploadedAt %} · {{ file.uploadedAt|format_datetime(pattern='dd.MM.yyyy') }}{% endif %}
                            </p>
                        {% endif %}
                    </div>
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="askDeleteFile"
                        data-live-key-param="{{ file.id }}"
                        title="{{ 'admin.dossiers.show.modules.file.deleteFile'|trans }}"
                        class="shrink-0 cursor-pointer rounded-full p-1 text-gray-400 transition-colors duration-100 ease-out hover:bg-red-50 hover:text-red-600"
                        data-testid="module-file-delete"
                    >
                        {{ ux_icon('lucide:x', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                    </button>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

{% macro pieceUpload(document, adminPrefix, reference) %}
    {# Dépôt par le staff (pièce reçue en direct) : un geste, le POST part
       au choix du fichier et Turbo suit la redirection. Sans adminPrefix
       (montage hors requête, tests), pas d'URL générable : pas de bouton. #}
    {% if adminPrefix %}
    <form
        action="{{ path('admin_dossier_document_upload', {adminPrefix: adminPrefix, reference: reference, id: document.id}) }}"
        method="post"
        enctype="multipart/form-data"
        data-controller="auto-submit"
        data-turbo="true"
        class="mt-2"
    >
        <input type="hidden" name="_token" value="{{ csrf_token('admin_document_upload') }}">
        <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-dashed border-gray-950/10 py-1 pr-2.5 pl-1.5 text-xs font-medium text-gray-500 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary">
            {{ ux_icon('lucide:upload', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
            {{ 'admin.dossiers.show.modules.file.upload.button'|trans }}
            <input
                type="file"
                name="file"
                accept="application/pdf,image/jpeg,image/png,image/webp"
                class="sr-only"
                data-action="change->auto-submit#submit"
                data-file-drop-target="input"
                data-testid="module-file-admin-upload"
            >
        </label>
    </form>
    {% endif %}
{% endmacro %}

{% macro pieceStateIcon(document) %}
    {% set stateStyles = {
        requested: {cls: 'bg-gray-100 text-gray-500', icon: 'lucide:clock'},
        received: {cls: 'bg-blue-50 text-blue-600', icon: 'lucide:inbox'},
        validated: {cls: 'bg-green-50 text-green-600', icon: 'lucide:check'},
        refused: {cls: 'bg-red-50 text-red-600', icon: 'lucide:x'},
    } %}
    <span class="flex size-7 shrink-0 items-center justify-center rounded-full {{ stateStyles[document.status].cls }}" aria-hidden="true">
        {{ ux_icon(stateStyles[document.status].icon, {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
    </span>
{% endmacro %}

{% macro pieceStatus(document, locked = false) %}
    {# Statut de vérification : badge dropdown (demandée, déposée, validée, refusée). #}
    {% set statusStyles = {
        requested: {badge: 'bg-gray-100 text-gray-500 hover:bg-gray-200', icon: 'lucide:clock'},
        received: {badge: 'bg-blue-50 text-blue-700 hover:bg-blue-100', icon: 'lucide:inbox'},
        validated: {badge: 'bg-green-50 text-green-700 hover:bg-green-100', icon: 'lucide:check'},
        refused: {badge: 'bg-red-50 text-red-700 hover:bg-red-100', icon: 'lucide:x'},
    } %}
    {% if locked %}
        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium {{ statusStyles[document.status].badge }}" data-testid="module-file-status">
            {{ ux_icon(statusStyles[document.status].icon, {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
            {{ document.statusLabelKey|trans }}
        </span>
    {% else %}
    <details
        class="relative inline-block text-left"
        data-controller="details-dropdown"
        data-action="click@window->details-dropdown#closeOnOutside keydown.esc@window->details-dropdown#close"
    >
        <summary
            class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium transition-colors duration-100 ease-out [&::-webkit-details-marker]:hidden {{ statusStyles[document.status].badge }}"
            data-testid="module-file-status"
        >
            {{ ux_icon(statusStyles[document.status].icon, {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
            {{ document.statusLabelKey|trans }}
            {{ ux_icon('lucide:chevron-down', {class: 'size-3 shrink-0 opacity-60', 'aria-hidden': 'true'}) }}
        </summary>
        <div class="absolute right-0 z-10 mt-2 w-48 rounded-xl border border-neutral-200 bg-white p-1 text-left shadow-lg">
            {% for statusValue, style in statusStyles %}
                <button
                    type="button"
                    data-action="live#action details-dropdown#close"
                    data-live-action-param="chooseStatus"
                    data-live-key-param="{{ document.id }}"
                    data-live-status-param="{{ statusValue }}"
                    class="flex w-full cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-left text-xs transition-colors duration-100 ease-out {{ statusValue == document.status ? 'bg-neutral-100 font-medium text-gray-900' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                    data-testid="module-file-status-choice"
                >
                    {{ ux_icon(style.icon, {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                    <span class="min-w-0 flex-1 truncate">{{ ('admin.dossiers.show.modules.file.status.' ~ statusValue)|trans }}</span>
                    {% if statusValue == document.status %}
                        {{ ux_icon('lucide:check', {class: 'size-3.5 shrink-0 text-primary', 'aria-hidden': 'true'}) }}
                    {% endif %}
                </button>
            {% endfor %}
        </div>
    </details>
    {% endif %}
{% endmacro %}

{% import _self as m %}

        <div {{ attributes.defaults({class: 'space-y-6'}) }} data-testid="dossier-show-modules">
    {# Dépôt client verrouillé : bandeau d'alerte sous les onglets, au-dessus
       des cards (même famille visuelle que le bandeau de clôture, en ambré
       car l'état est réversible). Live : suit le toggle du verrou. #}
    {% if this.isDepositLocked %}
        <div
            class="flex items-center gap-4 rounded-2xl border border-amber-300 bg-linear-to-r from-amber-100/80 to-amber-50/40 px-5 py-4 shadow-sm"
            role="status"
            data-testid="dossier-deposit-locked-banner"
        >
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-white text-amber-600 shadow-sm">
                {{ ux_icon('lucide:shield-off', {class: 'size-5', 'aria-hidden': 'true'}) }}
            </span>
            <div class="min-w-0 flex-1">
                <p class="font-semibold text-gray-900">{{ 'admin.dossiers.show.modules.file.depositLock.bannerTitle'|trans }}</p>
                <p class="mt-0.5 text-sm leading-5 text-gray-600">
                    {%- set depositLockedAt = this.depositLockedAt -%}
                    {%- if depositLockedAt -%}
                        {{ 'admin.dossiers.show.modules.file.depositLock.bannerText'|trans({'%date%': depositLockedAt|format_date('medium')}) }}
                    {%- endif -%}
                </p>
            </div>
        </div>
    {% endif %}
    {% for module in [{key: 'file'}, {key: 'visit'}, {key: 'payment'}] %}
        {# data-tab-panel : visibilité pilotée par les onglets de la page
           (attribut rendu côté serveur, donc morph-proof). #}
        <div data-tab-panel="{{ module.key }}" class="flex min-w-0 flex-col gap-3" data-testid="dossier-module-card">
        <section class="rounded-3xl border border-neutral-200 bg-white p-2">
            {% set unlocked = this.isModuleUnlocked(module.key) %}
            {% if unlocked %}
                {% set dossierVisits = module.key == 'visit' ? this.dossierVisits : null %}
                {# Repli piloté par la prop live : sans ça, le morph refermerait
                   la card ouverte au premier changement de statut. #}
                <details {{ module.key in this.openModules ? 'open' }} class="group details-animated rounded-2xl bg-neutral-50 p-2"
                    {% if module.key == 'file' %}data-controller="file-preview" data-action="keydown.esc@window->file-preview#close"{% endif %}>
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between gap-4 p-3 [&::-webkit-details-marker]:hidden"
                        data-action="live#action"
                        data-live-action-param="toggleModule"
                        data-live-module-param="{{ module.key }}"
                    >
                        <div class="min-w-0">
                            <h2 class="font-medium text-gray-900">{{ ('admin.dossiers.show.modules.' ~ module.key ~ '.title')|trans }}</h2>
                            <p class="mt-0.5 text-xs text-gray-500">{{ ('admin.dossiers.show.modules.' ~ module.key ~ '.description')|trans }}</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            {% if module.key == 'file' %}
                                {% set pieceCounts = this.pieceCounts %}
                                {% if pieceCounts.total > 0 %}
                                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium tabular-nums {{ pieceCounts.deposited == pieceCounts.total ? 'bg-green-50 text-green-700' : 'bg-neutral-100 text-gray-600' }}" data-testid="module-file-counter">
                                        {{ 'admin.dossiers.show.modules.file.counter'|trans({'%deposited%': pieceCounts.deposited, '%total%': pieceCounts.total}) }}
                                    </span>
                                {% endif %}
                                {# Cadenas anti-missclick : verrouillé par défaut à
                                   chaque chargement, comme la card Recherche. #}
                                <button
                                    type="button"
                                    data-action="live#action:prevent:stop"
                                    data-live-action-param="toggleFileLock"
                                    class="flex size-8 cursor-pointer items-center justify-center rounded-full border transition-colors duration-100 ease-out {{ this.fileLocked ? 'border-neutral-200 bg-white text-gray-500 hover:bg-gray-50 hover:text-gray-900' : 'border-primary/30 bg-primary/5 text-primary hover:bg-primary/10' }}"
                                    aria-pressed="{{ this.fileLocked ? 'false' : 'true' }}"
                                    aria-label="{{ (this.fileLocked ? 'admin.dossiers.show.search.unlock' : 'admin.dossiers.show.search.lock')|trans }}"
                                    title="{{ (this.fileLocked ? 'admin.dossiers.show.search.unlock' : 'admin.dossiers.show.search.lock')|trans }}"
                                    data-testid="module-file-lock"
                                >
                                    {{ ux_icon(this.fileLocked ? 'lucide:lock' : 'lucide:lock-open', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                </button>
                            {% elseif module.key == 'visit' and dossierVisits.upcoming|length > 0 %}
                                <span class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 tabular-nums" data-testid="module-visit-counter">
                                    {{ 'admin.dossiers.show.modules.visit.counter'|trans({'%count%': dossierVisits.upcoming|length}) }}
                                </span>
                            {% endif %}
                            {{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-gray-400 transition-transform duration-200 group-open:rotate-180', 'aria-hidden': 'true'}) }}
                        </div>
                    </summary>
                    {% if module.key == 'file' %}
                        {# Un bloc par locataire : avatar + compteur en tête,
                           puis la liste aérée des pièces demandées. #}
                        {# Verrouillé : contrôles désactivés (fieldset); le
                           lien de dépôt et les téléchargements restent actifs. #}
                        {% set fileBody %}
                        <fieldset {{ this.fileLocked ? 'disabled' }} class="contents">
                        <ul class="mt-1 flex flex-col gap-1" role="list">
                            {% for tenant in this.tenants %}
                                <li class="bg-white px-5 py-5 first:rounded-t-xl last:rounded-b-xl" data-testid="module-file-tenant">
                                    {# En-tête locataire : avatar (initiale), nom et compteur de
                                       pièces à gauche, gestes à droite. #}
                                    <div class="flex flex-wrap items-center justify-between gap-3">
                                        <div class="flex min-w-0 items-center gap-2.5">
                                            <twig:Avatar name="{{ tenant.name }}" size="8" />
                                            <div class="min-w-0">
                                                <p class="truncate text-sm font-semibold text-gray-900">{{ tenant.name }}</p>
                                                {% if tenant.documents is not empty %}
                                                    {% set tenantDeposited = tenant.documents|filter(d => d.status in ['received', 'validated'])|length %}
                                                    <p class="text-xs text-gray-400 tabular-nums">{{ 'admin.dossiers.show.modules.file.counter'|trans({'%deposited%': tenantDeposited, '%total%': tenant.documents|length}) }}</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="flex shrink-0 items-center gap-2">
                                            <button
                                                type="button"
                                                data-action="live#action"
                                                data-live-action-param="openPicker"
                                                data-live-key-param="{{ tenant.id }}"
                                                class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary disabled:cursor-default disabled:opacity-60"
                                                data-testid="module-file-request"
                                            >
                                                {{ ux_icon('lucide:list-checks', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                {{ 'admin.dossiers.show.modules.file.select'|trans }}
                                            </button>
                                        </div>
                                    </div>
                                    {% if tenant.documents is not empty %}
                                    {# Mix "Pastille d'état" + "Bandes grises" (choix utilisateur,
                                       août 2026) : une bande grise arrondie par pièce, pastille d'état
                                       colorée en tête, badge de statut à droite, fichiers en chips
                                       blanches. #}
                                    <ul class="mt-3 space-y-1.5" role="list">
                                        {% for document in tenant.documents %}
                                            {# Toute la rangée accepte le glisser-déposer d'un fichier,
                                               qui part par le formulaire d'upload existant. #}
                                            <li
                                                class="group/piece flex items-start gap-3 rounded-xl border border-gray-950/5 px-4 py-3 transition-colors duration-100 ease-out"
                                                data-testid="module-file-document"
                                                {% if this.adminPrefix %}
                                                    data-controller="file-drop"
                                                    data-file-drop-drag-class="border-primary/40 bg-primary/5"
                                                    data-action="dragover->file-drop#dragOver dragenter->file-drop#dragEnter dragleave->file-drop#dragLeave drop->file-drop#drop dragover@window->file-drop#guardWindow drop@window->file-drop#guardWindow"
                                                {% endif %}
                                            >
                                                {{ m.pieceStateIcon(document) }}
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-start justify-between gap-3">
                                                        <div class="min-w-0">
                                                            {{ m.pieceTitle(document, this.editingDescriptionId, this.descriptionDraft) }}
                                                            {{ m.pieceDate(document) }}
                                                        </div>
                                                        <div class="shrink-0">{{ m.pieceStatus(document, this.fileLocked) }}</div>
                                                    </div>
                                                    {{ m.pieceRefusal(document) }}
                                                    {{ m.pieceFileChips(document, this.adminPrefix, this.reference, this.renamingFileId, this.renameDraft) }}
                                                    {{ m.pieceUpload(document, this.adminPrefix, this.reference) }}
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                    {% else %}
                                        <p class="mt-3 text-xs text-gray-400">{{ 'admin.dossiers.show.modules.file.none'|trans }}</p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                        {# Création manuelle de l'arborescence Drive (dossier
                           vide) : disparaît dès qu'elle existe. #}
                        {% if this.canProvisionDrive %}
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="provisionDrive"
                                data-loading="action(provisionDrive)|addAttribute(disabled)"
                                class="mt-1 flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-xl border border-dashed border-gray-950/10 bg-white/60 px-3 py-3 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary disabled:cursor-default disabled:opacity-60"
                                data-testid="module-file-provision-drive"
                            >
                                <twig:Spinner class="hidden size-3.5 shrink-0" data-loading="action(provisionDrive)|removeClass(hidden)" />
                                {{ ux_icon('lucide:folder-plus', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(provisionDrive)|addClass(hidden)'}) }}
                                {{ 'admin.dossiers.show.modules.file.provisionDrive'|trans }}
                            </button>
                        {% endif %}
                        </fieldset>
                        {% endset %}
                        {# Verrouillé : contenu grisé et désaturé + bandeau
                           cliquable qui déverrouille (hors fieldset, donc
                           actif). Tout reprend ses couleurs à l'ouverture. #}
                        {% if this.fileLocked %}
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="toggleFileLock"
                                class="mt-1 flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-xl bg-neutral-100 px-3 py-2 text-xs font-medium text-gray-500 transition-colors duration-100 ease-out hover:bg-neutral-200 hover:text-gray-700"
                                data-testid="module-file-locked-banner"
                            >
                                {{ ux_icon('lucide:lock', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.locked.notice'|trans }}
                            </button>
                        {% endif %}
                        <div class="transition-[opacity,filter] duration-200 ease-out {{ this.fileLocked ? 'opacity-70 saturate-50' : '' }}">
                            {{ fileBody }}
                        </div>
                        {# Pied de card : briques factorisées, agencées par la
                           variante retenue ci-dessous. #}
                        {% set depositUrl = this.depositUrl %}
                        {% set depositLocked = this.depositLocked %}
                        {% set btnGhost = 'flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary disabled:cursor-default disabled:opacity-60' %}
                        {% set actionCopyLink %}
                            <button type="button" data-action="copy-link#copy" class="{{ btnGhost }}" data-testid="module-file-deposit-copy">
                                {{ ux_icon('lucide:copy', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                <span data-copy-link-target="label">{{ 'admin.dossiers.show.modules.file.depositLink.copy'|trans }}</span>
                            </button>
                        {% endset %}
                        {% set actionResend %}
                            {% if this.hasPendingPieces() %}
                                <button type="button" data-action="live#action" data-live-action-param="askResend" {{ this.fileLocked ? 'disabled' }} class="{{ btnGhost }}" title="{{ 'admin.dossiers.show.modules.file.resendTitle'|trans }}" data-testid="module-file-resend">
                                    {{ ux_icon('lucide:bell-ring', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.dossiers.show.modules.file.resend'|trans }}
                                </button>
                            {% endif %}
                        {% endset %}
                        {% set actionDepositLock %}
                            <button type="button" data-action="live#action" data-live-action-param="askDepositLock" {{ this.fileLocked ? 'disabled' }} class="flex cursor-pointer items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium transition-colors duration-100 ease-out disabled:cursor-default disabled:opacity-60 {{ depositLocked ? 'border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100' : 'border-neutral-200 bg-white text-gray-600 hover:border-amber-300 hover:bg-amber-50 hover:text-amber-800' }}" title="{{ (depositLocked ? 'admin.dossiers.show.modules.file.depositLock.unlock' : 'admin.dossiers.show.modules.file.depositLock.lock')|trans }}" data-testid="module-file-deposit-lock">
                                {{ ux_icon(depositLocked ? 'lucide:shield-off' : 'lucide:shield', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ (depositLocked ? 'admin.dossiers.show.modules.file.depositLock.locked' : 'admin.dossiers.show.modules.file.depositLock.lock')|trans }}
                            </button>
                        {% endset %}
                        {% set actionZip %}
                            {% if this.hasDepositedFiles %}
                                {% set zipUrl = path('admin_dossier_documents_zip', {adminPrefix: this.adminPrefix, reference: this.reference}) %}
                                {# Téléchargement natif (nom et intégrité garantis par
                                   le serveur) : le spinner ne fait que signaler la
                                   préparation du zip. #}
                                <a
                                    href="{{ zipUrl }}"
                                    class="{{ btnGhost }}"
                                    data-controller="download-feedback"
                                    data-action="click->download-feedback#start"
                                    data-testid="module-file-zip"
                                >
                                    <span class="relative flex shrink-0 items-center">
                                        <span data-download-feedback-target="label" class="flex items-center">{{ ux_icon('lucide:folder-archive', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}</span>
                                        <twig:Spinner class="absolute inset-0 m-auto hidden size-3.5" data-download-feedback-target="spinner" />
                                    </span>
                                    {{ 'admin.dossiers.show.modules.file.downloadZip'|trans }}
                                </a>
                            {% endif %}
                        {% endset %}
                        {% set codeInline %}
                            {% if this.pairingCode %}
                                <p class="flex items-center gap-1.5 text-xs text-gray-500" data-testid="module-file-deposit-code">
                                    {{ ux_icon('lucide:key-round', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.dossiers.show.modules.file.depositLink.codeLabel'|trans }}
                                    <span class="font-mono text-sm font-semibold tracking-widest text-gray-900">{{ this.pairingCode }}</span>
                                    <span data-controller="copy-link" data-copy-link-text-value="{{ this.pairingCode }}" data-copy-link-copied-label-value="{{ 'admin.dossiers.show.modules.file.depositLink.copied'|trans }}" class="contents">
                                        <button type="button" data-action="copy-link#copy" aria-label="{{ 'admin.dossiers.show.modules.file.depositLink.copyCode'|trans }}" title="{{ 'admin.dossiers.show.modules.file.depositLink.copyCode'|trans }}" class="cursor-pointer rounded p-0.5 text-gray-300 transition-colors duration-100 ease-out hover:text-gray-600">
                                            {{ ux_icon('lucide:copy', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                        </button>
                                    </span>
                                </p>
                            {% endif %}
                        {% endset %}
                        {% if depositUrl %}
                        {# Pied « Tuiles » : lien et code en tuiles label/valeur
                           (même langage que l'en-tête de la page de dépôt),
                           actions regroupées dans une tuile pleine largeur. #}
                        <div class="mt-1 grid grid-cols-1 gap-1 sm:grid-cols-2" data-controller="copy-link" data-copy-link-text-value="{{ depositUrl }}" data-copy-link-copied-label-value="{{ 'admin.dossiers.show.modules.file.depositLink.copied'|trans }}" data-testid="module-file-deposit-link">
                            <div class="rounded-xl bg-white px-4 py-3">
                                <p class="text-[0.6875rem] font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.dossiers.show.modules.file.depositLink.label'|trans }}</p>
                                <a href="{{ depositUrl }}" target="_blank" rel="noopener noreferrer" class="mt-0.5 block truncate text-xs text-gray-500 underline decoration-gray-300 underline-offset-2 transition-colors duration-100 ease-out hover:text-gray-900">{{ depositUrl }}</a>
                            </div>
                            <div class="rounded-xl bg-white px-4 py-3">
                                <p class="text-[0.6875rem] font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.dossiers.show.modules.file.depositLink.codeLabel'|trans|trim(':') }}</p>
                                <div class="mt-0.5">{{ codeInline }}</div>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-xl bg-white px-4 py-3 sm:col-span-2">
                                {# Gestes secondaires à gauche, actions du quotidien
                                   mises en évidence à droite. #}
                                <div class="flex flex-wrap items-center gap-2">
                                    {{ actionCopyLink }}{{ actionDepositLock }}
                                </div>
                                <div class="flex flex-wrap items-center gap-2">
                                    {{ actionResend }}{{ actionZip }}
                                </div>
                            </div>
                        </div>
                        {% endif %}
                        <twig:FilePreview />
                    {% elseif module.key == 'visit' %}
                        {# Visites du dossier : à venir puis passées; chaque
                           ligne ouvre la fiche visite si l'utilisateur a
                           accès à la section Visites. #}
                        {% set canOpenVisit = this.adminPrefix != '' and is_granted('ROLE_SECTION_VISITS') %}
                        {% set moduleVisits = dossierVisits.upcoming|merge(dossierVisits.past) %}
                        {% if moduleVisits is empty %}
                            <p class="mt-1 rounded-xl bg-white px-5 py-6 text-sm text-gray-400" data-testid="module-visit-empty">
                                {{ 'admin.dossiers.show.modules.visit.empty'|trans }}
                            </p>
                        {% else %}
                            <ul class="mt-1 flex flex-col gap-1" role="list">
                                {% for visit in moduleVisits %}
                                    {% set rowTag = canOpenVisit ? 'a' : 'div' %}
                                    <li class="bg-white first:rounded-t-xl last:rounded-b-xl" data-testid="module-visit-row">
                                        <{{ rowTag }}
                                            {% if canOpenVisit %}href="{{ path('admin_visit_show', {adminPrefix: this.adminPrefix, id: visit.id}) }}"{% endif %}
                                            class="group/visit flex items-center gap-4 px-5 py-3.5 {{ canOpenVisit ? 'transition-colors duration-100 ease-out hover:bg-neutral-50' }}"
                                        >
                                            <div class="min-w-0 flex-1">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <p class="text-sm font-medium text-gray-900 tabular-nums">{{ visit.scheduledAt|format_datetime(pattern='EEE d MMM, HH:mm')|capitalize }}</p>
                                                    <span class="text-xs text-gray-400">{{ visit.type.labelKey|trans }}</span>
                                                    <span class="flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium {{ visit.status.badgeClasses }}" data-testid="module-visit-status">
                                                        {{ ux_icon(visit.status.icon, {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                                        {{ visit.status.labelKey|trans }}
                                                    </span>
                                                </div>
                                                <p class="mt-0.5 truncate text-xs text-gray-500">{{ visit.address }}</p>
                                            </div>
                                            {% if canOpenVisit %}
                                                {{ ux_icon('lucide:chevron-right', {class: 'size-4 shrink-0 text-gray-300 transition-colors duration-100 ease-out group-hover/visit:text-gray-500', 'aria-hidden': 'true'}) }}
                                            {% endif %}
                                        </{{ rowTag }}>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if canOpenVisit %}
                            <div class="mt-1 flex justify-end rounded-xl bg-white px-5 py-3">
                                <a
                                    href="{{ path('admin_visit_new', {adminPrefix: this.adminPrefix, dossier: this.reference}) }}"
                                    class="flex items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                                    data-testid="module-visit-plan"
                                >
                                    {{ ux_icon('lucide:calendar-plus', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.dossiers.show.modules.visit.plan'|trans }}
                                </a>
                            </div>
                        {% endif %}
                    {% else %}
                        <p class="mt-1 rounded-xl bg-white px-5 py-6 text-sm text-gray-400">
                            {{ 'admin.dossiers.show.modules.comingSoon'|trans }}
                        </p>
                    {% endif %}
                </details>
            {% else %}
                {% set moduleTitle = ('admin.dossiers.show.modules.' ~ module.key ~ '.title')|trans %}
                {% set moduleDescription = ('admin.dossiers.show.modules.' ~ module.key ~ '.description')|trans %}
                <div class="rounded-2xl bg-neutral-50 p-2" data-testid="dossier-module-locked">
                    <div class="flex items-center justify-between gap-4 p-3">
                        <div class="min-w-0">
                            <h2 class="font-medium text-gray-900">{{ moduleTitle }}</h2>
                            <p class="mt-0.5 text-xs text-gray-500">{{ moduleDescription }}</p>
                        </div>
                        {# Texte complet du verrou en tooltip. #}
                        {% set blockingStep = this.blockingStepLabel(module.key) %}
                        <span
                            class="flex shrink-0 items-center gap-1.5 rounded-full bg-gray-100 py-1 pr-2.5 pl-1.5 text-xs font-medium text-gray-500"
                            title="{{ blockingStep ? 'admin.dossiers.show.steps.lockedHint'|trans({'%step%': blockingStep|trans}) : 'admin.dossiers.show.modules.locked'|trans }}"
                        >
                            {{ ux_icon('lucide:lock', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                            {{ 'admin.dossiers.show.modules.lockedShort'|trans }}
                        </span>
                    </div>
                </div>
            {% endif %}
        </section>
        {# Le pied "Valider l'étape" vit sous la card, hors coque (comme les
           cards Personnes et Recherche). Le paiement est terminal : rien à
           déverrouiller après. #}
        {% if unlocked and module.key != 'payment' %}
            <twig:Dossier:StepValidateFooter
                :validated="this.isModuleValidated(module.key)"
                :canReopen="this.canReopenModule(module.key)"
                action="validateModule"
                reopenAction="reopenModule"
                module="{{ module.key }}"
                :standalone="true"
            />
        {% endif %}
        </div>
    {% endfor %}

    {# Modale de demande de pièces : étape 1 checkboxes des pièces, étape 2
       choix du destinataire de l'email + confirmation d'envoi. #}
    {% if this.pickerId is not null %}
        {% set pickerTenant = null %}
        {% for tenant in this.tenants %}
            {% if tenant.id == this.pickerId %}{% set pickerTenant = tenant %}{% endif %}
        {% endfor %}
        {% set checkboxClass = 'peer size-4 inline-block align-middle accent-primary rounded-sm border border-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:ring-primary/60 focus:outline-primary/80 checked:bg-primary checked:border-primary disabled:cursor-not-allowed disabled:opacity-50' %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-file-picker-title"
            data-controller="modal-focus modal-anim instant-exit"
            data-action="keydown.esc@window->instant-exit#run keydown.esc@window->live#action"
            data-live-action-param="closePicker"
            data-testid="module-file-picker"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="instant-exit#run live#action"
                data-live-action-param="closePicker"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative max-h-[92vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-file-picker-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.requestTitle'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ (this.pickerStep == 'select'
                                ? 'admin.dossiers.show.modules.file.requestSubtitle'
                                : 'admin.dossiers.show.modules.file.recipientSubtitle')|trans({'%name%': pickerTenant ? pickerTenant.name : ''}) }}
                        </p>
                    </div>
                    <div class="space-y-5 rounded-xl bg-white px-5 py-4">

                        {% if this.pickerStep == 'select' %}
                            {% set requestedTypes = this.pickerRequestedTypes %}
                            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2" data-testid="module-file-types">
                                {% for type in this.documentTypes %}
                                    {# Pièce déjà demandée : cochée et grisée, on
                                       ne la redemande pas. #}
                                    {% set already = type.value in requestedTypes %}
                                    <label class="flex items-center gap-2.5 rounded-xl border px-3.5 py-2.5 text-sm font-medium transition-colors duration-100 ease-out {{ already
                                        ? 'cursor-default border-neutral-200 bg-neutral-50 text-gray-400'
                                        : 'cursor-pointer border-neutral-200 bg-white text-gray-600 hover:border-gray-400 hover:text-gray-900 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5 has-[input:checked]:text-primary' }}">
                                        <input
                                            type="checkbox"
                                            value="{{ type.value }}"
                                            {% if not already %}data-model="norender|selectedTypes[]"{% endif %}
                                            {% if already %}checked disabled{% elseif type.value in this.selectedTypes %}checked{% endif %}
                                            class="{{ checkboxClass }}"
                                            data-testid="module-file-type-checkbox"
                                        >
                                        {{ type.labelKey|trans }}
                                    </label>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="flex flex-col gap-2" role="radiogroup" data-testid="module-file-recipients">
                                <p class="text-sm text-gray-600">{{ 'admin.dossiers.show.modules.file.sendTo'|trans }}</p>
                                {% for recipient in this.recipients %}
                                    <label class="flex cursor-pointer items-center gap-2.5 rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 transition-colors duration-100 ease-out hover:border-gray-400 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5">
                                        <input
                                            type="radio"
                                            name="module-file-recipient"
                                            value="{{ recipient.id }}"
                                            data-model="norender|recipientId"
                                            {% if this.recipientId == recipient.id %}checked{% endif %}
                                            class="peer sr-only"
                                        >
                                        <span class="min-w-0 flex-1">
                                            <span class="block truncate text-sm font-medium text-gray-900">
                                                {{ recipient.name|title }}
                                                {% if recipient.primary %}
                                                    <span class="ml-1 rounded-full bg-primary/5 px-2 py-0.5 text-[11px] font-medium text-primary">{{ 'admin.dossiers.create.person.primaryTag'|trans }}</span>
                                                {% endif %}
                                            </span>
                                            <span class="block truncate text-xs text-gray-500">{{ recipient.email }}</span>
                                        </span>
                                        {{ ux_icon('lucide:check', {class: 'size-4 shrink-0 text-primary opacity-0 transition-opacity duration-100 peer-checked:opacity-100', 'aria-hidden': 'true'}) }}
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {% if this.pickerError %}
                            <p class="text-sm text-red-600" role="alert" data-testid="module-file-picker-error">{{ this.pickerError|trans }}</p>
                        {% endif %}

                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        {% if this.pickerStep == 'select' %}
                            <button
                                type="button"
                                data-action="instant-exit#run live#action"
                                data-live-action-param="closePicker"
                                class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            >
                                {{ 'admin.dossiers.create.cancel'|trans }}
                            </button>
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="pickerNext"
                                class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90"
                                data-testid="module-file-next"
                            >
                                {{ 'admin.dossiers.show.modules.file.next'|trans }}
                                {{ ux_icon('lucide:arrow-right', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                            </button>
                        {% else %}
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="pickerBack"
                                class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                                data-testid="module-file-back"
                            >
                                {{ 'admin.dossiers.show.modules.file.back'|trans }}
                            </button>
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="sendRequest"
                                data-loading="action(sendRequest)|addAttribute(disabled)"
                                class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60"
                                data-testid="module-file-send"
                            >
                                <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(sendRequest)|removeClass(hidden)" />
                                {{ ux_icon('lucide:send', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(sendRequest)|addClass(hidden)'}) }}
                                {{ 'admin.dossiers.show.modules.file.send'|trans }}
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Modal de relance : choix de l'email qui reçoit le rappel. ─────── #}
    {% if this.resending %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-file-resend-title"
            data-controller="modal-focus modal-anim instant-exit"
            data-action="keydown.esc@window->instant-exit#run keydown.esc@window->live#action"
            data-live-action-param="cancelResend"
            data-testid="module-file-resend-modal"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="instant-exit#run live#action"
                data-live-action-param="cancelResend"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-file-resend-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.resendModal.title'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ 'admin.dossiers.show.modules.file.resendModal.text'|trans }}
                        </p>
                    </div>
                    <div class="space-y-5 rounded-xl bg-white px-5 py-4">
                        {# Plusieurs personnes peuvent être relancées d'un coup. #}
                        <div class="flex flex-col gap-2" role="group" data-testid="module-file-resend-recipients">
                            {% for recipient in this.recipients %}
                                <label class="flex cursor-pointer items-center gap-2.5 rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 transition-colors duration-100 ease-out hover:border-gray-400 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5">
                                    {# Même style de checkbox que la modale de
                                       sélection des pièces. #}
                                    <input
                                        type="checkbox"
                                        value="{{ recipient.id }}"
                                        data-model="norender|resendRecipientIds[]"
                                        {% if recipient.id in this.resendRecipientIds %}checked{% endif %}
                                        class="peer size-4 shrink-0 inline-block align-middle accent-primary rounded-sm border border-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:ring-primary/60 focus:outline-primary/80 checked:bg-primary checked:border-primary"
                                        data-testid="module-file-resend-recipient"
                                    >
                                    <span class="min-w-0">
                                        <span class="block truncate text-sm font-medium text-gray-900">{{ recipient.name|title }}</span>
                                        <span class="block truncate text-xs text-gray-500">{{ recipient.email }}</span>
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                        {% if this.resendError %}
                            <p class="text-sm text-red-600" role="alert" data-testid="module-file-resend-error">{{ this.resendError|trans }}</p>
                        {% endif %}
                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="cancelResend"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="module-file-resend-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="confirmResend"
                            data-loading="action(confirmResend)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60"
                            data-testid="module-file-resend-confirm"
                        >
                            <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(confirmResend)|removeClass(hidden)" />
                            {{ ux_icon('lucide:send', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(confirmResend)|addClass(hidden)'}) }}
                            {{ 'admin.dossiers.show.modules.file.resendModal.confirm'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Modal de confirmation de retrait d'une pièce demandée. ────────── #}
    {% if this.confirmDeletePieceId is not null %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-piece-delete-title"
            data-controller="modal-focus modal-anim instant-exit"
            data-action="keydown.esc@window->instant-exit#run keydown.esc@window->live#action"
            data-live-action-param="cancelDeletePiece"
            data-testid="module-piece-delete-modal"
        >
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="instant-exit#run live#action"
                data-live-action-param="cancelDeletePiece"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-piece-delete-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.deletePieceConfirm.title'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ 'admin.dossiers.show.modules.file.deletePieceConfirm.text'|trans }}
                        </p>
                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="cancelDeletePiece"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="module-piece-delete-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="deletePiece"
                            data-live-key-param="{{ this.confirmDeletePieceId }}"
                            data-loading="action(deletePiece)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-red-700 disabled:cursor-default disabled:opacity-60"
                            data-testid="module-piece-delete-confirm"
                        >
                            <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(deletePiece)|removeClass(hidden)" />
                            {{ ux_icon('lucide:trash-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(deletePiece)|addClass(hidden)'}) }}
                            {{ 'admin.dossiers.show.modules.file.deletePieceConfirm.confirm'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Modal de confirmation du verrouillage de l'espace de dépôt. ───── #}
    {% if this.confirmingDepositLock %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-file-deposit-lock-title"
            data-controller="modal-focus modal-anim instant-exit"
            data-action="keydown.esc@window->instant-exit#run keydown.esc@window->live#action"
            data-live-action-param="cancelDepositLock"
            data-testid="module-file-deposit-lock-modal"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="instant-exit#run live#action"
                data-live-action-param="cancelDepositLock"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-file-deposit-lock-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.depositLock.confirmTitle'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ 'admin.dossiers.show.modules.file.depositLock.confirmText'|trans }}
                        </p>
                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="cancelDepositLock"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="module-file-deposit-lock-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="confirmDepositLock"
                            data-loading="action(confirmDepositLock)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-amber-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-amber-700 disabled:cursor-default disabled:opacity-60"
                            data-testid="module-file-deposit-lock-confirm"
                        >
                            <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(confirmDepositLock)|removeClass(hidden)" />
                            {{ ux_icon('lucide:shield', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(confirmDepositLock)|addClass(hidden)'}) }}
                            {{ 'admin.dossiers.show.modules.file.depositLock.confirmButton'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Modal de confirmation de suppression d'un fichier déposé. ─────── #}
    {% if this.confirmDeleteFileId is not null %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-file-delete-title"
            data-controller="modal-focus modal-anim instant-exit"
            data-action="keydown.esc@window->instant-exit#run keydown.esc@window->live#action"
            data-live-action-param="cancelDeleteFile"
            data-testid="module-file-delete-modal"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="instant-exit#run live#action"
                data-live-action-param="cancelDeleteFile"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-file-delete-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.deleteFileConfirm.title'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ 'admin.dossiers.show.modules.file.deleteFileConfirm.text'|trans }}
                        </p>
                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="cancelDeleteFile"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="module-file-delete-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="deleteFile"
                            data-live-key-param="{{ this.confirmDeleteFileId }}"
                            data-loading="action(deleteFile)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-red-700 disabled:cursor-default disabled:opacity-60"
                            data-testid="module-file-delete-confirm"
                        >
                            <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(deleteFile)|removeClass(hidden)" />
                            {{ ux_icon('lucide:trash-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(deleteFile)|addClass(hidden)'}) }}
                            {{ 'admin.dossiers.show.modules.file.deleteFileConfirm.confirm'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Modal de refus : motif optionnel + email au locataire. ────────── #}
    {% if this.refusingId is not null %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            role="dialog"
            aria-modal="true"
            aria-labelledby="module-file-refusal-title"
            data-controller="modal-focus modal-anim instant-exit"
            data-action="keydown.esc@window->instant-exit#run keydown.esc@window->live#action"
            data-live-action-param="cancelRefusal"
            data-testid="module-file-refusal"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="instant-exit#run live#action"
                data-live-action-param="cancelRefusal"
                aria-label="{{ 'admin.dossiers.create.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 id="module-file-refusal-title" class="text-lg font-semibold tracking-tight text-gray-900">
                            {{ 'admin.dossiers.show.modules.file.refuse.title'|trans }}
                        </h2>
                        <p class="mt-1 text-sm text-pretty text-gray-500">
                            {{ 'admin.dossiers.show.modules.file.refuse.text'|trans }}
                        </p>
                    </div>
                    <div class="space-y-5 rounded-xl bg-white px-5 py-4">
                        <div>
                            <label for="module-file-refusal-reason" class="text-sm text-gray-600">{{ 'admin.dossiers.show.modules.file.refuse.reasonLabel'|trans }}</label>
                            <textarea
                                id="module-file-refusal-reason"
                                rows="3"
                                maxlength="500"
                                data-model="norender|refusalReason"
                                placeholder="{{ 'admin.dossiers.show.modules.file.refuse.reasonPlaceholder'|trans }}"
                                class="mt-1.5 w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                                data-testid="module-file-refusal-input"
                            >{{ this.refusalReason }}</textarea>
                        </div>
                    </div>
                    <div class="flex items-center justify-end gap-4 p-3">
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="cancelRefusal"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="module-file-refusal-cancel"
                        >
                            {{ 'admin.dossiers.create.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="instant-exit#run live#action"
                            data-live-action-param="confirmRefusal"
                            data-loading="action(confirmRefusal)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-red-700 disabled:cursor-default disabled:opacity-60"
                            data-testid="module-file-refusal-confirm"
                        >
                            <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(confirmRefusal)|removeClass(hidden)" />
                            {{ ux_icon('lucide:x', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(confirmRefusal)|addClass(hidden)'}) }}
                            {{ 'admin.dossiers.show.modules.file.refuse.confirm'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
