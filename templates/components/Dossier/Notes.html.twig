{% macro managerChips(manager, choices) %}
    <div class="flex flex-wrap items-center gap-2">
        {% if manager %}
            <span class="flex items-center gap-2 rounded-full border border-neutral-200 bg-white py-1 pr-1.5 pl-1">
                <twig:Avatar filename="{{ manager.avatarFilename }}" name="{{ manager.fullName }}" email="{{ manager.email }}" size="6" />
                <span class="text-sm font-medium text-gray-900">{{ manager.fullName|title }}</span>
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="assignManager"
                    data-live-id-param="0"
                    class="flex size-5 cursor-pointer items-center justify-center rounded-full text-gray-400 transition-colors duration-100 ease-out hover:bg-gray-100 hover:text-gray-900"
                    aria-label="{{ 'admin.dossiers.show.manager.remove'|trans }}"
                    data-testid="dossier-notes-unassign"
                >
                    {{ ux_icon('lucide:x', {class: 'size-3', 'aria-hidden': 'true'}) }}
                </button>
            </span>
        {% else %}
            {% for choice in choices %}
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="assignManager"
                    data-live-id-param="{{ choice.id }}"
                    class="flex cursor-pointer items-center gap-1.5 rounded-full border border-dashed border-gray-300 py-1 pr-3 pl-1 text-sm text-gray-500 transition-colors duration-100 ease-out hover:border-gray-400 hover:text-gray-900"
                    data-testid="dossier-notes-assign"
                >
                    <twig:Avatar filename="{{ choice.avatarFilename }}" name="{{ choice.fullName }}" email="{{ choice.email }}" size="6" class="opacity-70" />
                    {{ choice.fullName|title }}
                </button>
            {% endfor %}
        {% endif %}
    </div>
{% endmacro %}

{# Rendu sans chrome propre : le shell de la card "Suivi" vit dans
   show.html.twig, comme ContactFollowUp / ContactNotes sur la fiche contact. #}
<div
    {{ attributes.defaults({
        class: 'contents',
        'data-controller': 'leave-guard',
        'data-leave-guard-clean-event-value': 'dossier-notes:saved',
        'data-leave-guard-message-value': 'admin.contacts.notes.unsaved'|trans,
        'data-action': 'input->leave-guard#markDirty change->leave-guard#markDirty',
    }) }}
    data-testid="dossier-notes"
>
    {% set sourceContactReference = this.sourceContactReference %}
    <div class="flex items-center justify-between gap-4 p-3">
        <h2 class="font-medium text-gray-900">{{ 'admin.contacts.followUp.title'|trans }}</h2>
    </div>

    <div class="rounded-xl bg-white px-5 py-4 text-sm">
        {# Statut semi-automatique : chips manuelles, cadenas quand l'état
           est déduit (pièces en attente ou dossier clôturé). #}
        <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
            <p class="text-gray-600">{{ 'admin.dossiers.status.label'|trans }}</p>
            {% set effectiveStatus = this.effectiveStatus %}
            {% if not effectiveStatus.isManual %}
                <span
                    class="flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-50 px-3 py-1 text-sm font-medium text-gray-900"
                    title="{{ 'admin.dossiers.status.autoHint'|trans }}"
                    data-testid="dossier-status-auto"
                >
                    {{ ux_icon('lucide:lock', {class: 'size-3 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                    <span class="size-1.5 shrink-0 rounded-full {{ effectiveStatus.dotClass }}" aria-hidden="true"></span>
                    {{ effectiveStatus.labelKey|trans }}
                </span>
            {% else %}
                <div class="flex flex-wrap items-center gap-2">
                    {% for choice in this.statusChoices %}
                        {% if choice == effectiveStatus %}
                            <span class="flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-3 py-1 text-sm font-medium text-gray-900" data-testid="dossier-status-current">
                                <span class="size-1.5 shrink-0 rounded-full {{ choice.dotClass }}" aria-hidden="true"></span>
                                {{ choice.labelKey|trans }}
                            </span>
                        {% else %}
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="changeStatus"
                                data-live-value-param="{{ choice.value }}"
                                class="flex cursor-pointer items-center gap-2 rounded-full border border-dashed border-gray-300 px-3 py-1 text-sm text-gray-500 transition-colors duration-100 ease-out hover:border-gray-400 hover:text-gray-900"
                                data-testid="dossier-status-choice"
                            >
                                <span class="size-1.5 shrink-0 rounded-full {{ choice.dotClass }} opacity-50" aria-hidden="true"></span>
                                {{ choice.labelKey|trans }}
                            </button>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
            <p class="text-gray-600">{{ 'admin.contacts.followUp.assignee'|trans }}</p>
            {{ _self.managerChips(this.manager, this.managerChoices) }}
        </div>
        {# Clôture : purge des pièces + rotation du lien de dépôt. La
           chronologie du dossier vit dans le tiroir Suivi et notes, comme
           le fil de suivi de la fiche contact. #}
        <div class="mt-4 border-t border-gray-950/5 pt-4">
            {% if this.closedAt %}
                <div class="flex items-center justify-between gap-3">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600" data-testid="dossier-closed-badge">
                        {{ ux_icon('lucide:archive', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                        {{ 'admin.dossiers.show.closure.badge'|trans }}
                    </span>
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="reopen"
                        class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                        data-testid="dossier-reopen"
                    >
                        {{ ux_icon('lucide:archive-restore', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                        {{ 'admin.dossiers.show.closure.reopen'|trans }}
                    </button>
                </div>
            {% else %}
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="askClose"
                    class="flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-2 text-xs font-medium text-gray-500 transition-colors duration-100 ease-out hover:border-red-200 hover:bg-red-50 hover:text-red-700"
                    data-testid="dossier-close"
                >
                    {{ ux_icon('lucide:archive', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                    {{ 'admin.dossiers.show.closure.close'|trans }}
                </button>
            {% endif %}
        </div>

        {% if this.confirmingClosure %}
            <div
                class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
                role="dialog"
                aria-modal="true"
                aria-labelledby="dossier-close-title"
                data-controller="modal-focus modal-anim"
                data-action="keydown.esc@window->modal-anim#out keydown.esc@window->live#action"
                data-live-action-param="cancelClose"
                data-testid="dossier-close-modal"
            >
                <button
                    type="button"
                    class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                    data-action="modal-anim#out live#action"
                    data-live-action-param="cancelClose"
                    aria-label="{{ 'admin.contacts.notes.cancel'|trans }}"
                    tabindex="-1"
                ></button>
                <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                    <div class="rounded-2xl bg-neutral-50 p-2">
                        <div class="p-3">
                            <h2 id="dossier-close-title" class="text-lg font-semibold tracking-tight text-gray-900">
                                {{ 'admin.dossiers.show.closure.modal.title'|trans }}
                            </h2>
                            <p class="mt-1 text-sm text-pretty text-gray-500">
                                {{ 'admin.dossiers.show.closure.modal.text'|trans }}
                            </p>
                        </div>
                        <div class="flex items-center justify-end gap-4 p-3">
                            <button
                                type="button"
                                data-action="modal-anim#out live#action"
                                data-live-action-param="cancelClose"
                                class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                                data-testid="dossier-close-cancel"
                            >
                                {{ 'admin.contacts.notes.cancel'|trans }}
                            </button>
                            <button
                                type="button"
                                data-action="modal-anim#out live#action"
                                data-live-action-param="confirmClose"
                                data-loading="action(confirmClose)|addAttribute(disabled)"
                                class="flex cursor-pointer items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-red-700 disabled:cursor-default disabled:opacity-60"
                                data-testid="dossier-close-confirm"
                            >
                                <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(confirmClose)|removeClass(hidden)" />
                                {{ ux_icon('lucide:archive', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(confirmClose)|addClass(hidden)'}) }}
                                {{ 'admin.dossiers.show.closure.modal.confirm'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>


    {# ── Accès au fil de notes : rangée-tiroir, comme la fiche contact. ── #}
    {% set noteRows = this.feed %}
    {% set notesCount = noteRows|length + this.hiddenFeedCount %}
    <div class="mt-1 flex flex-col overflow-hidden rounded-xl bg-white">
        <button
            type="button"
            data-action="live#action"
            data-live-action-param="openNotes"
            class="flex w-full cursor-pointer items-center gap-2 px-4 py-3 text-left text-sm font-medium text-gray-700 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-primary"
            data-testid="dossier-notes-drawer-open"
        >
            {{ ux_icon('lucide:message-square-text', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
            {{ 'admin.contacts.drawer.notes'|trans }}
            <span
                class="inline-flex min-w-5 items-center justify-center rounded-full bg-neutral-100 px-1.5 py-0.5 text-[11px] leading-none font-semibold text-gray-600 tabular-nums {{ notesCount == 0 ? 'hidden' }}"
                data-testid="dossier-notes-count-badge"
            >{{ notesCount }}</span>
            {{ ux_icon('lucide:chevron-right', {class: 'ml-auto size-4 shrink-0 text-gray-300', 'aria-hidden': 'true'}) }}
        </button>
    </div>

    <div class="flex justify-end px-3 pt-1 pb-1">
        <p class="text-xs font-medium text-gray-400 tabular-nums" data-testid="dossier-notes-reference">{{ this.reference }}</p>
    </div>

    {# ── Tiroir des notes : toujours dans le DOM (le fil reste indexable par
       les tests et le morph), masqué via `hidden` piloté par le serveur pour
       survivre aux re-rendus des actions de notes. Pas d'animation : même
       raison que la modale d'invitation. #}
    <div class="fixed inset-0 z-50" {% if not this.notesOpen %}hidden{% endif %} data-testid="dossier-notes-drawer">
        <button
            type="button"
            data-action="live#action"
            data-live-action-param="closeNotes"
            class="animate-drawer-backdrop absolute inset-0 cursor-default bg-gray-950/40 backdrop-blur-[1px]"
            aria-label="{{ 'admin.contacts.drawer.close'|trans }}"
            tabindex="-1"
        ></button>
        <aside
            class="animate-drawer-panel absolute inset-y-0 right-0 flex w-full max-w-md flex-col bg-white shadow-2xl"
            role="dialog"
            aria-modal="true"
            aria-label="{{ 'admin.contacts.drawer.notes'|trans }}"
            {% if this.notesOpen %}
                {# Échap ne s'écoute que tiroir ouvert : pas de requête live
                   parasite sur chaque Échap ailleurs dans la page. #}
                data-action="keydown.esc@window->live#action"
                data-live-action-param="closeNotes"
            {% endif %}
        >
            <div class="flex items-center justify-between gap-4 border-b border-gray-950/5 px-5 py-4">
                <h2 class="font-medium text-gray-900">{{ 'admin.contacts.drawer.notes'|trans }}</h2>
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="closeNotes"
                    class="flex size-8 cursor-pointer items-center justify-center rounded-lg text-gray-400 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900"
                    aria-label="{{ 'admin.contacts.drawer.close'|trans }}"
                    data-testid="dossier-notes-drawer-close"
                >
                    {{ ux_icon('lucide:x', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                </button>
            </div>

            {# ── Zone scrollable : fil des notes puis chronologie, même
                  style que le tiroir de la fiche lead. ──────────────────── #}
            <div class="min-h-0 flex-1 overflow-y-auto bg-neutral-50 p-2">
                <div class="rounded-xl bg-white px-5 py-4">
                    <p class="text-xs font-medium tracking-wide text-gray-400 uppercase">{{ 'admin.contacts.notes.title'|trans }}</p>
                    {% if noteRows is empty %}
                        <div class="flex flex-col items-center gap-1 py-6 text-center" data-testid="dossier-notes-empty">
                            {{ ux_icon('lucide:message-square-dashed', {class: 'size-5 shrink-0 text-gray-300', 'aria-hidden': 'true'}) }}
                            <p class="mt-1 text-sm font-medium text-gray-500">{{ 'admin.contacts.notes.empty'|trans }}</p>
                            <p class="max-w-60 text-xs text-pretty text-gray-400">{{ 'admin.contacts.notes.emptyHint'|trans }}</p>
                        </div>
                    {% else %}
                        <ul class="mt-3 divide-y divide-gray-950/5" role="list">
                            {% for row in noteRows %}
                                {% set note = row.note %}
                                <li class="animate-slide-in flex gap-3 py-4 first:pt-1 last:pb-0" data-controller="fade-exit" data-testid="dossier-note">
                                    <twig:Avatar filename="{{ note.authorAvatar }}" name="{{ note.authorName }}" size="8" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                                            <p class="flex items-baseline gap-2 text-sm">
                                                <span class="font-medium text-gray-900">{{ note.authorName|title }}</span>
                                                {% set noteDay = note.createdAt|date('Y-m-d') %}
                                                <span class="text-xs text-gray-400 tabular-nums" title="{{ note.createdAt|format_datetime('medium', 'short') }}">
                                                    {%- if noteDay == 'now'|date('Y-m-d') -%}
                                                        {{ note.createdAt|format_datetime(pattern="HH'h'mm") }}
                                                    {%- elseif noteDay == '-1 day'|date('Y-m-d') -%}
                                                        {{ 'admin.contacts.notes.yesterday'|trans }} {{ note.createdAt|format_datetime(pattern="HH'h'mm") }}
                                                    {%- else -%}
                                                        {{ note.createdAt|format_datetime(pattern='dd.MM.yy') }}
                                                    {%- endif -%}
                                                </span>
                                            </p>
                                            {% if this.editingNoteId != note.id and (row.canEdit or row.canDelete) %}
                                                {# Actions de la note en menu shadcn : … → Modifier / Supprimer. #}
                                                <details
                                                    class="relative"
                                                    data-controller="details-dropdown"
                                                    data-action="click@window->details-dropdown#closeOnOutside keydown.esc@window->details-dropdown#close"
                                                    data-testid="dossier-note-actions"
                                                >
                                                    <summary
                                                        class="flex size-7 cursor-pointer list-none items-center justify-center rounded-lg text-gray-400 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900 [&::-webkit-details-marker]:hidden"
                                                        aria-label="{{ 'admin.contacts.show.actions'|trans }}"
                                                    >
                                                        {{ ux_icon('lucide:ellipsis', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                    </summary>
                                                    <div class="absolute right-0 z-20 mt-1 w-40 rounded-lg border border-neutral-200 bg-white p-1 text-left shadow-md">
                                                        {% if row.canEdit %}
                                                            <button
                                                                type="button"
                                                                data-action="live#action details-dropdown#close"
                                                                data-live-action-param="startEdit"
                                                                data-live-id-param="{{ note.id }}"
                                                                class="flex w-full cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm text-gray-700 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900"
                                                                data-testid="dossier-note-edit"
                                                            >
                                                                {{ ux_icon('lucide:pencil', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                                                                {{ 'admin.contacts.notes.edit'|trans }}
                                                            </button>
                                                        {% endif %}
                                                        {% if row.canDelete %}
                                                            {% if row.canEdit %}
                                                                <div class="-mx-1 my-1 h-px bg-neutral-200/70" aria-hidden="true"></div>
                                                            {% endif %}
                                                            <button
                                                                type="button"
                                                                data-action="fade-exit#run live#action details-dropdown#close"
                                                                data-live-action-param="delete"
                                                                data-live-id-param="{{ note.id }}"
                                                                class="flex w-full cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm text-red-600 transition-colors duration-100 ease-out hover:bg-red-50"
                                                                data-testid="dossier-note-delete"
                                                            >
                                                                {{ ux_icon('lucide:trash-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                                                {{ 'admin.contacts.notes.delete'|trans }}
                                                            </button>
                                                        {% endif %}
                                                    </div>
                                                </details>
                                            {% endif %}
                                        </div>

                                        {% if this.editingNoteId == note.id %}
                                            <div class="mt-2 flex flex-col gap-2">
                                                <textarea
                                                    data-model="norender|editingText"
                                                    data-action="keydown.enter->live#action:prevent"
                                                    data-live-action-param="saveEdit"
                                                    rows="3"
                                                    title="{{ 'admin.contacts.notes.enterHint'|trans }}"
                                                    class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 focus:border-gray-400 focus:outline-none"
                                                >{{ this.editingText }}</textarea>
                                                <div class="flex items-center justify-end gap-3">
                                                    <button
                                                        type="button"
                                                        data-action="live#action"
                                                        data-live-action-param="cancelEdit"
                                                        class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                                                    >
                                                        {{ 'admin.contacts.notes.cancel'|trans }}
                                                    </button>
                                                    <twig:Button
                                                        size="sm"
                                                        data-action="live#action"
                                                        data-live-action-param="saveEdit"
                                                        data-loading="action(saveEdit)|addAttribute(disabled)"
                                                    >
                                                        <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(saveEdit)|removeClass(hidden)" />
                                                        {{ 'admin.contacts.notes.save'|trans }}
                                                    </twig:Button>
                                                </div>
                                            </div>
                                        {% else %}
                                            <p class="mt-1 text-sm leading-relaxed text-pretty whitespace-pre-line text-gray-900">{{ note.text }}</p>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                        {% if this.hiddenFeedCount > 0 %}
                            <div class="flex justify-center border-t border-gray-950/5 pt-3">
                                <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-action-param="showMoreFeed"
                                    class="flex cursor-pointer items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium text-gray-500 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900"
                                    data-testid="dossier-notes-show-more"
                                >
                                    {{ ux_icon('lucide:plus', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.contacts.notes.showMore'|trans({'%count%': this.hiddenFeedCount}) }}
                                </button>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>

                {# ── Chronologie du dossier : création, précédée de la demande
                      d'origine, puis le fil d'événements, repliable comme
                      l'historique de la fiche lead. ───────────────────────── #}
                <details {{ this.historyExpanded ? 'open' }} class="group details-animated mt-2 rounded-xl bg-white" data-testid="dossier-history">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between px-5 py-4 [&::-webkit-details-marker]:hidden"
                        data-action="live#action"
                        data-live-action-param="toggleHistory"
                    >
                        <p class="text-xs font-medium tracking-wide text-gray-400 uppercase">{{ 'admin.dossiers.show.followUp.timeline'|trans }}</p>
                        {{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-gray-300 transition-transform duration-200 ease-out group-open:rotate-180', 'aria-hidden': 'true'}) }}
                    </summary>
                    <div class="px-5 pb-4 text-sm">
                        <ol class="relative ml-1.5 space-y-3 border-l border-gray-950/10 pl-5">
                            {% if sourceContactReference %}
                                <li class="relative" data-testid="dossier-origin">
                                    <span class="absolute top-1 -left-[26px] size-2.5 rounded-full border-2 border-white bg-blue-400" aria-hidden="true"></span>
                                    {# La référence reste lisible, mais elle
                                       n'est cliquable qu'avec la section
                                       Leads (sinon le clic finit en 403). #}
                                    {% set canOpenContact = is_granted('ROLE_SECTION_CONTACTS') %}
                                    <p class="text-gray-900">
                                        {{ 'admin.dossiers.show.followUp.origin'|trans }}
                                        {% if canOpenContact %}
                                            <a
                                                href="{{ path('admin_contact_show', {adminPrefix: this.adminPrefix, reference: sourceContactReference}) }}"
                                                class="text-xs font-medium text-primary transition-colors duration-100 hover:text-primary/80 tabular-nums"
                                                data-testid="dossier-origin-link"
                                            >({{ sourceContactReference }})</a>
                                        {% else %}
                                            <span class="text-xs font-medium text-gray-500 tabular-nums" data-testid="dossier-origin-ref">({{ sourceContactReference }})</span>
                                        {% endif %}
                                    </p>
                                </li>
                            {% endif %}
                            <li class="relative">
                                <span class="absolute top-1 -left-[26px] size-2.5 rounded-full border-2 border-white bg-gray-300" aria-hidden="true"></span>
                                <p class="text-gray-900">{{ 'admin.dossiers.show.facts.createdAt'|trans }}</p>
                                <p class="mt-0.5 text-xs text-gray-400 tabular-nums">{{ this.createdAt|format_datetime('medium', 'short') }}</p>
                            </li>
                            {% if this.hiddenEventsCount > 0 %}
                                <li class="relative">
                                    <span class="absolute top-1 -left-[25px] size-2 rounded-full border-2 border-white bg-gray-200" aria-hidden="true"></span>
                                    <button
                                        type="button"
                                        data-action="live#action"
                                        data-live-action-param="showMoreEvents"
                                        class="flex cursor-pointer items-center gap-1.5 text-xs font-medium text-gray-500 transition-colors duration-100 ease-out hover:text-gray-900"
                                        data-testid="dossier-feed-show-more"
                                    >
                                        {{ ux_icon('lucide:plus', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.contacts.notes.showMore'|trans({'%count%': this.hiddenEventsCount}) }}
                                    </button>
                                </li>
                            {% endif %}
                            {% for event in this.events|reverse %}
                                <li class="relative" data-testid="dossier-event">
                                    <span class="absolute top-1 -left-[26px] size-2.5 rounded-full border-2 border-white bg-gray-300" aria-hidden="true"></span>
                                    <p class="text-gray-900">{{ event.text }}</p>
                                    {% set eventDay = event.createdAt|date('Y-m-d') %}
                                    {# Auteur en clair, sans vignette : à 16 px l'avatar
                                       n'était qu'une pastille d'initiale illisible, et il
                                       cassait la ligne meta au moindre repli. Le nom seul
                                       suffit à savoir qui a fait le geste. #}
                                    <p
                                        class="mt-0.5 text-xs leading-5 text-gray-400"
                                        title="{{ event.createdAt|format_datetime('medium', 'short') }}"
                                    >
                                        {%- if event.authorName -%}
                                            <span class="text-gray-500" data-testid="dossier-event-author">{{ event.authorName|title }}</span>
                                            <span aria-hidden="true"> &middot; </span>
                                        {%- endif -%}
                                        <span class="tabular-nums">
                                            {%- if eventDay == 'now'|date('Y-m-d') -%}
                                                {{ event.createdAt|format_datetime(pattern="HH'h'mm") }}
                                            {%- elseif eventDay == '-1 day'|date('Y-m-d') -%}
                                                {{ 'admin.contacts.notes.yesterday'|trans }} {{ event.createdAt|format_datetime(pattern="HH'h'mm") }}
                                            {%- else -%}
                                                {{ event.createdAt|format_datetime(pattern='dd.MM.yy') }}
                                            {%- endif -%}
                                        </span>
                                    </p>
                                </li>
                            {% endfor %}
                            {% if this.closedAt %}
                                <li class="relative" data-testid="dossier-closed-entry">
                                    <span class="absolute top-1 -left-[26px] size-2.5 rounded-full border-2 border-white bg-gray-500" aria-hidden="true"></span>
                                    <p class="text-gray-900">{{ 'admin.dossiers.show.closure.closedAt'|trans }}</p>
                                    <p class="mt-0.5 text-xs text-gray-400 tabular-nums">{{ this.closedAt|format_datetime('medium', 'short') }}</p>
                                </li>
                            {% endif %}
                        </ol>
                    </div>
                </details>
            </div>

            {# ── Composer épinglé en bas du tiroir, façon messagerie. ──── #}
            <div class="shrink-0 border-t border-gray-950/5 bg-white p-3">
                <textarea
                    data-model="norender|newNote"
                    data-action="keydown.enter->live#action:prevent"
                    data-live-action-param="add"
                    rows="2"
                    placeholder="{{ 'admin.contacts.notes.placeholder'|trans }}"
                    aria-label="{{ 'admin.contacts.notes.placeholder'|trans }}"
                    title="{{ 'admin.contacts.notes.enterHint'|trans }}"
                    class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                >{{ this.newNote }}</textarea>
                <div class="mt-2 flex items-center justify-between gap-3">
                    <p class="flex min-w-0 items-center gap-1.5 text-[11px] text-gray-400">
                        {{ ux_icon('lucide:lock', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                        <span class="truncate">{{ 'admin.contacts.notes.internal'|trans }}</span>
                    </p>
                    <twig:Button
                        size="sm"
                        data-action="live#action"
                        data-live-action-param="add"
                        data-loading="action(add)|addAttribute(disabled)"
                        data-testid="dossier-notes-add"
                    >
                        <twig:Spinner class="hidden size-4 shrink-0" data-loading="action(add)|removeClass(hidden)" />
                        {{ 'admin.contacts.notes.add'|trans }}
                    </twig:Button>
                </div>
            </div>
        </aside>
    </div>
</div>
