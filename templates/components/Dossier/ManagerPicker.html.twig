{#
    Dossier:ManagerPicker — "responsable de dossier" chip in the detail page
    header. Closed state shows the assigned staff member (or an assign CTA);
    the dropdown lists admin/editor users, with an unassign row when someone
    is assigned. Same <details> dropdown mechanics as Admin:ContactCreate.
#}
{% set manager = this.manager %}

<div {{ attributes.defaults({class: 'shrink-0'}) }} data-testid="dossier-manager">
    <details
        class="relative"
        data-controller="details-dropdown"
        data-action="click@window->details-dropdown#closeOnOutside keydown.esc@window->details-dropdown#close"
    >
        <summary
            class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-neutral-200 bg-white py-1 pr-2.5 pl-1 transition-colors duration-100 ease-out hover:bg-gray-50 [&::-webkit-details-marker]:hidden"
            data-testid="dossier-manager-toggle"
        >
            {% if manager %}
                <twig:Avatar
                    filename="{{ manager.avatarFilename }}"
                    name="{{ manager.fullName }}"
                    email="{{ manager.email }}"
                    size="6"
                />
                <span class="max-w-40 truncate text-sm font-medium text-gray-900" data-testid="dossier-manager-name">{{ manager.fullName }}</span>
            {% else %}
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-400">
                    {{ ux_icon('lucide:user-plus', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                </span>
                <span class="text-sm font-medium text-gray-600">{{ 'admin.dossiers.show.manager.assign'|trans }}</span>
            {% endif %}
            {{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
        </summary>
        <div class="absolute right-0 z-10 mt-2 w-64 rounded-xl border border-neutral-200 bg-white p-1 shadow-lg">
            <p class="px-3 pt-2 pb-1 text-xs font-semibold tracking-wide text-gray-400 uppercase">
                {{ 'admin.dossiers.show.manager.label'|trans }}
            </p>
            {% for choice in this.choices %}
                <button
                    type="button"
                    data-action="live#action details-dropdown#close"
                    data-live-action-param="chooseManager"
                    data-live-key-param="{{ choice.id }}"
                    class="flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm transition-colors duration-100 ease-out {{ manager and choice.id == manager.id ? 'bg-neutral-100 font-medium text-gray-900' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                    data-testid="dossier-manager-choice"
                >
                    <twig:Avatar
                        filename="{{ choice.avatarFilename }}"
                        name="{{ choice.fullName }}"
                        email="{{ choice.email }}"
                        size="8"
                    />
                    <span class="min-w-0 flex-1">
                        <span class="block truncate">{{ choice.fullName }}</span>
                        <span class="block truncate text-xs text-gray-400">{{ choice.email }}</span>
                    </span>
                    {% if manager and choice.id == manager.id %}
                        {{ ux_icon('lucide:check', {class: 'size-4 shrink-0 text-primary', 'aria-hidden': 'true'}) }}
                    {% endif %}
                </button>
            {% endfor %}
            {% if manager %}
                <div class="mt-1 border-t border-gray-950/5 pt-1">
                    <button
                        type="button"
                        data-action="live#action details-dropdown#close"
                        data-live-action-param="removeManager"
                        class="flex w-full cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-left text-sm text-gray-500 transition-colors duration-100 ease-out hover:bg-red-50 hover:text-red-600"
                        data-testid="dossier-manager-remove"
                    >
                        {{ ux_icon('lucide:user-x', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                        {{ 'admin.dossiers.show.manager.remove'|trans }}
                    </button>
                </div>
            {% endif %}
        </div>
    </details>
</div>
