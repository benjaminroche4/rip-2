{#
    RealEstateAgent:AgentCreate — "new agent" form on its dedicated admin
    page. Identity plus optional agency and contact details. Card shell and
    spacing follow the BO conventions (white shell, grey inner, white bands).
#}

{% macro input(field, label, type, required = true) %}
    {% set hasErrors = field.vars.errors|length > 0 %}
    <div class="min-w-0">
        <twig:Label for="{{ field.vars.id }}" class="text-gray-600">
            {{ label|trans }}
            {% if required %}<span class="text-red-600" aria-hidden="true">*</span>{% endif %}
        </twig:Label>
        <div class="mt-1.5">
            <input
                type="{{ type }}"
                id="{{ field.vars.id }}"
                name="{{ field.vars.full_name }}"
                value="{{ field.vars.value }}"
                {% if field.vars.attr.maxlength is defined %}maxlength="{{ field.vars.attr.maxlength }}"{% endif %}
                {% if field.vars.attr.placeholder is defined %}placeholder="{{ field.vars.attr.placeholder }}"{% endif %}
                {% if required %}required{% endif %}
                aria-invalid="{{ hasErrors ? 'true' : 'false' }}"
                class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
            >
            {% for error in field.vars.errors %}
                <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% macro chips(field) %}
    {# Même vocabulaire de chips que le choix de rôle du modal dossier. #}
    <div role="radiogroup" aria-labelledby="{{ field.vars.id }}-label" class="mt-2 flex flex-wrap gap-2">
        {% for choice in field.children %}
            <label for="{{ choice.vars.id }}" class="flex cursor-pointer items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-gray-400 hover:text-gray-900 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5 has-[input:checked]:text-primary">
                <input
                    type="radio"
                    id="{{ choice.vars.id }}"
                    name="{{ choice.vars.full_name }}"
                    value="{{ choice.vars.value }}"
                    {% if choice.vars.checked %}checked{% endif %}
                    class="sr-only"
                />
                {{ ux_icon(choice.vars.value == 'agency' ? 'lucide:building-2' : 'lucide:user', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                {{ choice.vars.label|trans }}
            </label>
        {% endfor %}
    </div>
{% endmacro %}

{% import _self as ui %}

<div {{ attributes }} data-testid="agent-create">
    <form
        class="w-full max-w-2xl rounded-3xl border border-neutral-200 bg-white p-2"
        data-action="live#action:prevent"
        data-live-action-param="create"
        data-model="on(change)|*"
        novalidate
        autocomplete="off"
        data-testid="agent-create-form"
        aria-labelledby="agent-create-title"
    >
        <div class="space-y-3 rounded-2xl bg-neutral-50 p-2">
            <div class="p-3 pb-0">
                <h2 id="agent-create-title" class="text-lg font-semibold tracking-tight text-gray-900">{{ 'admin.agents.create.title'|trans }}</h2>
                <p class="mt-1 text-sm text-pretty text-gray-500">{{ 'admin.agents.create.subtitle'|trans }}</p>
            </div>

            <div class="rounded-xl bg-white px-4 py-4">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    {# Statut demandé en premier : le champ agence n'apparaît
                       que pour un agent en agence (le composant re-rend au change). #}
                    <div class="sm:col-span-2">
                        <p id="{{ form.kind.vars.id }}-label" class="text-sm text-gray-600">
                            {{ 'admin.agents.create.kind.label'|trans }}
                            <span class="text-red-600" aria-hidden="true">*</span>
                        </p>
                        {{ ui.chips(form.kind) }}
                    </div>
                    {% if form.kind.vars.value == 'agency' %}
                        <div class="sm:col-span-2" data-testid="agent-create-agency-block">
                            {# Autocomplétion sur les agences existantes : un nom
                               connu réutilise l'agence, un nouveau la crée. #}
                            <twig:Label for="{{ form.agencyName.vars.id }}" class="text-gray-600">
                                {{ 'admin.agents.create.agency.label'|trans }}
                                <span class="text-red-600" aria-hidden="true">*</span>
                            </twig:Label>
                            <div class="mt-1.5">
                                <input
                                    type="text"
                                    id="{{ form.agencyName.vars.id }}"
                                    name="{{ form.agencyName.vars.full_name }}"
                                    value="{{ form.agencyName.vars.value }}"
                                    maxlength="100"
                                    list="agent-create-agency-options"
                                    placeholder="{{ 'admin.agents.create.agency.placeholder'|trans }}"
                                    aria-invalid="{{ form.agencyName.vars.errors|length > 0 ? 'true' : 'false' }}"
                                    class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                                    data-testid="agent-create-agency"
                                >
                                <datalist id="agent-create-agency-options">
                                    {% for name in this.agencyNames %}
                                        <option value="{{ name }}"></option>
                                    {% endfor %}
                                </datalist>
                                <p class="mt-1.5 text-xs text-gray-400">{{ 'admin.agents.create.agency.help'|trans }}</p>
                                {% for error in form.agencyName.vars.errors %}
                                    <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                                {% endfor %}
                            </div>
                        </div>
                        {# Poste dans l'agence : chips single avec toggle-off
                           (recliquer le chip actif le désélectionne via la
                           LiveAction, un radio natif ne sait pas se décocher).
                           Masqué côté indépendant : hors contexte. #}
                        <div class="sm:col-span-2" data-testid="agent-create-position-block">
                            <p id="{{ form.position.vars.id }}-label" class="text-sm text-gray-600">
                                {{ 'admin.agents.create.position.label'|trans }}
                            </p>
                            {% set currentPosition = form.position.vars.value %}
                            <div role="group" aria-labelledby="{{ form.position.vars.id }}-label" class="mt-2 flex flex-wrap gap-2">
                                {% for choice in form.position.children %}
                                    {% set active = currentPosition == choice.vars.value %}
                                    <button
                                        type="button"
                                        aria-pressed="{{ active ? 'true' : 'false' }}"
                                        data-action="live#action"
                                        data-live-action-param="togglePosition"
                                        data-live-position-param="{{ choice.vars.value }}"
                                        class="cursor-pointer rounded-full border px-3 py-1.5 text-sm font-medium transition-colors duration-100 ease-out {{ active ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:border-gray-400 hover:text-gray-900' }}"
                                        data-testid="agent-create-position-{{ choice.vars.value }}"
                                    >
                                        {{ choice.vars.label|trans }}
                                    </button>
                                {% endfor %}
                            </div>
                            {% for error in form.position.vars.errors %}
                                <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                            {% endfor %}
                        </div>
                    {% endif %}
                    {{ ui.input(form.firstName, 'admin.agents.create.firstName.label', 'text') }}
                    {{ ui.input(form.lastName, 'admin.agents.create.lastName.label', 'text') }}
                    {# Spécialités : chips multi (cases à cocher stylées), un
                       agent peut faire location et transaction. #}
                    <div class="sm:col-span-2" data-testid="agent-create-specialties-block">
                        <p id="{{ form.specialties.vars.id }}-label" class="text-sm text-gray-600">
                            {{ 'admin.agents.create.specialties.label'|trans }}
                        </p>
                        <div role="group" aria-labelledby="{{ form.specialties.vars.id }}-label" class="mt-2 flex flex-wrap gap-2">
                            {% for choice in form.specialties.children %}
                                <label for="{{ choice.vars.id }}" class="flex cursor-pointer items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-gray-400 hover:text-gray-900 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5 has-[input:checked]:text-primary">
                                    <input
                                        type="checkbox"
                                        id="{{ choice.vars.id }}"
                                        name="{{ choice.vars.full_name }}"
                                        value="{{ choice.vars.value }}"
                                        {% if choice.vars.checked %}checked{% endif %}
                                        class="sr-only"
                                        data-testid="agent-create-specialty-{{ choice.vars.value }}"
                                    />
                                    {{ choice.vars.label|trans }}
                                </label>
                            {% endfor %}
                        </div>
                        {% for error in form.specialties.vars.errors %}
                            <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                        {% endfor %}
                    </div>
                    {{ ui.input(form.email, 'admin.agents.create.email.label', 'email', false) }}
                    <div class="min-w-0">
                        <twig:Label for="{{ form.phone.vars.id }}" class="text-gray-600">
                            {{ 'admin.agents.create.phone.label'|trans }}
                        </twig:Label>
                        {# Same intl-tel-input widget as the public contact form.
                           data-live-ignore: the widget builds its own DOM around
                           the input — morphing must leave the zone alone (the
                           value still syncs to the model via the change event). #}
                        <div
                            class="mt-1.5"
                            data-live-ignore
                            data-controller="phone-input"
                            data-phone-input-initial-country-value="fr"
                            data-phone-input-search-placeholder-value="{{ 'phoneInput.searchPlaceholder'|trans }}"
                        >
                            <input
                                type="tel"
                                id="{{ form.phone.vars.id }}"
                                name="{{ form.phone.vars.full_name }}"
                                value="{{ form.phone.vars.value }}"
                                maxlength="30"
                                placeholder="6 12 34 56 78"
                                data-phone-input-target="input"
                                class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                            >
                        </div>
                        {% for error in form.phone.vars.errors %}
                            <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-4 p-3 pt-0">
                {# Annuler = simple retour à la liste, aucun état à défaire. #}
                <a
                    href="{{ path('admin_agents', {adminPrefix: adminPrefix}) }}"
                    class="text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                    data-testid="agent-create-cancel"
                >
                    {{ 'admin.agents.create.cancel'|trans }}
                </a>
                {# data-loading disables the button while `create` runs — a
                   double-click would otherwise insert two agents. #}
                <button
                    type="submit"
                    data-loading="action(create)|addAttribute(disabled)"
                    class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60"
                    data-testid="agent-create-submit"
                >
                    <span data-loading="action(create)|addClass(hidden)" class="flex items-center gap-2">
                        {{ ux_icon('lucide:plus', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                        {{ 'admin.agents.create.submit'|trans }}
                    </span>
                    <span data-loading="action(create)|removeClass(hidden)" class="hidden flex items-center gap-2">
                        {{ ux_icon('lucide:loader-circle', {class: 'size-4 shrink-0 animate-spin', 'aria-hidden': 'true'}) }}
                        {{ 'admin.agents.create.submitting'|trans }}
                    </span>
                </button>
            </div>
        </div>
    </form>
</div>
