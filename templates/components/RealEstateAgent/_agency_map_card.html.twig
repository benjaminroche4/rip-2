{# Card de l'InfoWindow d'un pin agence sur la carte de l'annuaire : logo,
   identité, coordonnées avec icônes, et bouton primaire vers la fiche.
   Rendue côté serveur dans le contenu de l'InfoWindow Google (chrome
   standard conservé : bulle blanche + bouton fermer). #}
<div class="w-64 font-sans">
    <div class="flex items-center gap-2.5">
        {% if row.logoFilename %}
            <img
                src="{{ path('app_avatar', {path: row.logoFilename}) }}"
                alt=""
                width="36"
                height="36"
                class="size-9 shrink-0 rounded-xl object-cover"
            >
        {% else %}
            <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary/5 text-primary">
                {{ ux_icon('lucide:building-2', {class: 'size-4', 'aria-hidden': 'true'}) }}
            </span>
        {% endif %}
        <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-gray-900">{{ row.name }}</p>
            {% if row.brand %}
                <p class="truncate text-xs text-gray-500">{{ row.brand }}</p>
            {% endif %}
        </div>
    </div>

    <div class="mt-2.5 space-y-1.5">
        {% if row.address %}
            <p class="flex items-start gap-1.5 text-xs leading-5 text-gray-600">
                {{ ux_icon('lucide:map-pin', {class: 'mt-0.5 size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                <span class="min-w-0">{{ row.address }}</span>
            </p>
        {% endif %}
        {% if row.phone %}
            <a href="tel:{{ row.phone }}" class="flex items-center gap-1.5 text-xs text-gray-600 tabular-nums transition-colors duration-100 hover:text-gray-900">
                {{ ux_icon('lucide:phone', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                {{ row.phone|phone_format }}
            </a>
        {% endif %}
    </div>

    <a
        href="{{ link }}"
        class="mt-3 flex w-full items-center justify-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-xs font-semibold text-white transition-colors duration-100 ease-out hover:bg-primary/90"
        data-testid="agency-map-card-open"
    >
        {{ 'admin.agencies.card.open'|trans }}
        {{ ux_icon('lucide:arrow-right', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
    </a>
</div>
