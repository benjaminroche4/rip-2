{# Card agent, même famille que les cards Dossier/Leads : coque blanche
   rounded-3xl > puits gris > bandes blanches (colonnes label/valeur avec
   séparateurs en dégradé), note interne en bande dédiée, footer avec la
   date d'ajout et le bouton vers la fiche. #}

{% macro chips(agent) %}
    {% for specialty in agent.specialties %}
        <span class="shrink-0 rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-medium text-gray-600" data-testid="agent-specialty">{{ specialty.labelKey|trans }}</span>
    {% endfor %}
{% endmacro %}

{% macro identity(agent) %}
    <div class="flex min-w-0 items-center gap-3">
        <twig:Avatar filename="{{ agent.avatarFilename }}" name="{{ agent.fullName }}" size="9" />
        <div class="flex min-w-0 flex-wrap items-center gap-2">
            <p class="truncate font-medium text-gray-900">{{ agent.fullName|title }}</p>
            {% if not agent.active %}
                {# Badge appuyé (ambre) : la card désactivée est grisée en bloc, un
                   badge gris s'y noierait. #}
                <span class="shrink-0 rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700" data-testid="agent-inactive">{{ 'admin.agents.status.inactive'|trans }}</span>
            {% endif %}
            {{ _self.chips(agent) }}
        </div>
    </div>
{% endmacro %}

{% macro divider() %}
    <div class="hidden w-px self-stretch bg-linear-to-b from-transparent via-gray-950/10 to-transparent sm:block" aria-hidden="true"></div>
{% endmacro %}

{% macro colEmail(agent) %}
    <div class="min-w-0 space-y-2 text-sm sm:flex-1">
        <p class="text-gray-600">{{ 'admin.agents.create.email.label'|trans }}</p>
        {% if agent.email %}
            <a href="mailto:{{ agent.email }}" class="block truncate font-medium text-gray-900 transition-colors duration-100 hover:text-primary" data-testid="agent-email">{{ agent.email }}</a>
        {% else %}
            <p class="font-medium text-gray-400">-</p>
        {% endif %}
    </div>
{% endmacro %}

{% macro colPhone(agent) %}
    <div class="min-w-0 space-y-2 text-sm sm:flex-1">
        <p class="text-gray-600">{{ 'admin.agents.create.phone.label'|trans }}</p>
        {% if agent.phone %}
            {# Même affichage que la fiche lead : drapeau + numéro formaté. #}
            {% set phoneCountry = agent.phone|phone_country %}
            <a href="tel:{{ agent.phone }}" class="flex min-w-0 items-center gap-2 font-medium text-gray-900 transition-colors duration-100 hover:text-primary" data-testid="agent-phone">
                {% if phoneCountry %}
                    {{ ux_icon('circle-flags:' ~ phoneCountry, {class: 'size-4 shrink-0 rounded-full', 'aria-hidden': 'true'}) }}
                {% endif %}
                <span class="truncate">{{ agent.phone|phone_format }}</span>
            </a>
        {% else %}
            <p class="font-medium text-gray-400">-</p>
        {% endif %}
    </div>
{% endmacro %}

{% macro colPosition(agent) %}
    <div class="min-w-0 space-y-2 text-sm sm:flex-1">
        <p class="text-gray-600">{{ 'admin.agents.create.position.label'|trans }}</p>
        {% if agent.position %}
            <p class="truncate font-medium text-gray-900" data-testid="agent-position">{{ agent.position.labelKey|trans }}</p>
        {% else %}
            <p class="font-medium text-gray-400">-</p>
        {% endif %}
    </div>
{% endmacro %}

{% macro agencyBadge(agent, adminPrefix) %}
    {% if agent.agencyId %}
        {# Le chip agence est un raccourci vers sa fiche. #}
        <a
            href="{{ path('admin_agency_show', {adminPrefix: adminPrefix, reference: agent.agencyReference}) }}"
            class="group/agency relative z-10 flex min-w-0 shrink-0 items-center gap-2 rounded-xl border border-neutral-200 bg-white px-3.5 py-1.5 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5"
            data-testid="agent-agency"
        >
            {# Logo de l'agence quand elle en a un, icône générique sinon. #}
            {% if agent.agencyLogo %}
                <twig:Avatar filename="{{ agent.agencyLogo }}" name="{{ agent.agency }}" size="5" class="-my-0.5 rounded-md" />
            {% else %}
                {{ ux_icon('lucide:building-2', {class: 'size-4 shrink-0 text-gray-400 transition-colors duration-100 ease-out group-hover/agency:text-primary', 'aria-hidden': 'true'}) }}
            {% endif %}
            <span class="truncate text-sm font-medium text-gray-900 transition-colors duration-100 ease-out group-hover/agency:text-primary">{{ agent.agency }}</span>
        </a>
    {% else %}
        <span class="flex min-w-0 shrink-0 items-center gap-2 rounded-xl border border-neutral-200 bg-white px-3.5 py-1.5" data-testid="agent-agency">
            {{ ux_icon('lucide:building-2', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
            <span class="truncate text-sm font-medium text-gray-900">{{ 'admin.agents.card.noAgency'|trans }}</span>
        </span>
    {% endif %}
{% endmacro %}

{# ---- Macros card agence (même famille, signature visuelle distincte). ---- #}

{% macro agencyNameBadges(agency) %}
    {% if not agency.active %}
        {# Badge appuyé (ambre) : même raison que le badge agent, la card
           désactivée est grisée en bloc. #}
        <span class="shrink-0 rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700" data-testid="agency-inactive">{{ 'admin.agencies.status.inactive'|trans }}</span>
    {% endif %}
    {% if agency.brand %}
        <span class="shrink-0 rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-medium text-gray-600" data-testid="agency-brand">{{ agency.brand }}</span>
    {% endif %}
    {% for specialty in agency.specialties %}
        <span class="shrink-0 rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-medium text-gray-600" data-testid="agency-specialty">{{ specialty.labelKey|trans }}</span>
    {% endfor %}
{% endmacro %}

{# Logo carré : la signature qui distingue une agence d'un agent (rond). #}
{% macro agencyLogo(agency) %}
    {% if agency.logoFilename %}
        <twig:Avatar filename="{{ agency.logoFilename }}" name="{{ agency.name }}" size="9" class="rounded-xl" />
    {% else %}
        <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary/5 text-primary">
            {{ ux_icon('lucide:building-2', {class: 'size-4', 'aria-hidden': 'true'}) }}
        </span>
    {% endif %}
{% endmacro %}

{% macro colAreas(agency) %}
    <div class="min-w-0 space-y-2 text-sm sm:flex-1">
        <p class="text-gray-600">{{ 'admin.agencies.show.areas'|trans }}</p>
        {% if agency.allAreas %}
            <p class="truncate font-medium text-gray-900" data-testid="agency-areas">{{ 'admin.contacts.project.allAreas'|trans }}</p>
        {% elseif agency.areaLabels is not empty %}
            <p class="truncate font-medium text-gray-900" title="{{ agency.areaLabels|join(', ') }}" data-testid="agency-areas">{{ agency.areaLabels|join(', ') }}</p>
        {% else %}
            <p class="font-medium text-gray-400">-</p>
        {% endif %}
    </div>
{% endmacro %}

{% macro colBrand(agency) %}
    <div class="min-w-0 space-y-2 text-sm sm:flex-1">
        <p class="text-gray-600">{{ 'admin.agencies.create.brand.label'|trans }}</p>
        {% if agency.brand %}
            <p class="truncate font-medium text-gray-900">{{ agency.brand }}</p>
        {% else %}
            <p class="font-medium text-gray-400">-</p>
        {% endif %}
    </div>
{% endmacro %}

{% macro agencyNoteBand(agency) %}
    {% if agency.note %}
        <div class="rounded-b-xl bg-white px-5 py-4" data-testid="agency-note">
            <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">{{ 'admin.agencies.create.note.label'|trans }}</p>
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-pretty text-gray-900">{{ agency.note }}</p>
        </div>
    {% endif %}
{% endmacro %}

{% macro agencyFooter(agency, adminPrefix) %}
    <div class="mt-1 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-1 pb-1">
        <p class="flex items-center gap-1 pl-1 text-xs text-gray-900">
            <span class="opacity-50">{{ 'admin.agencies.show.createdAt'|trans }}</span>
            <span class="tabular-nums">{{ agency.createdAt|format_date('medium') }}</span>
        </p>
        <twig:Button
            as="a"
            size="sm"
            href="{{ path('admin_agency_show', {adminPrefix: adminPrefix, reference: agency.reference}) }}"
            class="px-10"
            data-testid="agency-row-link"
        >
            {{ 'admin.agencies.card.open'|trans }}
        </twig:Button>
    </div>
{% endmacro %}

<div {{ attributes }} data-testid="agents-list-component">
    {% set agenciesView = this.isAgenciesView %}

    {# Même gabarit que la liste des dossiers : colonne de filtres sticky à
       gauche (recherche + vues avec compteurs), contenu à droite. #}
    <div class="lg:grid lg:grid-cols-[15rem_1fr] lg:items-start lg:gap-6">
        <aside class="lg:sticky lg:top-6">
            <div class="relative">
                {{ ux_icon('lucide:search', {class: 'pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-gray-400', 'aria-hidden': 'true'}) }}
                <input
                    type="search"
                    data-model="debounce(300)|search"
                    value="{{ this.search }}"
                    placeholder="{{ 'admin.agents.searchPlaceholder'|trans }}"
                    aria-label="{{ 'admin.agents.searchPlaceholder'|trans }}"
                    class="w-full rounded-xl border border-neutral-200 bg-white py-2 pr-3.5 pl-9 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                    data-testid="agents-search"
                >
            </div>

            <div class="mt-4 flex flex-col gap-1.5" role="group" aria-label="{{ 'admin.agents.title'|trans }}" data-testid="agents-view-toggle">
                {% for viewKey in ['agents', 'agencies'] %}
                    {% set isActive = this.view == viewKey %}
                    <button
                        type="button"
                        aria-pressed="{{ isActive ? 'true' : 'false' }}"
                        data-action="live#action"
                        data-live-action-param="chooseView"
                        data-live-view-param="{{ viewKey }}"
                        class="flex cursor-pointer items-center gap-2 rounded-xl border px-3.5 py-2 text-left text-sm font-medium transition-colors duration-100 ease-out {{ isActive ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                        data-testid="agents-view-{{ viewKey }}"
                    >
                        {{ ux_icon({agents: 'lucide:user', agencies: 'lucide:building-2'}[viewKey], {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                        {{ ('admin.agents.view.' ~ viewKey)|trans }}
                        <span class="ml-auto text-xs {{ isActive ? 'text-primary/60' : 'text-gray-400' }} tabular-nums">{{ {agents: this.agentTotal, agencies: this.agencyTotal}[viewKey] }}</span>
                    </button>
                {% endfor %}
            </div>
        </aside>

        <div class="max-lg:mt-6">
            {# Tous / Favoris : même pastille glissante que la portée des
               dossiers, partagée par les deux vues (favoris agents ou agences
               selon la vue active). Côté agents s'ajoutent à gauche les
               filtres discrets spécialité + quartier; côté agences,
               l'affichage Liste / Carte. #}
            <div class="mb-4 flex flex-wrap items-center gap-3 {{ agenciesView ? 'justify-end' : 'justify-between' }}">
                {% if not agenciesView %}
                    {% set activeSpecialty = this.activeSpecialty %}
                    {% set activeArea = this.activeArea %}
                    <div class="flex flex-wrap items-center gap-2" data-testid="agents-filters">
                        {# Chips pill spécialité : single avec toggle-off. #}
                        {% for specialty in this.specialtyOptions %}
                            {% set specActive = activeSpecialty == specialty.value %}
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="toggleSpecialty"
                                data-live-specialty-param="{{ specialty.value }}"
                                aria-pressed="{{ specActive ? 'true' : 'false' }}"
                                class="cursor-pointer rounded-full border px-3 py-1.5 text-xs font-medium transition-colors duration-100 ease-out {{ specActive ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:border-gray-400 hover:text-gray-900' }}"
                                data-testid="agents-filter-{{ specialty.value }}"
                            >{{ specialty.labelKey|trans }}</button>
                        {% endfor %}
                        {# Dropdown quartier compact : summary en chip pill,
                           panel scrollable des arrondissements + petite
                           couronne, « Tous les quartiers » en tête pour
                           effacer. #}
                        <details
                            class="relative"
                            data-controller="details-dropdown"
                            data-action="click@window->details-dropdown#closeOnOutside keydown.esc@window->details-dropdown#close"
                            data-testid="agents-filter-area"
                        >
                            <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors duration-100 ease-out [&::-webkit-details-marker]:hidden {{ activeArea != '' ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:border-gray-400 hover:text-gray-900' }}">
                                {{ ux_icon('lucide:map-pin', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                <span class="whitespace-nowrap">{{ activeArea != '' ? this.areaOptions[activeArea] : 'admin.agents.filter.area'|trans }}</span>
                                {{ ux_icon('lucide:chevron-down', {class: 'size-3.5 shrink-0 opacity-60', 'aria-hidden': 'true'}) }}
                            </summary>
                            <div class="absolute left-0 z-10 mt-2 max-h-72 w-56 overflow-y-auto rounded-xl border border-neutral-200 bg-white p-1 shadow-lg">
                                <button
                                    type="button"
                                    data-action="live#action click->details-dropdown#close"
                                    data-live-action-param="chooseArea"
                                    data-live-area-param=""
                                    class="flex w-full cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-left text-sm font-medium transition-colors duration-100 ease-out {{ activeArea == '' ? 'text-primary' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                                    data-testid="agents-filter-area-option-all"
                                >
                                    {{ 'admin.agents.filter.allAreas'|trans }}
                                    {% if activeArea == '' %}
                                        {{ ux_icon('lucide:check', {class: 'ml-auto size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                    {% endif %}
                                </button>
                                {% for code, label in this.areaOptions %}
                                    <button
                                        type="button"
                                        data-action="live#action click->details-dropdown#close"
                                        data-live-action-param="chooseArea"
                                        data-live-area-param="{{ code }}"
                                        class="flex w-full cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-left text-sm font-medium transition-colors duration-100 ease-out {{ activeArea == code ? 'text-primary' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                                        data-testid="agents-filter-area-option-{{ code }}"
                                    >
                                        {{ label }}
                                        {% if activeArea == code %}
                                            {{ ux_icon('lucide:check', {class: 'ml-auto size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                        {% endif %}
                                    </button>
                                {% endfor %}
                            </div>
                        </details>
                    </div>
                {% endif %}
                <div
                    class="inline-flex rounded-2xl border border-neutral-200 bg-white p-1.5"
                    data-controller="tabs"
                    data-tabs
                    data-active-tab="{{ this.tab }}"
                    data-tabs-active-class="text-primary"
                    data-tabs-inactive-class="text-gray-600 hover:text-gray-900"
                    data-testid="agents-tab"
                >
                    <div class="isolate relative flex items-stretch" role="tablist" aria-label="{{ 'admin.agents.tab.label'|trans }}" data-action="mouseleave->tabs#resetIndicator">
                        <span
                            data-tabs-target="indicator"
                            class="absolute top-0 left-0 z-0 rounded-lg bg-neutral-100 transition-[transform,width,height] duration-200 ease-out will-change-transform motion-reduce:transition-none"
                            aria-hidden="true"
                            hidden
                        ></span>
                        {% for tabKey in ['all', 'favorites'] %}
                            {% if not loop.first %}
                                <span class="z-0 my-2 w-px shrink-0 bg-gray-950/10" aria-hidden="true"></span>
                            {% endif %}
                            <button
                                type="button"
                                role="tab"
                                aria-selected="{{ this.tab == tabKey ? 'true' : 'false' }}"
                                data-tabs-target="tab"
                                data-tabs-key="{{ tabKey }}"
                                data-action="live#action mouseenter->tabs#hoverIndicator"
                                data-live-action-param="chooseTab"
                                data-live-tab-param="{{ tabKey }}"
                                class="relative z-10 flex cursor-pointer items-center gap-1.5 rounded-xl px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors duration-100 ease-out {{ this.tab == tabKey ? 'text-primary' : 'text-gray-600 hover:text-gray-900' }}"
                                data-testid="agents-tab-{{ tabKey }}"
                            >
                                {% if tabKey == 'favorites' %}
                                    {{ ux_icon('lucide:heart', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                {% endif %}
                                {{ ('admin.agents.tab.' ~ tabKey)|trans }}
                                {% if tabKey == 'favorites' %}
                                    <span class="inline-flex min-w-5 items-center justify-center rounded-full border border-neutral-200 bg-white px-1.5 py-0.5 text-[11px] leading-none font-semibold text-gray-600 tabular-nums">{{ this.favoriteTotal }}</span>
                                {% endif %}
                            </button>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% if agenciesView %}
            {% set agencies = this.agencies %}
            {% if agencies is empty %}
                {% set agencyFavoritesEmpty = this.isFavoritesTab and this.search|trim == '' %}
                <section class="rounded-2xl border border-dashed border-gray-950/10 bg-white/50 p-2" data-testid="agencies-empty">
                    <div class="flex flex-col items-center justify-center gap-3 rounded-xl px-4 py-16 text-center">
                        <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-400">
                            {{ ux_icon(this.search|trim != '' ? 'lucide:search-x' : (agencyFavoritesEmpty ? 'lucide:heart' : 'lucide:building-2'), {class: 'size-6', 'aria-hidden': 'true'}) }}
                        </div>
                        <div class="space-y-1">
                            <h2 class="text-sm font-medium text-gray-700">
                                {{ (this.search|trim != '' ? 'admin.agencies.emptyFiltered.title' : (agencyFavoritesEmpty ? 'admin.agencies.emptyFavorites.title' : 'admin.agencies.empty.title'))|trans }}
                            </h2>
                            <p class="max-w-[40ch] text-xs text-pretty text-gray-400">
                                {{ (this.search|trim != '' ? 'admin.agencies.emptyFiltered.description' : (agencyFavoritesEmpty ? 'admin.agencies.emptyFavorites.description' : 'admin.agencies.empty.description'))|trans }}
                            </p>
                        </div>
                        {% if this.search|trim == '' and not agencyFavoritesEmpty %}
                            <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
                                <a
                                    href="{{ path('admin_agency_new', {adminPrefix: this.adminPrefix}) }}"
                                    class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90"
                                    data-testid="agencies-empty-new-agency"
                                >
                                    {{ ux_icon('lucide:building-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.agencies.create.menuItem.title'|trans }}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </section>
            {% else %}
                {# Card agence : famille des cards Dossier/Agents, signature
                   agence (logo carré, compteur d'agents en tuile teintée). #}
                <div class="space-y-4">
                    {% for agency in agencies %}
                        <article class="rounded-3xl border border-neutral-200 bg-white p-2 {{ agency.active ? '' : 'opacity-60' }}" data-testid="agency-row">
                            <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
                                <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 p-3">
                                    <div class="flex min-w-0 items-center gap-3">
                                        {{ _self.agencyLogo(agency) }}
                                        <div class="flex min-w-0 flex-wrap items-center gap-2">
                                            <p class="truncate font-medium text-gray-900">{{ agency.name }}</p>
                                            {{ _self.agencyNameBadges(agency) }}
                                        </div>
                                    </div>
                                    {# Cœur favori d'équipe : même bascule que sur la card agent. #}
                                    <button
                                        type="button"
                                        data-action="live#action"
                                        data-live-action-param="toggleAgencyFavorite"
                                        data-live-id-param="{{ agency.id }}"
                                        aria-pressed="{{ agency.favorite ? 'true' : 'false' }}"
                                        aria-label="{{ (agency.favorite ? 'admin.agents.favorite.remove' : 'admin.agents.favorite.add')|trans }}"
                                        title="{{ (agency.favorite ? 'admin.agents.favorite.remove' : 'admin.agents.favorite.add')|trans }}"
                                        class="flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-full border transition-colors duration-100 ease-out {{ agency.favorite ? 'border-red-200 bg-red-50 text-red-500 hover:border-red-300' : 'border-neutral-200 bg-white text-gray-400 hover:border-red-200 hover:bg-red-50 hover:text-red-500' }}"
                                        data-testid="agency-favorite-toggle"
                                    >
                                        {{ ux_icon('lucide:heart', {class: 'size-4 shrink-0' ~ (agency.favorite ? ' fill-current' : ''), 'aria-hidden': 'true'}) }}
                                    </button>
                                </div>
                                <div class="flex flex-col gap-y-4 {{ agency.note ? 'rounded-t-xl' : 'rounded-xl' }} bg-white px-5 py-4 sm:flex-row sm:items-center sm:gap-x-6">
                                    {# Compteur d'agents rattachés en tuile teintée. #}
                                    <div class="shrink-0 rounded-lg bg-primary/5 px-4 py-2.5 text-center">
                                        <p class="text-xl font-semibold text-primary tabular-nums" data-testid="agency-agent-count">{{ agency.agentCount }}</p>
                                        <p class="text-[11px] font-medium text-primary/70">{{ 'admin.agencies.show.agentsTitle'|trans }}</p>
                                    </div>
                                    {{ _self.colAreas(agency) }}
                                    {{ _self.divider() }}
                                    {{ _self.colBrand(agency) }}
                                </div>
                                {{ _self.agencyNoteBand(agency) }}
                                {{ _self.agencyFooter(agency, this.adminPrefix) }}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        {% else %}
            {% set agents = this.agents %}
            {% if agents is empty %}
                {# « Filtré » couvre la recherche mais aussi les filtres
                   spécialité / quartier : un filtre actif sans résultat
                   affiche le même état vide que la recherche. #}
                {% set filtered = this.isFiltered %}
                {% set favoritesEmpty = this.isFavoritesTab and not filtered %}
                <section class="rounded-2xl border border-dashed border-gray-950/10 bg-white/50 p-2" data-testid="agents-empty">
                    <div class="flex flex-col items-center justify-center gap-3 rounded-xl px-4 py-16 text-center">
                        <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-400">
                            {{ ux_icon(filtered ? 'lucide:search-x' : (favoritesEmpty ? 'lucide:heart' : 'lucide:briefcase'), {class: 'size-6', 'aria-hidden': 'true'}) }}
                        </div>
                        <div class="space-y-1">
                            <h2 class="text-sm font-medium text-gray-700">
                                {{ (filtered ? 'admin.agents.emptyFiltered.title' : (favoritesEmpty ? 'admin.agents.emptyFavorites.title' : 'admin.agents.empty.title'))|trans }}
                            </h2>
                            <p class="max-w-[40ch] text-xs text-pretty text-gray-400">
                                {{ (filtered ? 'admin.agents.emptyFiltered.description' : (favoritesEmpty ? 'admin.agents.emptyFavorites.description' : 'admin.agents.empty.description'))|trans }}
                            </p>
                        </div>
                        {% if not filtered and not favoritesEmpty %}
                            {# Annuaire vide : l'action de démarrage directement
                               dans l'état vide, plus de renvoi vers le header. #}
                            <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
                                <a
                                    href="{{ path('admin_agent_new', {adminPrefix: this.adminPrefix}) }}"
                                    class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90"
                                    data-testid="agents-empty-new-agent"
                                >
                                    {{ ux_icon('lucide:user-plus', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.agents.create.menuItem.title'|trans }}
                                </a>
                                <a
                                    href="{{ path('admin_agency_new', {adminPrefix: this.adminPrefix}) }}"
                                    class="inline-flex items-center gap-2 rounded-xl border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-gray-400 hover:text-gray-900"
                                    data-testid="agents-empty-new-agency"
                                >
                                    {{ ux_icon('lucide:building-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.agencies.create.menuItem.title'|trans }}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </section>
            {% else %}
                <div class="space-y-4" data-testid="agents-list">
                    {% for agent in agents %}
                        <article class="rounded-3xl border border-neutral-200 bg-white p-2 {{ agent.active ? '' : 'opacity-60' }}" data-testid="agent-row">
                            <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
                                <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 p-3">
                                    {{ _self.identity(agent) }}
                                    <div class="flex shrink-0 items-center gap-2">
                                        {# Cœur favori d'équipe : bascule immédiate, la liste se re-rend. #}
                                        <button
                                            type="button"
                                            data-action="live#action"
                                            data-live-action-param="toggleFavorite"
                                            data-live-id-param="{{ agent.id }}"
                                            aria-pressed="{{ agent.favorite ? 'true' : 'false' }}"
                                            aria-label="{{ (agent.favorite ? 'admin.agents.favorite.remove' : 'admin.agents.favorite.add')|trans }}"
                                            title="{{ (agent.favorite ? 'admin.agents.favorite.remove' : 'admin.agents.favorite.add')|trans }}"
                                            class="flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-full border transition-colors duration-100 ease-out {{ agent.favorite ? 'border-red-200 bg-red-50 text-red-500 hover:border-red-300' : 'border-neutral-200 bg-white text-gray-400 hover:border-red-200 hover:bg-red-50 hover:text-red-500' }}"
                                            data-testid="agent-favorite-toggle"
                                        >
                                            {{ ux_icon('lucide:heart', {class: 'size-4 shrink-0' ~ (agent.favorite ? ' fill-current' : ''), 'aria-hidden': 'true'}) }}
                                        </button>
                                        {{ _self.agencyBadge(agent, this.adminPrefix) }}
                                    </div>
                                </div>
                                <div class="flex flex-col gap-y-4 {{ agent.note ? 'rounded-t-xl' : 'rounded-xl' }} bg-white px-5 py-4 sm:flex-row sm:items-stretch sm:gap-x-6">
                                    {{ _self.colEmail(agent) }}
                                    {{ _self.divider() }}
                                    {{ _self.colPhone(agent) }}
                                    {{ _self.divider() }}
                                    {{ _self.colPosition(agent) }}
                                </div>
                                {% if agent.note %}
                                    {# Note interne en bande dédiée, comme le message d'un lead. #}
                                    <div class="rounded-b-xl bg-white px-5 py-4" data-testid="agent-note">
                                        <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">{{ 'admin.agents.create.note.label'|trans }}</p>
                                        <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-pretty text-gray-900">{{ agent.note }}</p>
                                    </div>
                                {% endif %}
                                <div class="mt-1 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-1 pb-1">
                                    {# Une fiche éditée affiche sa dernière modification, sinon sa création. #}
                                    <p class="flex items-center gap-1 pl-1 text-xs text-gray-900">
                                        {% if agent.updatedAt %}
                                            <span class="opacity-50">{{ 'admin.agents.card.updatedAt'|trans }}</span>
                                            <span class="tabular-nums" data-testid="agent-updated-at">{{ agent.updatedAt|format_date('medium') }}</span>
                                        {% else %}
                                            <span class="opacity-50">{{ 'admin.agents.show.addedAt'|trans }}</span>
                                            <span class="tabular-nums">{{ agent.createdAt|format_date('medium') }}</span>
                                        {% endif %}
                                    </p>
                                    <twig:Button
                                        as="a"
                                        size="sm"
                                        href="{{ path('admin_agent_show', {adminPrefix: this.adminPrefix, reference: agent.reference}) }}"
                                        class="px-10"
                                        data-testid="agent-row-link"
                                    >
                                        {{ 'admin.agents.card.open'|trans }}
                                    </twig:Button>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
        </div>
    </div>

    {# Pagination "Voir plus" : la page grandit par 25, le reste est en base.
       Sans objet en mode carte (tous les markers filtrés sont déjà posés). #}
    {% if this.hiddenCount > 0 and not this.isMapDisplay %}
        <div class="mt-6 flex justify-center">
            <twig:Button
                variant="outline"
                data-action="live#action"
                data-live-action-param="more"
                data-testid="agents-load-more"
            >
                <span data-loading="action(more)|addClass(hidden)" class="contents">
                    {{ ux_icon('lucide:plus', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                    <span class="whitespace-nowrap">{{ 'admin.agents.list.loadMore'|trans({'%count%': this.hiddenCount}) }}</span>
                </span>
                <span data-loading="action(more)|removeClass(hidden)" class="hidden flex items-center gap-x-2 whitespace-nowrap">
                    <twig:Spinner class="inline" />
                    {{ 'admin.contacts.button.loading'|trans }}
                </span>
            </twig:Button>
        </div>
    {% endif %}
</div>
