{#
    RealEstateAgent:CreateMenu — single "Créer" button opening a small menu
    with two choices: a new agent or a new agency. Each choice is a plain
    link to its dedicated creation page (admin_agent_new / admin_agency_new).

    props:
      adminPrefix: string — secret admin URL prefix, forwarded to the pages
#}
{% props adminPrefix = '' %}
<details
    class="relative shrink-0"
    data-controller="details-dropdown"
    data-action="click@window->details-dropdown#closeOnOutside keydown.esc@window->details-dropdown#close"
    data-testid="agents-create-menu"
>
    <summary
        class="inline-flex cursor-pointer list-none items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 [&::-webkit-details-marker]:hidden"
        data-testid="agents-create-trigger"
    >
        {{ ux_icon('lucide:plus', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
        {{ 'admin.agents.create.button'|trans }}
        {{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 opacity-70', 'aria-hidden': 'true'}) }}
    </summary>

    <div class="absolute right-0 z-30 mt-2 w-72 rounded-2xl border border-neutral-200 bg-white p-1 shadow-lg">
        <a
            href="{{ path('admin_agent_new', {adminPrefix: adminPrefix}) }}"
            class="flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition-colors duration-100 ease-out hover:bg-neutral-50"
            data-testid="agent-create-open"
        >
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary/5 text-primary">
                {{ ux_icon('lucide:user', {class: 'size-4', 'aria-hidden': 'true'}) }}
            </span>
            <span class="min-w-0">
                <span class="block text-sm font-medium text-gray-900">{{ 'admin.agents.create.menuItem.title'|trans }}</span>
                <span class="block text-xs text-gray-500">{{ 'admin.agents.create.menuItem.subtitle'|trans }}</span>
            </span>
        </a>
        <a
            href="{{ path('admin_agency_new', {adminPrefix: adminPrefix}) }}"
            class="flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition-colors duration-100 ease-out hover:bg-neutral-50"
            data-testid="agency-create-open"
        >
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary/5 text-primary">
                {{ ux_icon('lucide:building-2', {class: 'size-4', 'aria-hidden': 'true'}) }}
            </span>
            <span class="min-w-0">
                <span class="block text-sm font-medium text-gray-900">{{ 'admin.agencies.create.menuItem.title'|trans }}</span>
                <span class="block text-xs text-gray-500">{{ 'admin.agencies.create.menuItem.subtitle'|trans }}</span>
            </span>
        </a>
    </div>
</details>
