{% set currentRoute = app.request.attributes.get('_route') ?? 'app_home' %}
{% set currentParameters = app.request.attributes.get('_route_params') %}

{% if currentRoute == 'app_blog_show' and post is defined and post is not null %}
    {% set blogSwitchParams = {
        'fr': {'_locale': 'fr', 'slug': post.alternateSlug is defined and post.alternateSlug ? post.alternateSlug.slug : post.slug},
        'en': {'_locale': 'en', 'slug': post.alternateSlug is defined and post.alternateSlug ? post.alternateSlug.slug : post.slug}
    } %}
{% endif %}

{% if currentRoute == 'app_property_show' and property is defined and property is not null %}
    {% set _currentLocale = app.request.locale %}
    {% set _otherLocale = _currentLocale == 'fr' ? 'en' : 'fr' %}
    {% set _altProperty = property.alternateProperty|default(null) %}
    {% set propertySwitchParams = {
        (_currentLocale): property_show_path_params(property, _currentLocale),
        (_otherLocale): _altProperty
            ? property_show_path_params(_altProperty, _otherLocale)
            : property_show_path_params(property, _otherLocale)
    } %}
{% endif %}

{# Sticky: stays on top while scrolling (above <main>, which is z-20). Sticky offsets elsewhere use top-24 #}
<header class="sticky top-0 z-40 bg-white" role="banner" data-controller="sticky-header">
    <nav aria-label="{{ 'header.nav.ariaLabel'|trans }}" class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8 gap-x-3">
        <div class="flex lg:flex-2 items-center justify-start gap-x-4">
            <a href="{{ path('app_home') }}" class="-m-1.5 p-1.5 rounded-lg outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50" aria-label="{{ 'header.logo.ariaLabel'|trans }}">
                <span class="sr-only">Relocation In Paris</span>
                <img
                    src="{{ asset('medias/logos/logo_red.svg') }}"
                    width="300"
                    height="68"
                    loading="eager"
                    alt="{{ 'header.logo.alt'|trans }}"
                    class="shrink-0 h-8 w-auto"
                />
            </a>
            <span class="hidden lg:block h-6 w-px bg-neutral-200" aria-hidden="true"></span>
            <el-popover-group class="hidden lg:flex lg:gap-x-3 lg:-ml-3">
                <a
                    href="{{ path('app_service_find_accommodation') }}"
                    {% if currentRoute == 'app_service_find_accommodation' %}aria-current="page"{% endif %}
                    class="{% if currentRoute == 'app_service_find_accommodation' %}bg-neutral-100 text-primary{% endif %} text-sm/6 font-medium text-gray-900 hover:bg-neutral-100 hover:text-primary py-2.5 px-3 rounded-lg transition duration-100 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                >
                    {{ 'header.menu.findAccommodation'|trans|raw }}
                </a>
                <a
                    href="{{ path('app_pricing') }}"
                    {% if currentRoute == 'app_pricing' %}aria-current="page"{% endif %}
                    class="{% if currentRoute == 'app_pricing' %}bg-neutral-100 text-primary{% endif %} text-sm/6 font-medium text-gray-900 hover:bg-neutral-100 hover:text-primary py-2.5 px-3 rounded-lg transition duration-100 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                >
                    {{ 'header.menu.pricing'|trans|raw }}
                </a>
                <button
                    data-controller="popover"
                    data-popover-popover-id-value="desktop-menu-solutions"
                    popovertarget="desktop-menu-solutions"
                    aria-haspopup="true"
                    class="{% if currentRoute in ['app_blog', 'app_blog_show', 'app_blog_author', 'app_faq', 'app_about_us'] %}bg-neutral-100 text-primary{% endif %} aria-expanded:bg-neutral-100 aria-expanded:text-primary text-sm/6 font-medium text-gray-900 hover:bg-neutral-100 hover:text-primary cursor-pointer py-2.5 px-3 rounded-lg transition duration-100 inline-flex items-center gap-x-1 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                >
                    {{ 'header.menu.resources'|trans }}
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 transition-transform duration-200 [[aria-expanded='true']_&]:rotate-180">
                        <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd"/>
                    </svg>
                </button>
            </el-popover-group>
            <el-popover
                id="desktop-menu-solutions"
                data-sticky-header-target="popover"
                popover
                class="fixed top-19 m-0 w-full overflow-visible bg-white p-0 transition [transition-behavior:allow-discrete] backdrop:top-19 backdrop:bg-neutral-950/10 open:block data-[closed]:-translate-y-1 data-[closed]:opacity-0 data-[enter]:duration-200 data-[leave]:duration-150 data-[enter]:ease-out data-[leave]:ease-in"
            >
                <div aria-hidden="true" class="absolute inset-0 top-1/2 bg-white shadow-lg ring-1 ring-gray-900/5"></div>
                <div class="h-[1px] bg-gradient-to-r from-slate-400/20 via-slate-500 to-slate-400/20 opacity-20"></div>
                <div class="relative bg-white">
                    <div class="mx-auto grid max-w-7xl grid-cols-3 gap-x-4 px-6 py-10 lg:px-8 xl:gap-x-8">
                        <a
                            href="{{ path('app_blog') }}"
                            {% if currentRoute == 'app_blog' %}aria-current="page"{% endif %}
                            class="{% if currentRoute in ['app_blog', 'app_blog_show', 'app_blog_author'] %}bg-neutral-100{% endif %} group relative rounded-lg p-3 text-sm/6 hover:bg-neutral-100 transition duration-100 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                        >
                            <div class="flex items-start justify-start gap-x-4">
                                <div class="bg-neutral-100 p-2 rounded-lg group-hover:bg-white transition duration-100 {% if currentRoute in ['app_blog', 'app_blog_show', 'app_blog_author'] %}bg-white{% endif %}">
                                    {{ ux_icon('lucide:newspaper', {'class': 'size-6 text-primary', 'aria-hidden': 'true'}) }}
                                </div>
                                <div class="flex flex-col">
                                    <div class="flex items-center justify-between gap-x-3">
                                        <p class="block font-semibold text-gray-900">
                                            {{ 'header.menu.resource.blog.title'|trans }}
                                        </p>
                                        {% set _blogPostCount = blog_post_count() %}
                                        {% if _blogPostCount > 0 %}
                                            <p class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium text-neutral-600 tabular-nums transition-colors duration-100 group-hover:bg-white {% if currentRoute in ['app_blog', 'app_blog_show', 'app_blog_author'] %}bg-white{% else %}bg-neutral-100{% endif %}">{{ 'header.menu.resource.blog.count'|trans({'%count%': _blogPostCount}) }}</p>
                                        {% endif %}
                                    </div>
                                    <p class="mt-2 text-neutral-600">
                                        {{ 'header.menu.resource.blog.text'|trans }}
                                    </p>
                                </div>
                            </div>
                        </a>
                        <a
                            href="{{ path('app_faq') }}"
                            {% if currentRoute == 'app_faq' %}aria-current="page"{% endif %}
                            class="{% if currentRoute in ['app_faq'] %}bg-neutral-100{% endif %} group relative rounded-lg p-3 text-sm/6 hover:bg-neutral-100 transition duration-100 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                        >
                            <div class="flex items-start justify-start gap-x-4">
                                <div class="bg-neutral-100 p-2 rounded-lg group-hover:bg-white transition duration-100 {% if currentRoute in ['app_faq'] %}bg-white{% endif %}">
                                    {{ ux_icon('lucide:circle-help', {'class': 'size-6 text-primary', 'aria-hidden': 'true'}) }}
                                </div>
                                <div class="flex flex-col">
                                    <div class="flex items-center justify-between gap-x-3">
                                        <p class="block font-semibold text-gray-900">
                                            {{ 'header.menu.resource.faq.title'|trans }}
                                        </p>
                                        <p class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium text-neutral-600 tabular-nums transition-colors duration-100 group-hover:bg-white {% if currentRoute == 'app_faq' %}bg-white{% else %}bg-neutral-100{% endif %}">{{ 'header.menu.resource.faq.count'|trans({'%count%': faq_question_count()}) }}</p>
                                    </div>
                                    <p class="mt-2 text-neutral-600">
                                        {{ 'header.menu.resource.faq.text'|trans }}
                                    </p>
                                </div>
                            </div>
                        </a>
                        <a
                            href="{{ path('app_about_us') }}"
                            {% if currentRoute == 'app_about_us' %}aria-current="page"{% endif %}
                            class="{% if currentRoute in ['app_about_us'] %}bg-neutral-100{% endif %} group relative rounded-lg p-3 text-sm/6 hover:bg-neutral-100 transition duration-100 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                        >
                            <div class="flex items-start justify-start gap-x-4">
                                <div class="bg-neutral-100 p-2 rounded-lg group-hover:bg-white transition duration-100 {% if currentRoute in ['app_about_us'] %}bg-white{% endif %}">
                                    {{ ux_icon('lucide:users', {'class': 'size-6 text-primary', 'aria-hidden': 'true'}) }}
                                </div>
                                <div class="flex flex-col">
                                    <div class="flex items-center justify-between">
                                        <p class="block font-semibold text-gray-900">
                                            {{ 'header.menu.resource.aboutUs.title'|trans }}
                                        </p>
                                    </div>
                                    <p class="mt-2 text-neutral-600">
                                        {{ 'header.menu.resource.aboutUs.text'|trans }}
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </el-popover>
        </div>
        <div class="flex lg:hidden items-center gap-x-2">
            {# Mobile call-back shortcut (replaces the former red banner above the header); hidden on very narrow screens to leave room for the logo #}
            <a
                href="{{ path('app_contact') }}"
                data-testid="callback-bubble"
                class="relative size-10 flex max-[359px]:hidden items-center justify-center rounded-full bg-primary/10 text-primary hover:bg-primary/15 transition-colors duration-100 ease-out outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
            >
                <span class="sr-only">{{ 'header.cta.title'|trans }}</span>
                {{ ux_icon('lucide:phone-call', {'class': 'size-5 shrink-0', 'aria-hidden': 'true'}) }}
                {# 48px touch target on touch screens #}
                <span class="absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2 pointer-fine:hidden" aria-hidden="true"></span>
            </a>
            <button
                type="button"
                command="show-modal"
                commandfor="mobile-menu"
                aria-label="{{ 'header.action'|trans }}"
                class="size-10 flex items-center justify-center rounded-lg text-gray-700 hover:bg-neutral-100 transition duration-100 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
            >
                <span class="sr-only">{{ 'header.action'|trans|raw }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6">
                    <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>
        <div class="hidden lg:flex lg:justify-end items-center gap-x-2">
            <twig:Button
                variant="outline"
                popovertarget="desktop-lang"
                size="icon-lg"
                aria-label="{{ 'header.lang.select'|trans }}"
                class="aria-expanded:bg-neutral-100 aria-expanded:text-primary hover:text-primary rounded-lg shadow-none border-none hover:bg-neutral-100 transition duration-100 flex items-center gap-x-2"
            >
                {{ ux_icon('proicons:globe', {'class': 'size-6', 'aria-hidden': 'true'}) }}
            </twig:Button>
            <el-popover
                id="desktop-lang"
                data-sticky-header-target="popover"
                anchor="bottom"
                popover
                class="m-0 w-screen max-w-max overflow-visible bg-transparent p-0 px-4 transition [--anchor-gap:theme(spacing.5)] [transition-behavior:allow-discrete] backdrop:bg-transparent open:flex data-[closed]:translate-y-1 data-[closed]:opacity-0 data-[enter]:duration-200 data-[leave]:duration-150 data-[enter]:ease-out data-[leave]:ease-in"
            >
                <div class="w-screen max-w-[142px] flex-auto rounded-2xl space-y-1.5 bg-white p-3 text-sm/6 shadow-lg outline outline-1 outline-gray-900/5">
                    <a
                        href="{{ path(currentRoute, blogSwitchParams is defined ? blogSwitchParams.fr : (propertySwitchParams is defined ? propertySwitchParams.fr : (currentParameters ?? {})|merge({'_locale': 'fr'}))) }}"
                        hreflang="fr"
                        lang="fr"
                        class="{% if app.request.locale == 'fr' %}bg-neutral-100 text-primary font-semibold{% endif %} relative rounded-lg px-4 py-2 hover:bg-neutral-100 block text-sm/7 text-gray-900 cursor-pointer flex justify-between items-center outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-colors duration-100 ease-out"
                    >
                        <span class="flex items-center gap-x-3">
                            {{ ux_icon('circle-flags:fr', {'class': 'size-5 rounded-full', 'aria-hidden': 'true'}) }}
                            {{ 'header.lang.type.fr'|trans|raw }}
                        </span>
                    </a>
                    <a
                        href="{{ path(currentRoute, blogSwitchParams is defined ? blogSwitchParams.en : (propertySwitchParams is defined ? propertySwitchParams.en : (currentParameters ?? {})|merge({'_locale': 'en'}))) }}"
                        hreflang="en"
                        lang="en"
                        class="{% if app.request.locale == 'en' %}bg-neutral-100 text-primary font-semibold{% endif %} relative rounded-lg px-4 py-2 hover:bg-neutral-100 block text-sm/7 text-gray-900 cursor-pointer flex justify-between items-center outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-colors duration-100 ease-out"
                    >
                        <span class="flex items-center gap-x-3">
                            {{ ux_icon('circle-flags:en', {'class': 'size-5 rounded-full', 'aria-hidden': 'true'}) }}
                            {{ 'header.lang.type.en'|trans|raw }}
                        </span>
                    </a>
                </div>
            </el-popover>
            <div class="flex items-center gap-x-3">
                <twig:Button variant="default" as="a" size="lg" href="{{ path('app_contact') }}">
                    {{ 'header.cta.title'|trans|raw }}
                </twig:Button>
            </div>
        </div>
    </nav>
    <el-dialog>
        <dialog id="mobile-menu" class="m-0 p-0 backdrop:bg-transparent lg:hidden" aria-label="{{ 'header.menu.mobile'|trans }}">
            <div tabindex="0" class="fixed inset-0 focus:outline focus:outline-0">
                <el-dialog-panel class="fixed inset-y-0 right-0 z-10 flex w-full flex-col justify-between overflow-y-auto bg-white sm:max-w-sm sm:ring-1 sm:ring-gray-900/10">
                    <div class="px-6 py-4">
                        <div class="flex items-center justify-between">
                            <a href="{{ path('app_home') }}" class="-m-1.5 p-1.5 rounded-lg outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50" aria-label="{{ 'header.logo.ariaLabel'|trans }}">
                                <span class="sr-only">Relocation In Paris</span>
                                <img
                                    src="{{ asset('medias/logos/logo_red.svg') }}"
                                    width="153"
                                    height="150"
                                    loading="eager"
                                    alt="{{ 'header.logo.alt'|trans }}"
                                    class="h-8 w-auto"
                                />
                            </a>
                            <div class="flex items-center gap-x-2 lg:hidden">
                                <button
                                    type="button"
                                    command="close"
                                    commandfor="mobile-menu"
                                    aria-label="{{ 'header.actionClose'|trans }}"
                                    class="size-10 flex items-center justify-center rounded-lg text-gray-700 hover:bg-neutral-100 transition duration-100 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                                >
                                    <span class="sr-only">{{ 'header.actionClose'|trans|raw }}</span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6">
                                        <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div class="mt-4 flow-root">
                            <div class="h-[1px] bg-gradient-to-r from-slate-400/20 via-slate-500 to-slate-400/20 opacity-20 mb-8"></div>
                            <div class="-my-6">
                                <div class="py-3 space-y-3">
                                    <a
                                        href="{{ path('app_service_find_accommodation') }}"
                                        {% if currentRoute == 'app_service_find_accommodation' %}aria-current="page"{% endif %}
                                        class="{% if currentRoute == 'app_service_find_accommodation' %}bg-neutral-100 text-primary{% endif %} -mx-3 block rounded-lg px-3 py-2 text-base font-medium text-gray-900 hover:bg-gray-50 flex items-center justify-between outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-colors duration-100 ease-out"
                                    >
                                        {{ 'header.menu.findAccommodation'|trans|raw }}
                                        <div class="max-[328px]:hidden px-2 py-0.5 rounded-lg font-medium border border-gray-200 text-xs flex items-center gap-x-2 text-gray-600 bg-white">
                                            <span class="relative flex size-2" aria-hidden="true">
                                                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
                                                <span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
                                            </span>
                                            {{ 'header.badge.tailorMade'|trans|raw }}
                                        </div>
                                    </a>
                                    <a
                                        href="{{ path('app_pricing') }}"
                                        {% if currentRoute == 'app_pricing' %}aria-current="page"{% endif %}
                                        class="{% if currentRoute == 'app_pricing' %}bg-neutral-100 text-primary{% endif %} -mx-3 block rounded-lg px-3 py-2 text-base font-medium text-gray-900 hover:bg-gray-50 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-colors duration-100 ease-out"
                                    >
                                        {{ 'header.menu.pricing'|trans|raw }}
                                    </a>
                                    <div class="-mx-3">
                                        <button
                                            type="button"
                                            command="--toggle"
                                            commandfor="resources"
                                            aria-expanded="false"
                                            class="aria-expanded:bg-neutral-100 {% if currentRoute in ['app_blog', 'app_blog_show', 'app_blog_author', 'app_faq', 'app_about_us'] %}bg-neutral-100 text-primary{% endif %} flex w-full items-center text-start justify-between rounded-lg py-2 pl-3 pr-3.5 font-medium text-gray-900 hover:bg-gray-50 text-base outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-colors duration-100 ease-out"
                                        >
                                            {{ 'header.menu.resources'|trans }}
                                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 flex-none shrink-0 transition-transform duration-200 [[aria-expanded='true']_&]:rotate-180">
                                                <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd"/>
                                            </svg>
                                        </button>
                                        <el-disclosure id="resources" hidden class="mt-2 space-y-2 [&:not([hidden])]:block">
                                            <a
                                                href="{{ path('app_blog') }}"
                                                {% if currentRoute == 'app_blog' %}aria-current="page"{% endif %}
                                                class="{% if currentRoute in ['app_blog', 'app_blog_show', 'app_blog_author'] %}bg-neutral-100{% endif %} group relative rounded-lg p-3 text-sm/6 hover:bg-neutral-100 transition duration-100 block outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                                            >
                                                <div class="flex items-start justify-start gap-x-4">
                                                    <div class="bg-neutral-100 p-2 rounded-lg group-hover:bg-white transition duration-100 {% if currentRoute in ['app_blog', 'app_blog_show', 'app_blog_author'] %}bg-white{% endif %}">
                                                        {{ ux_icon('lucide:newspaper', {'class': 'size-6 text-primary', 'aria-hidden': 'true'}) }}
                                                    </div>
                                                    <div class="flex flex-col w-full">
                                                        <div class="flex items-center justify-between gap-x-3">
                                                            <p class="block font-semibold text-gray-900">
                                                                {{ 'header.menu.resource.blog.title'|trans }}
                                                            </p>
                                                            {% set _blogPostCount = blog_post_count() %}
                                                            {% if _blogPostCount > 0 %}
                                                                <p class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium text-neutral-600 tabular-nums transition-colors duration-100 group-hover:bg-white {% if currentRoute in ['app_blog', 'app_blog_show', 'app_blog_author'] %}bg-white{% else %}bg-neutral-100{% endif %}">{{ 'header.menu.resource.blog.count'|trans({'%count%': _blogPostCount}) }}</p>
                                                            {% endif %}
                                                        </div>
                                                        <p class="mt-2 text-neutral-600">
                                                            {{ 'header.menu.resource.blog.text'|trans }}
                                                        </p>
                                                    </div>
                                                </div>
                                            </a>
                                            <a
                                                href="{{ path('app_faq') }}"
                                                {% if currentRoute == 'app_faq' %}aria-current="page"{% endif %}
                                                class="{% if currentRoute in ['app_faq'] %}bg-neutral-100{% endif %} group relative rounded-lg p-3 text-sm/6 hover:bg-neutral-100 transition duration-100 block outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                                            >
                                                <div class="flex items-start justify-start gap-x-4">
                                                    <div class="bg-neutral-100 p-2 rounded-lg group-hover:bg-white transition duration-100 {% if currentRoute in ['app_faq'] %}bg-white{% endif %}">
                                                        {{ ux_icon('lucide:circle-help', {'class': 'size-6 text-primary', 'aria-hidden': 'true'}) }}
                                                    </div>
                                                    <div class="flex flex-col w-full">
                                                        <div class="flex items-center justify-between gap-x-3">
                                                            <p class="block font-semibold text-gray-900">
                                                                {{ 'header.menu.resource.faq.title'|trans }}
                                                            </p>
                                                            <p class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium text-neutral-600 tabular-nums transition-colors duration-100 group-hover:bg-white {% if currentRoute == 'app_faq' %}bg-white{% else %}bg-neutral-100{% endif %}">{{ 'header.menu.resource.faq.count'|trans({'%count%': faq_question_count()}) }}</p>
                                                        </div>
                                                        <p class="mt-2 text-neutral-600">
                                                            {{ 'header.menu.resource.faq.text'|trans }}
                                                        </p>
                                                    </div>
                                                </div>
                                            </a>
                                            <a
                                                href="{{ path('app_about_us') }}"
                                                {% if currentRoute == 'app_about_us' %}aria-current="page"{% endif %}
                                                class="{% if currentRoute in ['app_about_us'] %}bg-neutral-100{% endif %} group relative rounded-lg p-3 text-sm/6 hover:bg-neutral-100 transition duration-100 block outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                                            >
                                                <div class="flex items-start justify-start gap-x-4">
                                                    <div class="bg-neutral-100 p-2 rounded-lg group-hover:bg-white transition duration-100 {% if currentRoute in ['app_about_us'] %}bg-white{% endif %}">
                                                        {{ ux_icon('lucide:users', {'class': 'size-6 text-primary', 'aria-hidden': 'true'}) }}
                                                    </div>
                                                    <div class="flex flex-col w-full">
                                                        <div class="flex items-center justify-between">
                                                            <p class="block font-semibold text-gray-900">
                                                                {{ 'header.menu.resource.aboutUs.title'|trans }}
                                                            </p>
                                                        </div>
                                                        <p class="mt-2 text-neutral-600">
                                                            {{ 'header.menu.resource.aboutUs.text'|trans }}
                                                        </p>
                                                    </div>
                                                </div>
                                            </a>
                                        </el-disclosure>
                                    </div>
                                </div>
                                <div class="py-3 space-y-3">
                                    <div class="h-[1px] bg-gradient-to-r from-slate-400/20 via-slate-500 to-slate-400/20 opacity-20 mb-4"></div>
                                    <div class="-mx-3">
                                        <button
                                            type="button"
                                            command="--toggle"
                                            commandfor="lang"
                                            aria-expanded="false"
                                            class="flex aria-expanded:bg-neutral-100 cursor-pointer w-full items-center justify-between rounded-lg py-2 px-3.5 text-sm/7 font-semibold text-gray-900 hover:bg-neutral-100 transition duration-100 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                                        >
                                            <span class="flex items-center gap-x-4">
                                                {% if app.request.locale == 'fr' %}
                                                    {{ ux_icon('circle-flags:fr', {'class': 'size-5 rounded-full', 'aria-hidden': 'true'}) }}
                                                    FR
                                                {% elseif app.request.locale == 'en' %}
                                                    {{ ux_icon('circle-flags:en', {'class': 'size-5 rounded-full', 'aria-hidden': 'true'}) }}
                                                    EN
                                                {% endif %}
                                            </span>
                                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 flex-none shrink-0 transition-transform duration-200 [[aria-expanded='true']_&]:rotate-180">
                                                <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd"/>
                                            </svg>
                                        </button>
                                        <el-disclosure id="lang" hidden class="mt-2 [&:not([hidden])]:block">
                                            <a
                                                href="{{ path(currentRoute, blogSwitchParams is defined ? blogSwitchParams.fr : (propertySwitchParams is defined ? propertySwitchParams.fr : (currentParameters ?? {})|merge({'_locale': 'fr'}))) }}"
                                                hreflang="fr"
                                                lang="fr"
                                                class="block rounded-lg py-2 px-3.5 text-sm/7 font-semibold text-gray-900 hover:bg-neutral-100 cursor-pointer flex justify-between items-center outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-colors duration-100 ease-out"
                                            >
                                                <span class="flex items-center gap-x-4">
                                                    {{ ux_icon('circle-flags:fr', {'class': 'size-5 rounded-full', 'aria-hidden': 'true'}) }}
                                                    FR
                                                </span>
                                                {% if app.request.locale == 'fr' %}
                                                    <div class="rounded-full bg-primary p-1" aria-label="Langue active">
                                                        {{ ux_icon('lucide:check', {'class': 'text-white size-2.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                    </div>
                                                {% endif %}
                                            </a>
                                            <a
                                                href="{{ path(currentRoute, blogSwitchParams is defined ? blogSwitchParams.en : (propertySwitchParams is defined ? propertySwitchParams.en : (currentParameters ?? {})|merge({'_locale': 'en'}))) }}"
                                                hreflang="en"
                                                lang="en"
                                                class="block rounded-lg py-2 px-3.5 text-sm/7 font-semibold text-gray-900 hover:bg-neutral-100 cursor-pointer flex justify-between items-center outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-colors duration-100 ease-out"
                                            >
                                                <span class="flex items-center gap-x-4">
                                                    {{ ux_icon('circle-flags:en', {'class': 'size-5 rounded-full', 'aria-hidden': 'true'}) }}
                                                    EN
                                                </span>
                                                {% if app.request.locale == 'en' %}
                                                    <div class="rounded-full bg-primary p-1" aria-label="Langue active">
                                                        {{ ux_icon('lucide:check', {'class': 'text-white size-2.5 shrink-0', 'aria-hidden': 'true'}) }}
                                                    </div>
                                                {% endif %}
                                            </a>
                                        </el-disclosure>
                                    </div>
                                    <div class="h-[1px] bg-gradient-to-r from-slate-400/20 via-slate-500 to-slate-400/20 opacity-20 mb-4"></div>
                                </div>
                                <div class="space-y-3 -mx-3">
                                    <twig:Button variant="default" as="a" size="lg" class="w-full" href="{{ path('app_contact') }}">
                                        {{ 'header.cta.title'|trans|raw }}
                                    </twig:Button>
                                </div>
                            </div>
                        </div>
                    </div>
                </el-dialog-panel>
            </div>
        </dialog>
    </el-dialog>
    <div class="h-[1px] bg-gradient-to-r from-slate-400/20 via-slate-500 to-slate-400/20 opacity-20 max-w-7xl mx-auto"></div>
</header>
