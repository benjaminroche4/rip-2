                                <path d="M3.96397 8.76642C4.73886 5.27811 6.65683 2.13254 7.89858 0.541938C8.11058 0.270387 8.52259 0.314194 8.68431 0.618383C9.54535 2.23801 11.0338 5.38925 11.4156 9.20474C11.852 13.5662 10.1004 17.9712 7.03238 17.5328C4.33705 17.1478 2.91409 13.4926 3.96397 8.76642Z" fill="url(#paint0_linear_998_3368)"/>
