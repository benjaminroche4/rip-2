                        <svg width="1" height="53" viewBox="0 0 1 53" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden sm:block">
                            <line x1="0.5" y1="2.18557e-08" x2="0.499998" y2="53" stroke="url(#paint0_linear_1004_281)" stroke-opacity="0.2"/>
                            <defs>
                                <linearGradient id="paint0_linear_1004_281" x1="-0.5" y1="-2.18557e-08" x2="-0.500002" y2="53" gradientUnits="userSpaceOnUse">
                                    <stop stop-color="#707070"/>
                                    <stop offset="0.495192" stop-color="#D6D6D6"/>
                                    <stop offset="1" stop-color="#707070"/>
                                </linearGradient>
                            </defs>
                        </svg>
                        <div>
                            <a href="https://share.google/DuM7reAcGSrmXQ65I" rel="noopener noreferrer" target="_blank" aria-label="{{ 'footer.google.ariaLabel'|trans }}" class="p-3 font-semibold flex items-center gap-x-3.5">
                                {{ ux_icon('devicon:google', {'class':'size-6 shrink-0'}) }}
                                <div class="flex flex-col justify-start -space-y-1">
                                    <div class="test-base font-bold flex items-center text-white gap-x-2">
                                        {{ google_rating }}
                                        <div class="flex items-center">
                                            {{ ux_icon('material-symbols:star-rounded', {'class':'size-4 text-orange-500'}) }}
                                            {{ ux_icon('material-symbols:star-rounded', {'class':'size-4 text-orange-500'}) }}
                                            {{ ux_icon('material-symbols:star-rounded', {'class':'size-4 text-orange-500'}) }}
                                            {{ ux_icon('material-symbols:star-rounded', {'class':'size-4 text-orange-500'}) }}
                                            {{ ux_icon('material-symbols:star-rounded', {'class':'size-4 text-orange-500'}) }}
                                        </div>
                                    </div>
                                    <span class="font-medium text-gray-200 text-sm">{{ 'header.google.basedOn'|trans|raw }} <span class="underline underline-offset-2">+{{ google_reviews_count }} {{ 'header.google.reviews'|trans|raw }}</span></span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="max-[810px]:hidden flex items-center justify-center space-x-2">
                        <a href="https://www.instagram.com/relocation_in_paris/" rel="noopener noreferrer" target="_blank" class="p-1.5 rounded-full border bg-zinc-900 hover:bg-zinc-800 border-zinc-700 hover:text-white text-zinc-200 transition duration-100">
                            <span class="sr-only">Instagram</span>
                            {{ ux_icon('uil:instagram', {'class':'size-6'}) }}
                        </a>
                        <a href="{{ site_linkedin_url }}" rel="noopener noreferrer" target="_blank" class="p-1.5 rounded-full border bg-zinc-900 hover:bg-zinc-800 border-zinc-700 hover:text-white text-zinc-200 transition duration-100">
                            <span class="sr-only">Linkedin</span>
                            {{ ux_icon('uil:linkedin', {'class':'size-6'}) }}
                        </a>
                    </div>
                </div>
                <div>
                    <div class="flex items-center space-x-3 md:flex-row flex-col space-y-6 md:space-y-0">
                        <div class="flex items-center max-[375px]:flex-col gap-3">
                            <div class="flex -space-x-1.5">
                                <img src="{{ asset('medias/team/team_1.webp') }}" alt="{{ 'ctaFooter.image.1.alt'|trans }}" loading="lazy" width="28" height="28" class="inline-block size-7 rounded-full outline outline-1 -outline-offset-1 outline-gray-700/10 ring-2 ring-white" />
                                <img src="{{ asset('medias/team/team_5.webp') }}" alt="{{ 'ctaFooter.image.2.alt'|trans }}" loading="lazy" width="28" height="28" class="inline-block size-7 rounded-full outline outline-1 -outline-offset-1 outline-gray-700/10 ring-2 ring-white" />
                                <img src="{{ asset('medias/team/team_3.webp') }}" alt="{{ 'ctaFooter.image.3.alt'|trans }}" loading="lazy" width="28" height="28" class="inline-block size-7 rounded-full outline outline-1 -outline-offset-1 outline-gray-700/10 ring-2 ring-white" />
                            </div>
                            <div>
                                <p class="text-base md:text-lg font-semibold text-white text-gray-200 text-center">
                                    {{ 'footer.callback.text'|trans|raw }}
                                </p>
                            </div>
                        </div>
                        <svg width="1" height="53" viewBox="0 0 1 53" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden md:block">
                            <line x1="0.5" y1="2.18557e-08" x2="0.499998" y2="53" stroke="url(#paint0_linear_1004_281)" stroke-opacity="0.2"/>
                            <defs>
                                <linearGradient id="paint0_linear_1004_281" x1="-0.5" y1="-2.18557e-08" x2="-0.500002" y2="53" gradientUnits="userSpaceOnUse">
                                    <stop stop-color="#707070"/>
                                    <stop offset="0.495192" stop-color="#D6D6D6"/>
                                    <stop offset="1" stop-color="#707070"/>
                                </linearGradient>
                            </defs>
                        </svg>
                        <a href="tel:+(33)184804344" aria-label="{{ 'footer.phone.ariaLabel'|trans }}" class="flex max-[214px]:text-xs max-[230px]:text-sm max-[365px]:text-base  items-center gap-x-4 rounded-full border bg-zinc-900 hover:bg-zinc-800 border-zinc-700 text-white transition duration-100 text-lg font-normal py-2 px-4">
                            +(33) 1 84 80 43 44
                            {% set currentDay = "now"|date("N", "Europe/Paris") %}
                            {% set currentHour = "now"|date("G", "Europe/Paris") %}
                            {% set isOpen = (currentDay >= 1 and currentDay <= 5 and currentHour >= 8 and currentHour < 20) or (currentDay == 6 and currentHour >= 8 and currentHour < 12) %}
                            {% if isOpen %}
                            <div class="max-[330px]:hidden bg-[#ECFDF5] text-[#047857] py-1.5 px-2 rounded-full text-xs font-medium flex items-center gap-x-1 justify-center">
                                <span class="relative flex size-2">
                                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
                                    <span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
                                </span>
                                {{ 'footer.callback.open'|trans|raw }}
                            </div>
                            {% endif %}
                        </a>
                    </div>
                </div>
            </div>
            <div class="h-[1px] bg-gradient-to-r from-white/20 via-white to-white/20 opacity-20"></div>
            <div class="grid grid-cols-2 gap-8 max-[281px]:grid-cols-1 md:grid-cols-4">
                <div class="space-y-4 text-sm">
                    <h2 id="footer-menu-1" class="text-white uppercase font-semibold">{{ 'footer.menuTitle.1'|trans|raw }}</h2>
                    <nav class="flex flex-col space-y-4" aria-labelledby="footer-menu-1">
                        <a href="{{ path('app_service_find_accommodation') }}" class="{% if app.request.attributes.get('_route') == 'app_service_find_accommodation' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.findAccommodation'|trans|raw }}</a>
                        <a href="{{ path('app_service_companies') }}" class="{% if app.request.attributes.get('_route') == 'app_service_companies' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.companies'|trans|raw }}</a>
                        <a href="{{ path('app_service_landlords') }}" class="{% if app.request.attributes.get('_route') == 'app_service_landlords' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.management'|trans|raw }}</a>
                    </nav>
                </div>
                <div class="space-y-4 text-sm">
                    <h2 id="footer-menu-2" class="text-white uppercase font-semibold">{{ 'footer.menuTitle.2'|trans|raw }}</h2>
                    <nav class="flex flex-col space-y-2 text-sm/6" aria-labelledby="footer-menu-2">
                        <a href="{{ path('app_pricing') }}" class="{% if app.request.attributes.get('_route') == 'app_pricing' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.pricing'|trans|raw }}</a>
                        <a href="{{ path('app_newsletter') }}" class="{% if app.request.attributes.get('_route') == 'app_newsletter' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.newsletter'|trans|raw }}</a>
                        <a href="{{ path('app_blog') }}" class="{% if app.request.attributes.get('_route') == 'app_blog' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.blog'|trans|raw }}</a>
                        <a href="{{ path('app_case_studies') }}" class="{% if app.request.attributes.get('_route') == 'app_case_studies' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.caseStudies'|trans|raw }}</a>
                        <a href="{{ path('app_property') }}" class="{% if app.request.attributes.get('_route') == 'app_property' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">
                            {{ 'footer.menu.ourProperty'|trans|raw }}
                        </a>
                        <a href="{{ path('app_about_us') }}" class="{% if app.request.attributes.get('_route') == 'app_about_us' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.aboutUs'|trans|raw }}</a>
                    </nav>
                </div>
                <div class="space-y-4 text-sm">
                    <h2 id="footer-menu-3" class="text-white uppercase font-semibold">{{ 'footer.menuTitle.3'|trans|raw }}</h2>
                    <nav class="flex flex-col space-y-2 text-sm/6" aria-labelledby="footer-menu-3">
                        <a href="{{ path('app_callback') }}" class="{% if app.request.attributes.get('_route') == 'app_callback' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100 flex items-center gap-x-2 self-start">
                            {{ 'footer.menu.callback'|trans }}
                            {# Soft "available" ping to nudge the call-back; still under prefers-reduced-motion #}
                            <span class="relative flex size-1.5" aria-hidden="true">
                                <span class="absolute inline-flex size-full rounded-full bg-green-400 opacity-40 motion-safe:animate-ping motion-safe:[animation-duration:2s]"></span>
                                <span class="relative inline-flex size-1.5 rounded-full bg-green-500/80"></span>
                            </span>
                        </a>
                        <a href="{{ path('app_contact') }}" class="{% if app.request.attributes.get('_route') == 'app_contact' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.contact'|trans|raw }}</a>
                        <a href="{{ path('app_faq') }}" class="{% if app.request.attributes.get('_route') == 'app_faq' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.faq'|trans|raw }}</a>
                    </nav>
                </div>
                <div class="space-y-4 text-sm">
                    <h2 id="footer-menu-4" class="text-white uppercase font-semibold">{{ 'footer.menuTitle.4'|trans|raw }}</h2>
                    <nav class="flex flex-col space-y-2 text-sm/6" aria-labelledby="footer-menu-4">
                        <a href="{{ path('app_legal_notice') }}" class="{% if app.request.attributes.get('_route') == 'app_legal_notice' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.legalNotice'|trans|raw }}</a>
                        <a href="{{ path('app_privacy_policy') }}" class="{% if app.request.attributes.get('_route') == 'app_privacy_policy' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.privacyPolicy'|trans|raw }}</a>
                        <a href="{{ path('app_terms_and_conditions') }}" class="{% if app.request.attributes.get('_route') == 'app_terms_and_conditions' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">{{ 'footer.menu.termsConditions'|trans|raw }}</a>
                        <a href="{{ path('app_sitemap') }}" class="{% if app.request.attributes.get('_route') == 'app_sitemap' %}text-slate-400{% else %}text-slate-200{% endif %} hover:text-slate-400 transition duration-100">Sitemap</a>
                    </nav>
                </div>
            </div>
            <div class="h-[1px] bg-gradient-to-r from-white/20 via-white to-white/20 opacity-20"></div>
            <section
                data-controller="marquee"
                aria-hidden="true"
                class="relative w-full container-block"
            >
                <div class="relative w-full py-3 mx-auto overflow-hidden text-lg italic tracking-wide text-white uppercase bg-white-900 max-w-7xl sm:text-xs md:text-sm lg:text-base xl:text-xl 2xl:text-2xl">
                    <div class="absolute left-0 z-20 w-40 h-full bg-gradient-to-r from-[#1D1D1D] to-transparent"></div>
                    <div class="absolute right-0 z-20 w-40 h-full bg-gradient-to-l from-[#1D1D1D] to-transparent"></div>
                    <div data-marquee-target="content" class="flex animate-marquee">
                        <div data-marquee-target="item" class="flex items-center justify-around flex-shrink-0 w-full py-2 space-x-2 text-white">
                            {{ ux_icon('brands:disney', {'class': 'h-8 text-slate-200 w-auto shrink-0', 'aria-hidden': 'true'}) }}
                            {{ ux_icon('brands:stripe', {'class': 'h-8 text-slate-200 w-auto shrink-0', 'aria-hidden': 'true'}) }}
                            {{ ux_icon('brands:twitch', {'class': 'h-8 text-slate-200 w-auto shrink-0', 'aria-hidden': 'true'}) }}
                            {{ ux_icon('brands:medium', {'class': 'hidden h-6 md:block text-slate-200 w-auto shrink-0', 'aria-hidden': 'true'}) }}
                            {{ ux_icon('brands:facebook', {'class': 'hidden h-6 sm:block text-slate-200 w-auto shrink-0', 'aria-hidden': 'true'}) }}
                            {{ ux_icon('brands:airbnb', {'class': 'h-8 text-slate-200 w-auto shrink-0', 'aria-hidden': 'true'}) }}
                        </div>
                    </div>
                </div>
            </section>
            <div class="h-[1px] bg-gradient-to-r from-white/20 via-white to-white/20 opacity-20"></div>
            <div class="min-[810px]:hidden flex items-center justify-center space-x-2">
                <a href="https://www.instagram.com/relocation_in_paris/" rel="noopener noreferrer" target="_blank" class="p-1.5 rounded-full border bg-zinc-900 hover:bg-zinc-800 border-zinc-700 hover:text-white text-zinc-200 transition duration-100">
                    <span class="sr-only">Instagram</span>
                    {{ ux_icon('uil:instagram', {'class':'size-6'}) }}
                </a>
                <a href="{{ site_linkedin_url }}" rel="noopener noreferrer" target="_blank" class="p-1.5 rounded-full border bg-zinc-900 hover:bg-zinc-800 border-zinc-700 hover:text-white text-zinc-200 transition duration-100">
                    <span class="sr-only">Linkedin</span>
                    {{ ux_icon('uil:linkedin', {'class':'size-6'}) }}
                </a>
            </div>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
                <div class="text-gray-300 text-sm lg:text-start text-center">
                    <p>&copy; {{ "now"|date("Y") }} {{ 'footer.bottomPage.rights'|trans|raw }}</p>
                </div>
                <div class="lg:text-start text-center">
                    <address class="not-italic text-gray-300 text-sm">
                        Paris ❥ France
                    </address>
                </div>
            </div>
        </section>
    </div>
</footer>
