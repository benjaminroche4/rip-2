{# Mobile-only strip above the header: one tap to the contact page.
   Hidden on lg+ where the header already exposes the contact CTA. #}
<a
    href="{{ path('app_contact') }}"
    class="flex lg:hidden items-center justify-center gap-x-2 bg-primary px-6 py-2 text-[0.8125rem] font-medium text-white hover:bg-primary/90 transition-colors duration-100 ease-out outline-none focus-visible:ring-[3px] focus-visible:ring-inset focus-visible:ring-white/60"
    data-testid="callback-banner"
>
    {{ ux_icon('iconoir:phone', {'class': 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
    <span>{{ 'header.callbackBanner.text'|trans }}</span>
    {{ ux_icon('lucide:arrow-right', {'class': 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
</a>
