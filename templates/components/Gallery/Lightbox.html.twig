{#
    Reusable fullscreen photo lightbox, driven by gallery_controller.js.

    Must live INSIDE an element carrying data-controller="gallery" and
    data-gallery-photos-value='[{"url":…,"alt":…}]'. Open it from any
    <button data-action="gallery#open" data-gallery-index-param="N">.

    Mobile = vertical scroll of every photo; desktop = single-image carousel
    with keyboard nav, swipe, a thumbnail strip and a counter.

    props:
      photos: list<{url: string, alt: string}> — same order as the trigger grid
#}
{% props photos = [] %}
<dialog
    data-gallery-target="dialog"
    data-action="click->gallery#closeOnClickOutside"
    tabindex="-1"
    class="fixed inset-0 z-50 m-0 h-full w-full max-h-full max-w-full bg-black/95 backdrop:bg-transparent open:block focus:outline-none"
>
    <button
        type="button"
        data-action="gallery#close"
        aria-label="{{ 'gallery.close'|trans }}"
        class="fixed top-4 right-4 z-20 flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition duration-100 hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none cursor-pointer"
    >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6"><path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    {# Mobile: vertical scroll #}
    <div class="h-full overflow-y-auto overscroll-contain lg:hidden">
        <div class="mx-auto flex max-w-4xl flex-col gap-2 px-3 pt-16 pb-8 sm:gap-3 sm:px-4 sm:pt-20 sm:pb-12">
            {% for photo in photos %}
                <img
                    src="{{ photo.url }}?w=1400&fit=max&auto=format&fm=webp&q=85"
                    alt="{{ photo.alt }}"
                    loading="{{ loop.first ? 'eager' : 'lazy' }}"
                    decoding="async"
                    draggable="false"
                    class="w-full rounded-xl select-none"
                />
            {% endfor %}
        </div>
    </div>

    {# Desktop: carousel #}
    <div class="relative hidden h-full w-full items-center justify-center px-4 py-12 lg:flex">
        <button
            type="button"
            data-action="gallery#prev"
            aria-label="{{ 'gallery.previous'|trans }}"
            class="absolute left-4 z-10 flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition duration-100 hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none cursor-pointer"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="size-5"><path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="flex max-h-full w-full flex-col items-center gap-6">
            <img
                data-gallery-target="image"
                src=""
                alt=""
                draggable="false"
                style="touch-action: none"
                class="max-h-[calc(100vh-14rem)] max-w-full cursor-grab rounded-lg object-contain transition-all duration-300 ease-out select-none"
            />
            <div class="w-full max-w-4xl px-4">
                <div class="flex flex-col items-center gap-2">
                    <span data-gallery-target="counter" class="text-xs font-medium text-white/50"></span>
                    <div data-gallery-target="thumbnails" class="scrollbar-hide flex w-full flex-nowrap gap-2 overflow-x-auto scroll-p-1 p-1 scroll-smooth"></div>
                </div>
            </div>
        </div>

        <button
            type="button"
            data-action="gallery#next"
            aria-label="{{ 'gallery.next'|trans }}"
            class="absolute right-4 z-10 flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition duration-100 hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none cursor-pointer"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="size-5"><path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    </div>
</dialog>
