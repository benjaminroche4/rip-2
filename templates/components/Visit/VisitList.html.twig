{% macro sectionEmpty(text, testid) %}
    {# État vide de section : cercle icône + texte, groupe centré. #}
    <div class="flex items-center justify-center gap-3 rounded-2xl border border-dashed border-gray-950/10 bg-white/50 px-5 py-5" data-testid="{{ testid }}">
        <span class="flex size-8 items-center justify-center rounded-full bg-gray-100">
            {{ ux_icon('lucide:calendar-off', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
        </span>
        <p class="text-sm text-gray-400">{{ text }}</p>
    </div>
{% endmacro %}

{# ── Briques partagées par les variantes de card. ── #}

{% macro typeBadges(visit, reportDue, minutesUntil = null) %}
    <span class="flex items-center gap-1 rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-medium text-gray-600" data-testid="visit-type-badge">
        {{ ux_icon(visit.type.icon, {class: 'size-3 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
        {{ visit.type.labelKey|trans }}
    </span>
    {% if visit.status.value != 'planned' %}
        <span class="flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium {{ visit.status.badgeClasses }}" data-testid="visit-status-chip">
            {{ ux_icon(visit.status.icon, {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
            {{ visit.status.labelKey|trans }}
        </span>
    {% endif %}
    {# Compte à rebours discret quand la visite est imminente (moins de
       deux heures), sur la même rangée que le type. #}
    {% if minutesUntil and visit.status.value == 'planned' %}
        <span class="rounded-full bg-primary/5 px-2 py-0.5 text-[11px] font-semibold text-primary tabular-nums" data-testid="visit-countdown">
            {% if minutesUntil >= 60 %}
                {{ 'admin.visits.row.startsInHours'|trans({'%count%': (minutesUntil / 60)|round(0, 'floor')}) }}
            {% else %}
                {{ 'admin.visits.row.startsInMinutes'|trans({'%count%': minutesUntil}) }}
            {% endif %}
        </span>
    {% endif %}
    {# Statut client : l'issue de candidature prime sur la décision. #}
    {% if visit.applicationOutcome %}
        <span class="flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium {{ visit.applicationOutcome.value == 'accepted' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-600' }}" data-testid="visit-outcome-chip">
            {{ ux_icon(visit.applicationOutcome.value == 'accepted' ? 'lucide:badge-check' : 'lucide:badge-x', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
            {{ visit.applicationOutcome.labelKey|trans }}
        </span>
    {% elseif visit.clientDecision %}
        <span class="flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium {{ {thinking: 'bg-sky-50 text-sky-700', positioning: 'bg-primary/5 text-primary', refused: 'bg-amber-50 text-amber-700'}[visit.clientDecision.value] }}" data-testid="visit-decision-chip">
            {{ ux_icon({thinking: 'lucide:hourglass', positioning: 'lucide:send', refused: 'lucide:x'}[visit.clientDecision.value], {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
            {{ visit.clientDecision.labelKey|trans }}
        </span>
        {% if visit.clientDecision.value == 'thinking' and visit.decisionDeadline and visit.decisionDeadline|date('Y-m-d', false) < 'now'|date('Y-m-d', 'Europe/Paris') %}
            {# Échéance de réflexion passée sans décision : rappel ambre. #}
            <span class="flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700" data-testid="visit-deadline-overdue">
                {{ ux_icon('lucide:clock-alert', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                {{ 'admin.visits.decisionDeadline.overdue'|trans }}
            </span>
        {% endif %}
        {% if visit.clientDecision.value == 'positioning' %}
            {# Positionné sans issue de candidature : on attend le retour du
               bailleur, l'ancienneté de l'attente se lit d'un coup d'œil. #}
            {% set waitingDays = (('now'|date('U') - (visit.clientDecisionAt ?? visit.scheduledAt)|date('U')) / 86400)|round(0, 'floor') %}
            <span class="flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700" data-testid="visit-waiting-chip">
                {{ ux_icon('lucide:timer', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                {{ 'admin.visits.row.waitingSince'|trans({'%count%': waitingDays}) }}
            </span>
        {% endif %}
    {% endif %}
    {% if reportDue %}
        {# L'heure est passée sans compte-rendu : rappel ambre sur la card. #}
        <span class="flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700" data-testid="visit-report-due">
            {{ ux_icon('lucide:clipboard-pen', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
            {{ 'admin.visits.row.reportDue'|trans }}
        </span>
    {% endif %}
{% endmacro %}

{% macro dossierAddress(visit, adminPrefix) %}
    {# Rattachement au dossier : cliquable seulement si le lecteur a la
       section Dossiers (un agent de visite ne doit pas atterrir sur un
       403), sinon simple texte. #}
    {% set canOpenDossier = is_granted('ROLE_SECTION_DOSSIERS') %}
    <{{ canOpenDossier ? 'a' : 'span' }}
        {% if canOpenDossier %}href="{{ path('admin_dossier_show', {adminPrefix: adminPrefix, reference: visit.dossierReference}) }}"{% endif %}
        class="relative z-10 flex items-center gap-1.5 truncate text-sm font-medium text-gray-900 {{ canOpenDossier ? 'transition-colors duration-100 ease-out hover:text-primary' }}"
        data-testid="visit-dossier-link"
    >
        {{ ux_icon('lucide:folder-open', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
        <span class="truncate">{{ visit.dossierName }} <span class="font-normal text-gray-400">({{ visit.dossierReference }})</span></span>
    </{{ canOpenDossier ? 'a' : 'span' }}>
    <a
        href="https://www.google.com/maps/search/?api=1&query={{ visit.address|url_encode }}"
        target="_blank"
        rel="noopener noreferrer"
        class="relative z-10 mt-1 flex items-center gap-1 truncate text-xs text-gray-500 transition-colors duration-100 ease-out hover:text-primary"
        title="{{ 'admin.visits.row.openInMaps'|trans }}"
        data-testid="visit-address-link"
    >
        {{ ux_icon('lucide:map-pin', {class: 'size-3 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
        <span class="truncate">{{ visit.address }}</span>
    </a>
{% endmacro %}

{% macro perfIdentity(visit, size) %}
    {% if visit.assigneeName %}
        <twig:Avatar filename="{{ visit.assigneeAvatar }}" name="{{ visit.assigneeName }}" size="{{ size }}" />
    {% elseif visit.clientPresent %}
        {{ ux_icon('lucide:user-check', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
    {% else %}
        {{ ux_icon('lucide:circle-alert', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
    {% endif %}
{% endmacro %}

{% macro performedBy(visit) %}
    {# Encart gris : le "qui" de la visite dans une bande neutre, avatar
       (repli icône) + nom tronqué à la largeur fixe de la colonne. #}
    {% set perfName = visit.assigneeName ? visit.assigneeName|title : (visit.clientPresent ? 'admin.visits.row.byClient'|trans : 'admin.visits.row.unassigned'|trans) %}
    {% set perfTestid = visit.assigneeName ? 'visit-assignee' : (visit.clientPresent ? 'visit-by-client' : 'visit-unassigned') %}
    <div class="w-full min-w-0 rounded-lg bg-neutral-50 px-2.5 py-1.5">
        <p class="text-[10px] font-medium tracking-wide text-gray-500 uppercase">{{ 'admin.visits.row.performedBy'|trans }}</p>
        <p class="mt-0.5 flex items-center gap-1.5 text-xs font-medium {{ visit.assigneeName or visit.clientPresent ? 'text-gray-900' : 'text-amber-600' }}" data-testid="{{ perfTestid }}">
            {{ _self.perfIdentity(visit, 5) }}
            <span class="truncate">{{ perfName }}</span>
        </p>
    </div>
{% endmacro %}

{% macro rowMenu(visit, adminPrefix) %}
    {# Menu "…" unique (même geste que la fiche agent) : Modifier ouvre
       le détail, Supprimer garde sa modale de confirmation. Le menu
       reste ouvert sous la modale : le <dialog> vit dans le sous-arbre
       du details, le refermer le masquerait. #}
    <details
        class="relative z-10 shrink-0"
        data-controller="details-dropdown"
        data-action="click@window->details-dropdown#closeOnOutside keydown.esc@window->details-dropdown#close"
        data-testid="visit-actions"
    >
        <summary
            class="flex size-7 cursor-pointer list-none items-center justify-center rounded-lg text-gray-400 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900 [&::-webkit-details-marker]:hidden"
            aria-label="{{ 'admin.contacts.show.actions'|trans }}"
            title="{{ 'admin.contacts.show.actions'|trans }}"
        >
            {{ ux_icon('lucide:ellipsis', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
        </summary>
        <div class="absolute right-0 z-10 mt-2 w-48 rounded-xl border border-neutral-200 bg-white p-1 shadow-lg">
        <a
            href="{{ path('admin_visit_show', {adminPrefix: adminPrefix, reference: visit.reference}) }}"
            class="flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-gray-900"
            data-testid="visit-edit"
        >
            {{ ux_icon('lucide:pencil', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
            {{ 'admin.visits.row.edit'|trans }}
        </a>
        <div class="-mx-1 my-1 h-px bg-neutral-200/70" aria-hidden="true"></div>
        <twig:AlertDialog id="delete-visit-{{ visit.id }}">
            <button
                type="button"
                class="flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm font-medium text-red-600 transition-colors duration-100 ease-out hover:bg-red-50"
                data-action="click->alert-dialog#open"
                data-alert-dialog-target="trigger"
                aria-haspopup="dialog"
                aria-expanded="false"
                data-testid="visit-delete-trigger"
            >
                {{ ux_icon('lucide:trash-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                {{ 'admin.visits.row.delete'|trans }}
            </button>
                <twig:AlertDialog:Content class="sm:max-w-md">
                    <twig:AlertDialog:Header>
                        <twig:AlertDialog:Title>
                            {{ 'admin.visits.row.deleteModal.title'|trans }}
                        </twig:AlertDialog:Title>
                        <twig:AlertDialog:Description>
                            {{ 'admin.visits.row.deleteModal.text'|trans({'%address%': visit.address}) }}
                        </twig:AlertDialog:Description>
                    </twig:AlertDialog:Header>
                    <twig:AlertDialog:Footer class="mt-4">
                        <twig:AlertDialog:Cancel>
                            {{ 'admin.visits.row.deleteModal.cancel'|trans }}
                        </twig:AlertDialog:Cancel>
                        <form
                            method="post"
                            action="{{ path('admin_visit_delete', {adminPrefix: adminPrefix, reference: visit.reference}) }}"
                            class="contents"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_visit') }}">
                            <twig:AlertDialog:Action type="submit" variant="destructive" data-testid="visit-delete">
                                <span class="flex items-center gap-2">
                                    {{ ux_icon('lucide:trash-2', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.visits.row.deleteModal.confirm'|trans }}
                                </span>
                            </twig:AlertDialog:Action>
                        </form>
                    </twig:AlertDialog:Footer>
                </twig:AlertDialog:Content>
            </twig:AlertDialog>
        </div>
    </details>
{% endmacro %}

{% macro photo(visit, adminPrefix, px, classes) %}
    {% if visit.firstPhotoId %}
        {# Vignette du bien : première photo prise sur place. #}
        <img
            src="{{ path('admin_visit_photo_file', {adminPrefix: adminPrefix, reference: visit.reference, photoId: visit.firstPhotoId}) }}"
            alt=""
            width="{{ px }}"
            height="{{ px }}"
            loading="lazy"
            class="{{ classes }} shrink-0 object-cover ring-1 ring-gray-950/10"
            data-testid="visit-photo-thumb"
        >
    {% endif %}
{% endmacro %}

{% macro rowLink(visit, adminPrefix) %}
    {# Lien étiré : toute la card ouvre le détail; les liens et menus
       internes repassent au-dessus via z-10. #}
    <a
        href="{{ path('admin_visit_show', {adminPrefix: adminPrefix, reference: visit.reference}) }}"
        class="absolute inset-0 z-0 rounded-xl"
        aria-label="{{ 'admin.visits.row.open'|trans }}"
        data-testid="visit-row-link"
    ></a>
{% endmacro %}

{% macro visitRow(visit, adminPrefix, showDate = true, minutesUntil = null) %}
    {# Une visite passée sans compte-rendu réclame le reporting; une
       passée traitée s'estompe pour laisser ressortir la prochaine. #}
    {# Compte-rendu attendu : l'heure est passée sans issue enregistrée, ou
       la visite est marquée effectuée sans compte-rendu rédigé. Une visite
       doit toujours finir complétée. #}
    {% set reportMissing = visit.report is null or visit.report|trim == '' %}
    {% set reportDue = (visit.scheduledAt|date('U') < 'now'|date('U') and visit.status.value == 'planned')
        or (visit.status.value == 'done' and reportMissing) %}
    {% set isPast = (visit.scheduledAt|date('U') < 'now'|date('U') or visit.status.value in ['cancelled', 'no_show']) and not reportDue %}
    {% set dateShort = visit.scheduledAt|format_datetime(pattern='EEE d MMM')|replace({'.': ''}) %}
    {% set timeShort = visit.scheduledAt|format_datetime(pattern="HH'h'mm") %}
    {% set rowAttrs %}
        data-controller="visit-hover"
        data-visit-hover-id-value="{{ visit.id }}"
        data-action="mouseenter->visit-hover#enter mouseleave->visit-hover#leave visit-pin:hover@window->visit-hover#pinEnter visit-pin:leave@window->visit-hover#pinLeave visit-pin:select@window->visit-hover#pinSelect"
        data-testid="visit-row"
    {% endset %}
    <li
        class="group/row isolate relative rounded-xl bg-white px-5 py-4 transition-[opacity,box-shadow] duration-100 ease-out hover:ring-1 hover:ring-neutral-200 has-[details[open]]:z-20 {{ isPast ? 'opacity-55 hover:opacity-100' }}"
        {{ rowAttrs }}
    >
        {{ _self.rowLink(visit, adminPrefix) }}
        <div class="flex flex-col gap-y-4 sm:flex-row sm:items-center sm:gap-x-6">
            <div class="flex min-w-0 items-center gap-4 sm:flex-1">
                {# Heure dans une pastille horloge primary, date dessous. #}
                <div class="flex shrink-0 items-center gap-2.5" data-testid="visit-time-block">
                    <span class="flex size-9 items-center justify-center rounded-full bg-primary/10">
                        {{ ux_icon('lucide:clock', {class: 'size-4 shrink-0 text-primary', 'aria-hidden': 'true'}) }}
                    </span>
                    <div>
                        <p class="text-sm font-semibold text-gray-900 tabular-nums">{{ timeShort }}</p>
                        {% if showDate %}
                            <p class="text-[10px] font-medium tracking-wide text-gray-500 uppercase">{{ dateShort }}</p>
                        {% endif %}
                    </div>
                </div>
                {# Séparateur vertical entre l'heure et le bloc dossier. #}
                <span class="hidden h-10 w-px shrink-0 bg-gray-950/10 sm:block" aria-hidden="true"></span>
                {{ _self.photo(visit, adminPrefix, 80, 'size-20 rounded-lg') }}
                <div class="min-w-0">
                    <p class="mb-1.5 flex flex-wrap items-center gap-1.5">{{ _self.typeBadges(visit, reportDue, minutesUntil) }}</p>
                    {{ _self.dossierAddress(visit, adminPrefix) }}
                </div>
            </div>
            {# Qui réalise la visite : la réservation se lit sur la fiche.
               Largeur fixe pour que le bloc s'aligne d'une card à l'autre. #}
            <div class="flex shrink-0 items-center sm:w-40" data-testid="visit-people">
                {{ _self.performedBy(visit) }}
            </div>
            {{ _self.rowMenu(visit, adminPrefix) }}
        </div>
    </li>
{% endmacro %}

{% import _self as ui %}

<div {{ attributes }} data-testid="visits-list-component">
    {% set todayVisits = this.todayVisits %}
    {% set tomorrowVisits = this.tomorrowVisits %}
    {% set laterVisits = this.laterVisits %}

    {% if this.isEmptyEverywhere %}
        <section class="rounded-2xl border border-dashed border-gray-950/10 bg-white/50 p-2" data-testid="visits-empty">
            <div class="flex flex-col items-center justify-center gap-3 rounded-xl px-4 py-16 text-center">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-400">
                    {{ ux_icon('lucide:calendar-check', {class: 'size-6', 'aria-hidden': 'true'}) }}
                </div>
                <div class="space-y-1">
                    <h2 class="text-sm font-medium text-gray-700">{{ 'admin.visits.empty.title'|trans }}</h2>
                    <p class="max-w-[40ch] text-xs text-pretty text-gray-400">{{ 'admin.visits.empty.description'|trans }}</p>
                </div>
                <twig:Button as="a" size="sm" href="{{ path('admin_visit_new', {adminPrefix: this.adminPrefix}) }}" data-testid="visits-empty-cta">
                    <span class="flex items-center gap-2">
                        {{ ux_icon('lucide:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'admin.visits.create.button'|trans }}
                    </span>
                </twig:Button>
            </div>
        </section>
    {% else %}
        <div class="space-y-8">
            {# Aujourd'hui : carte + liste numérotée comme les pins. #}
            <section data-testid="visits-today">
                <h2 class="mb-3 flex items-baseline gap-2 px-1 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                    {{ 'admin.visits.section.today'|trans }}
                    <span class="text-xs font-medium text-gray-400 normal-case tabular-nums">{{ todayVisits|length }}</span>
                </h2>

                {% if todayVisits is empty %}
                    {{ ui.sectionEmpty('admin.visits.section.todayEmpty'|trans, 'visits-today-empty') }}
                {% else %}
                    {% if this.mappableTodayVisits is not empty %}
                        {# Carte de la tournée du jour, pleine largeur et sans
                           cadre : pins numérotés reliés par le trajet à pied
                           entre visites consécutives (Routes API), dessinés
                           par le controller à partir des payloads JSON. #}
                        <div
                            class="mb-3 h-80 overflow-hidden rounded-2xl lg:h-[26rem]"
                            data-controller="visit-map"
                            data-visit-map-visits-value="{{ this.mapPayload }}"
                            data-visit-map-route-value="{{ this.routePayload }}"
                            data-testid="visits-map"
                        >
                            {{ ux_map(this.map, {style: 'height: 100%; width: 100%;'}) }}
                        </div>
                    {% endif %}
                    <div class="rounded-3xl border border-neutral-200 bg-white p-2">
                        <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
                            <ul class="flex flex-col gap-1" role="list">
                                {% for visit in todayVisits %}
                                    {{ ui.visitRow(visit, this.adminPrefix, false, this.minutesUntil(visit.scheduledAt)) }}
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}
            </section>

            {# Demain : masqué quand vide (comme Prochains jours), seul
               Aujourd'hui garde son encart vide. #}
            {% if tomorrowVisits is not empty %}
                <section data-testid="visits-tomorrow">
                    <h2 class="mb-3 flex items-baseline gap-2 px-1 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                        {{ 'admin.visits.section.tomorrow'|trans }}
                        <span class="text-xs font-medium text-gray-400 normal-case tabular-nums">{{ tomorrowVisits|length }}</span>
                    </h2>
                    <div class="rounded-3xl border border-neutral-200 bg-white p-2">
                        <ul class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2" role="list">
                            {% for visit in tomorrowVisits %}
                                {{ ui.visitRow(visit, this.adminPrefix, true, this.minutesUntil(visit.scheduledAt)) }}
                            {% endfor %}
                        </ul>
                    </div>
                </section>
            {% endif %}

            {# Prochains jours : la date apparaît au premier créneau de chaque jour. #}
            {% if laterVisits is not empty %}
                {% set laterMappable = this.mappableLaterVisits %}
                <section
                    data-testid="visits-later"
                    {% if laterMappable is not empty %}
                        data-controller="visit-days-map"
                        data-visit-days-map-visits-value="{{ this.laterMapPayload }}"
                    {% endif %}
                >
                    <div class="mb-3 flex items-center justify-between gap-3 px-1">
                        <h2 class="flex items-baseline gap-2 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                            {{ 'admin.visits.section.later'|trans }}
                            <span class="text-xs font-medium text-gray-400 normal-case tabular-nums">{{ laterVisits|length }}</span>
                        </h2>
                        {% if laterMappable is not empty %}
                            {# Carte repliée par défaut : les prochains jours se
                               lisent d'abord en liste. #}
                            <button
                                type="button"
                                data-action="visit-days-map#toggle"
                                class="flex shrink-0 cursor-pointer items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-2.5 py-1 text-xs font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                                data-testid="visits-later-map-toggle"
                            >
                                {{ ux_icon('lucide:map', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                <span data-visit-days-map-target="showLabel">{{ 'admin.visits.section.showMap'|trans }}</span>
                                <span data-visit-days-map-target="hideLabel" class="hidden">{{ 'admin.visits.section.hideMap'|trans }}</span>
                            </button>
                        {% endif %}
                    </div>
                    {% if laterMappable is not empty %}
                        {# Points simples (pas de numérotation ni de trajet : ces
                           visites ne sont pas une tournée), date au survol. #}
                        <div
                            class="mb-3 hidden h-80 overflow-hidden rounded-2xl lg:h-[26rem]"
                            data-visit-days-map-target="frame"
                            data-testid="visits-later-map"
                        >
                            {{ ux_map(this.map, {style: 'height: 100%; width: 100%;'}) }}
                        </div>
                    {% endif %}
                    <div class="rounded-3xl border border-neutral-200 bg-white p-2">
                        <ul class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2" role="list">
                            {% for visit in laterVisits %}
                                {% set day = visit.scheduledAt|format_datetime(pattern='yyyy-MM-dd') %}
                                {% set previousDay = loop.first ? null : laterVisits[loop.index0 - 1].scheduledAt|format_datetime(pattern='yyyy-MM-dd') %}
                                {% if day != previousDay %}
                                    <li class="px-3 pt-3 pb-1 first:pt-1">
                                        <p class="text-xs font-medium text-gray-500 capitalize" data-testid="visits-later-day">
                                            {{ visit.scheduledAt|format_datetime(pattern='EEEE d MMMM') }}
                                        </p>
                                    </li>
                                {% endif %}
                                {{ ui.visitRow(visit, this.adminPrefix, false, this.minutesUntil(visit.scheduledAt)) }}
                            {% endfor %}
                        </ul>
                    </div>
                </section>
            {% endif %}

        </div>
    {% endif %}
</div>
