{#
    Visit:VisitForm — quick booking form. One narrow column of separated
    white bands (same vocabulary as the Recherche card): visit, property,
    slot, who performs it, notes. The optional fields (real estate agent,
    listing link, client presence) live behind the "detail mode" toggle.
#}

{% macro input(field, label, type, required = true, min = null) %}
    {% set hasErrors = field.vars.errors|length > 0 %}
    <div class="min-w-0">
        <twig:Label for="{{ field.vars.id }}" class="text-gray-600">
            {{ label|trans }}
            {% if required %}<span class="text-red-600" aria-hidden="true">*</span>{% endif %}
        </twig:Label>
        <div class="mt-1.5">
            <input
                type="{{ type }}"
                {% if min is not null %}min="{{ min }}"{% endif %}
                id="{{ field.vars.id }}"
                name="{{ field.vars.full_name }}"
                value="{{ field.vars.value }}"
                {% if field.vars.attr.maxlength is defined %}maxlength="{{ field.vars.attr.maxlength }}"{% endif %}
                {% if field.vars.attr.placeholder is defined %}placeholder="{{ field.vars.attr.placeholder|trans }}"{% endif %}
                {% if required %}required{% endif %}
                aria-invalid="{{ hasErrors ? 'true' : 'false' }}"
                class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                data-testid="visit-form-{{ field.vars.name }}"
            >
            {% for error in field.vars.errors %}
                <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% macro enumChips(field, label, enumCases) %}
    {# Chips radio natives : input sr-only + peer-checked, POST classique. #}
    <div class="min-w-0">
        <twig:Label class="text-gray-600">{{ label|trans }}</twig:Label>
        <div class="mt-1.5 flex flex-wrap gap-1.5">
            {% for case in enumCases %}
                <label class="cursor-pointer">
                    <input
                        type="radio"
                        name="{{ field.vars.full_name }}"
                        value="{{ case.value }}"
                        {{ case.value == field.vars.value ? 'checked' }}
                        class="peer sr-only"
                        data-testid="visit-form-{{ field.vars.name }}-{{ case.value }}"
                    >
                    <span class="flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out peer-checked:border-primary/40 peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-gray-50 hover:text-gray-900">
                        {{ ux_icon(case.icon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                        {{ case.labelKey|trans }}
                    </span>
                </label>
            {% endfor %}
        </div>
        {% for error in field.vars.errors %}
            <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
        {% endfor %}
    </div>
{% endmacro %}

{% macro select(field, label, required = true) %}
    {% set hasErrors = field.vars.errors|length > 0 %}
    {% set placeholder = field.vars.placeholder is defined and field.vars.placeholder is not null ? field.vars.placeholder|trans : '' %}
    {% set selectedLabel = '' %}
    {% for choice in field.vars.choices %}
        {% if choice.value == field.vars.value %}{% set selectedLabel = choice.label %}{% endif %}
    {% endfor %}
    <div class="min-w-0">
        <twig:Label for="{{ field.vars.id }}" class="text-gray-600">
            {{ label|trans }}
            {% if required %}<span class="text-red-600" aria-hidden="true">*</span>{% endif %}
        </twig:Label>
        {# Dropdown stylisé maison : le <select> natif reste en sr-only pour
           le POST du formulaire, le contrôleur "select" pilote le panneau. #}
        <div class="relative mt-1.5" data-controller="select">
            <select
                id="{{ field.vars.id }}"
                name="{{ field.vars.full_name }}"
                {% if required %}required{% endif %}
                aria-invalid="{{ hasErrors ? 'true' : 'false' }}"
                aria-hidden="true"
                tabindex="-1"
                data-select-target="select"
                class="sr-only"
                data-testid="visit-form-{{ field.vars.name }}"
            >
                {% if placeholder is not empty %}
                    <option value="">{{ placeholder }}</option>
                {% endif %}
                {% for choice in field.vars.choices %}
                    <option value="{{ choice.value }}" {{ choice.value == field.vars.value ? 'selected' }}>{{ choice.label }}</option>
                {% endfor %}
            </select>
            <button
                type="button"
                data-select-target="button"
                data-action="click->select#toggle"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="{{ field.vars.id }}-panel"
                class="flex w-full cursor-pointer items-center justify-between gap-2 rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 ease-out hover:border-gray-300 hover:bg-gray-50 focus:border-gray-400 focus:outline-none"
                data-testid="visit-form-{{ field.vars.name }}-button"
            >
                <span data-select-target="display" class="{{ selectedLabel is empty ? 'text-gray-400' }} min-w-0 truncate">{{ selectedLabel is not empty ? selectedLabel : placeholder }}</span>
                {{ ux_icon('lucide:chevrons-up-down', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
            </button>
            <div
                id="{{ field.vars.id }}-panel"
                data-select-target="panel"
                hidden
                class="absolute z-20 mt-1 w-full overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-lg"
            >
                <ul
                    role="listbox"
                    tabindex="-1"
                    data-select-target="list"
                    data-action="click->select#choose keydown->select#keydown"
                    class="max-h-60 space-y-0.5 overflow-auto p-1 outline-none"
                ></ul>
            </div>
            {% for error in field.vars.errors %}
                <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% import _self as ui %}

<div {{ attributes }} data-testid="visit-form-page">
    {# Le dossier commande tout le reste : tant qu'il n'est pas choisi, le
       formulaire se limite à ce champ (une visite sans dossier n'existe
       pas, et les cards de rappel n'auraient rien à afficher). #}
    {% set dossier = this.selectedDossier %}
    {# Une visite se cadre sur les critères de recherche : dossier
       incomplet, le formulaire s'arrête au choix du dossier. #}
    {% set ready = dossier and dossier.searchComplete %}
    <div class="mx-auto flex max-w-2xl flex-col gap-4 lg:max-w-5xl lg:flex-row lg:items-start lg:gap-6">
    <form
        data-action="live#action:prevent"
        data-live-action-param="create"
        data-model="on(input)|debounce(400)|*"
        novalidate
        autocomplete="off"
        class="min-w-0 flex-1"
        data-testid="visit-form"
    >
        <div class="rounded-3xl border border-neutral-200 bg-white p-2">
            <div class="space-y-2 rounded-2xl bg-neutral-50 p-2">

                {# ── L'essentiel, en bandes séparées comme la card Recherche :
                      dossier et type, le bien, le créneau, l'agent, la note. ── #}
                <div class="flex flex-col gap-1">
                    <div class="{{ ready ? 'rounded-t-xl' : 'rounded-xl' }} bg-white px-5 py-4">
                        <h3 class="mb-4 text-xs font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.visits.create.sections.visit'|trans }}</h3>
                        <div class="space-y-4">
                            {{ ui.select(form.dossier, 'admin.visits.create.dossier.label') }}
                            {# Le choix d'un dossier déclenche un re-rendu live (récap,
                               critères) : petit loader le temps de la requête. #}
                            <div
                                data-loading="model(visit.dossier)|removeClass(hidden)"
                                class="hidden flex items-center gap-2 text-sm text-gray-400"
                                data-testid="visit-form-dossier-loading"
                            >
                                {{ ux_icon('lucide:loader-circle', {class: 'size-4 shrink-0 animate-spin', 'aria-hidden': 'true'}) }}
                                {{ 'admin.visits.create.dossier.loading'|trans }}
                            </div>
                            {% if dossier and not ready %}
                                {# Masquée pendant le changement de dossier : elle décrit
                                   l'ancien dossier tant que le nouveau n'est pas rendu. #}
                                <div data-loading="model(visit.dossier)|addClass(hidden)" class="flex flex-wrap items-center justify-between gap-2 rounded-xl bg-amber-50 px-3.5 py-3" data-testid="visit-form-dossier-incomplete">
                                    <p class="flex items-start gap-2 text-sm text-amber-700">
                                        {{ ux_icon('lucide:triangle-alert', {class: 'mt-0.5 size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.visits.create.dossier.incomplete'|trans }}
                                    </p>
                                    <a
                                        {# Directement sur l'onglet Recherche du dossier : le lien
                                           doit tomber sur le champ à compléter, pas sur le récap. #}
                                        href="{{ path('admin_dossier_show', {adminPrefix: this.adminPrefix, reference: dossier.reference, tab: 'search'}) }}"
                                        class="flex items-center gap-1.5 text-xs font-medium text-amber-800 transition-colors duration-100 ease-out hover:text-amber-900"
                                        data-testid="visit-form-dossier-incomplete-link"
                                    >
                                        {{ 'admin.visits.create.dossier.incompleteLink'|trans }}
                                        {{ ux_icon('lucide:arrow-right', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                    </a>
                                </div>
                            {% endif %}
                            {% if ready %}
                                {# Tout ce qui décrit le dossier se masque pendant qu'un
                                   autre dossier charge : le récap affiché serait celui
                                   de l'ancien. #}
                                <div data-loading="model(visit.dossier)|addClass(hidden)" class="space-y-4">
                                {# Rappel du dossier : la formule d'abord, elle
                                   décide de ce qu'on fait sur place. #}
                                <div class="grid gap-1.5 sm:grid-cols-3" data-testid="visit-form-dossier-recap">
                                    <div class="rounded-xl border border-primary/40 bg-primary/5 px-3.5 py-3" data-testid="visit-form-dossier-offer">
                                        <p class="flex items-center gap-1.5 text-xs text-primary/70">
                                            {{ ux_icon('lucide:badge-check', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                            <span class="truncate">{{ 'admin.dossiers.card.package.label'|trans }}</span>
                                        </p>
                                        <p class="mt-1 truncate text-sm font-medium text-primary">
                                            {{ dossier.offer ? ('contact.contactForm.offer.' ~ dossier.offer ~ '.title')|trans : 'admin.contacts.edit.noOffer'|trans }}
                                        </p>
                                    </div>
                                    <div class="rounded-xl border border-neutral-200 bg-neutral-50 px-3.5 py-3">
                                        <p class="flex items-center gap-1.5 text-xs text-gray-400">
                                            {{ ux_icon('lucide:user', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                            <span class="truncate">{{ 'admin.dossiers.create.person.primaryTag'|trans }}</span>
                                        </p>
                                        <p class="mt-1 truncate text-sm font-medium text-gray-900">
                                            {{ dossier.primaryTenantName ? dossier.primaryTenantName|title : '-' }}
                                        </p>
                                    </div>
                                    <div class="rounded-xl border border-neutral-200 bg-neutral-50 px-3.5 py-3">
                                        <p class="flex items-center gap-1.5 text-xs text-gray-400">
                                            {{ ux_icon('lucide:calendar-heart', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                            <span class="truncate">{{ 'admin.contacts.project.moveIn'|trans }}</span>
                                        </p>
                                        <p class="mt-1 truncate text-sm font-medium text-gray-900 tabular-nums">
                                            {{ dossier.moveInAt ? dossier.moveInAt|format_datetime(pattern='dd MMM yyyy') : '-' }}
                                        </p>
                                    </div>
                                </div>
                                {{ ui.enumChips(form.type, 'admin.visits.create.type.label', enum('App\\Visit\\Domain\\VisitType').cases()) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {% if ready %}
                    {# Les bandes suivantes dépendent du dossier : masquées le
                       temps qu'un changement de dossier se re-rende. #}
                    <div data-loading="model(visit.dossier)|addClass(hidden)" class="flex flex-col gap-1">
                    <div class="bg-white px-5 py-4">
                        <h3 class="mb-4 text-xs font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.visits.create.sections.property'|trans }}</h3>
                        {# Adresse : autocomplete Places (même widget que "Proposer
                           un bien"), les coordonnées partent via chooseLocation. #}
                        <div
                            class="relative min-w-0"
                            data-controller="places-autocomplete"
                            data-places-autocomplete-paris-only-value="false"
                            data-places-autocomplete-idf-only-value="true"
                            data-places-autocomplete-script-url-value="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&amp;libraries=places&amp;language={{ app.request ? app.request.locale : 'fr' }}"
                        >
                            <twig:Label for="{{ form.address.vars.id }}" class="text-gray-600">
                                {{ 'admin.visits.create.address.label'|trans }}
                                <span class="text-red-600" aria-hidden="true">*</span>
                            </twig:Label>
                            <div class="mt-1.5">
                                <input
                                    type="text"
                                    id="{{ form.address.vars.id }}"
                                    name="{{ form.address.vars.full_name }}"
                                    value="{{ form.address.vars.value }}"
                                    maxlength="255"
                                    required
                                    placeholder="{{ 'admin.visits.create.address.placeholder'|trans }}"
                                    data-places-autocomplete-target="input"
                                    data-action="input->places-autocomplete#search keydown->places-autocomplete#navigate"
                                    aria-invalid="{{ form.address.vars.errors|length > 0 ? 'true' : 'false' }}"
                                    class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                                    data-testid="visit-form-address"
                                >
                                {# Dropdown de suggestions rempli par le controller. #}
                                <ul
                                    data-places-autocomplete-target="results"
                                    role="listbox"
                                    class="absolute top-full right-0 left-0 z-50 mt-2 hidden max-h-72 overflow-y-auto rounded-xl border border-slate-200 bg-white p-1 shadow-xl shadow-gray-500/10"
                                ></ul>
                                {# Relais sélection Places -> LiveAction chooseLocation. #}
                                <span
                                    class="hidden"
                                    data-places-autocomplete-target="trigger"
                                    data-action="places-autocomplete:select->live#action"
                                    data-live-action-param="chooseLocation"
                                    aria-hidden="true"
                                ></span>
                                {% for error in form.address.vars.errors %}
                                    <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                                {% endfor %}
                            </div>
                        </div>
                        <twig:Visit:DuplicateWarning :visits="this.matchingVisits" adminPrefix="{{ this.adminPrefix }}" />
                    </div>

                    <div class="bg-white px-5 py-4">
                        <h3 class="mb-4 text-xs font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.visits.create.sections.slot'|trans }}</h3>
                        <div class="grid gap-4 sm:grid-cols-2">
                            {{ ui.input(form.scheduledAt, 'admin.visits.create.scheduledAt.label', 'datetime-local', true, 'now'|date('Y-m-d\\TH:i')) }}
                            <div class="min-w-0">
                                <p id="{{ form.durationMinutes.vars.id }}-label" class="text-sm text-gray-600">
                                    {{ 'admin.visits.create.duration.label'|trans }}
                                    <span class="text-red-600" aria-hidden="true">*</span>
                                </p>
                                {# Chips radio, même vocabulaire que le choix de type. #}
                                <div role="radiogroup" aria-labelledby="{{ form.durationMinutes.vars.id }}-label" class="mt-2 flex flex-wrap gap-1.5">
                                    {% for choice in form.durationMinutes.vars.choices %}
                                        <label class="cursor-pointer">
                                            <input
                                                type="radio"
                                                name="{{ form.durationMinutes.vars.full_name }}"
                                                value="{{ choice.value }}"
                                                {{ choice.value == form.durationMinutes.vars.value ? 'checked' }}
                                                class="peer sr-only"
                                                data-testid="visit-form-duration-{{ choice.value }}"
                                            >
                                            <span class="flex items-center rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 tabular-nums transition-colors duration-100 ease-out peer-checked:border-primary/40 peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-gray-50 hover:text-gray-900">
                                                {{ choice.label|trans }}
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>
                                {% for error in form.durationMinutes.vars.errors %}
                                    <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    {# Effectuée par : chips des agents de visite (même geste que
                       "Suivi par" sur un lead), le titre de bande sert de label. #}
                    <div class="bg-white px-5 py-4">
                        <h3 class="mb-4 text-xs font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.visits.create.assignee.label'|trans }}</h3>
                        <input
                            type="hidden"
                            id="{{ form.assignee.vars.id }}"
                            name="{{ form.assignee.vars.full_name }}"
                            value="{{ this.formValues['assignee'] ?? '' }}"
                            data-testid="visit-form-assignee"
                        >
                        {% set pickedAssignee = (this.formValues['assignee'] ?? '') %}
                        <div class="flex flex-wrap items-center gap-2" data-testid="assignee-chips">
                            {% for choice in this.assigneeChoices %}
                                {% set picked = pickedAssignee == choice.id %}
                                <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-action-param="pickAssignee"
                                    data-live-id-param="{{ choice.id }}"
                                    aria-pressed="{{ picked ? 'true' : 'false' }}"
                                    class="flex cursor-pointer items-center gap-1.5 rounded-full border py-1 pr-3 pl-1 text-sm transition-colors duration-100 ease-out {{ picked ? 'border-primary/40 bg-primary/5 font-medium text-primary' : 'border-dashed border-gray-300 text-gray-500 hover:border-gray-400 hover:text-gray-900' }}"
                                    data-testid="assignee-chip"
                                >
                                    <twig:Avatar filename="{{ choice.avatar }}" name="{{ choice.name }}" size="6" class="{{ picked ? '' : 'opacity-70' }}" />
                                    {{ choice.name|title }}
                                    {% if picked %}
                                        {{ ux_icon('lucide:x', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                    {% endif %}
                                </button>
                            {% else %}
                                <p class="text-xs text-gray-400">{{ 'admin.visits.create.assignee.none'|trans }}</p>
                            {% endfor %}
                        </div>
                        {% for error in form.assignee.vars.errors %}
                            <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                        {% endfor %}
                    </div>

                    {# Consignes du jour J : code d'accès, contact sur place... #}
                    <div class="rounded-b-xl bg-white px-5 py-4">
                        <h3 class="mb-4 text-xs font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.visits.create.note.label'|trans }}</h3>
                        <textarea
                            id="{{ form.note.vars.id }}"
                            name="{{ form.note.vars.full_name }}"
                            rows="3"
                            maxlength="2000"
                            placeholder="{{ 'admin.visits.create.note.placeholder'|trans }}"
                            aria-label="{{ 'admin.visits.create.note.label'|trans }}"
                            class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                            data-testid="visit-form-note"
                        >{{ form.note.vars.value }}</textarea>
                        {% for error in form.note.vars.errors %}
                            <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                        {% endfor %}
                    </div>
                    </div>
                    {% endif %}
                </div>

                {% if ready %}
                <div data-loading="model(visit.dossier)|addClass(hidden)" class="space-y-2">
                {# ── Mode détaillé : le complément, replié par défaut. ── #}
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="toggleDetails"
                    aria-pressed="{{ this.detailed ? 'true' : 'false' }}"
                    class="flex w-full cursor-pointer items-center gap-3 rounded-xl bg-white px-5 py-3.5 text-left transition-colors duration-100 ease-out hover:bg-neutral-100/60"
                    data-testid="visit-form-details-toggle"
                >
                    <span class="min-w-0 flex-1">
                        <span class="block text-sm font-medium text-gray-900">{{ 'admin.visits.create.details.label'|trans }}</span>
                        <span class="block text-xs text-gray-500">{{ 'admin.visits.create.details.help'|trans }}</span>
                    </span>
                    {# Interrupteur visuel piloté par la prop live. #}
                    <span class="flex h-5 w-9 shrink-0 items-center rounded-full p-0.5 transition-colors duration-100 ease-out {{ this.detailed ? 'bg-primary' : 'bg-neutral-200' }}" aria-hidden="true">
                        <span class="size-4 rounded-full bg-white shadow-sm transition-transform duration-100 ease-out {{ this.detailed ? 'translate-x-4' : '' }}"></span>
                    </span>
                </button>

                {% if this.detailed %}
                    <div class="flex flex-col gap-1" data-testid="visit-form-details">
                        <div class="rounded-t-xl bg-white px-5 py-4">
                            <h3 class="mb-4 text-xs font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.visits.create.sections.contacts'|trans }}</h3>
                            <div class="space-y-4">
                                {{ ui.select(form.agent, 'admin.visits.create.agent.label', false) }}
                                {{ ui.input(form.listingUrl, 'admin.visits.create.listingUrl.label', 'url', false) }}
                            </div>
                        </div>

                        {# Tuile-option cliquable : le client vient, ou l'agent
                           visite pour son compte (procuration). #}
                        <div class="rounded-b-xl bg-white px-5 py-4">
                            <h3 class="mb-4 text-xs font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.visits.create.sections.options'|trans }}</h3>
                            <label
                                class="group/present flex w-full cursor-pointer items-center gap-3 rounded-xl border border-neutral-200 bg-white px-4 py-3 transition-colors duration-100 ease-out has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5 hover:bg-neutral-50 has-[input:checked]:hover:bg-primary/10"
                            >
                                <input
                                    type="checkbox"
                                    name="{{ form.clientPresent.vars.full_name }}"
                                    value="1"
                                    {{ form.clientPresent.vars.checked ? 'checked' }}
                                    class="sr-only"
                                    data-testid="visit-form-client-present"
                                >
                                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-neutral-100 text-gray-400 transition-colors duration-100 ease-out group-has-[input:checked]/present:bg-primary group-has-[input:checked]/present:text-white">
                                    {{ ux_icon('lucide:user-check', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                </span>
                                <span class="min-w-0 flex-1">
                                    <span class="block text-sm font-medium text-gray-900 transition-colors duration-100 ease-out group-has-[input:checked]/present:text-primary">{{ 'admin.visits.create.clientPresent.label'|trans }}</span>
                                    <span class="block text-xs text-gray-500">{{ 'admin.visits.create.clientPresent.help'|trans }}</span>
                                </span>
                                <span class="flex h-5 w-9 shrink-0 items-center rounded-full bg-neutral-200 p-0.5 transition-colors duration-100 ease-out group-has-[input:checked]/present:bg-primary" aria-hidden="true">
                                    <span class="size-4 rounded-full bg-white shadow-sm transition-transform duration-100 ease-out group-has-[input:checked]/present:translate-x-4"></span>
                                </span>
                            </label>
                        </div>
                    </div>
                {% endif %}
                </div>
                {% endif %}

                {# Pied : annuler / planifier. #}
                <div class="flex items-center justify-end gap-4 p-3">
                    <a
                        href="{{ path('admin_visits', {adminPrefix: this.adminPrefix}) }}"
                        class="text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                        data-testid="visit-form-cancel"
                    >
                        {{ 'admin.visits.create.cancel'|trans }}
                    </a>
                    {% if ready %}
                    {# data-loading désactive le bouton pendant create :
                       un double-clic créerait deux visites. #}
                    <button
                        type="submit"
                        data-loading="action(create)|addAttribute(disabled) model(visit.dossier)|addClass(hidden)"
                        class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60"
                        data-testid="visit-form-submit"
                    >
                        <span data-loading="action(create)|addClass(hidden)">{{ 'admin.visits.create.submit'|trans }}</span>
                        <span data-loading="action(create)|removeClass(hidden)" class="hidden flex items-center gap-2">
                            {{ ux_icon('lucide:loader-circle', {class: 'size-4 shrink-0 animate-spin', 'aria-hidden': 'true'}) }}
                            {{ 'admin.visits.create.submitting'|trans }}
                        </span>
                    </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </form>

    {% if ready %}
        {# ── Récapitulatif de la visite en cours de saisie : colonne sticky à
              droite sur desktop, re-rendue à chaque frappe (le formulaire est
              déjà un live model). Masquée sur mobile (elle ne ferait que
              dupliquer le formulaire juste au-dessus) et pendant qu'un
              changement de dossier charge. ── #}
        {% set recapType = (this.formValues['type'] ?? '') ? enum('App\\Visit\\Domain\\VisitType').tryFrom(this.formValues['type']) : null %}
        {% set recapAddress = (this.formValues['address'] ?? '')|trim %}
        {% set recapScheduledAt = this.formValues['scheduledAt'] ?? '' %}
        {% set recapDurationLabel = '' %}
        {% for choice in form.durationMinutes.vars.choices %}
            {% if choice.value == form.durationMinutes.vars.value %}{% set recapDurationLabel = choice.label|trans %}{% endif %}
        {% endfor %}
        {% set recapAssignee = this.assigneeChoices|filter(c => c.id == (this.formValues['assignee'] ?? ''))|first %}
        <aside
            data-loading="model(visit.dossier)|addClass(hidden)"
            class="hidden lg:sticky lg:top-6 lg:block lg:w-80 lg:shrink-0"
            data-testid="visit-form-recap"
        >
            <div class="rounded-3xl border border-neutral-200 bg-white p-2">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="rounded-xl bg-white px-5 py-4">
                        <h3 class="mb-4 text-xs font-semibold tracking-wide text-gray-400 uppercase">{{ 'admin.visits.create.recap.title'|trans }}</h3>
                        <dl class="space-y-3.5">
                            <div class="min-w-0">
                                <dt class="flex items-center gap-1.5 text-xs text-gray-400">
                                    {{ ux_icon('lucide:folder', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                    <span class="truncate">{{ 'admin.visits.create.dossier.label'|trans }}</span>
                                </dt>
                                <dd class="mt-1 truncate text-sm font-medium text-gray-900">
                                    {{ dossier.name }}
                                    <span class="font-normal text-gray-400">{{ dossier.reference }}</span>
                                </dd>
                            </div>
                            {% if recapType %}
                                <div class="min-w-0">
                                    <dt class="flex items-center gap-1.5 text-xs text-gray-400">
                                        {{ ux_icon(recapType.icon, {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        <span class="truncate">{{ 'admin.visits.create.type.label'|trans }}</span>
                                    </dt>
                                    <dd class="mt-1 truncate text-sm font-medium text-gray-900">{{ recapType.labelKey|trans }}</dd>
                                </div>
                            {% endif %}
                            {% if recapAddress %}
                                <div class="min-w-0">
                                    <dt class="flex items-center gap-1.5 text-xs text-gray-400">
                                        {{ ux_icon('lucide:map-pin', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        <span class="truncate">{{ 'admin.visits.create.address.label'|trans }}</span>
                                    </dt>
                                    <dd class="mt-1 text-sm font-medium text-gray-900">{{ recapAddress }}</dd>
                                </div>
                            {% endif %}
                            {% if recapScheduledAt %}
                                <div class="min-w-0">
                                    <dt class="flex items-center gap-1.5 text-xs text-gray-400">
                                        {{ ux_icon('lucide:calendar-clock', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        <span class="truncate">{{ 'admin.visits.create.scheduledAt.label'|trans }}</span>
                                    </dt>
                                    <dd class="mt-1 truncate text-sm font-medium text-gray-900 tabular-nums">
                                        {{ recapScheduledAt|format_datetime(pattern='EEE d MMM yyyy, HH:mm') }}
                                        {% if recapDurationLabel %}
                                            <span class="font-normal text-gray-400">· {{ recapDurationLabel }}</span>
                                        {% endif %}
                                    </dd>
                                </div>
                            {% endif %}
                            {% if recapAssignee %}
                                <div class="min-w-0">
                                    <dt class="flex items-center gap-1.5 text-xs text-gray-400">
                                        {{ ux_icon('lucide:user', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        <span class="truncate">{{ 'admin.visits.create.assignee.label'|trans }}</span>
                                    </dt>
                                    <dd class="mt-1 truncate text-sm font-medium text-gray-900">{{ recapAssignee.name|title }}</dd>
                                </div>
                            {% endif %}
                        </dl>
                    </div>
                </div>
            </div>
        </aside>
    {% endif %}
    </div>
</div>
