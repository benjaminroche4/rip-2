{# Bandeau d'alerte du formulaire de visite (création et modification) :
   une visite est déjà prévue sur ce bien, même adresse ou même annonce.
   Informatif, jamais bloquant : deux visites sur le même bien restent
   légitimes (deux dossiers, deux créneaux). #}
{%- props visits, adminPrefix -%}
{% if visits is not empty %}
    <div
        class="mt-3 flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2.5"
        role="status"
        data-testid="visit-duplicate-warning"
    >
        {{ ux_icon('lucide:triangle-alert', {class: 'mt-0.5 size-4 shrink-0 text-amber-600', 'aria-hidden': 'true'}) }}
        <div class="min-w-0 space-y-1">
            <p class="text-sm font-medium text-amber-900">
                {{ 'admin.visits.create.duplicate.title'|trans({'%count%': visits|length}) }}
            </p>
            <ul class="space-y-0.5" role="list">
                {% for visit in visits %}
                    <li class="min-w-0 text-xs text-amber-800">
                        <a
                            href="{{ path('admin_visit_show', {adminPrefix: adminPrefix, id: visit.id}) }}"
                            class="font-medium underline underline-offset-2 transition-colors duration-100 ease-out hover:text-amber-950"
                            data-testid="visit-duplicate-link"
                        >
                            {{ visit.reference }}
                        </a>
                        {{ 'admin.visits.create.duplicate.item'|trans({
                            '%date%': visit.scheduledAt|format_datetime(pattern='dd MMM yyyy, HH:mm'),
                            '%dossier%': visit.dossierName,
                        }) }}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}
