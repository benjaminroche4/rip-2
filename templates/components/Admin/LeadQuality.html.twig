<div
    {{ attributes.defaults({
        'data-controller': 'leave-guard',
        'data-leave-guard-clean-event-value': 'lead-quality:saved',
        'data-leave-guard-message-value': 'admin.contacts.leadQuality.unsaved'|trans,
        'data-action': 'input->leave-guard#markDirty change->leave-guard#markDirty',
    }) }}
    data-testid="lead-quality-card"
>
    {% set contact = this.contact %}
    <div class="rounded-3xl border border-neutral-200 bg-white p-2">
        <details open class="group details-animated rounded-2xl bg-neutral-50 p-2">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-3 [&::-webkit-details-marker]:hidden">
                <div>
                    <h2 class="font-medium text-gray-900">{{ 'admin.contacts.show.field.leadRating'|trans }}</h2>
                    <p class="mt-0.5 text-xs text-gray-500">{{ 'admin.contacts.leadQuality.internal'|trans }}</p>
                </div>
                {{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-gray-400 transition-transform duration-200 group-open:rotate-180', 'aria-hidden': 'true'}) }}
            </summary>
            {% if this.promptRating %}
                <div class="mt-1 flex items-center justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50/60 px-4 py-2.5 text-sm text-amber-800" data-testid="rating-prompt">
                    <span class="flex items-center gap-2">
                        {{ ux_icon('lucide:star', {class: 'size-4 shrink-0 text-amber-500', 'aria-hidden': 'true'}) }}
                        {{ 'admin.contacts.leadQuality.ratingPrompt'|trans }}
                    </span>
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="dismissRatingPrompt"
                        class="flex size-6 shrink-0 cursor-pointer items-center justify-center rounded-full text-amber-600 transition-colors duration-100 ease-out hover:bg-amber-100"
                        aria-label="{{ 'admin.contacts.leadQuality.ratingPromptDismiss'|trans }}"
                        data-testid="rating-prompt-dismiss"
                    >
                        {{ ux_icon('lucide:x', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                    </button>
                </div>
            {% endif %}
            <div class="mt-1 flex flex-col gap-4 rounded-xl bg-white px-5 py-4">
                <div class="flex flex-wrap items-start justify-between gap-x-10 gap-y-4">
                    <div class="space-y-2 text-sm">
                        <p class="text-gray-600">{{ 'admin.contacts.leadQuality.ratingLabel'|trans }}</p>
                        {# Étoiles toujours pleines (jamais creuses) : or pour la note,
                           gris pour le reste. Survol = prévisualisation : pleines or
                           jusqu'à celle survolée, pleines grises après. #}
                        <p
                            class="flex items-center pt-1 [&:hover>button]:text-amber-400 [&>button:hover~button]:text-gray-300"
                            aria-label="{{ contact ? (contact.leadRating ?? 0) : 0 }}/5"
                        >
                            {% for star in 1..5 %}
                                <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-action-param="rate"
                                    data-live-rating-param="{{ star }}"
                                    class="-mx-px cursor-pointer transition-all duration-150 ease-out hover:scale-125 active:scale-100 {{ contact and contact.leadRating and star <= contact.leadRating ? 'text-amber-400' : 'text-gray-300' }}"
                                    aria-label="{{ 'admin.contacts.leadQuality.starLabel'|trans({'%count%': star}) }}"
                                    aria-pressed="{{ contact and contact.leadRating and star <= contact.leadRating ? 'true' : 'false' }}"
                                >
                                    {{ ux_icon('material-symbols:star-rounded', {class: 'size-7 transition-all duration-150 ease-out', 'aria-hidden': 'true'}) }}
                                </button>
                            {% endfor %}
                        </p>
                    </div>
                    <div class="space-y-2 text-sm">
                        <p class="text-gray-600">{{ 'admin.contacts.leadQuality.channelLabel'|trans }}</p>
                        {# Chips pill, mêmes que le planificateur de recontact
                           (ContactStatusControl) : un clic persiste le canal. #}
                        <div class="flex flex-wrap gap-1.5">
                            {% for channel in this.channels %}
                                {% set picked = contact and contact.recontactChannel == channel %}
                                <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-action-param="chooseChannel"
                                    data-live-channel-param="{{ channel.value }}"
                                    aria-pressed="{{ picked ? 'true' : 'false' }}"
                                    class="flex cursor-pointer items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium transition-colors duration-100 ease-out {{ picked ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                                    data-testid="lead-quality-channel-chip"
                                >
                                    {{ ux_icon(channel.icon, {class: 'size-3.5 shrink-0 ' ~ (picked ? 'text-primary/70' : 'text-gray-400'), 'aria-hidden': 'true'}) }}
                                    {{ channel.labelKey|trans }}
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <div class="space-y-2 text-sm">
                    <p class="text-gray-600">{{ 'admin.contacts.show.field.leadNote'|trans }}</p>
                    {% if this.editingNote %}
                        <div class="space-y-1.5">
                        <textarea
                            data-model="norender|note"
                            data-action="change->live#action keydown.enter->live#action:prevent"
                            data-live-action-param="saveNote"
                            rows="3"
                            placeholder="{{ 'admin.contacts.leadQuality.notePlaceholder'|trans }}"
                            aria-label="{{ 'admin.contacts.show.field.leadNote'|trans }}"
                            title="{{ 'admin.contacts.notes.enterHint'|trans }}"
                            class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                        >{{ this.note }}</textarea>
                        <p class="flex items-center gap-1.5 text-xs text-gray-400">
                            {{ ux_icon('lucide:info', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                            {{ 'admin.contacts.project.note.autosaveHint'|trans }}
                        </p>
                        </div>
                    {% else %}
                        <div class="flex items-start justify-between gap-3">
                            <p class="min-w-0 flex-1 font-medium text-pretty whitespace-pre-line text-gray-900">{{ this.note }}</p>
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="startEditingNote"
                                class="shrink-0 cursor-pointer rounded-lg p-1.5 text-gray-400 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-gray-900"
                                aria-label="{{ 'admin.contacts.notes.edit'|trans }}"
                                title="{{ 'admin.contacts.notes.edit'|trans }}"
                                data-testid="lead-quality-edit"
                            >
                                {{ ux_icon('lucide:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            </button>
                        </div>
                    {% endif %}
                </div>
            </div>
        </details>
    </div>
</div>
