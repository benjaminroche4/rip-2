{# Rendered as a row of the contact "Actions" dropdown menu — the trigger uses
   the menu-row vocabulary; the confirmation modal itself is fixed-positioned
   so it overlays the page from anywhere. L'envoi ne laisse pas de trace ici :
   la confirmation passe par le toast. #}
<div {{ attributes }} data-testid="contact-recap-email">
    {% set contact = this.contact %}
    {% if contact and not contact.email %}
        {# No email on this contact (manual intake) — nothing to send to. #}
    {% else %}
        <button
            type="button"
            data-action="live#action"
            data-live-action-param="openModal"
            class="flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:bg-gray-50 hover:text-gray-900"
            data-testid="contact-recap-send"
        >
            {{ ux_icon('lucide:mail', {class: 'size-4 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
            {{ 'admin.contacts.recapEmail.button'|trans }}
        </button>
    {% endif %}

    {% if this.state == 'modal' and contact %}
        <div
            class="group/modal fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 ease-out data-entered:opacity-100 motion-reduce:transition-none"
            data-controller="modal-anim instant-exit"
            data-action="keydown.esc@window->instant-exit#run keydown.esc@window->live#action"
            data-live-action-param="closeModal"
            data-testid="contact-recap-modal"
        >
            {# Clic en dehors de la carte = fermeture. #}
            <button
                type="button"
                class="absolute inset-0 cursor-default bg-gray-950/60 backdrop-blur-[2px]"
                data-action="instant-exit#run live#action"
                data-live-action-param="closeModal"
                aria-label="{{ 'admin.contacts.notes.cancel'|trans }}"
                tabindex="-1"
            ></button>
            <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-2 shadow-xl scale-90 translate-y-4 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-entered/modal:scale-100 group-data-entered/modal:translate-y-0 motion-reduce:transition-none">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <div class="p-3">
                        <h2 class="text-lg font-semibold tracking-tight text-gray-900">{{ 'admin.contacts.recapEmail.modalTitle'|trans }}</h2>
                        <p class="mt-0.5 text-sm text-pretty text-gray-500">
                            {{ 'admin.contacts.recapEmail.modalSubtitle'|trans({'%email%': contact.email|e})|raw }}
                        </p>
                    </div>

                    <div class="rounded-xl bg-white px-5 py-4">
                        {% if this.paymentAvailable %}
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="togglePayment"
                                role="switch"
                                aria-checked="{{ this.includePayment ? 'true' : 'false' }}"
                                class="flex w-full cursor-pointer items-start gap-3 text-left"
                                data-testid="contact-recap-payment-toggle"
                            >
                                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-md border transition-colors duration-100 ease-out {{ this.includePayment ? 'border-primary bg-primary text-white' : 'border-neutral-300 bg-white text-transparent' }}">
                                    {{ ux_icon('lucide:check', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                                </span>
                                <span class="min-w-0">
                                    <span class="block text-sm font-medium text-gray-900">{{ 'admin.contacts.recapEmail.paymentToggle'|trans }}</span>
                                    <span class="mt-0.5 block text-xs text-gray-500">
                                        {{ 'admin.contacts.recapEmail.paymentHint'|trans({
                                            '%offer%': ('contact.contactForm.offer.' ~ contact.offer ~ '.title')|trans,
                                            '%price%': ('contact.contactForm.offer.' ~ contact.offer ~ '.price')|trans,
                                        }) }}
                                    </span>
                                </span>
                            </button>
                            {% if this.includePayment and this.depositAvailable %}
                                <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-action-param="toggleDeposit"
                                    role="switch"
                                    aria-checked="{{ this.includeDeposit ? 'true' : 'false' }}"
                                    class="mt-3 ml-8 flex w-full cursor-pointer items-start gap-3 text-left"
                                    data-testid="contact-recap-deposit-toggle"
                                >
                                    <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-md border transition-colors duration-100 ease-out {{ this.includeDeposit ? 'border-primary bg-primary text-white' : 'border-neutral-300 bg-white text-transparent' }}">
                                        {{ ux_icon('lucide:check', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                                    </span>
                                    <span class="min-w-0">
                                        <span class="block text-sm font-medium text-gray-900">{{ 'admin.contacts.recapEmail.depositToggle'|trans }}</span>
                                        <span class="mt-0.5 block text-xs text-gray-500">{{ 'admin.contacts.recapEmail.depositHint'|trans }}</span>
                                    </span>
                                </button>
                            {% endif %}
                        {% else %}
                            <p class="flex items-start gap-2 text-xs text-gray-500">
                                {{ ux_icon('lucide:info', {class: 'mt-0.5 size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.contacts.recapEmail.paymentUnavailable'|trans }}
                            </p>
                        {% endif %}
                    </div>

                    <div class="flex items-center justify-end gap-3 p-3">
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="closeModal"
                            class="cursor-pointer text-xs font-medium text-gray-500 transition-colors duration-100 hover:text-gray-900"
                            data-testid="contact-recap-cancel"
                        >
                            {{ 'admin.contacts.notes.cancel'|trans }}
                        </button>
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="send"
                            data-loading="action(send)|addAttribute(disabled)"
                            class="flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 disabled:cursor-default disabled:opacity-60"
                            data-testid="contact-recap-confirm"
                        >
                            {{ ux_icon('lucide:send', {class: 'size-4 shrink-0', 'aria-hidden': 'true', 'data-loading': 'action(send)|addClass(hidden)'}) }}
                            {{ ux_icon('lucide:loader-circle', {class: 'hidden size-4 shrink-0 animate-spin', 'aria-hidden': 'true', 'data-loading': 'action(send)|removeClass(hidden)'}) }}
                            {{ 'admin.contacts.recapEmail.send'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
