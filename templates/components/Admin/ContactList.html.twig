{% macro statusDropdown(contact, statuses) %}
    <details
        class="relative shrink-0"
        data-controller="details-dropdown"
        data-action="click@window->details-dropdown#closeOnOutside keydown.esc@window->details-dropdown#close"
    >
        <summary class="flex w-44 cursor-pointer list-none items-center gap-2 rounded-xl border border-neutral-200 bg-white px-4 py-2.5 transition-colors duration-100 ease-out hover:bg-gray-50 [&::-webkit-details-marker]:hidden">
            <span class="min-w-0 flex-1 truncate text-sm font-medium text-gray-900">{{ contact.status.labelKey|trans }}</span>
            {{ ux_icon('lucide:chevron-down', {class: 'size-4 shrink-0 text-gray-900', 'aria-hidden': 'true'}) }}
        </summary>
        <div class="absolute right-0 z-10 mt-2 w-44 rounded-xl border border-neutral-200 bg-white p-1 shadow-lg">
            {% for status in statuses %}
                <button
                    type="button"
                    data-action="live#action details-dropdown#close"
                    data-live-action-param="changeStatus"
                    data-live-id-param="{{ contact.id }}"
                    data-live-status-param="{{ status.value }}"
                    class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm transition-colors duration-100 ease-out {{ status == contact.status ? 'bg-neutral-100 font-medium text-gray-900' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                >
                    <span class="size-1.5 shrink-0 rounded-full {{ status.dotClass }}" aria-hidden="true"></span>
                    {{ status.labelKey|trans }}
                </button>
            {% endfor %}
        </div>
    </details>
{% endmacro %}

{% macro phoneValue(contact) %}
    {% set phoneCountry = contact.phoneNumber|phone_country %}
    <a href="tel:{{ contact.phoneNumber }}" class="flex min-w-0 items-center gap-2 font-medium text-gray-900 transition-colors duration-100 hover:text-primary">
        {% if phoneCountry %}
            {{ ux_icon('circle-flags:' ~ phoneCountry, {class: 'size-4 shrink-0 rounded-full', 'aria-hidden': 'true'}) }}
        {% endif %}
        <span class="truncate">{{ contact.phoneNumber|phone_format }}</span>
    </a>
{% endmacro %}

{% macro contactCard(contact, statuses, leavingContactId, adminPrefix, confirmedContactId = null) %}
    {# data-skip-morph: nos controllers Stimulus (countdown, details-dropdown,
       expandable) mutent le DOM de la carte; idiomorph + le tracker de mutations
       externes peuvent alors réappliquer l'ancien contenu par-dessus le re-rendu.
       On réécrit donc le contenu de la carte à chaque re-rendu au lieu de le morpher. #}
    <article
        id="contact-card-{{ contact.id }}"
        class="rounded-3xl border border-neutral-200 bg-white p-2 {{ contact.id == confirmedContactId ? 'animate-card-glow' }}"
        data-testid="contact-card"
        data-skip-morph
        {% if contact.id == leavingContactId %}data-controller="card-exit"{% endif %}
    >
        <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 p-3">
                <div class="min-w-0">
                    <p class="truncate font-medium text-gray-900">{{ contact.fullName ? contact.fullName|title : contact.email }}</p>
                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                        <p class="flex items-center gap-1.5 text-sm {{ contact.status.textClass }}">
                            <span class="size-1.5 shrink-0 rounded-full {{ contact.status.dotClass }}" aria-hidden="true"></span>
                            {{ contact.status.labelKey|trans }}
                        </p>
                        {% if contact.status.value == 'in_progress' and contact.nextStep %}
                            <span
                                class="flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700"
                                title="{{ 'admin.contacts.nextStep.label'|trans }}"
                            >
                                {{ ux_icon('lucide:corner-down-right', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ contact.nextStep.labelKey|trans }}
                            </span>
                        {% endif %}
                        {% if contact.recallAt %}
                            {% set recallOverdue = contact.recallAt < date() %}
                            <span
                                class="flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium tabular-nums {{ recallOverdue ? 'bg-red-50 text-red-600' : 'bg-purple-50 text-purple-700' }}"
                                title="{{ 'admin.contacts.followUp.recallLabel'|trans }}"
                            >
                                {{ ux_icon('lucide:calendar-clock', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.contacts.card.recallAtText'|trans({
                                    '%date%': contact.recallAt|format_datetime(pattern='dd.MM'),
                                    '%time%': contact.recallAt|format_datetime(pattern="HH'h'mm"),
                                }) }}
                            </span>
                        {% endif %}
                        {% if contact.id == confirmedContactId %}
                            <span class="animate-status-confirm flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700" role="status">
                                {{ ux_icon('lucide:check', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ 'admin.contacts.card.statusUpdated'|trans }}
                            </span>
                        {% endif %}
                        {% if contact.status.value == 'new' %}
                            {% set deadline = contact.createdAt|date_modify('+30 minutes') %}
                            {% set alreadyOverdue = date() > deadline %}
                            <div
                                data-controller="countdown"
                                data-countdown-deadline-value="{{ deadline|date('c') }}"
                                title="{{ 'admin.contacts.card.timer.title'|trans }}"
                            >
                                <span
                                    data-countdown-target="running"
                                    class="flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 tabular-nums"
                                    {% if alreadyOverdue %}hidden{% endif %}
                                >
                                    {{ ux_icon('lucide:timer', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                    <span data-countdown-target="remaining">--:--</span>
                                </span>
                                <span
                                    data-countdown-target="overdue"
                                    class="flex items-center gap-1.5 rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-600"
                                    {% if not alreadyOverdue %}hidden{% endif %}
                                >
                                    {{ ux_icon('lucide:alarm-clock-off', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.contacts.card.timer.overdue'|trans }}
                                </span>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="flex shrink-0 items-center gap-3">
                    {# La personne de suivi assignée prime sur le dernier intervenant. #}
                    {% if contact.assigneeName %}
                        <div class="flex items-center gap-2">
                            <div class="min-w-0 text-right">
                                <p class="text-xs text-gray-500">{{ 'admin.contacts.followUp.assignee'|trans }}</p>
                                <p class="truncate text-xs font-medium text-gray-900">{{ contact.assigneeName|title }}</p>
                            </div>
                            <twig:Avatar filename="{{ contact.assigneeAvatar }}" name="{{ contact.assigneeName }}" size="7" />
                        </div>
                    {% elseif contact.statusChangedBy %}
                        {% set isUpdate = contact.firstTreatedAt and contact.statusChangedAt and contact.statusChangedAt > contact.firstTreatedAt %}
                        <div class="flex items-center gap-2">
                            <div class="min-w-0 text-right">
                                <p class="text-xs text-gray-500">{{ (isUpdate ? 'admin.contacts.card.updatedBy' : 'admin.contacts.card.treatedBy')|trans }}</p>
                                <p class="truncate text-xs font-medium text-gray-900">{{ contact.statusChangedBy|title }}</p>
                            </div>
                            <twig:Avatar filename="{{ contact.statusChangedByAvatar }}" name="{{ contact.statusChangedBy }}" size="7" />
                        </div>
                    {% endif %}
                    {{ _self.statusDropdown(contact, statuses) }}
                </div>
            </div>

            <div class="flex flex-col gap-y-4 rounded-t-xl bg-white px-5 py-4 sm:flex-row sm:items-stretch sm:gap-x-6">
                <div class="min-w-0 space-y-2 text-sm sm:flex-1">
                    <p class="text-gray-600">{{ 'admin.contacts.card.field.email'|trans }}</p>
                    <a href="mailto:{{ contact.email }}" class="block truncate font-medium text-gray-900 transition-colors duration-100 hover:text-primary">
                        {{ contact.email }}
                    </a>
                </div>
                <div class="hidden w-px self-stretch bg-linear-to-b from-transparent via-gray-950/10 to-transparent sm:block" aria-hidden="true"></div>
                <div class="min-w-0 space-y-2 text-sm sm:flex-1">
                    <p class="text-gray-600">{{ 'admin.contacts.card.field.phone'|trans }}</p>
                    {% if contact.phoneNumber %}
                        {{ _self.phoneValue(contact) }}
                    {% else %}
                        <p class="font-medium text-gray-400">-</p>
                    {% endif %}
                </div>
                <div class="hidden w-px self-stretch bg-linear-to-b from-transparent via-gray-950/10 to-transparent sm:block" aria-hidden="true"></div>
                <div class="min-w-0 space-y-2 text-sm sm:flex-1">
                    <p class="text-gray-600">{{ 'admin.contacts.card.field.language'|trans }}</p>
                    <p class="flex min-w-0 items-center gap-2 font-medium text-gray-900">
                        {{ ux_icon('circle-flags:' ~ contact.lang, {class: 'size-4 shrink-0 rounded-full', 'aria-hidden': 'true'}) }}
                        <span class="truncate">{{ ('admin.contacts.card.lang.' ~ contact.lang)|trans }}</span>
                    </p>
                </div>
            </div>

            <div class="flex flex-col gap-4 rounded-b-xl bg-white px-5 pt-5 pb-6">
                <p class="flex flex-wrap gap-2 text-sm font-medium">
                    <span class="text-gray-600">{{ 'admin.contacts.card.help'|trans }}</span>
                    <span class="min-w-0 flex-1 text-gray-900">{{ contact.helpType|trans }}</span>
                </p>
                {% if contact.message %}
                    <div data-controller="expandable">
                        <p data-expandable-target="content" class="line-clamp-3 text-sm leading-relaxed text-pretty text-gray-900">{{ contact.message }}</p>
                        <button
                            type="button"
                            data-action="expandable#expand"
                            data-expandable-target="trigger"
                            class="mt-1 cursor-pointer text-xs font-medium text-gray-600 underline-offset-4 transition-colors duration-100 hover:text-gray-900 hover:underline"
                        >
                            ... {{ 'admin.contacts.card.message.showMore'|trans }}
                        </button>
                    </div>
                {% endif %}
            </div>

            <div class="mt-2 mb-1 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-1">
                <p class="flex items-center gap-1 pl-1 text-xs text-gray-900" title="{{ contact.createdAt|format_datetime('medium', 'short') }}">
                    <span class="opacity-50">{{ 'admin.contacts.card.created'|trans }}</span>
                    <span class="tabular-nums">{{ contact.createdAt|human_date }}</span>
                </p>
                <div class="flex items-center gap-3">
                    {% if contact.leadRating %}
                        <twig:Admin:LeadRatingBadge :rating="contact.leadRating" />
                    {% endif %}
                    <twig:Button
                        as="a"
                        size="sm"
                        href="{{ path('admin_contact_show', {adminPrefix: adminPrefix, reference: contact.reference}) }}"
                        class="px-10"
                        data-testid="contact-card-details"
                    >
                        {{ 'admin.contacts.card.viewMore'|trans }}
                    </twig:Button>
                </div>
            </div>
        </div>
    </article>
{% endmacro %}

{% macro cardsBlock(contacts, statuses, leavingContactId, statusFilter, hasMore, adminPrefix, confirmedContactId = null) %}
    {% if contacts is empty %}
        <div class="mt-6">
            <twig:Admin:EmptyCard message="{{ (statusFilter == 'new' ? 'admin.contacts.emptyNew' : 'admin.contacts.empty')|trans }}" />
        </div>
    {% else %}
        <div class="mt-6 space-y-4">
            {% for contact in contacts %}
                {{ _self.contactCard(contact, statuses, leavingContactId, adminPrefix, confirmedContactId) }}
            {% endfor %}
        </div>

        {% if hasMore %}
            <div class="mt-6 flex justify-center">
                <twig:Button
                    variant="outline"
                    data-action="live#action"
                    data-live-action-param="more"
                    data-testid="contacts-load-more"
                >
                    <span data-loading="action(more)|hide">{{ 'admin.contacts.button.loadMore'|trans }}</span>
                    <span data-loading="action(more)|show" class="hidden items-center gap-x-2">
                        <twig:Spinner class="inline" />
                        {{ 'admin.contacts.button.loading'|trans }}
                    </span>
                </twig:Button>
            </div>
        {% endif %}
    {% endif %}
{% endmacro %}

<div {{ attributes }} data-testid="contacts-list">
    {% set contacts = this.items %}
    {% set statuses = this.statuses %}
    {% set counts = this.statusCounts %}
    {% set statCards = statuses|filter(s => s.value in ['new', 'in_progress', 'to_recall']) %}

    <div class="lg:grid lg:grid-cols-[15rem_1fr] lg:items-start lg:gap-6">
        <aside class="lg:sticky lg:top-6">
            <div class="rounded-2xl border border-neutral-200 bg-white p-2">
                <div class="divide-y divide-gray-950/5 rounded-xl bg-linear-to-b from-neutral-100/50 to-neutral-100/0 px-4">
                    {% for status in statCards %}
                        <div class="flex items-center justify-between py-3">
                            <p class="flex items-center gap-1.5 text-xs font-medium tracking-wide text-gray-500 uppercase">
                                <span class="size-1.5 shrink-0 rounded-full {{ status.dotClass }}" aria-hidden="true"></span>
                                {{ status.labelKey|trans }}
                            </p>
                            <p class="text-lg font-medium text-gray-900 tabular-nums">{{ counts[status.value] }}</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="relative mt-4">
                {{ ux_icon('lucide:search', {class: 'pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-gray-400', 'aria-hidden': 'true'}) }}
                <input
                    type="search"
                    data-model="debounce(300)|search"
                    value="{{ this.search }}"
                    placeholder="{{ 'admin.contacts.searchPlaceholder'|trans }}"
                    aria-label="{{ 'admin.contacts.searchPlaceholder'|trans }}"
                    class="w-full rounded-xl border border-neutral-200 bg-white py-2 pr-3.5 pl-9 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                    data-testid="contacts-search"
                >
            </div>

            <div class="mt-4 flex flex-col gap-1.5" data-testid="contacts-filters">
                {% for status in statuses %}
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="filter"
                        data-live-status-param="{{ status.value }}"
                        class="flex cursor-pointer items-center gap-2 rounded-xl border px-3.5 py-2 text-left text-sm font-medium transition-colors duration-100 ease-out {{ this.statusFilter == status.value ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                    >
                        <span class="size-1.5 shrink-0 rounded-full {{ status.dotClass }}" aria-hidden="true"></span>
                        {{ status.labelKey|trans }}
                        <span class="ml-auto text-xs {{ this.statusFilter == status.value ? 'text-primary/60' : 'text-gray-400' }} tabular-nums">{{ counts[status.value] }}</span>
                    </button>
                {% endfor %}
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="filter"
                    data-live-status-param="all"
                    class="flex cursor-pointer items-center rounded-xl border px-3.5 py-2 text-left text-sm font-medium transition-colors duration-100 ease-out {{ this.statusFilter == 'all' ? 'border-primary/40 bg-primary/5 text-primary' : 'border-neutral-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
                >
                    {{ 'admin.contacts.filter.all'|trans }}
                    <span class="ml-auto text-xs {{ this.statusFilter == 'all' ? 'text-primary/60' : 'text-gray-400' }} tabular-nums">{{ counts|reduce((sum, c) => sum + c, 0) }}</span>
                </button>
            </div>
        </aside>
        {% if this.recallContactId %}
            <div
                class="fixed inset-0 z-50 flex items-center justify-center p-4"
                role="dialog"
                aria-modal="true"
                aria-label="{{ 'admin.contacts.recallModal.title'|trans }}"
                data-action="keydown.esc@window->live#action"
                data-live-action-param="closeRecall"
                data-testid="recall-modal"
            >
                <button
                    type="button"
                    class="absolute inset-0 cursor-default bg-gray-950/30"
                    data-action="live#action"
                    data-live-action-param="closeRecall"
                    aria-label="{{ 'admin.contacts.recallModal.skip'|trans }}"
                    tabindex="-1"
                ></button>
                <div class="relative w-full max-w-md rounded-3xl border border-neutral-200 bg-white p-6 shadow-xl">
                    <h2 class="text-lg font-semibold tracking-tight text-gray-900">{{ 'admin.contacts.recallModal.title'|trans }}</h2>
                    <p class="mt-0.5 text-sm text-pretty text-gray-500">{{ 'admin.contacts.recallModal.subtitle'|trans }}</p>
                    <input
                        type="datetime-local"
                        min="{{ 'now'|date('Y-m-d\\TH:i') }}"
                        data-model="norender|recallAt"
                        data-action="keydown.enter->live#action:prevent"
                        data-live-action-param="saveRecall"
                        value="{{ this.recallAt }}"
                        aria-label="{{ 'admin.contacts.followUp.recallLabel'|trans }}"
                        title="{{ 'admin.contacts.notes.enterHint'|trans }}"
                        class="mt-4 w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 focus:border-gray-400 focus:outline-none"
                        data-testid="recall-modal-input"
                        autofocus
                    >
                    <div class="mt-5 flex items-center justify-end gap-3">
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="closeRecall"
                            class="cursor-pointer text-sm text-gray-500 transition-colors duration-100 hover:text-gray-900"
                        >
                            {{ 'admin.contacts.recallModal.skip'|trans }}
                        </button>
                        <twig:Button
                            size="sm"
                            data-action="live#action"
                            data-live-action-param="saveRecall"
                            data-testid="recall-modal-save"
                        >
                            {{ 'admin.contacts.notes.save'|trans }}
                        </twig:Button>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if this.qualifyContactId %}
            <div
                class="fixed inset-0 z-50 flex items-center justify-center p-4"
                role="dialog"
                aria-modal="true"
                aria-label="{{ 'admin.contacts.qualify.title'|trans }}"
                data-action="keydown.esc@window->live#action"
                data-live-action-param="closeQualify"
                data-testid="qualify-modal"
            >
                <button
                    type="button"
                    class="absolute inset-0 cursor-default bg-gray-950/30"
                    data-action="live#action"
                    data-live-action-param="closeQualify"
                    aria-label="{{ 'admin.contacts.qualify.done'|trans }}"
                    tabindex="-1"
                ></button>
                <div class="relative w-full max-w-xl">
                    <div class="mb-3 px-1">
                        <h2 class="text-lg font-semibold tracking-tight text-white">{{ 'admin.contacts.qualify.title'|trans }}</h2>
                        <p class="mt-0.5 text-sm text-white/80">{{ 'admin.contacts.qualify.subtitle'|trans }}</p>
                    </div>
                    <twig:Admin:LeadQuality :contactId="this.qualifyContactId" />
                </div>
            </div>
        {% endif %}

        <div class="relative max-lg:mt-6 lg:-mt-6">
            {# Overlay visible pendant les requêtes live (filtre, statut, pagination). #}
            {# Le spinner reste au centre de la zone VISIBLE même quand la
               liste est très haute : sticky à mi-viewport dans l'overlay. #}
            <div
                data-loading="delay(150)|show"
                class="absolute inset-0 z-20 mt-6 flex items-start justify-center rounded-3xl bg-neutral-50/90 backdrop-blur-sm"
                data-testid="contacts-loading-overlay"
            >
                <span class="sticky top-[45vh]">
                    <twig:Spinner class="size-7 text-gray-500" label="{{ 'admin.contacts.loading'|trans }}" />
                </span>
            </div>
            {{ _self.cardsBlock(contacts, statuses, this.leavingContactId, this.statusFilter, this.hasMore, this.adminPrefix, this.confirmedContactId) }}
        </div>
    </div>
</div>
