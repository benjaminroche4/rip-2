<div {{ attributes }} data-testid="contacts-list">
    {% set contacts = this.items %}

    {% if contacts is empty %}
        <twig:Admin:EmptyCard message="{{ 'admin.contacts.empty'|trans }}" />
    {% else %}
        <div class="space-y-4">
            {% for contact in contacts %}
                <article class="rounded-2xl border border-gray-950/5 bg-white p-5" data-testid="contact-card">
                    <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
                        <div class="flex min-w-0 items-center gap-3">
                            <twig:Avatar name="{{ contact.fullName }}" email="{{ contact.email }}" size="10" />
                            <div class="min-w-0">
                                <p class="truncate font-medium text-gray-900">{{ contact.fullName ?: contact.email }}</p>
                                <p class="truncate text-sm text-gray-500">
                                    {{ contact.company ?: contact.email }}
                                </p>
                            </div>
                        </div>
                        <div class="flex shrink-0 flex-wrap items-center gap-2">
                            <twig:Badge variant="primary" class="rounded-full">
                                {{ contact.helpType|trans }}
                            </twig:Badge>
                            <twig:Badge variant="secondary" class="rounded-full uppercase">
                                {{ contact.lang }}
                            </twig:Badge>
                            <span class="text-xs text-gray-500 tabular-nums" title="{{ contact.createdAt|format_datetime('medium', 'short') }}">
                                {{ contact.createdAt|ago|capitalize }}
                            </span>
                        </div>
                    </div>

                    {% if contact.message %}
                        <p class="mt-4 rounded-xl bg-neutral-50 p-4 text-sm leading-relaxed text-pretty text-gray-700">
                            {{ contact.message }}
                        </p>
                    {% endif %}

                    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                        <a href="mailto:{{ contact.email }}" class="flex items-center gap-1.5 text-gray-600 transition-colors duration-100 hover:text-primary">
                            {{ ux_icon('lucide:mail', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                            {{ contact.email }}
                        </a>
                        {% if contact.phoneNumber %}
                            <a href="tel:{{ contact.phoneNumber }}" class="flex items-center gap-1.5 text-gray-600 transition-colors duration-100 hover:text-primary">
                                {{ ux_icon('lucide:phone', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                                {{ contact.phoneNumber }}
                            </a>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>

        {% if this.hasMore %}
            <div class="mt-6 flex justify-center">
                <twig:Button
                    variant="secondary"
                    data-action="live#action"
                    data-live-action-param="more"
                    data-testid="contacts-load-more"
                >
                    <span data-loading="action(more)|hide">{{ 'admin.contacts.button.loadMore'|trans }}</span>
                    <span data-loading="action(more)|show" class="hidden items-center gap-x-2">
                        <twig:Spinner class="inline" />
                        {{ 'admin.contacts.button.loading'|trans }}
                    </span>
                </twig:Button>
            </div>
        {% endif %}
    {% endif %}
</div>
