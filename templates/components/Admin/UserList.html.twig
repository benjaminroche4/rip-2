{% macro roleBadge(user) %}
    {# Badge contour : primary pour l'admin, rempli neutre pour le staff,
       contour pâle pour l'utilisateur classique. #}
    {% set badgeStyles = {
        admin: 'border-primary/30 bg-white text-primary',
        staff: 'border-gray-950/10 bg-neutral-100 text-gray-800',
        user: 'border-neutral-200 bg-white text-gray-500',
    } %}
    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium {{ badgeStyles[user.primaryRole] }}">
        {{ ('admin.users.role.' ~ user.primaryRole)|trans }}
    </span>
{% endmacro %}

{% macro userRows(users, adminPrefix, trClass, tdPad) %}
    {% for user in users %}
        {% set profileUrl = path('admin_user_show', {
            adminPrefix: adminPrefix,
            uniqueId: user.uniqueId,
            slug: user.slug,
        }) %}
        {# Rangée estompée quand le compte est suspendu. #}
        <tr class="{{ trClass }}{{ user.isSuspended ? ' opacity-60' : '' }}">
            <td class="relative {{ tdPad }}">
                <div class="flex items-center gap-3">
                    <twig:Avatar
                        filename="{{ user.avatarFilename }}"
                        name="{{ user.fullName }}"
                        email="{{ user.email }}"
                        size="8"
                    />
                    <a
                        href="{{ profileUrl }}"
                        class="font-medium text-gray-900 after:absolute after:inset-0 after:content-['']"
                        data-testid="user-row-link"
                    >
                        {{ user.fullName ? user.fullName|title : user.email }}
                    </a>
                </div>
            </td>
            <td class="{{ tdPad }}">
                <span class="flex items-center gap-1.5">
                    {{ _self.roleBadge(user) }}
                    {% if user.isSuspended %}
                        <span class="inline-flex items-center rounded-full border border-red-200 bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-700" data-testid="user-suspended-badge">
                            {{ 'admin.users.suspended'|trans }}
                        </span>
                    {% endif %}
                </span>
            </td>
            <td class="{{ tdPad }} text-gray-600">
                <span class="flex items-center gap-1.5">
                    {% if user.hasGoogleAuth %}
                        {{ ux_icon('material-icon-theme:google', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                        {{ 'admin.users.connection.google'|trans }}
                    {% else %}
                        {{ ux_icon('lucide:globe', {class: 'size-3.5 shrink-0 text-gray-400', 'aria-hidden': 'true'}) }}
                        {{ 'admin.users.connection.website'|trans }}
                    {% endif %}
                </span>
            </td>
            <td class="{{ tdPad }} text-right text-gray-500">
                {% if user.lastLoginAt %}
                    <span title="{{ user.lastLoginAt|format_datetime('medium', 'short') }}">
                        {{ user.lastLoginAt|ago|capitalize }}
                    </span>
                {% else %}
                    <span class="text-gray-500">{{ 'admin.users.lastLoginNever'|trans }}</span>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
{% endmacro %}

{% macro headRow(thClass) %}
    <tr class="{{ thClass }}">
        <th scope="col" class="px-4 py-3 font-semibold">{{ 'admin.users.column.name'|trans }}</th>
        <th scope="col" class="px-4 py-3 font-semibold">{{ 'admin.users.column.role'|trans }}</th>
        <th scope="col" class="px-4 py-3 font-semibold">{{ 'admin.users.column.connection'|trans }}</th>
        <th scope="col" class="px-4 py-3 text-right font-semibold">{{ 'admin.users.column.lastLogin'|trans }}</th>
    </tr>
{% endmacro %}

<div {{ attributes }} data-testid="users-list">
    {% set users = this.items %}

    {% if users is empty %}
        <twig:Admin:EmptyCard message="{{ 'admin.users.empty'|trans }}" />
    {% else %}
        {# Rangées blanches détachées sur bande grise (langage cards). #}
        <div class="rounded-2xl border border-neutral-200 bg-white p-2">
            <div class="rounded-xl bg-neutral-50 p-2">
                <table class="w-full border-separate border-spacing-y-1 text-left text-sm" data-testid="users-table" aria-label="{{ 'admin.users.title'|trans }}">
                    <thead>
                        {{ _self.headRow('text-xs font-medium text-gray-400') }}
                    </thead>
                    {# Un tbody par grade (admin > staff > user), séparés par un
                       en-tête de groupe discret. #}
                    {% for roleKey, groupUsers in this.groups %}
                        <tbody data-testid="users-group-{{ roleKey }}">
                            <tr>
                                <th
                                    colspan="4"
                                    scope="colgroup"
                                    class="px-4 pb-1.5 text-left text-xs font-medium tracking-wide text-gray-400 uppercase {{ loop.first ? 'pt-1' : 'pt-5' }}"
                                >
                                    {{ ('admin.users.group.' ~ roleKey)|trans }}
                                    <span class="ml-1.5 inline-flex items-center rounded-full bg-neutral-200/70 px-1.5 py-0.5 text-[10px] font-medium text-gray-600 tabular-nums">{{ groupUsers|length }}</span>
                                </th>
                            </tr>
                            {{ _self.userRows(groupUsers, this.adminPrefix, 'group cursor-pointer [&>td]:bg-white [&>td]:transition-colors [&>td]:duration-100 [&>td:first-child]:rounded-l-xl [&>td:last-child]:rounded-r-xl hover:[&>td]:bg-neutral-100', 'px-4 py-3') }}
                        </tbody>
                    {% endfor %}
                </table>
            </div>
        </div>
    {% endif %}

</div>
