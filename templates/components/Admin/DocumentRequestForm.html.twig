{#
    Admin:DocumentRequestForm — bilingual multi-person document request flow.
    Sidebar master-detail layout: left rail lists every person with their
    summary, right panel shows the form of the active one. Below the grids
    sit the household-wide fields (typology, drive link, language).

    Spacing / surface conventions mirror DocumentList:
      - section heading: text-base font-semibold + text-sm text-gray-500 sub
      - container cards: rounded-2xl border border-neutral-200 bg-white p-2
      - inner surface: rounded-xl bg-neutral-50/50 p-4..p-5
      - vertical rhythm: space-y-6 between sections, gap-* inside flex/grid
#}

{# Macro: form fields for a single person. Reused as the body of the
   right-hand panel — keeps the input markup in a single place. #}
{% macro personFields(personForm, docsById, locale) %}
    {% set hasFirstNameErrors = personForm.firstName.vars.errors|length > 0 %}
    {% set hasLastNameErrors = personForm.lastName.vars.errors|length > 0 %}

    <div class="flex flex-col gap-5">
        <div>
            <p id="{{ personForm.role.vars.id }}-label" class="text-sm text-gray-600">
                {{ 'admin.tools.documents.request.person.role.label'|trans }}
                <span class="text-red-600" aria-hidden="true">*</span>
            </p>
            <div role="radiogroup" aria-labelledby="{{ personForm.role.vars.id }}-label" class="mt-2 flex flex-wrap gap-2">
                {% for choice in personForm.role.children %}
                    {% set roleIcons = {tenant: 'lucide:key-round', guarantor: 'lucide:shield-check'} %}
                    <label for="{{ choice.vars.id }}" class="flex cursor-pointer items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-gray-400 hover:text-gray-900 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5 has-[input:checked]:text-primary">
                        <input
                            type="radio"
                            id="{{ choice.vars.id }}"
                            name="{{ choice.vars.full_name }}"
                            value="{{ choice.vars.value }}"
                            {% if choice.vars.checked %}checked{% endif %}
                            class="sr-only"
                        />
                        {% if roleIcons[choice.vars.value] is defined %}
                            {{ ux_icon(roleIcons[choice.vars.value], {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                        {% endif %}
                        {{ choice.vars.label|trans }}
                    </label>
                {% endfor %}
            </div>
            {% for error in personForm.role.vars.errors %}
                <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
                <twig:Label for="{{ personForm.firstName.vars.id }}" class="text-gray-600">
                    {{ 'admin.tools.documents.request.person.firstName.label'|trans }}
                    <span class="text-red-600" aria-hidden="true">*</span>
                </twig:Label>
                <div class="mt-1.5">
                    <input
                        type="text"
                        id="{{ personForm.firstName.vars.id }}"
                        name="{{ personForm.firstName.vars.full_name }}"
                        value="{{ personForm.firstName.vars.value }}"
                        maxlength="50"
                        required
                        data-name-preview-target="first"
                        data-action="input->name-preview#refresh"
                        aria-invalid="{{ hasFirstNameErrors ? 'true' : 'false' }}"
                        class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                    >
                    {% for error in personForm.firstName.vars.errors %}
                        <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                    {% endfor %}
                </div>
            </div>
            <div>
                <twig:Label for="{{ personForm.lastName.vars.id }}" class="text-gray-600">
                    {{ 'admin.tools.documents.request.person.lastName.label'|trans }}
                    <span class="text-red-600" aria-hidden="true">*</span>
                </twig:Label>
                <div class="mt-1.5">
                    <input
                        type="text"
                        id="{{ personForm.lastName.vars.id }}"
                        name="{{ personForm.lastName.vars.full_name }}"
                        value="{{ personForm.lastName.vars.value }}"
                        maxlength="50"
                        required
                        data-name-preview-target="last"
                        data-action="input->name-preview#refresh"
                        aria-invalid="{{ hasLastNameErrors ? 'true' : 'false' }}"
                        class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                    >
                    {% for error in personForm.lastName.vars.errors %}
                        <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div>
            <p id="{{ personForm.documents.vars.id }}-label" class="text-sm text-gray-600">
                {{ 'admin.tools.documents.request.person.documents.label'|trans }}
                <span class="text-red-600" aria-hidden="true">*</span>
            </p>
            {% if personForm.documents.children is empty %}
                <p class="mt-2 rounded-lg border border-dashed border-gray-950/10 bg-gray-50/50 p-3 text-xs italic text-gray-500">
                    {{ 'admin.tools.documents.request.person.documents.emptyCatalogue'|trans }}
                </p>
            {% else %}
                {# Group choices by category. The form's query_builder already
                   orders by category > pinned > nameFr, so the bucket map below
                   inherits that order via insertion-order preservation. #}
                {% set docsByCategory = {} %}
                {% for docChoice in personForm.documents.children %}
                    {% set doc = docsById[docChoice.vars.value] ?? null %}
                    {% set cat = doc and doc.category ? doc.category.value : 'other' %}
                    {% set bucket = docsByCategory[cat]|default([]) %}
                    {% set bucket = bucket|merge([docChoice]) %}
                    {% set docsByCategory = docsByCategory|merge({(cat): bucket}) %}
                {% endfor %}

                <div role="group" aria-labelledby="{{ personForm.documents.vars.id }}-label" class="mt-3 space-y-4">
                    {% for category, choices in docsByCategory %}
                        <div data-controller="check-all" data-testid="document-category-group-{{ category }}">
                            <p class="flex items-baseline gap-2.5 text-xs font-semibold tracking-wide text-gray-500 uppercase">
                                {{ ('admin.tools.documents.category.' ~ category)|trans }}
                                <button
                                    type="button"
                                    data-action="check-all#toggle"
                                    class="cursor-pointer text-[10px] font-medium tracking-normal normal-case text-gray-400 underline-offset-2 transition-colors duration-100 hover:text-primary hover:underline"
                                    data-testid="document-category-check-all"
                                >
                                    {{ 'admin.tools.documents.request.person.documents.checkAll'|trans }}
                                </button>
                            </p>
                            <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
                                {% for docChoice in choices %}
                                    {% set doc = docsById[docChoice.vars.value] ?? null %}
                                    <label for="{{ docChoice.vars.id }}" class="group flex h-full cursor-pointer items-start gap-3 rounded-xl border border-neutral-200 bg-white p-3 transition-colors duration-100 ease-out has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5 hover:border-gray-400">
                                        <span class="group inline-grid size-4 shrink-0 grid-cols-1 self-start pt-0.5">
                                            <input
                                                type="checkbox"
                                                id="{{ docChoice.vars.id }}"
                                                name="{{ docChoice.vars.full_name }}"
                                                value="{{ docChoice.vars.value }}"
                                                {% if docChoice.vars.checked %}checked{% endif %}
                                                class="col-start-1 row-start-1 appearance-none rounded-sm border border-gray-300 bg-white checked:border-primary checked:bg-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:border-gray-300 disabled:bg-gray-100 forced-colors:appearance-auto"
                                            />
                                            <svg viewBox="0 0 14 14" fill="none" class="pointer-events-none col-start-1 row-start-1 size-7/8 self-center justify-self-center stroke-white">
                                                <path d="M3 8L6 11L11 3.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-not-has-checked:opacity-0" />
                                            </svg>
                                        </span>
                                        <span class="min-w-0 flex-1">
                                            <span class="flex items-center gap-1.5">
                                                <span class="block text-sm font-medium text-gray-900">{{ doc ? doc.getName(locale) : docChoice.vars.label|trans }}</span>
                                                {% if doc and doc.pinned %}
                                                    <twig:ux:icon
                                                        name="lucide:pin"
                                                        class="size-3 shrink-0 text-gray-400"
                                                        title="{{ 'admin.tools.documents.list.pinnedBadge'|trans }}"
                                                        role="img"
                                                        aria-label="{{ 'admin.tools.documents.list.pinnedBadge'|trans }}"
                                                        data-testid="document-pinned-badge"
                                                    />
                                                {% endif %}
                                            </span>
                                            {% if doc %}
                                                {% set desc = doc.getDescription(locale) %}
                                                {% if desc %}
                                                    <span class="mt-0.5 block text-xs text-gray-500">{{ desc }}</span>
                                                {% endif %}
                                            {% endif %}
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
            {% for error in personForm.documents.vars.errors %}
                <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% macro removeButton(idx, label) %}
    <button
        type="button"
        class="inline-flex items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-gray-500 transition-colors hover:bg-red-50 hover:text-red-600 focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-gray-300"
        data-action="live#action"
        data-live-action-param="removePerson"
        data-live-index-param="{{ idx }}"
    >
        <twig:ux:icon name="lucide:x" class="size-3.5 shrink-0" aria-hidden="true" />
        {{ label }}
    </button>
{% endmacro %}

{% import _self as ui %}

{% set persons = form.persons %}
{% set personCount = persons.children|length %}
{% set maxPersons = constant('App\\Admin\\Entity\\DocumentRequest::MAX_PERSONS') %}
{% set canAdd = personCount < maxPersons %}
{% set docsById = this.documentsById %}
{% set activeIndex = this.activePersonIndex %}

{# Autosave : chaque change déclenche l'action `autosave` (les modèles en
   attente partent avec la requête). Un brouillon invalide n'est simplement
   pas persisté, sans afficher d'erreurs. #}
<form
    {{ attributes.defaults({
        'data-action': 'change->live#action live#action:prevent document-request:download@window->download-trigger#download',
        'data-live-action-param': 'autosave',
        'data-model': 'on(change)|*',
        'data-controller': 'download-trigger',
        novalidate: true,
        autocomplete: 'off',
    }) }}
    class="space-y-6"
    data-testid="document-request-form"
>
    {# ───── Persons (sidebar master-detail) ─────────────────────────── #}
    <section class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="document-request-persons">
        <div class="rounded-2xl bg-neutral-50 p-2">
        <div class="flex items-baseline justify-between gap-4 p-3">
            <h2 class="font-medium text-gray-900">
                {{ 'admin.tools.documents.request.persons.title'|trans }}
            </h2>
            <span class="flex shrink-0 items-center gap-3">
                {% if this.editId %}
                    {# data-loading restaure un display inline sur l'élément
                       togglé : le flex vit donc sur un span interne intouché. #}
                    <span data-loading="action(autosave)|addClass(hidden)" data-testid="document-request-autosaved">
                        <span class="flex items-center gap-1 text-xs whitespace-nowrap text-gray-400">
                            {{ ux_icon('lucide:check', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                            <span>{{ 'admin.tools.documents.request.autosaved'|trans }}</span>
                        </span>
                    </span>
                {% endif %}
                <span class="hidden" data-loading="action(autosave)|removeClass(hidden)">
                    <span class="flex items-center gap-1 text-xs whitespace-nowrap text-gray-400">
                        <twig:Spinner class="inline size-3" />
                        <span>{{ 'admin.tools.documents.request.autosaving'|trans }}</span>
                    </span>
                </span>
                {% if this.editId %}
                    <span class="text-xs text-gray-300" aria-hidden="true">·</span>
                {% endif %}
                <p class="text-xs text-gray-500 tabular-nums">
                    {{ 'admin.tools.documents.request.persons.count'|trans({'%count%': personCount, '%max%': maxPersons}) }}
                </p>
            </span>
        </div>

        <div
            class="grid grid-cols-1 gap-1 lg:grid-cols-[220px_1fr]"
            data-controller="person-picker"
            data-person-picker-active-value="{{ activeIndex }}"
        >
            <aside class="self-start rounded-xl bg-white p-2 lg:sticky lg:top-6">
                <nav class="flex flex-col gap-1" aria-label="{{ 'admin.tools.documents.request.persons.title'|trans }}">
                    {% for personForm in persons %}
                        {% set fn = personForm.firstName.vars.value %}
                        {% set ln = personForm.lastName.vars.value %}
                        {% set role = personForm.role.vars.value %}
                        <button
                            type="button"
                            data-action="click->person-picker#select"
                            data-person-picker-target="tab"
                            data-person-picker-index-param="{{ loop.index0 }}"
                            data-active="{{ loop.index0 == activeIndex ? 'true' : 'false' }}"
                            class="group flex w-full cursor-pointer items-start justify-between gap-2 rounded-lg px-3 py-2 text-left text-sm transition-colors duration-100 ease-out hover:bg-neutral-50 data-[active=true]:bg-primary/5 data-[active=true]:ring-1 data-[active=true]:ring-primary/30"
                            data-testid="document-request-person-tab"
                        >
                            <span class="min-w-0">
                                <span class="block truncate font-medium text-gray-900">
                                    {{ fn or ln ? ((fn ~ ' ' ~ ln)|title) : 'admin.tools.documents.request.person.heading'|trans({'%number%': loop.index}) }}
                                </span>
                                {# Rôle sous le nom, en clair. #}
                                {% if role %}
                                    <span class="block text-xs text-gray-500">{{ ('admin.tools.documents.request.person.role.' ~ role)|trans }}</span>
                                {% endif %}
                                {% if not (fn or ln) %}
                                    <span class="block text-xs italic text-gray-400">{{ 'admin.tools.documents.request.person.toComplete'|trans }}</span>
                                {% endif %}
                                {# Compteur de pièces : repérer les personnes incomplètes
                                   sans ouvrir leur panneau. #}
                                {% set docCount = personForm.documents.children|filter(c => c.vars.checked)|length %}
                                <span
                                    class="mt-1 inline-flex items-center gap-1 rounded-full px-1.5 py-0.5 text-[10px] font-medium tabular-nums {{ docCount > 0 ? 'bg-neutral-100 text-gray-600 group-data-[active=true]:bg-white' : 'bg-amber-50 text-amber-700' }}"
                                    data-testid="document-request-person-doc-count"
                                >
                                    {{ ux_icon(docCount > 0 ? 'lucide:file-check' : 'lucide:file-warning', {class: 'size-3 shrink-0', 'aria-hidden': 'true'}) }}
                                    {{ 'admin.tools.documents.request.person.docCount'|trans({'%count%': docCount}) }}
                                </span>
                            </span>
                        </button>
                    {% endfor %}
                    {% if canAdd %}
                        <button
                            type="button"
                            class="flex w-full items-center justify-center gap-1.5 rounded-lg border border-dashed border-gray-950/10 px-2 py-2 text-xs font-medium whitespace-nowrap text-gray-600 transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-gray-300"
                            data-action="live#action"
                            data-live-action-param="addPerson"
                            data-testid="document-request-add-person"
                        >
                            <twig:ux:icon name="lucide:user-plus" class="size-3.5 shrink-0" aria-hidden="true" />
                            {{ 'admin.tools.documents.request.actions.addPerson'|trans }}
                        </button>
                    {% endif %}
                </nav>
            </aside>

            <div class="rounded-xl bg-white px-5 py-4">
                {% for personForm in persons %}
                    <div data-person-picker-target="form" data-controller="name-preview" {% if not loop.first %}hidden{% endif %} data-testid="document-request-person">
                        {% set panelFn = personForm.firstName.vars.value %}
                        {% set panelLn = personForm.lastName.vars.value %}
                        <header class="mb-4 flex items-center justify-between gap-3">
                            {# Suit chaque frappe via name-preview, sans aller-retour serveur. #}
                            <p
                                class="text-sm font-medium text-gray-900"
                                data-name-preview-target="output"
                                data-default="{{ 'admin.tools.documents.request.person.heading'|trans({'%number%': loop.index}) }}"
                            >
                                {{ panelFn or panelLn ? ((panelFn ~ ' ' ~ panelLn)|title) : 'admin.tools.documents.request.person.heading'|trans({'%number%': loop.index}) }}
                            </p>
                            <span class="flex items-center gap-1">
                                {% if loop.index0 > 0 %}
                                    <button
                                        type="button"
                                        class="inline-flex cursor-pointer items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-gray-500 transition-colors duration-100 ease-out hover:bg-neutral-100 hover:text-gray-900"
                                        data-action="live#action"
                                        data-live-action-param="copyDocumentsFromFirst"
                                        data-live-index-param="{{ loop.index0 }}"
                                        title="{{ 'admin.tools.documents.request.actions.copyFromFirst'|trans }}"
                                        data-testid="document-request-copy-docs"
                                    >
                                        {{ ux_icon('lucide:copy', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                                        {{ 'admin.tools.documents.request.actions.copyFromFirst'|trans }}
                                    </button>
                                {% endif %}
                                {% if personCount > 1 %}
                                    {{ ui.removeButton(loop.index0, 'admin.tools.documents.request.actions.removePerson'|trans) }}
                                {% endif %}
                            </span>
                        </header>
                        {{ ui.personFields(personForm, docsById, app.locale) }}
                    </div>
                {% endfor %}
            </div>
        </div>

        {% for error in persons.vars.errors %}
            <p class="mt-3 px-3 pb-2 text-sm text-red-600" role="alert">{{ error.message }}</p>
        {% endfor %}
        </div>
    </section>

    {# ───── Message, lien Drive (optionnel) et langue : une card, trois
           rangées blanches sur la bande grise. ───────────────────────────── #}
    <section class="rounded-3xl border border-neutral-200 bg-white p-2" data-testid="document-request-settings">
        <div class="flex flex-col gap-1 rounded-2xl bg-neutral-50 p-2">
            <div class="rounded-xl bg-white px-5 py-4" data-testid="document-request-note">
                <twig:Label for="{{ form.note.vars.id }}" class="text-gray-600">
                    {{ 'admin.tools.documents.request.note.label'|trans }}
                </twig:Label>
                <p id="{{ form.note.vars.id }}-help" class="mt-0.5 text-xs text-gray-500">{{ 'admin.tools.documents.request.note.help'|trans }}</p>
                <div class="mt-1.5">
                    <textarea
                        id="{{ form.note.vars.id }}"
                        name="{{ form.note.vars.full_name }}"
                        rows="3"
                        maxlength="2000"
                        placeholder="{{ 'admin.tools.documents.request.note.placeholder'|trans }}"
                        aria-invalid="{{ form.note.vars.errors|length > 0 ? 'true' : 'false' }}"
                        aria-describedby="{{ form.note.vars.id }}-help"
                        class="min-h-20 resize-y w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                    >{{ form.note.vars.value }}</textarea>
                    {% for error in form.note.vars.errors %}
                        <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                    {% endfor %}
                </div>
            </div>

            <div class="rounded-xl bg-white px-5 py-4" data-testid="document-request-drive">
                <twig:Label for="{{ form.driveLink.vars.id }}" class="text-gray-600">
                    {{ 'admin.tools.documents.request.driveLink.label'|trans }}
                </twig:Label>
                <p class="mt-0.5 text-xs text-gray-500">{{ 'admin.tools.documents.request.driveLink.help'|trans }}</p>
                <div class="mt-1.5">
                    <input
                        type="url"
                        id="{{ form.driveLink.vars.id }}"
                        name="{{ form.driveLink.vars.full_name }}"
                        value="{{ form.driveLink.vars.value }}"
                        maxlength="512"
                        placeholder="https://drive.google.com/..."
                        inputmode="url"
                        aria-invalid="{{ form.driveLink.vars.errors|length > 0 ? 'true' : 'false' }}"
                        class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none"
                    >
                    {% for error in form.driveLink.vars.errors %}
                        <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                    {% endfor %}
                </div>
            </div>

            <div class="rounded-xl bg-white px-5 py-4" data-testid="document-request-language">
                <p class="text-sm text-gray-600">
                    {{ 'admin.tools.documents.request.language.title'|trans }}
                </p>
                <p class="mt-0.5 text-xs text-gray-500">{{ 'admin.tools.documents.request.language.subtitle'|trans }}</p>
                <div class="mt-1.5 flex flex-wrap gap-2">
                    {% for choice in form.language.children %}
                        <label for="{{ choice.vars.id }}" class="flex cursor-pointer items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors duration-100 ease-out hover:border-gray-400 hover:text-gray-900 has-[input:checked]:border-primary/40 has-[input:checked]:bg-primary/5 has-[input:checked]:text-primary">
                            <input
                                type="radio"
                                id="{{ choice.vars.id }}"
                                name="{{ choice.vars.full_name }}"
                                value="{{ choice.vars.value }}"
                                {% if choice.vars.checked %}checked{% endif %}
                                class="sr-only"
                            />
                            {{ ux_icon(choice.vars.value == 'fr' ? 'circle-flags:fr' : 'circle-flags:en', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                            {{ choice.vars.label|trans }}
                        </label>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    {# ───── Action : Télécharger (persiste puis stream le PDF). Le reste
           se sauvegarde tout seul à chaque modification. ─────────────────── #}
    <div class="flex flex-col-reverse items-stretch gap-3 border-t border-gray-950/5 pt-5 sm:flex-row sm:items-center sm:justify-end">
        {# Le data-loading couvre la phase LiveAction (validation + save);
           download-trigger reprend le relais et garde le loader affiché
           jusqu'à la fin réelle du téléchargement du PDF. #}
        <twig:Button
            variant="default"
            type="button"
            data-testid="document-request-download"
            data-action="live#action:prevent"
            data-live-action-param="download"
            data-loading="action(download)|addAttribute(disabled)"
            data-download-trigger-target="button"
        >
            <span class="relative inline-flex items-center justify-center gap-2">
                <span class="inline-flex items-center gap-2" data-loading="action(download)|addClass(invisible)" data-download-trigger-target="label">
                    <twig:ux:icon name="lucide:download" class="size-4 shrink-0" aria-hidden="true" />
                    {{ 'admin.tools.documents.request.actions.download'|trans }}
                </span>
                <span class="hidden absolute inset-0 flex items-center justify-center" data-loading="action(download)|removeClass(hidden)" data-download-trigger-target="spinner">
                    <twig:Spinner />
                </span>
            </span>
        </twig:Button>
    </div>
</form>
