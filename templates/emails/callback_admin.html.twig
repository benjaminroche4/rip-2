{# Admin notification of the "On vous rappelle" form: appointment first, then the answers by topic. #}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="en">
<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta content="width=device-width" name="viewport" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta content="telephone=no,address=no,email=no,date=no,url=no" name="format-detection" />
    <link rel="preload" as="image" href="https://resend-attachments.s3.amazonaws.com/y8VsZ3nZ1GDIWiz" />
    <link rel="preload" as="image" href="https://resend-attachments.s3.amazonaws.com/16d42dd0-bce1-40e8-b0fb-29790baccd42" />
</head>
<body>
    {% set fontStack = "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif" %}

    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
        <tbody>
            <tr>
                <td>
                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                        style="font-family:{{ fontStack }};font-size:1.077em;min-height:100%;line-height:155%">
                        <tbody>
                            <tr>
                                <td>
                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                                        style="max-width:600px;width:100%;padding:40px 20px;border:1px solid #e2e2e2;border-radius:12px;background-color:#ffffff;font-family:{{ fontStack }}">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <img
                                                        src="https://resend-attachments.s3.amazonaws.com/y8VsZ3nZ1GDIWiz"
                                                        alt="Logo Relocation in Paris"
                                                        width="166" height="38"
                                                        style="display:block;outline:none;border:none;text-decoration:none;max-width:100%;border-radius:0" />

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>

                                                    <h2 style="margin:0;padding:0.389em 0 0;font-size:1.8em;line-height:1.44;font-weight:600;text-align:center">
                                                        Nouvelle demande de rappel
                                                    </h2>

                                                    <p style="margin:0;padding:0.5em 0;text-align:center"><br /></p>

                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                        style="background-color:#EFFDF4;border:1px solid #DCFCE7;border-radius:12px;padding:10px 20px">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="margin:0;padding:0.5em 0 0.25em;font-size:15px;text-align:center">
                                                                        <strong>Rendez-vous</strong>
                                                                    </p>
                                                                    <p style="margin:0;padding:0.25em 0;font-size:1.15em;text-align:center">
                                                                        {% if callbackAnswers.contactSlot is defined and callbackAnswers.contactSlot != 'asap' %}
                                                                            <strong>{{ ('callback.form.contactSlot.choice.' ~ callbackAnswers.contactSlot)|trans(locale='fr') }}</strong>
                                                                        {% else %}
                                                                            <strong>Dès que possible</strong> : rappel sous 5 à 30 min
                                                                        {% endif %}
                                                                    </p>
                                                                    <p style="margin:0;padding:0.25em 0 0.5em;font-size:1em;text-align:center;color:#525252">
                                                                        {% if callbackAnswers.contactMethod is defined %}
                                                                            {{ ('callback.form.contactMethod.choice.' ~ callbackAnswers.contactMethod)|trans(locale='fr') }} au
                                                                        {% else %}
                                                                            Appel au
                                                                        {% endif %}
                                                                        {% if phoneNumber %}<a href="tel:{{ phoneNumber }}" style="color:#0F172A">{{ phoneNumber|phone_format }}</a>{% endif %}
                                                                    </p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>

                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                        style="background-color:#F7F7F7;border:1px solid #E5E5E5;border-radius:12px;padding:10px">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="margin:0;padding:8px 0 16px;font-size:15px;line-height:155%">
                                                                        <strong>Informations de contact</strong>
                                                                    </p>

                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="background-color:#ffffff;border-radius:12px 0 0 0;padding:12px 12px 0">
                                                                                    <p style="margin:0;padding:0.5em 0;font-size:1em">
                                                                                        <span style="color:#525252">Nom/Prénom :</span> {{ firstName }} {{ lastName }}
                                                                                    </p>
                                                                                    <p style="margin:0;padding:0.5em 0;font-size:1em">
                                                                                        <span style="color:#525252">Email :</span> {{ emailContact }}
                                                                                    </p>
                                                                                    <p style="margin:0;padding:0.5em 0;font-size:1em">
                                                                                        <span style="color:#525252">Envoyé le :</span> {{ createdAt|date('d F Y')|format_date(locale='fr') }} à {{ createdAt|date('H:i') }}
                                                                                    </p>
                                                                                </td>
                                                                                <td style="background-color:#ffffff;border-radius:0 12px 0 0;padding:12px 12px 0">
                                                                                    <p style="margin:0;padding:0.5em 0;font-size:1em">
                                                                                        <span style="color:#525252">Téléphone :</span>
                                                                                        {% if phoneNumber %}<a href="tel:{{ phoneNumber }}" style="color:#0F172A;text-decoration:none">{{ phoneNumber|phone_format }}</a>{% endif %}
                                                                                    </p>
                                                                                    <p style="margin:0;padding:0.5em 0;font-size:1em">
                                                                                        <span style="color:#525252">Langue :</span>
                                                                                        {{ lang == 'fr' ? 'Français' : 'Anglais' }}
                                                                                    </p>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>

                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                                        style="background-color:#ffffff;border-radius:0 0 12px 12px;padding:0 0 12px 12px">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td>
                                                                                    {% if offer %}
                                                                                        <p style="margin:0;padding:8px 0 4px;font-size:1em">
                                                                                            <span style="color:#525252">Formule choisie :</span> <strong>{{ ('contact.contactForm.offer.' ~ offer ~ '.title')|trans(locale='fr') }}</strong> ({{ ('contact.contactForm.offer.' ~ offer ~ '.price')|trans(locale='fr') }})
                                                                                        </p>
                                                                                    {% endif %}
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                        style="background-color:#F7F7F7;border:1px solid #E5E5E5;border-radius:12px;padding:10px">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="margin:0;padding:8px 0 16px;font-size:15px;line-height:155%">
                                                                        <strong>Projet</strong>
                                                                    </p>
                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                                        style="background-color:#ffffff;border-radius:12px;padding:8px 12px">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td>
                                                                                    {% for field in ['situation', 'settleTiming'] %}
                                                                                        {% if callbackAnswers[field] is defined %}
                                                                                            <p style="margin:0;padding:0.4em 0;font-size:1em">
                                                                                                <span style="color:#525252">{{ ('callback.summary.' ~ field)|trans(locale='fr') }}</span>
                                                                                                {{ ('callback.form.' ~ field ~ '.choice.' ~ callbackAnswers[field])|trans(locale='fr') }}
                                                                                            </p>
                                                                                        {% endif %}
                                                                                    {% endfor %}
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                    <p style="margin:0;padding:0.5em 0"><br /></p>
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                        style="background-color:#F7F7F7;border:1px solid #E5E5E5;border-radius:12px;padding:10px">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="margin:0;padding:8px 0 16px;font-size:15px;line-height:155%">
                                                                        <strong>Recherche</strong>
                                                                    </p>
                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                                        style="background-color:#ffffff;border-radius:12px;padding:8px 12px">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td>
                                                                                    {% for field in ['furnishing', 'rooms', 'rentBudget', 'guarantor'] %}
                                                                                        {% if callbackAnswers[field] is defined %}
                                                                                            <p style="margin:0;padding:0.4em 0;font-size:1em">
                                                                                                <span style="color:#525252">{{ ('callback.summary.' ~ field)|trans(locale='fr') }}</span>
                                                                                                {{ ('callback.form.' ~ field ~ '.choice.' ~ callbackAnswers[field])|trans(locale='fr') }}
                                                                                            </p>
                                                                                        {% endif %}
                                                                                    {% endfor %}
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>


                                                    <br /><br />

                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation">
                                                        <tbody>
                                                            <tr>
                                                                <td align="center">
                                                                    <img
                                                                        src="https://resend-attachments.s3.amazonaws.com/16d42dd0-bce1-40e8-b0fb-29790baccd42"
                                                                        alt="Relocation in Paris"
                                                                        width="124" height="88"
                                                                        style="display:block;outline:none;border:none;text-decoration:none;max-width:100%;border-radius:8px" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:16px 0 8px;font-size:1em;text-align:center">
                                                        <em>Cet email provient du site internet (IP : {{ ip }})</em>
                                                    </p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>