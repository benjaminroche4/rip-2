<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="{{ locale }}">
<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta content="width=device-width" name="viewport" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta content="telephone=no,address=no,email=no,date=no,url=no" name="format-detection" />
    <link rel="preload" as="image" href="https://resend-attachments.s3.amazonaws.com/y8VsZ3nZ1GDIWiz" />
</head>
<body>
    {% set fr = locale == 'fr' %}
    {# Preheader : la ligne de prévisualisation en boîte de réception. #}
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all">
        {{ fr
            ? 'Budget, quartiers, emménagement : votre projet en un coup d\'œil.'
            : 'Budget, districts, move-in: your project at a glance.' }}
        &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
    </div>
    {% set fontStack = "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif" %}
    {% set rowLabel = 'margin:0;padding:0.5em 0;font-size:1em' %}
    {% macro row(label, value) %}
        <p style="margin:0;padding:0.5em 0;font-size:1em">
            <span style="color:#525252">{{ label }} :</span> {{ value }}
        </p>
    {% endmacro %}

    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
        <tbody>
            <tr>
                <td>
                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                        style="font-family:{{ fontStack }};font-size:1.077em;min-height:100%;line-height:155%">
                        <tbody>
                            <tr>
                                <td>
                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                                        style="max-width:600px;width:100%;padding:40px 20px;border:1px solid #e2e2e2;border-radius:12px;background-color:#ffffff;font-family:{{ fontStack }}">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <img
                                                        src="https://resend-attachments.s3.amazonaws.com/y8VsZ3nZ1GDIWiz"
                                                        alt="Logo Relocation in Paris"
                                                        width="166" height="38"
                                                        style="display:block;outline:none;border:none;text-decoration:none;max-width:100%;border-radius:0" />

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>

                                                    <h2 style="margin:0;padding:0.389em 0 0;font-size:1.8em;line-height:1.44;font-weight:600;text-align:center">
                                                        {{ fr ? 'Votre projet logement' : 'Your housing project' }}
                                                    </h2>

                                                    <p style="margin:0;padding:0.75em 0 0.5em;font-size:1em;text-align:center;color:#525252">
                                                        {{ fr
                                                            ? 'Bonjour ' ~ contact.firstName|title ~ ', voici le récapitulatif de votre projet tel que nous l\'avons compris. Ces éléments constituent une première approche de votre recherche : ils pourront être affinés à tout moment avec votre conseiller.'
                                                            : 'Hello ' ~ contact.firstName|title ~ ', here is the summary of your project as we understood it. These details are a first outline of your search and can be refined with your advisor at any time.' }}
                                                    </p>

                                                    <p style="margin:0;padding:0.5em 0;text-align:center"><br /></p>

                                                    {# ---- Housing project ---- #}
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                        style="background-color:#F7F7F7;border:1px solid #E5E5E5;border-radius:12px;padding:10px">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="margin:0;padding:8px 0 16px;font-size:15px;line-height:155%">
                                                                        <strong>{{ fr ? 'Votre projet' : 'Your project' }}</strong>
                                                                    </p>
                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="background-color:#ffffff;border-radius:12px;padding:12px">
                                                                                    {% if offerLabel %}
                                                                                        {{ _self.row(fr ? 'Formule' : 'Package', offerLabel) }}
                                                                                    {% endif %}
                                                                                    {% if contact.projectBudget %}
                                                                                        {{ _self.row(fr ? 'Budget mensuel' : 'Monthly budget', contact.projectBudget|format_number(locale=locale) ~ ' €' ~ (fr ? '/mois' : '/mo')) }}
                                                                                    {% endif %}
                                                                                    {% if contact.projectMoveInAt %}
                                                                                        {{ _self.row(fr ? 'Emménagement souhaité' : 'Desired move-in', contact.projectMoveInAt|format_date(pattern='dd MMMM yyyy', locale=locale)) }}
                                                                                    {% endif %}
                                                                                    {% if propertyTypeLabels is not empty %}
                                                                                        {{ _self.row(fr ? 'Type de bien' : 'Property type', propertyTypeLabels|join(', ')) }}
                                                                                    {% endif %}
                                                                                    {% if contact.projectStayDuration %}
                                                                                        {{ _self.row(fr ? 'Durée d\'installation' : 'Length of stay', contact.projectStayDuration.labelKey|trans([], 'messages', locale) ~ ' (' ~ contact.projectStayDuration.hintKey|trans([], 'messages', locale) ~ ')') }}
                                                                                    {% endif %}
                                                                                    {% if contact.projectFurnishing %}
                                                                                        {% set furnishingLabels = contact.projectFurnishing|split(',')|filter(v => v != '')|map(v => ('admin.contacts.project.furnishing.choice.' ~ v)|trans([], 'messages', locale)) %}
                                                                                        {{ _self.row(fr ? 'Meublé / non meublé' : 'Furnishing', furnishingLabels|join(', ')) }}
                                                                                    {% endif %}
                                                                                    {% if contact.projectGuarantorType %}
                                                                                        {{ _self.row(fr ? 'Type de garant' : 'Guarantor', contact.projectGuarantorType.labelKey|trans([], 'messages', locale)) }}
                                                                                    {% endif %}
                                                                                </td>
                                                                            </tr>
                                                                            {% if areasMapUrl %}
                                                                                <tr>
                                                                                    <td style="padding-top:10px">
                                                                                        <img
                                                                                            src="{{ areasMapUrl }}"
                                                                                            alt="{{ fr ? 'Carte des quartiers souhaités' : 'Map of the requested districts' }}"
                                                                                            width="560"
                                                                                            style="display:block;outline:none;border:none;max-width:100%;height:auto;border-radius:12px" />
                                                                                    </td>
                                                                                </tr>
                                                                            {% endif %}
                                                                            {% if areaLabels is not empty %}
                                                                                <tr>
                                                                                    <td style="padding-top:8px">
                                                                                        <p style="margin:0;padding:0 0 4px;font-size:0.9em;color:#525252">{{ fr ? 'Arrondissements souhaités :' : 'Requested districts:' }}</p>
                                                                                        {% for label in areaLabels %}
                                                                                            <span style="display:inline-block;background-color:#F7EDEF;border:1px solid #E3C6CD;border-radius:999px;padding:3px 12px;margin:2px 4px 2px 0;font-size:0.85em;font-weight:600;color:#71172e">{{ label }}</span>
                                                                                        {% endfor %}
                                                                                    </td>
                                                                                </tr>
                                                                            {% endif %}
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.5em 0;text-align:center"><br /></p>

                                                    {# ---- Their contact details ---- #}
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                        style="background-color:#F7F7F7;border:1px solid #E5E5E5;border-radius:12px;padding:10px">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="margin:0;padding:8px 0 16px;font-size:15px;line-height:155%">
                                                                        <strong>{{ fr ? 'Vos coordonnées' : 'Your contact details' }}</strong>
                                                                    </p>
                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="background-color:#ffffff;border-radius:12px;padding:12px">
                                                                                    {{ _self.row(fr ? 'Nom' : 'Name', contact.fullName|title) }}
                                                                                    {{ _self.row('Email', contact.email) }}
                                                                                    {% if contact.phoneNumber %}
                                                                                        {{ _self.row(fr ? 'Téléphone' : 'Phone', contact.phoneNumber|phone_format) }}
                                                                                    {% endif %}
                                                                                    {{ _self.row(fr ? 'Référence' : 'Reference', contact.reference) }}
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    {% if contact.assigneeName %}
                                                        <p style="margin:0;padding:0.5em 0;text-align:center"><br /></p>

                                                        {# ---- Their advisor ---- #}
                                                        <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                            style="background-color:#F7F7F7;border:1px solid #E5E5E5;border-radius:12px;padding:10px">
                                                            <tbody>
                                                                <tr>
                                                                    <td>
                                                                        <p style="margin:0;padding:8px 0 16px;font-size:15px;line-height:155%">
                                                                            <strong>{{ fr ? 'Votre conseiller' : 'Your advisor' }}</strong>
                                                                        </p>
                                                                        <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
                                                                            <tbody>
                                                                                <tr>
                                                                                    <td style="background-color:#ffffff;border-radius:12px;padding:12px">
                                                                                        <p style="margin:0;padding:0.5em 0;font-size:1em">
                                                                                            <strong style="color:#111827">{{ contact.assigneeName|title }}</strong>
                                                                                        </p>
                                                                                        <p style="margin:0;padding:0.5em 0;font-size:1em;color:#525252">
                                                                                            {{ fr
                                                                                                ? 'Votre interlocuteur dédié suit votre dossier de bout en bout.'
                                                                                                : 'Your dedicated advisor follows your file end to end.' }}
                                                                                        </p>
                                                                                        <p style="margin:0;padding:0.75em 0 0.25em">
                                                                                            <a href="{{ site_whatsapp_url }}"
                                                                                                style="display:inline-block;background-color:#71172e;color:#ffffff;text-decoration:none;font-weight:600;font-size:0.95em;padding:10px 20px;border-radius:8px;margin:0 8px 8px 0">
                                                                                                WhatsApp
                                                                                            </a>
                                                                                            <a href="tel:{{ site_phone }}"
                                                                                                style="display:inline-block;background-color:#ffffff;color:#71172e;border:1px solid #E3C6CD;text-decoration:none;font-weight:600;font-size:0.95em;padding:10px 20px;border-radius:8px;margin:0 0 8px">
                                                                                                {{ fr ? 'Appeler' : 'Call us' }} {{ site_phone_display }}
                                                                                            </a>
                                                                                        </p>
                                                                                    </td>
                                                                                </tr>
                                                                            </tbody>
                                                                        </table>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    {% endif %}

                                                    {# ---- Next steps ---- #}
                                                    <p style="margin:0;padding:0.5em 0;text-align:center"><br /></p>
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                        style="background-color:#F7F7F7;border:1px solid #E5E5E5;border-radius:12px;padding:10px">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="margin:0;padding:8px 0 16px;font-size:15px;line-height:155%">
                                                                        <strong>{{ fr ? 'Et ensuite ?' : 'What happens next?' }}</strong>
                                                                    </p>
                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="background-color:#ffffff;border-radius:12px;padding:14px 16px">
                                                                                    {% set steps = fr
                                                                                        ? ['Validation de votre projet avec votre conseiller', 'Sélection de biens, y compris off-market', 'Visites et remise des clés']
                                                                                        : ['Project validation with your advisor', 'Property selection, including off-market', 'Viewings and key handover'] %}
                                                                                    {% for step in steps %}
                                                                                        <p style="margin:0;padding:0.45em 0;font-size:1em">
                                                                                            <span style="display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;background-color:#F7EDEF;color:#71172e;border-radius:999px;font-size:0.8em;font-weight:700;margin-right:8px;vertical-align:middle">{{ loop.index }}</span>{{ step }}
                                                                                        </p>
                                                                                    {% endfor %}
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    {% if paymentUrl %}
                                                        <p style="margin:0;padding:1em 0 0.5em;text-align:center"><br /></p>
                                                        <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
                                                            <tbody>
                                                                <tr>
                                                                    <td align="center" style="padding:8px 0 28px;border-top:1px solid #efefef">
                                                                        <p style="margin:0 auto;padding:24px 0 18px;font-size:1em;color:#525252;max-width:400px;text-align:center;text-wrap:balance">
                                                                            {{ fr
                                                                                ? 'Il ne vous reste plus qu\'à confirmer votre recherche pour démarrer la sélection.'
                                                                                : 'All that remains is to confirm your search to start the selection.' }}
                                                                        </p>
                                                                        <a href="{{ paymentUrl }}"
                                                                            style="display:inline-block;background-color:#71172e;color:#ffffff;text-decoration:none;font-weight:600;font-size:1em;padding:13px 28px;border-radius:8px">
                                                                            {{ fr
                                                                                ? 'Confirmer ma formule ' ~ paymentOfferTitle
                                                                                : 'Confirm my ' ~ paymentOfferTitle ~ ' package' }}
                                                                        </a>
                                                                        <p style="margin:0;padding:12px 0 0;font-size:0.85em;color:#9ca3af">
                                                                            <img src="{{ site_url }}/medias/website/email-icons/lock.png" alt="" width="12" height="12" style="display:inline-block;vertical-align:-1px;margin-right:4px;border:none;outline:none" />
                                                                            {{ fr ? 'Paiement sécurisé via Stripe' : 'Secure payment via Stripe' }} · {{ paymentDeposit ? (fr ? 'Acompte de 50 % sur ' : '50% deposit on ') }}{{ paymentOfferPrice }}
                                                                        </p>
                                                                        <p style="margin:0;padding:26px 0 0;font-size:0.8em;color:#9ca3af;letter-spacing:0.01em">
                                                                            {{ fr ? '+900 installations réussies · Biens off-market ·' : '+900 successful relocations · Off-market listings ·' }}
                                                                            <a href="https://share.google/c8msBrKphxqVY03er" style="color:#9ca3af;text-decoration:underline">{{ fr ? '+400 avis Google' : '+400 Google reviews' }}</a>
                                                                        </p>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    {% endif %}

                                                    <p style="margin:0;padding:0.75em 0"><br /></p>

                                                    <p style="margin:0;padding:0;font-size:0.9em;text-align:center;color:#9ca3af">
                                                        Relocation in Paris — 155 Rue du Faubourg Saint-Denis, 75010 Paris
                                                    </p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>
