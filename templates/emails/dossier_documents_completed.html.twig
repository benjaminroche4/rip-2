<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="{{ fr ? 'fr' : 'en' }}">
<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta content="width=device-width" name="viewport" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta content="telephone=no,address=no,email=no,date=no,url=no" name="format-detection" />
</head>
<body>
    {% set fontStack = "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif" %}
    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
        <tbody>
            <tr>
                <td>
                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                        style="font-family:{{ fontStack }};font-size:1.077em;min-height:100%;line-height:155%">
                        <tbody>
                            <tr>
                                <td>
                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                                        style="max-width:600px;width:100%;padding:40px 20px;border:1px solid #e2e2e2;border-radius:12px;background-color:#ffffff;font-family:{{ fontStack }}">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <img
                                                        src="https://resend-attachments.s3.amazonaws.com/y8VsZ3nZ1GDIWiz"
                                                        alt="Logo Relocation in Paris"
                                                        width="166" height="38"
                                                        style="display:block;outline:none;border:none;text-decoration:none;max-width:100%;border-radius:0" />

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>

                                                    <h2 style="margin:0;padding:0.389em 0 0;font-size:1.8em;line-height:1.44;font-weight:600">
                                                        {{ fr ? 'Votre dossier est complet' : 'Your application is complete' }}
                                                    </h2>

                                                    <p style="margin:0;padding:0.8em 0 0;font-size:1em;color:#111827">
                                                        {{ fr ? 'Bonjour' : 'Hello' }}{% if recipientFirstName %} {{ recipientFirstName }}{% endif %},
                                                    </p>

                                                    <p style="margin:0;padding:0.8em 0 0;font-size:1em;color:#525252">
                                                        {{ fr
                                                            ? 'Bonne nouvelle : toutes les pièces de votre dossier locatif ont été validées. Votre dossier est complet.'
                                                            : 'Good news: every document of your rental application has been validated. Your application is complete.' }}
                                                    </p>

                                                    <p style="margin:0;padding:0.8em 0 0;font-size:1em;color:#525252">
                                                        {{ fr
                                                            ? 'Votre conseiller prend le relais et revient vers vous très prochainement pour la suite.'
                                                            : 'Your advisor is taking over and will get back to you very soon with the next steps.' }}
                                                    </p>

                                                    <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="margin-top:20px">
                                                        <tbody>
                                                            <tr>
                                                                <td style="border-radius:8px;background-color:#111827">
                                                                    <a href="{{ depositUrl }}"
                                                                        style="display:inline-block;padding:12px 24px;font-size:1em;font-weight:600;color:#ffffff;text-decoration:none">
                                                                        {{ fr ? 'Consulter mon dossier' : 'View my application' }}
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:1em 0 0;font-size:0.9em;color:#525252">
                                                        {{ fr
                                                            ? 'Sur la page, saisissez votre adresse email (celle qui a reçu ce message) et le code suivant :'
                                                            : 'On the page, enter your email address (the one this message was sent to) and the following code:' }}
                                                        <strong style="color:#111827;letter-spacing:0.2em">{{ pairingCode }}</strong>
                                                    </p>

                                                    <p style="margin:0;padding:1.2em 0 0;font-size:1em;color:#525252">
                                                        {{ fr ? "L'équipe Relocation in Paris" : 'The Relocation in Paris team' }}
                                                    </p>

                                                    <p style="margin:0;padding:1.2em 0 0;font-size:0.8em;color:#9ca3af">
                                                        {{ fr ? 'Référence dossier' : 'File reference' }} : {{ reference }}
                                                    </p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>
