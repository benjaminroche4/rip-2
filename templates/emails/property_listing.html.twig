<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="fr">
<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta content="width=device-width" name="viewport" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta content="telephone=no,address=no,email=no,date=no,url=no" name="format-detection" />
    <link rel="preload" as="image" href="https://resend-attachments.s3.amazonaws.com/y8VsZ3nZ1GDIWiz" />
    <link rel="preload" as="image" href="https://resend-attachments.s3.amazonaws.com/16d42dd0-bce1-40e8-b0fb-29790baccd42" />
</head>
<body>
    {% set fontStack = "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif" %}

    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
        <tbody>
            <tr>
                <td>
                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                        style="font-family:{{ fontStack }};font-size:1.077em;min-height:100%;line-height:155%">
                        <tbody>
                            <tr>
                                <td>
                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                                        style="max-width:600px;width:100%;padding:40px 20px;border:1px solid #e2e2e2;border-radius:12px;background-color:#ffffff;font-family:{{ fontStack }}">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <img
                                                        src="https://resend-attachments.s3.amazonaws.com/y8VsZ3nZ1GDIWiz"
                                                        alt="Logo Relocation in Paris"
                                                        width="166" height="38"
                                                        style="display:block;outline:none;border:none;text-decoration:none;max-width:100%;border-radius:0" />

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>

                                                    <h2 style="margin:0;padding:0.389em 0 0;font-size:1.8em;line-height:1.44;font-weight:600;text-align:center">
                                                        Nouveau bien proposé à la location
                                                    </h2>

                                                    <p style="margin:0;padding:0.5em 0;text-align:center"><br /></p>

                                                    {% set sectionStyle = 'background-color:#F7F7F7;border:1px solid #E5E5E5;border-radius:12px;padding:10px' %}
                                                    {% set cardStyle = 'background-color:#ffffff;border-radius:12px;padding:4px 12px' %}
                                                    {% set rowStyle = 'margin:0;padding:0.5em 0;font-size:1em' %}
                                                    {% set labelStyle = 'color:#525252' %}
                                                    {% set titleStyle = 'margin:0;padding:4px 0 10px;font-size:15px;line-height:155%' %}

                                                    {# Section 1 : vos coordonnees (memes sections que le formulaire) #}
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ sectionStyle }}">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="{{ titleStyle }}"><strong>Informations de contact</strong></p>
                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ cardStyle }}">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Nom :</span> {{ fullName }}</p>
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Email :</span> {{ emailLead }}</p>
                                                                                    <p style="{{ rowStyle }}">
                                                                                        <span style="{{ labelStyle }}">Téléphone :</span>
                                                                                        {% if phoneNumber %}<a href="tel:{{ phoneNumber }}" style="color:#0F172A;text-decoration:none">{{ phoneNumber|phone_format }}</a>{% endif %}
                                                                                    </p>
                                                                                </td>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Langue :</span> {{ lang == 'fr' ? 'Français' : 'Anglais' }}</p>
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Envoyé le :</span> {{ createdAt|date('d F Y')|format_date(locale='fr') }} à {{ createdAt|date('H:i') }}</p>
                                                                                </td>
                                                                            </tr>
                                                                            {% if phoneNumber or emailLead %}
                                                                                {% set buttonStyle = 'display:inline-block;background-color:#71172E;color:#ffffff;font-size:0.85em;font-weight:600;text-decoration:none;padding:8px 14px;border-radius:8px' %}
                                                                                {% set mailSubject = lang == 'fr' ? 'Votre bien ' ~ address : 'Your property ' ~ address %}
                                                                                <tr>
                                                                                    <td colspan="2" style="padding:8px 0 10px">
                                                                                        {% if phoneNumber %}
                                                                                            <a href="tel:{{ phoneNumber }}" style="{{ buttonStyle }}">Appeler</a>&nbsp;
                                                                                            <a href="https://wa.me/{{ phoneNumber|replace({'+': '', ' ': ''}) }}" style="{{ buttonStyle }}">WhatsApp</a>&nbsp;
                                                                                        {% endif %}
                                                                                        <a href="mailto:{{ emailLead }}?subject={{ mailSubject|url_encode }}" style="{{ buttonStyle }}">Répondre par email</a>
                                                                                    </td>
                                                                                </tr>
                                                                            {% endif %}
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.35em 0"><br /></p>

                                                    {# Section 2 : detail du bien (carte + adresse + caracteristiques) #}
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ sectionStyle }}">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="{{ titleStyle }}"><strong>Détail du bien</strong></p>
                                                                    <img
                                                                        src="https://maps.googleapis.com/maps/api/staticmap?center={{ address|url_encode }}&zoom=16&size=560x220&scale=2&markers=anchor:bottom%7Cicon:{{ (site_url ~ '/medias/website/map-pin.png')|url_encode }}%7C{{ address|url_encode }}&language=fr&key={{ google_maps_api_key }}"
                                                                        alt="Carte : {{ address }}"
                                                                        width="560" height="220"
                                                                        style="display:block;outline:none;border:none;width:100%;height:auto;border-radius:12px 12px 0 0" />
                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#ffffff;border-radius:0 0 12px 12px;padding:4px 12px">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td colspan="2">
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Adresse :</span> {{ address }}</p>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Type :</span> {{ propertyType|trans(locale='fr') }}</p>
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Statut :</span> {{ propertyStatus|trans(locale='fr') }}</p>
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Meublé :</span> {{ furnishing|trans(locale='fr') }}</p>
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Orientation :</span> {{ orientations|map(o => o|trans(locale='fr'))|join(', ') }}</p>
                                                                                </td>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Chambres :</span> {{ bedrooms }}</p>
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Salles de bain :</span> {{ bathrooms }}</p>
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Surface :</span> {{ surface }} m&sup2;</p>
                                                                                    {% if floor is not null and buildingFloors is not null %}<p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Étage :</span> {{ floor }} sur {{ buildingFloors }}</p>{% endif %}
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.35em 0"><br /></p>

                                                    {# Section 3 : conditions de location (bail, finances, equipements) #}
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ sectionStyle }}">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="{{ titleStyle }}"><strong>Conditions de location</strong></p>
                                                                    {% if rent is null and deposit is null %}
                                                                        <p style="margin:0 0 8px;padding:0">
                                                                            <span style="display:inline-block;background-color:#FEF3C7;border:1px solid #FDE68A;color:#92400E;font-size:0.85em;font-weight:600;padding:6px 12px;border-radius:999px">Projet Airbnb uniquement</span>
                                                                        </p>
                                                                    {% endif %}
                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ cardStyle }}">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Bail souhaité :</span> {{ leaseTypes|map(l => l|trans(locale='fr'))|join(', ') }}</p>
                                                                                    {% if rent is not null %}<p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Loyer HC :</span> {{ rent }} &euro;</p>{% endif %}
                                                                                </td>
                                                                                <td style="vertical-align:top">
                                                                                    {% if charges is not null %}<p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Charges :</span> {{ charges }} &euro;</p>{% endif %}
                                                                                    {% if deposit is not null %}<p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Dépôt de garantie :</span> {{ deposit }} &euro;</p>{% endif %}
                                                                                </td>
                                                                            </tr>
                                                                            {% if amenities is not empty %}
                                                                                <tr>
                                                                                    <td colspan="2">
                                                                                        <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Équipements :</span> {{ amenities|map(a => a|trans(locale='fr'))|join(', ') }}</p>
                                                                                    </td>
                                                                                </tr>
                                                                            {% endif %}
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.35em 0"><br /></p>

                                                    {# Section 4 : photos et precisions #}
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ sectionStyle }}">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="{{ titleStyle }}"><strong>Photos et précisions</strong></p>
                                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ cardStyle }}">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td>
                                                                                    <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Photos :</span> {% if photosCount > 0 %}{{ photosCount }} photo{{ photosCount > 1 ? 's' }} en pièce{{ photosCount > 1 ? 's' }} jointe{{ photosCount > 1 ? 's' }}{% else %}aucune{% endif %}</p>
                                                                                    {% if note %}
                                                                                        <p style="{{ rowStyle }}"><span style="{{ labelStyle }}">Note du propriétaire :</span><br/>{{ note|nl2br }}</p>
                                                                                    {% endif %}
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>

                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                        style="background-color:#EFFDF4;border:1px solid #DCFCE7;border-radius:12px;padding:10px 20px">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="margin:0;padding:0.5em 0;font-size:1em;text-align:center;color:#525252">
                                                                        Ce propriétaire attend un retour <strong><em>sous 24 heures ouvrées</em></strong>.
                                                                    </p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <br /><br />

                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation">
                                                        <tbody>
                                                            <tr>
                                                                <td align="center">
                                                                    <img
                                                                        src="https://resend-attachments.s3.amazonaws.com/16d42dd0-bce1-40e8-b0fb-29790baccd42"
                                                                        alt="Relocation in Paris"
                                                                        width="124" height="88"
                                                                        style="display:block;outline:none;border:none;text-decoration:none;max-width:100%;border-radius:8px" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:16px 0 8px;font-size:1em;text-align:center">
                                                        <em>Cet email provient du site internet (IP : {{ ip }})</em>
                                                    </p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>
