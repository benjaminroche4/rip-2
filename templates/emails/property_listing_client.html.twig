<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="{{ lang }}">
<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta content="width=device-width" name="viewport" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta content="telephone=no,address=no,email=no,date=no,url=no" name="format-detection" />
    <link rel="preload" as="image" href="https://resend-attachments.s3.amazonaws.com/y8VsZ3nZ1GDIWiz" />
    <link rel="preload" as="image" href="https://resend-attachments.s3.amazonaws.com/16d42dd0-bce1-40e8-b0fb-29790baccd42" />
    <link rel="preload" as="image" href="https://resend.com/static/email/social-linkedin.png" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <style>
        @media (prefers-color-scheme: dark) {
            body, .email-body { background-color: #111111 !important; }
            .email-card { background-color: #1e1e1e !important; border-color: #333333 !important; }
            .email-card td { color: #e4e4e4 !important; }
            .email-card h2, .email-card h3 { color: #f5f5f5 !important; }
            .box-gray { background-color: #2a2a2a !important; border-color: #3a3a3a !important; }
            .box-white { background-color: #252525 !important; }
            .box-green { background-color: #052e16 !important; border-color: #166534 !important; color: #bbf7d0 !important; }
            .box-green strong { color: #bbf7d0 !important; }
            .label-muted { color: #9ca3af !important; }
            .text-muted { color: #9ca3af !important; }
            hr { border-top-color: #3a3a3a !important; }
        }
    </style>
</head>
<body class="email-body" style="background-color:#f4f4f4">
    {% set fontStack = "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif" %}
    {% set fr = (lang == 'fr') %}

    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
        <tbody>
            <tr>
                <td>
                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                        style="font-family:{{ fontStack }};font-size:1.077em;min-height:100%;line-height:155%">
                        <tbody>
                            <tr>
                                <td>
                                    <table class="email-card" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center"
                                        style="max-width:600px;width:100%;padding:40px 20px;border:1px solid #e2e2e2;border-radius:12px;background-color:#ffffff;font-family:{{ fontStack }}">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <img
                                                        src="https://resend-attachments.s3.amazonaws.com/y8VsZ3nZ1GDIWiz"
                                                        alt="Logo Relocation in Paris"
                                                        width="166" height="38"
                                                        style="display:block;outline:none;border:none;text-decoration:none;max-width:100%;border-radius:0" />

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>

                                                    <h2 style="margin:0;padding:0.389em 0 0;font-size:1.8em;line-height:1.44;font-weight:600;text-align:center">
                                                        {{ fr ? "Merci d'avoir proposé votre bien" : 'Thank you for listing your property' }}
                                                    </h2>

                                                    <p style="margin:0;padding:0.5em 0;text-align:center"><br /></p>

                                                    {% set sectionStyle = 'background-color:#F7F7F7;border:1px solid #E5E5E5;border-radius:12px;padding:10px' %}
                                                    {% set cardStyle = 'background-color:#ffffff;border-radius:12px;padding:4px 12px' %}
                                                    {% set rowStyle = 'margin:0;padding:0.5em 0;font-size:1em' %}
                                                    {% set labelStyle = 'color:#525252' %}
                                                    {% set titleStyle = 'margin:0;padding:4px 0 10px;font-size:15px;line-height:155%' %}

                                                    {# Statut : bien soumis, traite en interne par l'equipe #}
                                                    <table class="box-green" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                                                        style="background-color:#EFFDF4;border:1px solid #BBF7D0;border-radius:12px;padding:14px 20px">
                                                        <tbody>
                                                            <tr>
                                                                <td align="center">
                                                                    <p style="margin:0;padding:0;font-size:1em">
                                                                        <strong>&#10003; {{ fr ? 'Votre bien a bien été soumis' : 'Your property has been submitted' }}</strong>
                                                                    </p>
                                                                    <p class="text-muted" style="margin:0;padding:6px 0 0;font-size:1em;color:#6b7280;text-wrap:balance">
                                                                        {{ fr ? 'Notre équipe l\'analyse en interne et revient vers vous sous 24 heures ouvrées.' : 'Our team is reviewing it internally and will get back to you within 24 business hours.' }}
                                                                    </p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.35em 0"><br /></p>

                                                    {# Section 1 : informations de contact #}
                                                    <table class="box-gray" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ sectionStyle }}">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="{{ titleStyle }}"><strong>{{ fr ? 'Informations de contact' : 'Contact information' }}</strong></p>
                                                                    <table class="box-white" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ cardStyle }}">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Nom :' : 'Name:' }}</span> {{ fullName }}</p>
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Email :' : 'Email:' }}</span> {{ emailLead }}</p>
                                                                                </td>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Téléphone :' : 'Phone:' }}</span> {{ phoneNumber|phone_format }}</p>
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Envoyé le :' : 'Sent on:' }}</span> {{ createdAt|date('d F Y')|format_date(locale=lang) }} {{ fr ? 'à' : 'at' }} {{ createdAt|date('H:i') }}</p>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.35em 0"><br /></p>

                                                    {# Section 2 : detail du bien #}
                                                    <table class="box-gray" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ sectionStyle }}">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="{{ titleStyle }}"><strong>{{ fr ? 'Détail du bien' : 'Property details' }}</strong></p>
                                                                    <img
                                                                        src="https://maps.googleapis.com/maps/api/staticmap?center={{ address|url_encode }}&zoom=16&size=560x220&scale=2&markers=anchor:bottom%7Cicon:{{ (site_url ~ '/medias/website/map-pin.png')|url_encode }}%7C{{ address|url_encode }}&language={{ lang }}&key={{ google_maps_api_key }}"
                                                                        alt="{{ fr ? 'Carte : ' : 'Map: ' }}{{ address }}"
                                                                        width="560" height="220"
                                                                        style="display:block;outline:none;border:none;width:100%;height:auto;border-radius:12px 12px 0 0" />
                                                                    <table class="box-white" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#ffffff;border-radius:0 0 12px 12px;padding:4px 12px">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td colspan="2">
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Adresse :' : 'Address:' }}</span> {{ address }}</p>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Type :' : 'Type:' }}</span> {{ propertyType|trans(locale=lang) }}</p>
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Statut :' : 'Status:' }}</span> {{ propertyStatus|trans(locale=lang) }}</p>
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Meublé :' : 'Furnishing:' }}</span> {{ furnishing|trans(locale=lang) }}</p>
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Orientation :' : 'Orientation:' }}</span> {{ orientations|map(o => o|trans(locale=lang))|join(', ') }}</p>
                                                                                </td>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Chambres :' : 'Bedrooms:' }}</span> {{ bedrooms }}</p>
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Salles de bain :' : 'Bathrooms:' }}</span> {{ bathrooms }}</p>
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Surface :' : 'Surface:' }}</span> {{ surface }} m&sup2;</p>
                                                                                    {% if floor is not null and buildingFloors is not null %}<p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Étage :' : 'Floor:' }}</span> {{ floor }} / {{ buildingFloors }}</p>{% endif %}
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.35em 0"><br /></p>

                                                    {# Section 3 : conditions de location #}
                                                    <table class="box-gray" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ sectionStyle }}">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="{{ titleStyle }}"><strong>{{ fr ? 'Conditions de location' : 'Rental terms' }}</strong></p>
                                                                    {% if rent is null and deposit is null %}
                                                                        <p style="margin:0 0 8px;padding:0">
                                                                            <span style="display:inline-block;background-color:#FEF3C7;border:1px solid #FDE68A;color:#92400E;font-size:0.85em;font-weight:600;padding:6px 12px;border-radius:999px">{{ fr ? 'Projet Airbnb uniquement' : 'Airbnb-only project' }}</span>
                                                                        </p>
                                                                    {% endif %}
                                                                    <table class="box-white" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ cardStyle }}">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="vertical-align:top">
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Bail souhaité :' : 'Preferred lease:' }}</span> {{ leaseTypes|map(l => l|trans(locale=lang))|join(', ') }}</p>
                                                                                    {% if rent is not null %}<p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Loyer HC :' : 'Rent excl. charges:' }}</span> {{ rent }} &euro;</p>{% endif %}
                                                                                </td>
                                                                                <td style="vertical-align:top">
                                                                                    {% if charges is not null %}<p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Charges :' : 'Charges:' }}</span> {{ charges }} &euro;</p>{% endif %}
                                                                                    {% if deposit is not null %}<p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Dépôt de garantie :' : 'Deposit:' }}</span> {{ deposit }} &euro;</p>{% endif %}
                                                                                </td>
                                                                            </tr>
                                                                            {% if amenities is not empty %}
                                                                                <tr>
                                                                                    <td colspan="2">
                                                                                        <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Équipements :' : 'Amenities:' }}</span> {{ amenities|map(a => a|trans(locale=lang))|join(', ') }}</p>
                                                                                    </td>
                                                                                </tr>
                                                                            {% endif %}
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.35em 0"><br /></p>

                                                    {# Section 4 : photos et precisions #}
                                                    <table class="box-gray" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ sectionStyle }}">
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <p style="{{ titleStyle }}"><strong>{{ fr ? 'Photos et précisions' : 'Photos and details' }}</strong></p>
                                                                    <table class="box-white" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="{{ cardStyle }}">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td>
                                                                                    {% set plural = photosCount > 1 ? 's' %}
                                                                                    <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Photos :' : 'Photos:' }}</span> {% if photosCount > 0 %}{{ fr ? photosCount ~ ' photo' ~ plural ~ ' transmise' ~ plural ~ ' avec votre demande' : photosCount ~ ' photo' ~ plural ~ ' sent with your request' }}{% else %}{{ fr ? 'aucune' : 'none' }}{% endif %}</p>
                                                                                    {% if note %}
                                                                                        <p style="{{ rowStyle }}"><span class="label-muted" style="{{ labelStyle }}">{{ fr ? 'Votre note :' : 'Your note:' }}</span><br/>{{ note|nl2br }}</p>
                                                                                    {% endif %}
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.5em 0;text-align:center"><br /></p>

                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
                                                        <tbody>
                                                            <tr>
                                                                <td align="center">
                                                                    <img
                                                                        src="https://resend-attachments.s3.amazonaws.com/16d42dd0-bce1-40e8-b0fb-29790baccd42"
                                                                        alt="Relocation in Paris"
                                                                        width="124" height="88"
                                                                        style="display:block;outline:none;border:none;text-decoration:none;max-width:100%;border-radius:8px" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p class="text-muted" style="margin:0;padding:16px 0;font-size:1em;text-align:center">
                                                        {{ fr ? 'Agence de Relocation pour Particuliers et Professionnels' : 'Relocation Agency for Individuals and Businesses' }}
                                                    </p>

                                                    <hr style="width:100%;border:none;border-top:2px solid #eaeaea;margin:16px 0 0" />

                                                    <p class="text-muted" style="margin:0;padding:2em 0;font-size:1em;text-align:center">
                                                        155 Rue du Faubourg Saint-Denis<br />75010 Paris, France
                                                    </p>

                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" align="center">
                                                        <tbody>
                                                            <tr>
                                                                <td align="center">
                                                                    <a href="https://www.linkedin.com/company/relocation-in-paris/" rel="noopener noreferrer" target="_blank">
                                                                        <img
                                                                            src="https://resend.com/static/email/social-linkedin.png"
                                                                            alt="LinkedIn"
                                                                            width="32" height="32"
                                                                            style="display:block;outline:none;border:none;text-decoration:none" />
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                    <p style="margin:0;padding:0.5em 0"><br /></p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>
