{% extends 'public/base.html.twig' %}

{% block title %}{{ 'meta.aboutUs.title'|trans }}{% endblock %}
{% block description %}{{ 'meta.aboutUs.description'|trans({'%year%': site_founding_year}) }}{% endblock %}
{% block url %}{{ path('app_about_us') }}{% endblock %}

{% block schema_page %}
    ,{
        "@type": "AboutPage",
        "@id": "{{ site_url }}{{ path('app_about_us') }}/#aboutpage",
        "url": "{{ site_url }}{{ path('app_about_us') }}",
        "name": "{{ 'meta.aboutUs.title'|trans|e('js') }}",
        "description": "{{ 'meta.aboutUs.description'|trans({'%year%': site_founding_year})|e('js') }}",
        "inLanguage": "{{ app.request.locale == 'fr' ? 'fr-FR' : 'en-GB' }}",
        "isPartOf": { "@id": "{{ site_url }}/#website" },
        "about": { "@id": "{{ site_url }}/#organization" }
    }
{% endblock %}

{% block body %}
    <section class="max-w-7xl mx-auto lg:px-8 px-6 lg:py-16 py-12">
        <twig:Section:PageHeader caption="aboutUs.title" subtitle="aboutUs.subTitle" intro="aboutUs.intro" />
        {# Three photos in a fan: the middle one is taller and in front (z-10), the sides tilt outwards and tuck behind it.
           They open on page load (CSS only, app.css `fan-*`), never for reduced-motion visitors. #}
        <div class="mx-auto mt-10 grid max-w-[860px] grid-cols-[26fr_34fr_26fr] items-center lg:mt-16" data-testid="about-hero-photos">
            {% for photo in [
                {file: 1, small: 260, width: 520, height: 640, ratio: 'aspect-[260/320]', fan: 'relative z-0 -rotate-6 translate-x-[14%] translate-y-4 shadow-lg shadow-black/5 animate-fan-left'},
                {file: 2, small: 340, width: 680, height: 840, ratio: 'aspect-[340/420]', fan: 'relative z-10 shadow-xl shadow-black/10 animate-fan-center'},
                {file: 3, small: null, width: 347, height: 427, ratio: 'aspect-[260/320]', fan: 'relative z-0 rotate-6 -translate-x-[14%] translate-y-4 shadow-lg shadow-black/5 animate-fan-right'},
            ] %}
                {# Small 1x version for phones, full size for retina and desktop (photo 3 is already small) #}
                <img src="{{ asset('medias/website/about_hero_' ~ photo.file ~ '.webp') }}"{% if photo.small %} srcset="{{ asset('medias/website/about_hero_' ~ photo.file ~ '-' ~ photo.small ~ '.webp') }} {{ photo.small }}w, {{ asset('medias/website/about_hero_' ~ photo.file ~ '.webp') }} {{ photo.width }}w" sizes="(min-width: 908px) {{ photo.small }}px, {{ photo.file == 2 ? '40vw' : '30vw' }}"{% endif %} alt="{{ ('aboutUs.heroPhotos.' ~ photo.file)|trans }}" width="{{ photo.width }}" height="{{ photo.height }}" loading="eager" class="{{ photo.ratio }} {{ photo.fan }} w-full rounded-xl border-4 border-white bg-[#f7f7f7] object-cover motion-reduce:animate-none sm:rounded-2xl" />
            {% endfor %}
        </div>
    </section>
    {# Mission + Google rating + key figures (same rating card as the service pages) #}
    {# Same block as the "story" section of the service pages: dotted grey card, centered text, rating + award badges #}
    <section class="max-w-7xl mx-auto lg:px-8 px-6 mb-12 lg:mb-16" data-testid="about-mission">
    <div class="relative overflow-hidden rounded-3xl bg-[#f7f7f7] px-6 py-12 sm:px-12 lg:py-16">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#d4d4d4_1px,transparent_1px)] [background-size:18px_18px] opacity-40" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-2xl text-center">
            <p class="font-semibold text-primary font-secondary">{{ 'aboutUs.mission.caption'|trans }}</p>
            <h2 class="mt-3 text-3xl sm:text-4xl font-medium text-black text-balance leading-[1.3]">{{ 'aboutUs.mission.title'|trans }}</h2>
            <p class="mt-6 text-neutral-600 text-balance font-light">{{ 'aboutUs.mission.text'|trans }}</p>
            <dl class="mt-10 flex flex-col items-center gap-6 sm:flex-row sm:items-stretch sm:gap-4">
                {% for stat in ['relocations', 'expertise', 'partners'] %}
                    {% if not loop.first %}
                        <div class="h-px w-24 bg-linear-to-r from-transparent via-neutral-400 to-transparent opacity-30 sm:h-auto sm:w-px sm:self-stretch sm:bg-linear-to-b" aria-hidden="true"></div>
                    {% endif %}
                    <div class="flex flex-1 flex-col-reverse">
                        <dt class="mt-1 text-sm text-[#525252] text-balance">{{ ('aboutUs.mission.stats.' ~ stat ~ '.label')|trans }}</dt>
                        <dd class="text-2xl sm:text-3xl font-semibold text-primary">{{ ('aboutUs.mission.stats.' ~ stat ~ '.value')|trans }}</dd>
                    </div>
                {% endfor %}
            </dl>
            <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
                <a href="https://share.google/oE0GyLX8xNnTNdX84" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 rounded-xl border border-neutral-100 bg-white px-4 py-2.5 shadow-sm transition-colors duration-100 ease-out hover:border-neutral-200">
                    {{ ux_icon('logos:google-icon', {'class': 'size-7 shrink-0', 'aria-hidden': 'true'}) }}
                    <span class="flex flex-col text-left">
                        <span class="flex items-center gap-1.5">
                            <span class="flex items-center -space-x-0.5" aria-hidden="true">
                                {% for i in 1..5 %}{{ ux_icon('material-symbols:star-rounded', {'class': 'size-4 shrink-0 text-yellow-500'}) }}{% endfor %}
                            </span>
                            <span class="text-sm font-semibold text-slate-900">{{ google_rating }}</span>
                        </span>
                        <span class="text-xs text-slate-500 transition-colors duration-100 ease-out group-hover:text-primary">{{ 'aboutUs.mission.reviews'|trans({'%count%': google_reviews_count}) }}</span>
                    </span>
                </a>
                <div class="inline-flex items-center gap-3 rounded-xl border border-neutral-100 bg-white px-4 py-2.5 shadow-sm">
                    <img loading="lazy" src="{{ asset('medias/svg/laurel-left.svg') }}" alt="" aria-hidden="true" width="24" height="43" class="h-10 w-auto shrink-0 rotate-180 -scale-y-100" />
                    <p class="max-w-[10rem] text-center text-sm text-slate-700">{{ 'findAccommodation.story.award'|trans({'%year%': site_award_year})|raw }}</p>
                    <img loading="lazy" src="{{ asset('medias/svg/laurel-right.svg') }}" alt="" aria-hidden="true" width="24" height="43" class="h-10 w-auto shrink-0" />
                </div>
            </div>
        </div>
    </div>
    </section>
    {# Photo, name and languages are facts about the person; role and bio are translated #}
    {% set team = [
        {name: 'Julien L.', photo: 1, languages: ['fr', 'gb']},
        {name: 'Eva B.', photo: 3, languages: ['fr', 'gb']},
        {name: 'Charles M.', photo: 2, languages: ['fr', 'gb', 'es']},
        {name: 'Sophie B.', photo: 4, languages: ['fr', 'gb', 'de']},
        {name: 'Élodie G.', photo: 5, languages: ['fr', 'gb', 'es']},
        {name: 'Jean-Pierre A.', photo: 6, languages: ['fr', 'gb']},
        {name: 'David K.', photo: 7, languages: ['fr', 'gb', 'de']},
        {name: 'Laura P.', photo: 8, languages: ['fr', 'gb']},
    ] %}
    <section class="max-w-5xl mx-auto lg:px-8 px-6 mt-4 mb-12 lg:mb-16">
        {# Desktop: 6 tracks, 2 per card, so an incomplete last row of 2 can start half a card in and sit centered #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-6">
            {% for member in team %}
                {% set centerLastRow = loop.length % 3 == 2 and loop.index == loop.length - 1 %}
                <div class="lg:col-span-2 {{ centerLastRow ? 'lg:col-start-2' }}">
                    <twig:Section:AgentCard
                        name="{{ member.name }}"
                        :photo="member.photo"
                        role="aboutUs.team.{{ member.photo }}.role"
                        bio="aboutUs.team.{{ member.photo }}.bio"
                        :languages="member.languages"
                        :eager="loop.index <= 3"
                    />
                </div>
            {% endfor %}
        </div>
    </section>
    {# Our story: photo + text, then the journey timeline #}
    {# Founding and award years come from the twig.yaml globals, shared with the badges and schema.org #}
    {% set storyYears = {independent: site_experience_since, founded: site_founding_year, corporate: 2024, award: site_award_year} %}
    <section class="max-w-7xl mx-auto px-6 lg:px-8 lg:py-16 py-12" data-testid="about-story">
        <div class="relative overflow-hidden rounded-3xl bg-[#f7f7f7] px-6 py-10 sm:px-10 lg:p-16">
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#d4d4d4_1px,transparent_1px)] [background-size:18px_18px] opacity-40" aria-hidden="true"></div>
            <div class="relative grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
                <img src="{{ asset('medias/website/paris_2_story.webp') }}" srcset="{{ asset('medias/website/paris_2_story-640.webp') }} 640w, {{ asset('medias/website/paris_2_story.webp') }} 1100w" sizes="(min-width: 1024px) 560px, 100vw" alt="{{ 'aboutUs.story.imageAlt'|trans }}" width="1100" height="733" loading="lazy" class="aspect-3/2 w-full rounded-xl border-6 border-white object-cover" />
                <div class="flex flex-col gap-8">
                    <div>
                        <p class="font-semibold text-primary font-secondary">{{ 'aboutUs.story.caption'|trans }}</p>
                        <h2 class="mt-3 text-3xl sm:text-4xl font-medium text-black text-balance leading-[1.3]">{{ 'aboutUs.story.title'|trans }}</h2>
                        <p class="mt-6 text-neutral-600 font-light text-pretty">{{ 'aboutUs.story.text'|trans({'%year%': site_founding_year, '%since%': site_experience_since})|raw }}</p>
                    </div>
                </div>
            </div>

            <div class="relative mt-12 lg:mt-16">
                <h3 class="text-2xl font-medium text-black">{{ 'aboutUs.story.journey.title'|trans }}</h3>
                <ol class="mt-6 grid gap-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
                    {% for step, year in storyYears %}
                        <li class="flex flex-col gap-4">
                            <div class="flex items-center gap-4">
                                <p class="flex items-center gap-2 text-xl font-semibold text-primary">
                                    <span class="size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                                    {{ year }}
                                </p>
                                <span class="h-px flex-1 bg-neutral-300" aria-hidden="true"></span>
                            </div>
                            <div class="flex flex-col gap-1 pl-3.5 pr-3">
                                <p class="text-base font-semibold text-black">{{ ('aboutUs.story.journey.' ~ step ~ '.title')|trans }}</p>
                                <p class="text-sm font-light text-[#525252]">{{ ('aboutUs.story.journey.' ~ step ~ '.text')|trans }}</p>
                            </div>
                        </li>
                    {% endfor %}
                </ol>
            </div>
        </div>
    </section>
    <twig:Section:SolutionGrid
        keyPrefix="aboutUs.ourValues"
        :icons="['material-symbols:workspace-premium-outline-rounded', 'icon-park-outline:eyes', 'ri:diamond-line']"
        :withText="true"
        align="start"
    />
    <twig:Section:CtaFooter />
{% endblock %}
