{% extends 'public/base.html.twig' %}

{% set pageLabel = currentPage > 1 ? 'blog.pagination.pageSuffix'|trans({'%page%': currentPage}) : '' %}
{# Must mirror the query string of the canonical URL (block url) #}
{% set hreflangQuery = currentPage > 1 ? {page: currentPage} : {} %}

{% block title %}{{ 'meta.blog.title'|trans }}{{ pageLabel }}{% endblock %}
{% set metaDescription = guidesCount ? 'meta.blog.withCount.description'|trans({'%count%': guidesCount}) : 'meta.blog.description'|trans %}
{% block description %}{{ metaDescription }}{{ pageLabel }}{% endblock %}
{% block url %}{{ path('app_blog') }}{% if currentPage > 1 %}?page={{ currentPage }}{% endif %}{% endblock %}

{% block schema_page %}
    ,{
        "@type": "CollectionPage",
        "@id": "{{ site_url }}{{ path('app_blog') }}/#bloglist",
        "url": "{{ site_url }}{{ path('app_blog') }}{% if currentPage > 1 %}?page={{ currentPage }}{% endif %}",
        "name": "{{ 'meta.blog.title'|trans|e('js') }}",
        "description": "{{ metaDescription|e('js') }}",
        "inLanguage": "{{ app.request.locale == 'fr' ? 'fr-FR' : 'en-GB' }}",
        "isPartOf": { "@id": "{{ site_url }}/#website" },
        "about": { "@id": "{{ site_url }}/#organization" },
        "numberOfItems": {{ totalArticles }}
    }
    ,{
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "{{ 'blog.show.breadcrumb.home'|trans|e('js') }}",
                "item": "{{ site_url }}/{{ app.request.locale }}"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ 'blog.show.breadcrumb.blog'|trans|e('js') }}"
            }
        ]
    }
{% endblock %}

{% block body %}
    <section class="max-w-7xl mx-auto lg:px-8 px-6 lg:py-16 py-12">
        <twig:Section:PageHeader
            caption="blog.list.title"
            subtitle="blog.list.subTitle"
            :intro="guidesCount ? 'blog.list.textWithCount' : 'blog.list.text'"
            :introParams="{'%count%': guidesCount}"
            captionClass="capitalize"
        />
    </section>
    <section class="max-w-6xl mx-auto lg:px-8 px-6 mt-4 mb-12 lg:mb-16">
        {% if hero %}
            {% set heroDate = hero.publishedAt is defined and hero.publishedAt ? hero.publishedAt : hero._createdAt %}
                <a href="{{ path('app_blog_show', {'slug': hero.slug}) }}" class="bg-linear-to-b from-[#FFE5EB] group to-[#FFF7F9] border border-primary/20 p-2 rounded-3xl hover:border-primary/40 transition duration-100 block">
                    <div class="pb-2">
                        <p class="text-sm text-primary uppercase tracking-normal font-semibold text-center">
                            {{ 'blog.list.lastArticle'|trans|raw }}
                        </p>
                    </div>
                    <div class="rounded-2xl bg-white grid grid-cols-1 lg:grid-cols-5 lg:gap-4">
                        <div class="col-span-2 flex flex-col justify-between space-y-6 p-6 lg:order-1 order-2">
                            <div class="space-y-2">
                                <div class="flex min-[359px]:items-center min-[359px]:flex-row flex-col gap-x-2 text-sm text-neutral-600">
                                    {% if hero.authors is defined and hero.authors|length > 0 %}
                                        <div class="flex items-center gap-x-2">
                                            {% if hero.authors[0].photo %}
                                                <img src="{{ hero.authors[0].photo }}?w=48&h=48&fit=crop&auto=format&fm=webp&q=70" alt="{{ hero.authors[0].fullName }}" loading="lazy" width="24" height="24" class="size-6 rounded-full object-cover"/>
                                            {% endif %}
                                            <p class="truncate">{{ hero.authors[0].fullName }}</p>
                                        </div>
                                        <svg width="4" height="4" viewBox="0 0 4 4" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0 min-[359px]:block hidden">
                                            <circle cx="2" cy="2" r="2" fill="#525252"/>
                                        </svg>
                                    {% endif %}
                                    <div class="min-[359px]:mt-0 mt-2">
                                        <time class="truncate" datetime="{{ heroDate|date('c') }}">{{ heroDate|date('d F Y')|format_date(locale=app.request.locale) }}</time>
                                    </div>
                                </div>
                                <h2 class="mt-4 lg:mt-8 font-semibold text-xl lg:text-3xl text-pretty">{{ hero.title }}</h2>
                                {% if hero.shortDescription %}
                                    <p class="text-neutral-600 font-light">{{ hero.shortDescription|u.truncate(120, '...') }}</p>
                                {% endif %}
                            </div>
                            <div class="pt-5 mt-auto">
                                <span class="font-medium text-primary flex items-center gap-x-2.5 transition duration-100 group-hover:text-primary/70">
                                    {{ 'blog.list.readArticle'|trans }}
                                    {{ ux_icon('streamline-ultimate:arrow-right', {'class': 'size-3 shrink-0'}) }}
                                </span>
                            </div>
                        </div>
                        <div class="col-span-3 lg:order-2 order-1 p-2 relative">
                            {% if hero.mainPhoto %}
                                <img loading="eager" src="{{ hero.mainPhoto }}?w=1200&h=900&fit=crop&auto=format&fm=webp&q=80" srcset="{{ hero.mainPhoto }}?w=600&h=450&fit=crop&auto=format&fm=webp&q=80 600w, {{ hero.mainPhoto }}?w=1200&h=900&fit=crop&auto=format&fm=webp&q=80 1200w, {{ hero.mainPhoto }}?w=1800&h=1350&fit=crop&auto=format&fm=webp&q=80 1800w" sizes="(max-width: 1024px) 100vw, 66vw" alt="{{ hero.mainPhotoAlt }}" width="1200" height="900" class="w-full h-[200px] lg:h-[450px] rounded-xl object-cover">
                            {% endif %}
                            {% if hero.category is defined and hero.category %}
                                <div class="absolute top-5 left-5">
                                    <twig:Badge variant="secondary" class="gap-x-1.5">
                                        <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
                                            <circle cx="4" cy="4" r="3" fill="{{ hero.category.color|e('html_attr') }}"/>
                                        </svg>
                                        {{ hero.category.name }}
                                    </twig:Badge>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </a>
        {% endif %}

        <turbo-frame id="blog-list" data-turbo-action="advance" autoscroll data-autoscroll-block="start">
            <section class="py-7 lg:py-12">
                <twig:Blog:CategoryTabs
                    :categories="categories"
                    :activeCategory="activeCategory"
                    :total="totalArticles"
                    route="app_blog"
                />
            </section>
            <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for blog in posts %}
                    <twig:Blog:PostCard :post="blog" />
                {% endfor %}
            </section>

            <twig:Pagination
                :currentPage="currentPage"
                :totalPages="totalPages"
                route="app_blog"
                :routeParams="activeCategory ? {category: activeCategory} : {}"
            />
        </turbo-frame>

    </section>
    <twig:Section:CtaFooter />
{% endblock %}
