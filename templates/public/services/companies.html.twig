{% extends 'public/base.html.twig' %}

{% block title %}{{ 'meta.companies.title'|trans }}{% endblock %}
{% block description %}{{ 'meta.companies.description'|trans }}{% endblock %}
{% block url %}{{ path('app_service_companies') }}{% endblock %}
{# Page-specific share image, 1200x630 like the default banner #}
{% block og_image %}{{ asset('medias/website/companies-og.webp') }}{% endblock %}

{% block schema_page %}
    {% include '_partials/schema/service.html.twig' with {
        routeName: 'app_service_companies',
        metaPrefix: 'companies',
        image: 'medias/website/companies-why-3.webp',
        serviceType: 'Corporate relocation',
        audience: 'BusinessAudience',
    } only %}
    {% include '_partials/schema/breadcrumb.html.twig' with {
        items: [
            {name: 'sitemap.menu.home'|trans, url: site_url ~ path('app_home')},
            {name: 'sitemap.menu.companies'|trans, url: site_url ~ path('app_service_companies')},
        ],
    } only %}
{% endblock %}

{% block body %}
    {# Header: the app's standard page header, one call to action, one quiet line of proof #}
    <section class="max-w-7xl mx-auto px-6 lg:px-8 py-12 lg:py-16" data-testid="companies-hero">
        <twig:Section:PageHeader caption="companies.hero.caption" subtitle="companies.hero.title" intro="companies.hero.text" />
        <div class="mt-8 flex flex-col items-center gap-4">
            <twig:Button variant="default" as="a" size="lg" href="{{ path('app_contact') }}">
                {{ 'companies.cta.button'|trans|raw }}
                {{ ux_icon('lucide:arrow-right', {'class': 'size-4 shrink-0'}) }}
            </twig:Button>
            <div class="flex items-center gap-2 text-sm text-neutral-600">
                {{ ux_icon('material-symbols:star-rounded', {'class': 'size-4 shrink-0 text-yellow-500', 'aria-hidden': 'true'}) }}
                {# The Google logo stands for the "G" of "Google" (same as the stats below); screen readers read "Google" #}
                {% set googleWord %}<span aria-hidden="true">{{ ux_icon('devicon:google', {'class': 'inline-block size-[0.9em] align-[-0.1em]'}) }}oogle</span><span class="sr-only">Google</span>{% endset %}
                <p>{{ 'companies.hero.rating'|trans({'%rating%': google_rating, '%count%': google_reviews_count, '%google%': googleWord})|raw }}</p>
            </div>
        </div>
    </section>

    {# Why: title + stats, then the four benefits for the company (time, attractiveness, market access, security) #}
    <section class="max-w-7xl mx-auto px-6 lg:px-8 py-12 lg:py-16" data-testid="companies-why">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:gap-16 mb-10 lg:mb-14">
            <div class="lg:flex-1">
                <p class="font-semibold text-primary font-secondary">{{ 'companies.why.caption'|trans|raw }}</p>
                <h2 class="mt-2 text-3xl sm:text-4xl font-medium text-black text-balance leading-[1.3]">{{ 'companies.why.title'|trans|raw }}</h2>
            </div>
            <div class="flex items-stretch gap-4 lg:w-[560px]">
                <div class="flex-1">
                    <p class="text-2xl sm:text-3xl font-semibold text-primary">+900</p>
                    <p class="mt-1 text-sm text-[#525252] text-balance">{{ 'companies.why.stats.relocations'|trans|raw }}</p>
                </div>
                <div class="w-px self-stretch bg-linear-to-b from-transparent via-neutral-400 to-transparent opacity-30" aria-hidden="true"></div>
                <div class="flex-1">
                    <p class="text-2xl sm:text-3xl font-semibold text-primary">+80</p>
                    <p class="mt-1 text-sm text-[#525252] text-balance">{{ 'companies.why.stats.partners'|trans|raw }}</p>
                </div>
                <div class="hidden sm:block w-px self-stretch bg-linear-to-b from-transparent via-neutral-400 to-transparent opacity-30" aria-hidden="true"></div>
                <div class="hidden sm:block flex-1">
                    <div class="flex items-center gap-1.5">
                        {{ ux_icon('material-symbols:star-rounded', {'class': 'size-6 text-yellow-500 shrink-0'}) }}
                        <p class="text-2xl sm:text-3xl font-semibold text-primary">{{ google_rating }}</p>
                    </div>
                    {% set googleWord %}<span aria-hidden="true">{{ ux_icon('devicon:google', {'class': 'inline-block size-[0.9em] align-[-0.1em]'}) }}oogle</span><span class="sr-only">Google</span>{% endset %}
                    <p class="mt-1 text-sm text-[#525252]">{{ 'companies.why.stats.reviews'|trans({'%count%': google_reviews_count, '%google%': googleWord})|raw }}</p>
                </div>
            </div>
        </div>

        {# Benefits on photo cards, autoplay slider (finger, mouse, buttons): same block as "Trouver un logement" #}
        {# One photo per benefit: HR team, accepted offer, quality home, settled employee (1280 px original + 640 px for phones) #}
        {% set images = [{src: 'medias/website/companies-why-1.webp', position: 'object-center'}, {src: 'medias/website/companies-why-2.webp', position: 'object-top'}, {src: 'medias/website/companies-why-3.webp', position: 'object-center'}, {src: 'medias/website/companies-why-4.webp', position: 'object-center'}] %}
        <div
            data-controller="slider"
            data-slider-autoplay-value="true"
            data-slider-autoplay-delay-value="3000"
            data-action="mouseenter->slider#pause mouseleave->slider#resume"
        >
            <div class="overflow-hidden -mx-6 px-6 md:mx-0 md:px-0">
                <div data-slider-target="track" class="flex gap-4 md:gap-6 cursor-grab touch-pan-y">
                    {% for img in images %}
                        <div class="w-[85%] sm:w-[calc(50%-8px)] md:w-[calc(50%-12px)] shrink-0 rounded-2xl border border-neutral-200 p-2">
                            <div class="group relative overflow-hidden rounded-xl">
                                <img src="{{ asset(img.src|replace({'.webp': '-640.webp'})) }}" srcset="{{ asset(img.src|replace({'.webp': '-640.webp'})) }} 640w, {{ asset(img.src) }} 1280w" sizes="(min-width: 768px) 50vw, 85vw" alt="" aria-hidden="true" draggable="false" width="640" height="480" loading="lazy" class="w-full aspect-[3/4] sm:aspect-[4/3] object-cover {{ img.position }} transition-transform duration-700 ease-out group-hover:scale-105" />
                                <div class="absolute inset-0 bg-linear-to-t from-black/80 from-10% via-black/40 to-black/5" aria-hidden="true"></div>
                                <div class="absolute inset-0 flex flex-col p-5">
                                    <div class="mt-auto flex flex-col gap-2.5">
                                        <div class="h-px w-10 bg-linear-to-r from-white/70 to-transparent" aria-hidden="true"></div>
                                        <h3 class="text-xl sm:text-2xl font-semibold text-white text-balance leading-snug">{{ ('companies.why.' ~ loop.index ~ '.title')|trans|raw }}</h3>
                                        <p class="text-sm font-light text-white/90 text-pretty">{{ ('companies.why.' ~ loop.index ~ '.text')|trans|raw }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="mt-6 flex justify-start gap-3">
                <button type="button" data-slider-target="prev" data-action="click->slider#prev" aria-label="{{ 'a11y.previous'|trans }}" class="size-11 rounded-full border border-neutral-200 flex items-center justify-center outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-all duration-200 hover:bg-primary hover:text-white hover:border-primary opacity-30 cursor-not-allowed pointer-events-none">
                    {{ ux_icon('lucide:arrow-left', {'class': 'size-4 shrink-0'}) }}
                </button>
                <button type="button" data-slider-target="next" data-action="click->slider#next" aria-label="{{ 'a11y.next'|trans }}" class="size-11 rounded-full border border-neutral-200 flex items-center justify-center outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 transition-all duration-200 hover:bg-primary hover:text-white hover:border-primary">
                    {{ ux_icon('lucide:arrow-right', {'class': 'size-4 shrink-0'}) }}
                </button>
            </div>
        </div>
    </section>

    <twig:Section:SolutionGrid
        keyPrefix="companies.service"
        :icons="['lucide:search', 'lucide:messages-square', 'lucide:file-check', 'lucide:key-round', 'lucide:video', 'lucide:map']"
        :withText="true"
        container="max-w-7xl"
    />

    <section class="max-w-7xl mx-auto lg:px-8 px-6 lg:py-16 py-12">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:gap-12 mb-10 lg:mb-16">
            <div class="lg:w-[55%]">
                <p class="font-semibold text-primary font-secondary">{{ 'companies.process.caption'|trans|raw }}</p>
                <h2 class="mt-2 text-3xl sm:text-4xl font-medium text-black leading-[1.3] text-balance">{{ 'companies.process.title'|trans|raw }}</h2>
            </div>
            <p class="text-lg font-light text-[#525252] lg:flex-1 lg:pb-1">{{ 'companies.process.text'|trans|raw }}</p>
        </div>

        <div class="mx-auto max-w-5xl rounded-[28px] border border-neutral-200 p-2">
            <div class="rounded-3xl bg-linear-to-b from-[#f7f7f7] to-[#f7f7f7]/0 px-3 py-8 sm:px-10 sm:py-10 lg:px-16 lg:py-14">
                <div class="text-center mb-10 lg:mb-14">
                    <p class="font-semibold text-primary font-secondary">{{ 'companies.process.eyebrow'|trans|raw }}</p>
                    <h3 class="mt-2 text-3xl sm:text-4xl font-medium text-black leading-[1.3] text-balance">{{ 'companies.process.subTitle'|trans|raw }}</h3>
                </div>

                {% set prefix = 'companies.process.steps.' %}
                {% set steps = [
                    { icon: 'lucide:messages-square', chips: [] },
                    { icon: 'lucide:compass', chips: [{ icon: 'lucide:sparkles', key: 'chips.1' }, { icon: 'lucide:armchair', key: 'chips.2' }] },
                    { icon: 'lucide:video', chips: [] },
                    { icon: 'lucide:clipboard-pen-line', chips: [] },
                    { icon: 'lucide:key-round', chips: [] },
                ] %}

                <div data-controller="process-stepper" class="mx-auto max-w-3xl">
                    <div class="relative space-y-6 lg:space-y-8">
                        <div class="absolute left-[17px] sm:left-[21px] lg:left-[25px] top-6 bottom-6 w-px bg-neutral-200" aria-hidden="true">
                            <div data-process-stepper-target="progressBar" class="absolute inset-x-0 top-0 bg-primary transition-all duration-500 ease-out" style="height: 0%;"></div>
                        </div>

                        {% for step in steps %}
                            {% set stepNum = loop.index %}
                            <div data-process-stepper-target="step" class="relative flex items-start gap-3 sm:gap-4 lg:gap-6">
                                <span
                                    data-process-stepper-target="circle"
                                    class="relative z-10 flex size-9 sm:size-11 lg:size-13 shrink-0 items-center justify-center rounded-full bg-neutral-200 text-black text-base sm:text-lg lg:text-xl font-semibold transition-all duration-300"
                                >{{ stepNum }}</span>
                                <div
                                    data-process-stepper-target="card"
                                    class="min-w-0 flex-1 rounded-2xl border border-transparent bg-white p-4 sm:p-5 lg:p-6 shadow-[0_2px_15px_rgba(0,0,0,0.05)] transition-all duration-300"
                                >
                                    <div class="flex items-center gap-2.5">
                                        {{ ux_icon(step.icon, {'class': 'size-5 text-primary shrink-0'}) }}
                                        <h4 class="text-base lg:text-lg font-medium text-black text-pretty">{{ (prefix ~ stepNum ~ '.title')|trans|raw }}</h4>
                                    </div>
                                    <div class="my-3 h-px w-full bg-linear-to-r from-transparent via-neutral-300 to-transparent"></div>
                                    <p class="text-sm lg:text-base font-light text-[#525252]">{{ (prefix ~ stepNum ~ '.description')|trans|raw }}</p>
                                    {% if step.chips is not empty %}
                                        <div class="mt-4 flex flex-wrap gap-2">
                                            {% for chip in step.chips %}
                                                <span class="inline-flex items-center gap-1.5 rounded-md bg-primary/5 px-2 py-1 text-sm text-gray-900">
                                                    {{ ux_icon(chip.icon, {'class': 'size-3.5 text-primary shrink-0'}) }}
                                                    {{ (prefix ~ stepNum ~ '.' ~ chip.key)|trans|raw }}
                                                </span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="mt-10 lg:mt-14 flex justify-center">
                    <twig:Button variant="default" as="a" size="lg" href="{{ path('app_contact') }}">
                        <img loading="lazy" src="{{ asset('medias/team/thumb/team_2.webp') }}" alt="" aria-hidden="true" width="20" height="20" class="size-5 rounded-full object-cover" />
                        {{ 'companies.cta.button'|trans|raw }}
                    </twig:Button>
                </div>
            </div>
        </div>
    </section>

    {# Use cases: the mobility situations HR teams search for (transfer, hiring, short assignment, families).
       Same cards as Section:SolutionGrid; title left + intro right, like the process block #}
    <section class="max-w-7xl mx-auto px-6 lg:px-8 lg:py-16 py-12" data-testid="companies-use-cases">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:gap-12 mb-10 lg:mb-16">
            <div class="lg:w-[55%]">
                <p class="font-semibold text-primary font-secondary">{{ 'companies.useCases.caption'|trans|raw }}</p>
                <h2 class="mt-2 text-3xl sm:text-4xl font-medium text-black leading-[1.3] text-balance">{{ 'companies.useCases.title'|trans|raw }}</h2>
            </div>
            <p class="text-lg font-light text-[#525252] lg:flex-1 lg:pb-1">{{ 'companies.useCases.text'|trans|raw }}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            {% for icon in ['lucide:plane-landing', 'lucide:briefcase-business', 'lucide:calendar-range', 'lucide:house-heart'] %}
                <div class="group rounded-2xl p-2 border border-neutral-200" data-testid="companies-use-case">
                    <div class="flex h-full flex-col items-start gap-4 rounded-xl p-5 bg-linear-to-b from-neutral-100 to-neutral-100/0 transition-colors duration-100 ease-out group-hover:from-primary group-hover:to-primary">
                        <div class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-white p-2.5">
                            {{ ux_icon(icon, {'class': 'size-6 text-primary shrink-0', 'aria-hidden': 'true'}) }}
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <h3 class="text-lg font-medium text-pretty text-black transition-colors duration-100 ease-out group-hover:text-white">{{ ('companies.useCases.' ~ loop.index ~ '.title')|trans|raw }}</h3>
                            <p class="text-sm font-light text-[#525252] transition-colors duration-100 ease-out group-hover:text-white/90">{{ ('companies.useCases.' ~ loop.index ~ '.text')|trans|raw }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    {# HR follow-up + trust signals (Google rating, award) #}
    <section class="max-w-7xl mx-auto px-6 lg:px-8 lg:py-16 py-12">
        <div class="relative overflow-hidden rounded-3xl bg-[#f7f7f7] px-6 py-12 sm:px-12 lg:py-16">
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#d4d4d4_1px,transparent_1px)] [background-size:18px_18px] opacity-40" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-2xl text-center">
                <p class="font-semibold text-primary font-secondary">{{ 'companies.reporting.caption'|trans|raw }}</p>
                <h2 class="mt-3 text-3xl sm:text-4xl font-medium text-black text-balance leading-[1.3]">{{ 'companies.reporting.title'|trans|raw }}</h2>
                <p class="mt-6 text-neutral-600 text-balance font-light">{{ 'companies.reporting.text'|trans({'%year%': site_experience_since})|raw }}</p>
                <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
                    <div class="inline-flex items-center gap-3 rounded-xl border border-neutral-100 bg-white px-4 py-2.5 shadow-sm">
                        {{ ux_icon('logos:google-icon', {'class': 'size-7 shrink-0'}) }}
                        <div class="text-left">
                            <div class="flex items-center gap-1.5">
                                <div class="flex items-center -space-x-0.5">
                                    {% for i in 1..5 %}{{ ux_icon('material-symbols:star-rounded', {'class': 'size-4 text-yellow-500 shrink-0'}) }}{% endfor %}
                                </div>
                                <span class="text-sm font-semibold text-slate-900">{{ google_rating }}</span>
                            </div>
                            <p class="text-xs text-slate-500">{{ 'propertyManagement.hero.rating.label'|trans }} +{{ google_reviews_count }} {{ 'propertyManagement.hero.rating.reviews'|trans }}</p>
                        </div>
                    </div>
                    <div class="inline-flex items-center gap-3 rounded-xl border border-neutral-100 bg-white px-4 py-2.5 shadow-sm">
                        <img loading="lazy" src="{{ asset('medias/svg/laurel-left.svg') }}" alt="" aria-hidden="true" width="24" height="43" class="h-10 w-auto shrink-0 rotate-180 -scale-y-100" />
                        <p class="max-w-[10rem] text-center text-sm text-slate-700">{{ 'findAccommodation.story.award'|trans({'%year%': site_award_year})|raw }}</p>
                        <img loading="lazy" src="{{ asset('medias/svg/laurel-right.svg') }}" alt="" aria-hidden="true" width="24" height="43" class="h-10 w-auto shrink-0" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <twig:Section:ClientLogos caption="companies.logos.title" />

    <section class="max-w-2xl mx-auto lg:max-w-7xl px-6 lg:px-8 lg:py-16 py-12">
        <div class="lg:grid lg:grid-cols-12 lg:gap-8">
            <div class="lg:col-span-5">
                <div class="space-y-3 max-w-md">
                    <p class="font-semibold text-primary font-secondary">{{ 'companies.faq.title'|trans|raw }}</p>
                    <h2 class="text-pretty text-3xl font-semibold font-secondary tracking-tight text-gray-900 sm:text-4xl">{{ 'companies.faq.subTitle'|trans|raw }}</h2>
                    <p class="text-neutral-600">{{ 'home.faq.text'|trans({'%url%': path('app_faq')})|raw }}</p>
                </div>
            </div>
            <div class="mt-10 lg:col-span-7 lg:mt-0">
                {# The five questions an HR team asks before committing: full scope of the package, cost, timing, remote, follow-up #}
                <twig:Section:FaqAccordion keyPrefix="companies.faq.question" :keys="[1, 9, 4, 7, 5]" />
            </div>
        </div>
    </section>

    <twig:Section:CtaFooter />
{% endblock %}
