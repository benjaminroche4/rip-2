{% extends 'public/base.html.twig' %}

{% block title %}{{ 'meta.home.title'|trans }}{% endblock %}
{% block description %}{{ 'meta.home.description'|trans }}{% endblock %}
{% block url %}{{ path('app_home') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preload" as="image" href="{{ asset('medias/videos/home-hero-poster.webp') }}" fetchpriority="high">
{% endblock %}

{% set isFr = app.request.locale == 'fr' %}

{% block schema_page %}
    ,{
        "@type": "WebPage",
        "@id": "{{ site_url }}/{{ app.request.locale }}/#homepage",
        "url": "{{ site_url }}/{{ app.request.locale }}",
        "name": "{{ 'meta.home.title'|trans|e('js') }}",
        "description": "{{ 'meta.home.description'|trans|e('js') }}",
        "inLanguage": "{{ app.request.locale == 'fr' ? 'fr-FR' : 'en-GB' }}",
        "isPartOf": { "@id": "{{ site_url }}/#website" },
        "about": { "@id": "{{ site_url }}/#organization" },
        "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": "{{ site_url }}/medias/banner/relocation-in-paris-banner.webp"
        },
        "video": { "@id": "{{ site_url }}/{{ app.request.locale }}/#hero-video" }
    },
    {
        "@type": "VideoObject",
        "@id": "{{ site_url }}/{{ app.request.locale }}/#hero-video",
        "name": "{{ 'home.heroSection.video.label'|trans|e('js') }}",
        "description": "{{ 'home.heroSection.video.description'|trans|e('js') }}",
        "inLanguage": "{{ app.request.locale == 'fr' ? 'fr-FR' : 'en-GB' }}",
        "thumbnailUrl": "{{ site_url }}{{ asset('medias/videos/home-hero-poster.webp') }}",
        "contentUrl": "{{ site_url }}{{ asset('medias/videos/home-hero-' ~ app.request.locale ~ '.mp4') }}",
        "uploadDate": "2026-09-15",
        "duration": "PT1M15S",
        "publisher": { "@id": "{{ site_url }}/#organization" }
    }
{% endblock %}

{% block body %}
    <section class="max-w-7xl mx-auto lg:px-8 py-8 lg:py-12 px-6">
        <div class="flex justify-center flex-col items-center space-y-10">
            <div class="flex flex-col  justify-center items-center">
                <div class="flex items-center justify-center space-x-3 pb-10 lg:justify-start" aria-hidden="true">
