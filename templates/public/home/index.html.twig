                        <path d="M16.016 15.6551C13.6008 13.0216 10.367 11.2564 8.49628 10.4998C8.17691 10.3706 7.842 10.6146 7.85404 10.9589C7.91818 12.792 8.20471 16.2653 9.78184 19.7605C11.5846 23.7558 15.3041 26.6949 17.7419 24.7813C19.8836 23.1001 19.2883 19.2232 16.016 15.6551Z" fill="url(#g2)" />
                        <path d="M12.4043 26.6068C9.38973 24.6881 5.80926 23.8201 3.80649 23.5734C3.46457 23.5313 3.20421 23.8536 3.30495 24.183C3.84136 25.9371 5.01709 29.2179 7.44509 32.1858C10.2205 35.5784 14.5739 37.4546 16.4334 34.9753C18.067 32.7971 16.4886 29.2063 12.4043 26.6068Z" fill="url(#g3)" />
