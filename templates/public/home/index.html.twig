                                <stop stop-color="#FDF193"/><stop offset="1" stop-color="#FF8554"/>
                            </linearGradient>
                            <linearGradient id="g2" x1="7.75754" y1="10.3005" x2="17.3092" y2="25.066" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#FFEF79"/><stop offset="1" stop-color="#FF743D"/>
                            </linearGradient>
                            <linearGradient id="g3" x1="3.04135" y1="23.5721" x2="16.0891" y2="35.3623" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#FFEB56"/><stop offset="1" stop-color="#FA692F"/>
                            </linearGradient>
                            <linearGradient id="g4" x1="11.3851" y1="40.5265" x2="28.0701" y2="46.0821" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#FFE940"/><stop offset="1" stop-color="#FA692F"/>
                            </linearGradient>
                        </defs>
                    </svg>
                    <div class="flex flex-col text-center text-sm font-medium text-gray-600">
                        <p>{{ 'home.heroSection.top.1'|trans|raw }}</p>
                        <p>{{ 'home.heroSection.top.2'|trans|raw }}</p>
                    </div>
                    <svg viewBox="0 0 30 50" xmlns="http://www.w3.org/2000/svg" class="size-9">
                        <path d="M4.46397 8.76642C5.23886 5.27811 7.15683 2.13254 8.39858 0.541938C8.61058 0.270387 9.02259 0.314194 9.18431 0.618383C10.0453 2.23801 11.5338 5.38925 11.9156 9.20474C12.352 13.5662 10.6004 17.9712 7.53238 17.5328C4.83705 17.1478 3.41409 13.4926 4.46397 8.76642Z" fill="url(#g1b)" />
                        <path d="M13.984 15.6551C16.3992 13.0216 19.633 11.2564 21.5037 10.4998C21.8231 10.3706 22.158 10.6146 22.146 10.9589C22.0818 12.792 21.7953 16.2653 20.2182 19.7605C18.4154 23.7558 14.6959 26.6949 12.2581 24.7813C10.1164 23.1001 10.7117 19.2232 13.984 15.6551Z" fill="url(#g2b)" />
                        <path d="M17.5957 26.6068C20.6103 24.6881 24.1907 23.8201 26.1935 23.5734C26.5354 23.5313 26.7958 23.8536 26.695 24.183C26.1586 25.9371 24.9829 29.2179 22.5549 32.1858C19.7795 35.5784 15.4261 37.4546 13.5666 34.9753C11.933 32.7971 13.5114 29.2063 17.5957 26.6068Z" fill="url(#g3b)" />
                        <path d="M8.82157 39.5443C12.3529 38.9983 15.9805 39.6417 17.9137 40.2203C18.2437 40.3191 18.3527 40.7189 18.1281 40.9801C16.9322 42.3709 14.5375 44.9031 11.1218 46.6456C7.21732 48.6375 2.47695 48.6068 1.77011 45.5893C1.14913 42.9384 4.03702 40.2842 8.82157 39.5443Z" fill="url(#g4b)" />
                        <defs>
                            <linearGradient id="g1b" x1="8.93872" y1="0" x2="8.04949" y2="17.5631"><stop stop-color="#FDF193"/><stop offset="1" stop-color="#FF8554"/></linearGradient>
                            <linearGradient id="g2b" x1="22.2425" y1="10.3005" x2="12.6908" y2="25.066"><stop stop-color="#FFEF79"/><stop offset="1" stop-color="#FF743D"/></linearGradient>
                            <linearGradient id="g3b" x1="26.9587" y1="23.5721" x2="13.9109" y2="35.3623"><stop stop-color="#FFEB56"/><stop offset="1" stop-color="#FA692F"/></linearGradient>
                            <linearGradient id="g4b" x1="18.6149" y1="40.5265" x2="1.92991" y2="46.0821"><stop stop-color="#FFE940"/><stop offset="1" stop-color="#FA692F"/></linearGradient>
                        </defs>
                    </svg>
                </div>
                <h1 class="mx-auto max-w-2xl text-center max-[280px]:text-3xl text-4xl lg:text-5xl font-medium tracking-wide text-gray-900 lg:text-6xl/16 text-balance">
                    {{ 'home.heroSection.title'|trans|raw }}
                </h1>
                <p class="mx-auto mt-5 max-w-lg text-center font-light text-slate-800 lg:mx-0 text-pretty">
                    {{ 'home.heroSection.subTitle'|trans|raw }}
                </p>
                <div class="shimmer-border shimmer-border-soft mt-8 w-full max-w-3xl lg:max-w-4xl mx-auto rounded-2xl border border-neutral-200 bg-white p-2">
                    <div
                        data-controller="hero-video"
                        data-playing="true"
                        data-hero-video-play-label-value="{{ 'home.heroSection.video.play'|trans }}"
                        data-hero-video-pause-label-value="{{ 'home.heroSection.video.pause'|trans }}"
                        data-hero-video-sound-on-label-value="{{ 'home.heroSection.video.soundOn'|trans }}"
                        data-hero-video-sound-off-label-value="{{ 'home.heroSection.video.soundOff'|trans }}"
                        class="group/video relative rounded-xl overflow-hidden bg-neutral-100"
                    >
                        <video
                            data-hero-video-target="video"
                            data-action="click->hero-video#togglePlay play->hero-video#syncPlay pause->hero-video#syncPlay"
                            class="w-full aspect-video object-cover cursor-pointer"
                            tabindex="-1"
                            width="1280"
                            height="720"
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            poster="{{ asset('medias/videos/home-hero-poster.webp') }}"
                            aria-label="{{ 'home.heroSection.video.label'|trans }}"
                        >
                            <source src="{{ asset('medias/videos/home-hero-' ~ app.request.locale ~ '.webm') }}" type="video/webm">
                            <source src="{{ asset('medias/videos/home-hero-' ~ app.request.locale ~ '.mp4') }}" type="video/mp4">
                        </video>
                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                            <button
                                type="button"
                                data-action="hero-video#togglePlay"
                                class="liquid-glass shimmer-border shimmer-border-soft flex size-16 md:size-20 items-center justify-center rounded-full text-gray-900 opacity-0 scale-90 pointer-events-none transition-[opacity,scale,background-color,box-shadow] duration-200 ease-out group-data-[playing=false]/video:opacity-100 group-data-[playing=false]/video:scale-100 group-data-[playing=false]/video:pointer-events-auto focus-visible:opacity-100 focus-visible:scale-100 focus-visible:pointer-events-auto hover:bg-white/60 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
                                data-hero-video-target="playButton"
                                aria-label="{{ 'home.heroSection.video.play'|trans }}"
                            >
                                {{ ux_icon('iconoir:play-solid', {'class': 'size-7 md:size-8 translate-x-0.5'}) }}
                            </button>
                        </div>
                        <div class="absolute top-3 right-3 flex items-center gap-2">
                            <button
                                type="button"
                                data-action="hero-video#toggleFullscreen"
                                class="liquid-glass shimmer-border shimmer-border-soft flex size-9 items-center justify-center rounded-full text-gray-900 transition-[transform,background-color,box-shadow] duration-200 ease-out hover:scale-105 hover:bg-white/60 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer group/fs"
                                aria-label="{{ 'home.heroSection.video.fullscreen'|trans }}"
                            >
                                <span data-hero-video-target="enterFullscreen" class="flex transition-transform duration-200 ease-out group-hover/fs:scale-110">{{ ux_icon('lucide:maximize', {'class': 'size-4'}) }}</span>
                                <span data-hero-video-target="exitFullscreen" class="flex hidden transition-transform duration-200 ease-out group-hover/fs:scale-90">{{ ux_icon('lucide:minimize', {'class': 'size-4'}) }}</span>
                            </button>
                            <button
                                type="button"
                                data-action="hero-video#toggleSound"
                                data-hero-video-target="soundButton"
                                aria-pressed="false"
                                aria-label="{{ 'home.heroSection.video.soundOn'|trans }}"
                                class="liquid-glass shimmer-border shimmer-border-soft motion-safe:animate-float flex h-11 items-center gap-2 rounded-full px-3 sm:pl-3 sm:pr-4 text-sm font-medium text-gray-900 transition-[transform,background-color,box-shadow] duration-200 ease-out hover:scale-105 hover:bg-white/60 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer group/sound"
                            >
                                <span data-hero-video-target="soundOff" class="flex items-center gap-2">
                                    <span class="flex transition-transform duration-200 ease-out group-hover/sound:scale-110 motion-safe:animate-pulse">{{ ux_icon('iconoir:sound-off', {'class': 'size-5'}) }}</span>
                                    <span class="hidden sm:inline" aria-hidden="true">{{ 'home.heroSection.video.soundOn'|trans }}</span>
                                </span>
                                <span data-hero-video-target="soundOn" class="flex hidden items-center gap-2">
                                    <span class="flex transition-transform duration-200 ease-out group-hover/sound:scale-110 motion-safe:animate-pulse">{{ ux_icon('iconoir:sound-high', {'class': 'size-5'}) }}</span>
                                    <span class="hidden sm:inline" aria-hidden="true">{{ 'home.heroSection.video.soundOff'|trans }}</span>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="mt-7 lg:mt-10 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-6">
                    <twig:Button variant="default" as="a" size="lg" href="{{ path('app_contact') }}" class="text-base">
                        {{ 'home.heroSection.button'|trans|raw }}
                        {{ ux_icon('codicon:arrow-right', {'class':'size-4 shrink-0'}) }}
                    </twig:Button>
                </div>
                <div class="flex items-center max-[340px]:flex-col flex-row gap-2 mt-8">
                    <div class="flex -space-x-1.5">
                        <img src="{{ asset('medias/team/team_1.webp') }}" alt="{{ 'ctaFooter.image.1.alt'|trans }}" loading="eager" width="28" height="28" class="inline-block size-6 rounded-full outline outline-1 -outline-offset-1 outline-gray-700/10 ring-2 ring-white" />
                        <img src="{{ asset('medias/team/team_5.webp') }}" alt="{{ 'ctaFooter.image.2.alt'|trans }}" loading="eager" width="28" height="28" class="inline-block size-6 rounded-full outline outline-1 -outline-offset-1 outline-gray-700/10 ring-2 ring-white" />
                        <img src="{{ asset('medias/team/team_3.webp') }}" alt="{{ 'ctaFooter.image.3.alt'|trans }}" loading="eager" width="28" height="28" class="inline-block size-6 rounded-full outline outline-1 -outline-offset-1 outline-gray-700/10 ring-2 ring-white" />
                    </div>
                    <p class="text-gray-600 font-light text-sm text-center">
                        <span class="font-semibold">4.9/5</span> {{ 'home.heroSection.google.prefix'|trans({'%count%': google_reviews_count}) }}
                        {% set googleWord %}<span aria-hidden="true">{{ ux_icon('devicon:google', {'class': 'inline-block size-[0.9em] align-[-0.1em]'}) }}oogle</span><span class="sr-only">Google</span>{% endset %}
                        <a href="https://share.google/0s1NpwCRsqIJjeuqT" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-primary transition-colors duration-100 ease-out">
                            {{ 'home.heroSection.google.link'|trans({'%google%': googleWord})|raw }}
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </section>
    <section class="max-w-7xl lg:px-8 px-6 py-8 mx-auto" data-controller="snap-carousel" data-snap-carousel-interval-value="4000">
        <div data-snap-carousel-target="track" class="flex cursor-grab snap-x snap-mandatory gap-4 overflow-x-auto pb-3 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:grid lg:cursor-default lg:grid-cols-3 lg:gap-0 lg:overflow-visible lg:pb-0">
            <div class="flex w-[85%] shrink-0 snap-start items-center gap-x-4 sm:w-[46%] lg:w-auto lg:shrink lg:px-6">
                <div class="p-2 bg-neutral-50 rounded-full">
                    {{ ux_icon('iconoir:badge-check', {'class':'size-7 text-primary'}) }}
                </div>
                <div class="flex flex-col items-start">
                    <p class="font-semibold text-lg">{{ 'home.highlights.1.title'|trans }}</p>
                    <p class="font-light text-base text-slate-600 sm:text-sm">{{ 'home.highlights.1.text'|trans }}</p>
                </div>
            </div>
            <div class="flex w-[85%] shrink-0 snap-start items-center gap-x-4 sm:w-[46%] lg:w-auto lg:shrink lg:border-l lg:border-slate-200 lg:px-6">
                <div class="p-2 bg-neutral-50 rounded-full">
                    {{ ux_icon('lineicons:message-2-question', {'class':'size-7 text-primary'}) }}
                </div>
                <div class="flex flex-col items-start">
                    <p class="font-semibold text-lg">{{ 'home.highlights.2.title'|trans }}</p>
                    <p class="font-light text-base text-slate-600 sm:text-sm">{{ 'home.highlights.2.text'|trans }}</p>
                </div>
            </div>
            <div class="flex w-[85%] shrink-0 snap-start items-center gap-x-4 sm:w-[46%] lg:w-auto lg:shrink lg:border-l lg:border-slate-200 lg:px-6">
                <div class="p-2 bg-neutral-50 rounded-full">
                    {{ ux_icon('iconoir:home-simple', {'class':'size-7 text-primary'}) }}
                </div>
                <div class="flex flex-col items-start">
                    <p class="font-semibold text-lg">{{ 'home.highlights.3.title'|trans }}</p>
                    <p class="font-light text-base text-slate-600 sm:text-sm">{{ 'home.highlights.3.text'|trans }}</p>
                </div>
            </div>
        </div>

        {# Dot indicators (mobile only). Active dot stretches into a primary bar. #}
        <div class="mt-5 flex justify-center gap-2 lg:hidden">
            {% for i in 0..2 %}
                <button
                    type="button"
                    data-snap-carousel-target="dot"
                    data-index="{{ i }}"
                    data-active="{{ i == 0 ? 'true' : 'false' }}"
                    data-action="snap-carousel#to"
                    aria-label="Slide {{ i + 1 }}"
                    class="h-2 w-2 rounded-full bg-slate-300 transition-all duration-300 data-[active=true]:w-6 data-[active=true]:bg-primary"
                ></button>
            {% endfor %}
        </div>
    </section>
    <section class="max-w-2xl lg:max-w-7xl mx-auto lg:px-8 px-6 lg:py-16 py-12">
        <div
            data-controller="slider"
            class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start"
        >
            <div class="space-y-6 max-w-md">
                <div class="space-y-3">
                    <p class="font-semibold text-primary font-secondary">{{ 'home.services.title'|trans|raw }}</p>
                    <h2 class="text-3xl sm:text-4xl font-medium text-pretty">
                        {{ 'home.services.subTitle'|trans|raw }}
                    </h2>
                    <p class="text-slate-600 font-light text-pretty">
                        {{ 'home.services.text'|trans|raw }}
                    </p>
                </div>
                <div class="hidden sm:flex gap-3">
                    <button
                        data-slider-target="prev"
                        data-action="click->slider#prev"
                        aria-label="{{ 'home.services.prev'|trans }}"
                        class="size-11 rounded-full border border-gray-300 flex items-center justify-center transition-all duration-200 hover:bg-primary hover:text-white hover:border-primary opacity-30 cursor-not-allowed pointer-events-none"
                    >
                        {{ ux_icon('codicon:arrow-left', {'class':'size-4'}) }}
                    </button>
                    <button
                        data-slider-target="next"
                        data-action="click->slider#next"
                        aria-label="{{ 'home.services.next'|trans }}"
                        class="size-11 rounded-full border border-gray-300 flex items-center justify-center transition-all duration-200 hover:bg-primary hover:text-white hover:border-primary"
                    >
                        {{ ux_icon('codicon:arrow-right', {'class':'size-4'}) }}
                    </button>
                </div>
            </div>
            <div class="overflow-hidden">
                <div data-slider-target="track" class="flex gap-6 cursor-grab touch-pan-y">
                    <div class="w-full sm:w-[calc(50%-12px)] shrink-0 rounded-2xl p-2 border border-neutral-200 group">
                       <div class="flex flex-col justify-between gap-30 p-4 rounded-xl bg-linear-to-b from-neutral-100 to-neutral-100/0 group-hover:from-primary group-hover:to-primary h-full transition-colors duration-100">
                           <div class="space-y-4">
                               {{ ux_icon('lineicons:home-2', {'class': 'size-8 shrink-0 group-hover:text-white transition-colors duration-100 ease-out'}) }}
                               <h3 class="text-lg font-medium group-hover:text-white transition-colors duration-100 ease-out">{{ 'home.services.1.title'|trans|raw }}</h3>
                           </div>
                           <p class="font-light text-slate-600 text-pretty group-hover:text-slate-100 transition-colors duration-100 ease-out">
                               {{ 'home.services.1.text'|trans|raw }}
                           </p>
                       </div>
                    </div>
                    <div class="w-full sm:w-[calc(50%-12px)] shrink-0 rounded-2xl p-2 border border-neutral-200 group">
                        <div class="flex flex-col justify-between gap-20 lg:gap-30 p-4 rounded-xl bg-linear-to-b from-neutral-100 to-neutral-100/0 group-hover:from-primary group-hover:to-primary h-full transition-colors duration-100">
                            <div class="space-y-4">
                                {{ ux_icon('akar-icons:paper', {'class': 'size-8 shrink-0 group-hover:text-white transition-colors duration-100 ease-out'}) }}
                                <h3 class="text-lg font-medium group-hover:text-white transition-colors duration-100 ease-out">{{ 'home.services.2.title'|trans|raw }}</h3>
                            </div>
                            <p class="font-light text-slate-600 text-pretty group-hover:text-slate-100 transition-colors duration-100 ease-out">
                                {{ 'home.services.2.text'|trans|raw }}
                            </p>
                        </div>
                    </div>
                    <div class="w-full sm:w-[calc(50%-12px)] shrink-0 rounded-2xl p-2 border border-neutral-200 group">
                        <div class="flex flex-col justify-between gap-20 lg:gap-30 p-4 rounded-xl bg-linear-to-b from-neutral-100 to-neutral-100/0 group-hover:from-primary group-hover:to-primary h-full transition-colors duration-100">
                            <div class="space-y-4">
                                {{ ux_icon('hugeicons:package', {'class': 'size-8 shrink-0 group-hover:text-white transition-colors duration-100 ease-out'}) }}
                                <h3 class="text-lg font-medium group-hover:text-white transition-colors duration-100 ease-out">{{ 'home.services.3.title'|trans|raw }}</h3>
                            </div>
                            <p class="font-light text-slate-600 text-pretty group-hover:text-slate-100 transition-colors duration-100 ease-out">
                                {{ 'home.services.3.text'|trans|raw }}
                            </p>
                        </div>
                    </div>
                    <div class="w-full sm:w-[calc(50%-12px)] shrink-0 rounded-2xl p-2 border border-neutral-200 group">
                        <div class="flex flex-col justify-between gap-20 lg:gap-30 p-4 rounded-xl bg-linear-to-b from-neutral-100 to-neutral-100/0 group-hover:from-primary group-hover:to-primary h-full transition-colors duration-100">
                            <div class="space-y-4">
                                {{ ux_icon('ic:outline-school', {'class': 'size-8 shrink-0 group-hover:text-white transition-colors duration-100 ease-out'}) }}
                                <h3 class="text-lg font-medium group-hover:text-white transition-colors duration-100 ease-out">{{ 'home.services.4.title'|trans|raw }}</h3>
