{# Coque dédiée sans header/footer site : la personne vient déposer ses
   pièces, rien ne doit l'en distraire. base_auth = noindex par défaut,
   pas de canonical, pas de nav. Même langage visuel que le backoffice :
   cards rounded-3xl bordées, intérieur neutral-50, rangées blanches. #}
{% extends 'public/base_auth.html.twig' %}

{% block title %}{{ 'deposit.meta.title'|trans }}{% endblock %}
{% block description %}{{ 'deposit.meta.description'|trans }}{% endblock %}
{% block url %}{{ path('app_dossier_deposit') }}{% endblock %}

{% block body %}
    <div class="flex min-h-full w-full flex-col bg-neutral-50">
        <div class="mx-auto flex w-full max-w-2xl flex-1 flex-col px-4 py-8 lg:py-12">
            <div class="mb-8 flex items-center justify-between">
                <a href="{{ path('app_home') }}" class="shrink-0">
                    <img
                        src="{{ asset('medias/logos/logo_red.svg') }}"
                        alt="{{ 'header.logo.alt'|trans|raw }}"
                        width="166" height="38"
                        loading="eager"
                        class="h-8 w-auto"
                    />
                </a>
                {# Même switch de langue que le header du site (globe +
                   popover drapeaux); conserve le code pré-rempli du lien
                   email. #}
                {% set codeParam = app.request.query.get('code') ? {code: app.request.query.get('code')} : {} %}
                <div data-testid="deposit-locale-switch">
                    <twig:Button
                        variant="outline"
                        popovertarget="deposit-lang"
                        size="icon-lg"
                        aria-label="{{ 'header.lang.select'|trans|raw }}"
                        class="aria-expanded:bg-neutral-100 aria-expanded:text-primary hover:text-primary rounded-lg shadow-none border-none hover:bg-neutral-100 transition duration-100 flex items-center gap-x-2"
                    >
                        {{ ux_icon('proicons:globe', {'class': 'size-6', 'aria-hidden': 'true'}) }}
                    </twig:Button>
                    <el-popover
                        id="deposit-lang"
                        anchor="bottom"
                        popover
                        class="m-0 w-screen max-w-max overflow-visible bg-transparent p-0 px-4 transition [--anchor-gap:theme(spacing.5)] [transition-behavior:allow-discrete] backdrop:bg-transparent open:flex data-[closed]:translate-y-1 data-[closed]:opacity-0 data-[enter]:duration-200 data-[leave]:duration-150 data-[enter]:ease-out data-[leave]:ease-in"
                    >
                        <div class="w-screen max-w-[142px] flex-auto rounded-2xl space-y-1.5 bg-white p-3 text-sm/6 shadow-lg outline outline-1 outline-gray-900/5">
                            {% for locale in ['fr', 'en'] %}
                                <a
                                    href="{{ path('app_dossier_deposit', {_locale: locale}|merge(codeParam)) }}"
                                    hreflang="{{ locale }}"
                                    lang="{{ locale }}"
                                    class="{% if app.request.locale == locale %}bg-neutral-100 text-primary font-semibold{% endif %} relative rounded-lg px-4 py-2 hover:bg-neutral-100 text-sm/7 text-gray-900 cursor-pointer flex justify-between items-center"
                                >
                                    <span class="flex items-center gap-x-3">
                                        {{ ux_icon('circle-flags:' ~ locale, {'class': 'size-5 rounded-full', 'aria-hidden': 'true'}) }}
                                        {{ ('header.lang.type.' ~ locale)|trans|raw }}
                                    </span>
                                </a>
                            {% endfor %}
                        </div>
                    </el-popover>
                </div>
            </div>

            {% if paired %}
                {% include 'public/dossier/_documents.html.twig' with {deposit: deposit} only %}
            {% else %}
                {% include 'public/dossier/_pairing.html.twig' with {pairingForm: pairingForm, prefilledCode: prefilledCode} only %}
            {% endif %}

            {# Bandeau de confiance : même coque que les cards du BO. #}
            <section class="mt-8 rounded-3xl border border-neutral-200 bg-white p-2" data-testid="deposit-trust">
                <div class="rounded-2xl bg-neutral-50 p-2">
                    <ul role="list" class="grid grid-cols-1 gap-1 sm:grid-cols-2">
                        {% for item in [
                            {icon: 'lucide:lock', key: 'encrypted'},
                            {icon: 'lucide:eye-off', key: 'private'},
                            {icon: 'lucide:timer', key: 'retention'},
                            {icon: 'lucide:map-pin', key: 'hosting'},
                        ] %}
                            <li class="flex items-start gap-2.5 rounded-xl bg-white px-4 py-3">
                                {{ ux_icon(item.icon, {'class': 'mt-0.5 size-4 shrink-0 text-primary', 'aria-hidden': 'true'}) }}
                                <div class="min-w-0">
                                    <p class="text-xs font-semibold text-gray-900">{{ ('deposit.trust.' ~ item.key ~ '.title')|trans }}</p>
                                    <p class="mt-0.5 text-xs text-pretty text-gray-500">{{ ('deposit.trust.' ~ item.key ~ '.text')|trans }}</p>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </section>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs text-gray-400">
                <p>
                    Relocation in Paris ·
                    <a href="mailto:contact@relocation-in-paris.fr" class="underline decoration-gray-300 underline-offset-2 transition-colors duration-100 ease-out hover:text-gray-600">contact@relocation-in-paris.fr</a>
                </p>
                {% if paired %}
                    <span aria-hidden="true">·</span>
                    <form action="{{ path('app_dossier_deposit_leave') }}" method="post" data-turbo="true">
                        <input type="hidden" name="_token" value="{{ csrf_token('deposit_leave') }}">
                        <button type="submit" class="cursor-pointer underline decoration-gray-300 underline-offset-2 transition-colors duration-100 ease-out hover:text-gray-600" data-testid="deposit-leave">
                            {{ 'deposit.documents.leave'|trans }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
