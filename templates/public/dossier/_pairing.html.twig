{# Pairing region of the deposit page, replaced in place by the POST's
   Turbo Stream on validation errors. Same look as the login form: centered
   heading, max-w-sm stacked fields, full-width primary button. #}
{% set inputClass = 'flex h-10 w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-base text-gray-900 sm:text-sm/6 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:ring-primary/60 focus:outline-primary/80' %}
<div id="deposit-pairing" data-turbo="true" class="mx-auto w-full max-w-xl">
    <div class="flex w-full flex-col items-center space-y-2">
        <h1 class="mt-12 text-2xl/9 font-semibold tracking-tight text-gray-900">{{ 'deposit.pairing.title'|trans }}</h1>
        <p class="max-w-sm text-center font-light text-balance text-neutral-400">{{ 'deposit.pairing.text'|trans }}</p>
    </div>

    <div class="mx-auto mt-10 w-full max-w-sm">
        {{ form_start(pairingForm, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

            {% for error in pairingForm.vars.errors %}
                <twig:Alert class="border-amber-200 bg-amber-50 text-amber-900" role="alert" aria-live="polite">
                    <twig:ux:icon name="lucide:triangle-alert" class="size-4" />
                    <twig:Alert:Description>{{ error.message }}</twig:Alert:Description>
                </twig:Alert>
            {% endfor %}

            <div>
                {{ form_label(pairingForm.email, null, {'label_attr': {'class': 'flex items-center gap-2 text-sm/6 font-medium select-none text-gray-900'}}) }}
                <div class="mt-2">
                    {{ form_widget(pairingForm.email, {'attr': {
                        'class': inputClass,
                        'placeholder': 'deposit.pairing.email.placeholder'|trans,
                        'aria-required': 'true'
                    }}) }}
                </div>
                {% for error in pairingForm.email.vars.errors %}
                    <p class="mt-1 text-xs text-red-600" role="alert">{{ error.message }}</p>
                {% endfor %}
            </div>

            <div>
                {{ form_label(pairingForm.code, null, {'label_attr': {'class': 'flex items-center gap-2 text-sm/6 font-medium select-none text-gray-900'}}) }}
                {# Segmented code entry: the real form field stays as the no-JS
                   fallback and the submitted value; the six boxes are revealed
                   by the controller and mirror into it (paste fills them all). #}
                <div class="mt-2" data-controller="otp-input" data-testid="deposit-code-otp">
                    {{ form_widget(pairingForm.code, {'value': pairingForm.code.vars.value ?: prefilledCode, 'attr': {
                        'class': inputClass ~ ' tracking-[0.3em] uppercase placeholder:tracking-normal placeholder:normal-case',
                        'placeholder': 'deposit.pairing.code.placeholder'|trans,
                        'aria-required': 'true',
                        'data-otp-input-target': 'input'
                    }}) }}
                    <div class="hidden justify-between gap-2 [&:not(.hidden)]:flex" data-otp-boxes>
                        {% for i in 1..6 %}
                            <input
                                type="text"
                                inputmode="text"
                                autocapitalize="characters"
                                autocomplete="{{ loop.first ? 'one-time-code' : 'off' }}"
                                spellcheck="false"
                                maxlength="2"
                                aria-label="{{ 'deposit.pairing.code.charLabel'|trans({'%position%': i}) }}"
                                class="size-10 rounded-xl border border-neutral-200 bg-white text-center text-base font-semibold text-gray-900 uppercase transition-colors duration-100 ease-out focus:border-gray-400 focus:outline-none sm:size-12 sm:text-lg"
                                data-otp-input-target="box"
                                data-action="input->otp-input#input keydown->otp-input#keydown paste->otp-input#paste focus->otp-input#select"
                            >
                        {% endfor %}
                    </div>
                </div>
                {% for error in pairingForm.code.vars.errors %}
                    <p class="mt-1 text-xs text-red-600" role="alert">{{ error.message }}</p>
                {% endfor %}
                <p class="mt-1.5 flex items-center gap-1.5 text-xs text-neutral-400">
                    {{ ux_icon('lucide:circle-help', {class: 'size-3.5 shrink-0', 'aria-hidden': 'true'}) }}
                    {{ 'deposit.pairing.code.hint'|trans }}
                </p>
            </div>

            {{ form_widget(pairingForm.website) }}

            <div>
                <twig:Button variant="default" size="lg" class="w-full cursor-pointer">
                    {{ 'deposit.pairing.submit'|trans }}
                </twig:Button>
            </div>

        {{ form_end(pairingForm) }}
    </div>
</div>
