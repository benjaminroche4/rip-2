{# Pairing region of the deposit page, replaced in place by the POST's
   Turbo Stream on validation errors. Same card language as the backoffice:
   rounded-3xl bordered shell, neutral-50 inner, white content row. #}
{% set inputClass = 'w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 transition-colors duration-100 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none' %}
<div id="deposit-pairing" data-turbo="true" class="mx-auto w-full max-w-md">
    <div class="mb-6 space-y-1 text-center">
        <h1 class="text-2xl font-semibold">{{ 'deposit.pairing.title'|trans }}</h1>
        <p class="font-light text-pretty text-gray-600">{{ 'deposit.pairing.text'|trans }}</p>
    </div>

    <section class="rounded-3xl border border-neutral-200 bg-white p-2">
        <div class="rounded-2xl bg-neutral-50 p-2">
            <div class="rounded-xl bg-white p-4 lg:p-5">
                {{ form_start(pairingForm, {'attr': {'class': 'space-y-5', 'novalidate': 'novalidate'}}) }}

                    {% for error in pairingForm.vars.errors %}
                        <div role="alert" aria-live="polite" class="rounded-xl bg-red-50 p-3">
                            <p class="text-sm text-red-700">{{ error.message }}</p>
                        </div>
                    {% endfor %}

                    <div>
                        <div class="flex items-center gap-x-0.5">
                            {{ form_label(pairingForm.email, null, {'label_attr': {'class': 'text-sm text-gray-600'}}) }}
                            <span class="text-red-600" aria-hidden="true">*</span>
                        </div>
                        <div class="mt-1.5">
                            {{ form_widget(pairingForm.email, {'attr': {
                                'class': inputClass,
                                'placeholder': 'deposit.pairing.email.placeholder'|trans,
                                'aria-required': 'true'
                            }}) }}
                            {% for error in pairingForm.email.vars.errors %}
                                <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                            {% endfor %}
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center gap-x-0.5">
                            {{ form_label(pairingForm.code, null, {'label_attr': {'class': 'text-sm text-gray-600'}}) }}
                            <span class="text-red-600" aria-hidden="true">*</span>
                        </div>
                        <div class="mt-1.5">
                            {{ form_widget(pairingForm.code, {'value': pairingForm.code.vars.value ?: prefilledCode, 'attr': {
                                'class': inputClass ~ ' tracking-[0.3em] uppercase placeholder:tracking-normal placeholder:normal-case',
                                'placeholder': 'deposit.pairing.code.placeholder'|trans,
                                'aria-required': 'true'
                            }}) }}
                            {% for error in pairingForm.code.vars.errors %}
                                <p class="mt-1.5 text-sm text-red-600" role="alert">{{ error.message }}</p>
                            {% endfor %}
                            <p class="mt-1.5 text-xs text-gray-500">{{ 'deposit.pairing.code.hint'|trans }}</p>
                        </div>
                    </div>

                    {{ form_widget(pairingForm.website) }}

                    <button type="submit"
                        class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-white transition-colors duration-100 ease-out hover:bg-primary/90 focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-primary">
                        {{ ux_icon('lucide:lock-keyhole', {'class': 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                        {{ 'deposit.pairing.submit'|trans }}
                    </button>

                {{ form_end(pairingForm) }}
            </div>
        </div>
    </section>
</div>
