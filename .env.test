# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='t3st-s3cret-l0ng-en0ugh-f0r-jwt-trusted-dev1ce-c00kies-2026'

# Static fallback so the int cast in twig.yaml resolves cleanly under test
# (in dev/prod the real value lives in .env.local). Not a secret.
GOOGLE_REVIEWS_COUNT=370

# In-memory bus for tests — lets flow tests inspect dispatched messages via
# InMemoryTransport::getSent() without persisting to the DB or hitting workers.
MESSENGER_TRANSPORT_DSN=in-memory://

# Google Maps: empty key so no request ever leaves the test process.
GOOGLE_MAPS_API_KEY=
UX_MAP_DSN=google://test-google-maps-key@default
