# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> app/admin ###
# Path secret pour l'espace admin. Override OBLIGATOIRE dans .env.local.
# Generate: openssl rand -hex 16
ADMIN_PATH_PREFIX=
###< app/admin ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Google Calendar (visio) : compte de service Workspace avec délégation
# de domaine. Vide = désactivé, fallback invitation iCalendar par email.
# KEY_FILE accepte un chemin vers la clé JSON ou la clé encodée en base64.
GOOGLE_CALENDAR_KEY_FILE=
GOOGLE_CALENDAR_IMPERSONATE=

# Stockage GCS PRIVE (documents de dossier + avatars). 'local' = disque (dev),
# 'gcs' = bucket. Buckets europe-west9, accès uniforme, public bloqué :
#   - prod    : rip-bucket
#   - test/preprod : rip-bucket-test
# GCS_KEY_FILE = clé JSON du compte de service (visio-calendar, qui a le rôle
# Storage Object Admin sur les deux buckets). La séparation test/prod se fait
# via GCS_BUCKET dans le .env.local de chaque environnement.
# Documents de dossier : 'local' | 'gcs' | 'drive'. En mode 'drive' les pièces
# vont dans un Drive partagé (un folder par dossier, un sous-folder par
# personne), cf. GOOGLE_DRIVE_* plus bas.
DOSSIER_STORAGE=local
# Avatars : 'local' (disque, dev) ou 'gcs' (même bucket que les dossiers,
# sous le préfixe user/avatar/). Réutilise GCS_BUCKET + GCS_KEY_FILE.
AVATAR_STORAGE=local
# Photos d'annonce (formulaire public) : local|gcs, sous listings/<folder>/photos/.
LISTING_STORAGE=local
# Photos de bien des visites : même logique, même bucket (visits/<ref>/photos/).
VISIT_PHOTO_STORAGE=local
GCS_BUCKET=
GCS_KEY_FILE=

# Drive partagé pour les pièces de dossier (DOSSIER_STORAGE=drive). Le compte
# de service (visio-calendar) doit être membre "Gestionnaire de contenu" du
# Drive partagé ; pas de délégation de domaine nécessaire dans ce cas.
#   - GOOGLE_DRIVE_KEY_FILE : chemin ou clé JSON base64 (même compte de service)
#   - GOOGLE_DRIVE_SHARED_DRIVE_ID : id du Drive partagé (dans son URL)
#   - GOOGLE_DRIVE_IMPERSONATE : optionnel, seulement pour un My Drive via
#     délégation de domaine (laisser vide pour le Drive partagé)
# Vide = Drive désactivé, la création de folders et le partage sont no-op.
GOOGLE_DRIVE_KEY_FILE=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_IMPERSONATE=

# MAILER_DSN=sendmail://default
###< symfony/mailer ###

###> symfony/resend-mailer ###
# MAILER_DSN=resend+api://API_KEY@default
# MAILER_DSN=resend+smtp://resend:API_KEY@default
###< symfony/resend-mailer ###

###> sanity ###
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2019-01-29
SANITY_TOKEN=
SANITY_USE_CDN=false
WEBHOOK_SANITY_SECRET=
###< sanity ###

###> symfony/ux-google-map ###
# Options available at https://github.com/symfony/ux/blob/2.x/src/Map/src/Bridge/Google/README.md#
GOOGLE_MAPS_API_KEY="# Get your API key at https://developers.google.com/maps/documentation/javascript/get-api-key"
UX_MAP_DSN=google://%env(GOOGLE_MAPS_API_KEY)%@default
###< symfony/ux-google-map ###

###> withallo/api ###
# Allo API for the admin dashboard (call counts). Required scope: CONVERSATIONS_READ.
# Real values live in .env.local (gitignored). Phone number must be E.164.
###< withallo/api ###


###> docraptor ###
# HTML → PDF rendering through DocRaptor's hosted Chrome/Prince. Real key
# lives in .env.local (gitignored). Keep DOC_RAPTOR_TEST_MODE=true in dev
# and CI so we hit the free watermarked endpoint; flip to false in
# .env.local once the production key is provisioned.
DOC_RAPTOR_KEY=
DOC_RAPTOR_TEST_MODE=false
###< docraptor ###

###> Others ###
PHONE_NUMBER=
GOOGLE_REVIEWS_COUNT=
###< Others ###

###> symfony/ai-anthropic-platform ###
ANTHROPIC_API_KEY=
###< symfony/ai-anthropic-platform ###
